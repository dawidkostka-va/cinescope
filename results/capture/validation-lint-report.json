nent.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/project/apps/cinescope/src/app/movies/movie-list.component.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/workspace/project/apps/cinescope/src/app/seats/seat-selection.component.html","messages":[{"ruleId":"@angular-eslint/template/click-events-have-key-events","severity":2,"message":"click must be accompanied by either keyup, keydown or keypress event for accessibility.","line":22,"column":19,"nodeType":null,"messageId":"clickEventsHaveKeyEvents","endLine":29,"endColumn":43},{"ruleId":"@angular-eslint/template/interactive-supports-focus","severity":2,"message":"Elements with interaction handlers must be focusable.","line":22,"column":19,"nodeType":null,"messageId":"interactiveSupportsFocus","endLine":29,"endColumn":43},{"ruleId":"@angular-eslint/template/click-events-have-key-events","severity":2,"message":"click must be accompanied by either keyup, keydown or keypress event for accessibility.","line":32,"column":19,"nodeType":null,"messageId":"clickEventsHaveKeyEvents","endLine":40,"endColumn":57},{"ruleId":"@angular-eslint/template/interactive-supports-focus","severity":2,"message":"Elements with interaction handlers must be focusable.","line":32,"column":19,"nodeType":null,"messageId":"interactiveSupportsFocus","endLine":40,"endColumn":57}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"<main class=\"page\">\n  @if (screening(); as current) {\n    <h1 data-testid=\"seat-map-title\">Choose your seats</h1>\n    <p class=\"subtitle\" data-testid=\"seat-map-subtitle\">{{ subtitle() }}</p>\n    <p class=\"limit\" data-testid=\"seat-limit-info\">You can reserve up to 10 seats per reservation</p>\n\n    <div class=\"auditorium\">\n      <div class=\"screen\" data-testid=\"screen-indicator\">SCREEN</div>\n      <div class=\"seat-map\" data-testid=\"seat-map\">\n        @for (row of rows(); track row.number) {\n          <div class=\"seat-row\" data-testid=\"seat-row\" [attr.data-row]=\"row.number\">\n            <span class=\"row-label\" data-testid=\"row-label-left\" [attr.data-row]=\"row.number\">{{ row.number }}</span>\n            @for (item of row.items; track $index) {\n              @switch (item.kind) {\n                @case ('entrance') {\n                  <span class=\"entrance\"></span>\n                }\n                @case ('aisle') {\n                  <span class=\"aisle\" data-testid=\"aisle\" [attr.data-row]=\"item.row\"></span>\n                }\n                @case ('seat') {\n                  <div\n                    class=\"seat\"\n                    data-testid=\"seat\"\n                    [attr.data-row]=\"item.row\"\n                    [attr.data-column]=\"item.column\"\n                    [attr.data-state]=\"item.state\"\n                    (click)=\"toggle(item)\"\n                  >{{ item.column }}</div>\n                }\n                @case ('couch') {\n                  <div\n                    class=\"couch\"\n                    data-testid=\"couch\"\n                    [attr.data-row]=\"item.row\"\n                    [attr.data-column-start]=\"item.start\"\n                    [attr.data-column-end]=\"item.end\"\n                    [attr.data-state]=\"item.state\"\n                    (click)=\"toggle(item)\"\n                  >{{ item.start }}-{{ item.end }}</div>\n                }\n              }\n            }\n            <span class=\"row-label\" data-testid=\"row-label-right\" [attr.data-row]=\"row.number\">{{ row.number }}</span>\n          </div>\n        }\n      </div>\n    </div>\n\n    <div class=\"legend\" data-testid=\"legend\">\n      <span class=\"legend-item\" data-testid=\"legend-item\" data-state=\"available\"><i class=\"swatch\" data-state=\"available\"></i>Available</span>\n      <span class=\"legend-item\" data-testid=\"legend-item\" data-state=\"selected\"><i class=\"swatch\" data-state=\"selected\"></i>Selected</span>\n      <span class=\"legend-item\" data-testid=\"legend-item\" data-state=\"unavailable\"><i class=\"swatch\" data-state=\"unavailable\"></i>Unavailable</span>\n      <span class=\"legend-item\" data-testid=\"legend-item\" data-state=\"accessible\"><i class=\"swatch\" data-state=\"accessible\"></i>Accessible</span>\n    </div>\n\n    <section class=\"selected-seats\" data-testid=\"selected-seats\">\n      <p data-testid=\"selected-seats-count\">Selected seats: {{ selectedCount() }}</p>\n      @for (row of selectedRows(); track row.row) {\n        <p data-testid=\"selected-seats-row\" [attr.data-row]=\"row.row\">Row {{ row.row }}: {{ row.label }}</p>\n      }\n    </section>\n\n    <div class=\"actions\">\n      <button mat-stroked-button type=\"button\" data-testid=\"cancel-button\" (click)=\"cancel()\">Cancel</button>\n      <button mat-flat-button type=\"button\" data-testid=\"continue-button\" [disabled]=\"selectedCount() === 0\" (click)=\"goToSummary()\">Continue</button>\n    </div>\n  }\n</main>\n","usedDeprecatedRules":[]},{"filePath":"/workspace/project/apps/cinescope/src/app/seats/seat-selection.component.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@ty