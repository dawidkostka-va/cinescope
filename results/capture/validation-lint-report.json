ningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/project/apps/cinescope/src/app/movie-list/movie-list.component.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'DatePipe' is defined but never used.","line":1,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":18,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"DatePipe"},"fix":{"range":[0,44],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { DatePipe } from '@angular/common';\nimport { HttpClient } from '@angular/common/http';\nimport { Component, computed, DestroyRef, inject, input, signal } from '@angular/core';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { MatButtonModule } from '@angular/material/button';\nimport { MatDatepickerModule } from '@angular/material/datepicker';\nimport { MatFormFieldModule } from '@angular/material/form-field';\nimport { MatInputModule } from '@angular/material/input';\nimport { Router } from '@angular/router';\nimport { forkJoin } from 'rxjs';\nimport { addDays, parseIsoDate, startOfToday, toIsoDate, weekdayName } from '../dates';\nimport { API_URL } from '../api';\nimport { Movie, Screening } from '../models';\n\ntype LoadState = 'loading' | 'error' | 'loaded';\n\ninterface DayButton {\n  iso: string;\n  label: string;\n}\n\ninterface MovieCard {\n  movie: Movie;\n  screenings: Screening[];\n}\n\n@Component({\n  selector: 'app-movie-list',\n  imports: [MatButtonModule, MatDatepickerModule, MatFormFieldModule, MatInputModule],\n  templateUrl: './movie-list.component.html',\n  styleUrl: './movie-list.component.scss',\n})\nexport class MovieListComponent {\n  private readonly http = inject(HttpClient);\n  private readonly router = inject(Router);\n  private readonly destroyRef = inject(DestroyRef);\n\n  readonly date = input<string>();\n\n  readonly today = startOfToday();\n  readonly selectedDate = computed(() => {\n    const parsed = parseIsoDate(this.date());\n    return parsed && parsed >= this.today ? parsed : this.today;\n  });\n  readonly selectedIso = computed(() => toIsoDate(this.selectedDate()));\n\n  readonly days = computed<DayButton[]>(() =>\n    [0, 1, 2, 3, 4].map((offset) => {\n      const day = addDays(this.today, offset);\n      return { iso: toIsoDate(day), label: offset === 0 ? 'Today' : weekdayName(day) };\n    }),\n  );\n\n  readonly state = signal<LoadState>('loading');\n  private readonly movies = signal<Movie[]>([]);\n  private readonly screenings = signal<Screening[]>([]);\n\n  readonly cards = computed<MovieCard[]>(() =>\n    this.movies()\n      .map((movie) => ({\n        movie,\n        screenings: this.screenings()\n          .filter((s) => s.movieId === movie.id && s.date === this.selectedIso())\n          .sort((a, b) => a.time.localeCompare(b.time)),\n      }))\n      .filter((card) => card.screenings.length > 0),\n  );\n\n  constructor() {\n    this.load();\n  }\n\n  load(): void {\n    this.state.set('loading');\n    forkJoin({\n      movies: this.http.get<Movie[]>(`${API_URL}/movies`),\n      screenings: this.http.get<Screening[]>(`${API_URL}/screenings`),\n    })\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: ({ movies, screenings }) => {\n          this.movies.set(movies);\n          this.screenings.set(screenings);\n          this.state.set('loaded');\n        },\n        error: () => this.state.set('error'),\n      });\n  }\n\n  selectDay(iso: string): void {\n    this.router.navigate([], { queryParams: { date: iso } });\n  }\n\n  onDatePicked(value: Date | null): void {\n    if (!value) {\n      return;\n    }\n    const iso = toIsoDate(value);\n    if (iso < toIsoDate(this.today)) {\n      return;\n    }\n    this.selectDay(iso);\n  }\n\n  openScreening(id: number): void {\n    this.router.navigate(['/screenings', id, 'seats']);\n  }\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/workspace/project/apps/cinescope/src/app/seat-selection/seat-selection.component.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/project/apps/cinescope/src/app/seat-selection/seat-selection.component.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/workspace/project/apps/cinescope/src/app/seats.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/workspace/project/apps/cinescope/src/app/summary/summary.component.html","messages":