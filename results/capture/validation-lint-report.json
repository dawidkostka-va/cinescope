":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/project/apps/cinescope/src/app/seat-selection/seat-selection.spec.ts","messages":[{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":1,"message":"Forbidden non-null assertion.","line":41,"column":7,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":41,"endColumn":34,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[2035,2036],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { provideHttpClient } from '@angular/common/http';\nimport { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';\nimport { TestBed } from '@angular/core/testing';\nimport { ActivatedRoute, convertToParamMap, provideRouter } from '@angular/router';\nimport { Booking } from '../core/booking';\nimport { SeatSelection } from './seat-selection';\n\ndescribe('SeatSelection', () => {\n  function setup() {\n    sessionStorage.clear();\n    TestBed.configureTestingModule({\n      providers: [provideRouter([]), provideHttpClient(), provideHttpClientTesting(),\n        { provide: ActivatedRoute, useValue: { snapshot: { paramMap: convertToParamMap({ id: '1' }) } } },\n      ],\n    });\n    const fixture = TestBed.createComponent(SeatSelection);\n    TestBed.inject(HttpTestingController)\n      .expectOne('http://localhost:3000/screenings/1')\n      .flush({ id: 1, movieId: 1, date: '2026-09-15', time: '16:00', occupiedSeats: ['R3C7', 'R15C5'] });\n    fixture.detectChanges();\n    return { fixture, el: fixture.nativeElement as HTMLElement };\n  }\n\n  const q = (el: HTMLElement, id: string) => Array.from(el.querySelectorAll<HTMLElement>(`[data-testid=\"${id}\"]`));\n\n  it('draws the auditorium', () => {\n    const { el } = setup();\n    expect(q(el, 'seat-row').length).toBe(15);\n    expect(q(el, 'seat').length + q(el, 'couch').length).toBe(308);\n    expect(q(el, 'couch').length).toBe(12);\n    expect(q(el, 'aisle').length).toBe(30);\n    expect(q(el, 'seat').filter((s) => s.dataset['state'] === 'accessible').length).toBe(6);\n    expect(q(el, 'seat').filter((s) => s.dataset['state'] === 'unavailable').length).toBe(1);\n    expect(q(el, 'couch').filter((s) => s.dataset['state'] === 'unavailable').length).toBe(1);\n    expect(q(el, 'seat-map-subtitle')[0].textContent).toBe('Show Date: Tuesday 15 Sep 16:00');\n  });\n\n  it('selects, caps and lists seats', () => {\n    const { fixture, el } = setup();\n    const click = (testid: string, filter: (e: HTMLElement) => boolean) => {\n      q(el, testid).find(filter)!.click();\n      fixture.detectChanges();\n    };\n    click('seat', (s) => s.dataset['row'] === '7' && s.dataset['column'] === '12');\n    click('seat', (s) => s.dataset['row'] === '7' && s.dataset['column'] === '11');\n    click('couch', (s) => s.dataset['columnStart'] === '1');\n    expect(q(el, 'selected-seats-count')[0].textContent).toBe('Selected seats: 4');\n    expect(q(el, 'selected-seats-row').map((r) => r.textContent)).toEqual(['Row 7: 11, 12', 'Row 15: 1-2']);\n    expect(TestBed.inject(Booking).total()).toBe(32 * 2 + 89);\n  });\n});\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/workspace/project/apps/cinescope/src/app/seat-selection/seat-selection.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecate