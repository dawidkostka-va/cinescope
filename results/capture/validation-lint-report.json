nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":65,"endColumn":40,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[2859,2860],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":1,"message":"Forbidden non-null assertion.","line":66,"column":12,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":66,"endColumn":32,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[2939,2940],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { TestBed } from '@angular/core/testing';\nimport { provideRouter } from '@angular/router';\nimport { of } from 'rxjs';\nimport { ApiService } from './core/api.service';\nimport { BookingService } from './core/booking.service';\nimport { Checkout } from './checkout/checkout';\nimport { SeatMap } from './seat-map/seat-map';\n\nconst screening = {\n  id: 1,\n  movieId: 1,\n  date: '2026-09-15',\n  time: '16:00',\n  occupiedSeats: ['R3C7', 'R15C5', 'R15C6', 'R1C11'],\n};\n\ndescribe('screens', () => {\n  beforeEach(() => {\n    sessionStorage.clear();\n    TestBed.configureTestingModule({\n      providers: [provideRouter([]), { provide: ApiService, useValue: { screening: () => of(screening) } }],\n    });\n  });\n\n  it('renders the seat map and handles selection', async () => {\n    const fixture = TestBed.createComponent(SeatMap);\n    fixture.autoDetectChanges();\n    await fixture.whenStable();\n    const el: HTMLElement = fixture.nativeElement;\n    const q = (s: string) => Array.from(el.querySelectorAll<HTMLElement>(`[data-testid=\"${s}\"]`));\n    expect(q('seat').length + q('couch').length).toBe(308);\n    expect(q('couch').length).toBe(12);\n    expect(q('aisle').length).toBe(30);\n    expect(q('seat-row').length).toBe(15);\n    expect(q('seat-map-subtitle')[0].textContent).toBe('Show Date: Tuesday 15 Sep 16:00');\n    expect(q('seat').filter((s) => s.dataset['state'] === 'accessible').length).toBe(5);\n    expect(q('seat').filter((s) => s.dataset['state'] === 'unavailable').length).toBe(2);\n    expect(q('couch').filter((s) => s.dataset['state'] === 'unavailable').length).toBe(1);\n\n    const seat = q('seat').find((s) => s.dataset['row'] === '7' && s.dataset['column'] === '12')!;\n    seat.click();\n    q('couch')[0].click();\n    fixture.detectChanges();\n    expect(seat.dataset['state']).toBe('selected');\n    expect(q('selected-seats-count')[0].textContent).toBe('Selected seats: 3');\n    expect(q('selected-seats-row').map((r) => r.textContent)).toEqual(['Row 7: 12', 'Row 15: 1-2']);\n    expect(seat.textContent).toBe('12');\n  });\n\n  it('renders checkout and validates on pay', async () => {\n    const booking = TestBed.inject(BookingService);\n    booking.start(1);\n    booking.setSeats(['R7C12', 'R15C1', 'R15C2']);\n    const fixture = TestBed.createComponent(Checkout);\n    fixture.autoDetectChanges();\n    await fixture.whenStable();\n    const el: HTMLElement = fixture.nativeElement;\n    const byId = (id: string) => el.querySelector<HTMLElement>(`[data-testid=\"${id}\"]`);\n    expect(byId('pay-button')!.textContent).toBe('Pay 121.00 PLN');\n    expect(byId('first-name-label')!.textContent).toContain('First name *');\n    expect(byId('first-name-error')).toBeNull();\n    byId('pay-button')!.click();\n    fixture.detectChanges();\n    expect(byId('first-name-error')!.textContent).toBe('First name is required');\n    expect(byId('confirm-email-error')!.textContent).toBe('Confirm email is required');\n    expect(byId('terms-error')!.textContent).toBe('You must accept the terms and conditions');\n    expect(byId('phone-error')).toBeNull();\n  });\n});\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/workspace/project/apps/cinescope/src/app/seat-map/seat-map.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/workspace/project/apps/cinescope/src/app/summary/summary.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/workspace/project/apps/cinescope/src/index.html","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/project/apps/cinescope/src/main.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fata