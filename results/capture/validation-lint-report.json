assertion","severity":1,"message":"Forbidden non-null assertion.","line":79,"column":5,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":79,"endColumn":23,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[3212,3213],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":1,"message":"Forbidden non-null assertion.","line":89,"column":6,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":89,"endColumn":28,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[3684,3685],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":1,"message":"Forbidden non-null assertion.","line":91,"column":5,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":91,"endColumn":23,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[3789,3790],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { TestBed } from '@angular/core/testing';\nimport { ActivatedRoute, Router, convertToParamMap, provideRouter } from '@angular/router';\nimport { Subject } from 'rxjs';\nimport { ApiService } from '../core/api.service';\nimport { BookingService } from '../core/booking.service';\nimport { Reservation } from '../core/models';\nimport { CheckoutComponent } from './checkout';\n\ndescribe('CheckoutComponent', () => {\n  const reserve = new Subject<Reservation>();\n  const reserveSpy = vi.fn(() => reserve);\n\n  function setup() {\n    sessionStorage.clear();\n    TestBed.configureTestingModule({\n      providers: [\n        provideRouter([]),\n        { provide: ActivatedRoute, useValue: { snapshot: { paramMap: convertToParamMap({ id: '1' }) } } },\n        { provide: ApiService, useValue: { reserve: reserveSpy } },\n      ],\n    });\n    const booking = TestBed.inject(BookingService);\n    booking.open(1);\n    booking.addSeats(['R7C12', 'R15C1', 'R15C2']);\n    const fixture = TestBed.createComponent(CheckoutComponent);\n    fixture.detectChanges();\n    const el = fixture.nativeElement as HTMLElement;\n    const get = (id: string) => el.querySelector<HTMLElement>(`[data-testid=\"${id}\"]`);\n    const type = (id: string, value: string) => {\n      const input = get(id) as HTMLInputElement;\n      input.value = value;\n      input.dispatchEvent(new Event('input'));\n      fixture.detectChanges();\n    };\n    const blur = (id: string) => {\n      get(id)!.dispatchEvent(new Event('blur'));\n      fixture.detectChanges();\n    };\n    return { fixture, get, type, blur, booking };\n  }\n\n  it('labels and total', () => {\n    const { get } = setup();\n    expect(get('first-name-label')?.textContent).toBe('First name *');\n    expect(get('phone-label')?.textContent).toBe('Phone number');\n    expect(get('pay-button')?.textContent).toBe('Pay 121.00 PLN');\n  });\n\n  it('shows messages after blur and re-checks confirm email', () => {\n    const { get, type, blur } = setup();\n    expect(get('first-name-error')).toBeNull();\n    blur('first-name-input');\n    expect(get('first-name-error')?.textContent).toBe('First name is required');\n    type('first-name-input', 'A');\n    expect(get('first-name-error')?.textContent).toBe('First name must be at least 2 characters');\n    type('first-name-input', 'An');\n    expect(get('first-name-error')).toBeNull();\n\n    type('email-input', 'a@b');\n    blur('email-input');\n    expect(get('email-error')?.textContent).toBe('Enter a valid email address');\n    type('confirm-email-input', 'x@y.pl');\n    blur('confirm-email-input');\n    expect(get('confirm-email-error')?.textContent).toBe('Email addresses do not match');\n    type('email-input', 'x@y.pl');\n    expect(get('confirm-email-error')).toBeNull();\n\n    type('phone-input', '12345678');\n    blur('phone-input');\n    expect(get('phone-error')?.textContent).toBe('Phone number must be exactly 9 digits');\n    type('phone-input', '');\n    expect(get('phone-error')).toBeNull();\n  });\n\n  it('rejects an invalid form and pays a valid one', () => {\n    const { fixture, get, type, booking } = setup();\n    const router = TestBed.inject(Router);\n    const nav = vi.spyOn(router, 'navigateByUrl').mockResolvedValue(true);\n    get('pay-button')!.click();\n    fixture.detectChanges();\n    expect(reserveSpy).not.toHaveBeenCalled();\n    expect(get('terms-error')?.textContent).toBe('You must accept the terms and conditions');\n    expect(get('confirm-email-error')?.textContent).toBe('Confirm email is required');\n\n    type('first-name-input', 'Anna');\n    type('last-name-input', 'Kowalska');\n    type('email-input', 'anna@example.com');\n    type('confirm-email-input', 'anna@example.com');\n    (get('terms-checkbox')!.querySelector('input') as HTMLInputElement).click();\n    fixture.detectChanges();\n    get('pay-button')!.click();\n    fixture.detectChanges();\n    expect(reserveSpy).toHaveBeenCalledWith({\n      screeningId: 1,\n      seats: ['R7C12', 'R15C1', 'R15C2'],\n      customer: { firstName: 'Anna', lastName: 'Kowalska', email: 'anna@example.com', phone: '' },\n      totalPrice: 121,\n    });\n    expect(get('pay-button')?.textContent).toBe('Processing…');\n    expect((get('pay-button') as HTMLButtonElement).disabled).toBe(true);\n    reserve.next({} as Reservation);\n    expect(booking.booking()?.paid).toBe(true);\n    expect(booking.booking()?.email).toBe('anna@example.com');\n    expect(nav).toHaveBeenCalledWith('/confirmation');\n  });\n});\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/workspace/project/apps/cinescope/src/app/checkout/checkout.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/workspace/project/apps/cinescope/src/app/confirmation/confirmation.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/workspace/project/apps/cinescope/src/app/core/api.service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.