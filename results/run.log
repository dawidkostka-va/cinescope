s: FormErrors = validateForm(currentBooking.form);\n  const total = totalPrice(currentBooking.seats);\n\n  function updateField<K extends keyof BookingFormValues>(field: K, value: BookingFormValues[K]) {\n    setBooking({ ...currentBooking, form: { ...currentBooking.form, [field]: value } });\n  }\n\n  function markTouched(field: FieldName) {\n    setTouched((prev) => ({ ...prev, [field]: true }));\n  }\n\n  async function handlePay() {\n    const currentErrors = validateForm(currentBooking.form);\n    if (Object.keys(currentErrors).length > 0) {\n      setTouched(ALL_TOUCHED);\n      showToast('The form contains errors');\n      return;\n    }\n    setSubmitting(true);\n    try {\n      const seats = orderedSeatIds(currentBooking.seats);\n      await createReservation({\n        screeningId,\n        seats,\n        customer: {\n          firstName: currentBooking.form.firstName,\n          lastName: currentBooking.form.lastName,\n          email: currentBooking.form.email,\n          phone: currentBooking.form.phone,\n        },\n        totalPrice: total,\n      });\n      setBooking({ ...currentBooking, paid: true, paidEmail: currentBooking.form.email });\n      navigate('/confirmation');\n    } catch {\n      showToast('Payment failed. Please try again.');\n    } finally {\n      setSubmitting(false);\n    }\n  }","originalFile":"import Button from '@mui/material/Button';\nimport Checkbox from '@mui/material/Checkbox';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport TextField from '@mui/material/TextField';\nimport { useEffect, useState } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport { createReservation } from '../lib/api';\nimport { BookingFormValues, getBookingSnapshot, setBooking, useBooking } from '../lib/bookingStore';\nimport { formatPrice, orderedSeatIds, totalPrice } from '../lib/ticketing';\nimport { useToast } from '../lib/toast';\nimport { FormErrors, validateForm } from '../lib/validation';\n\ntype TextFieldName = 'firstName' | 'lastName' | 'email' | 'confirmEmail' | 'phone';\ntype FieldName = TextFieldName | 'termsAccepted';\n\nconst TEXT_FIELDS: { name: TextFieldName; label: string; testid: string; labelTestid: string; errorTestid: string }[] = [\n  { name: 'firstName', label: 'First name *', testid: 'first-name-input', labelTestid: 'first-name-label', errorTestid: 'first-name-error' },\n  { name: 'lastName', label: 'Last name *', testid: 'last-name-input', labelTestid: 'last-name-label', errorTestid: 'last-name-error' },\n  { name: 'email', label: 'Email *', testid: 'email-input', labelTestid: 'email-label', errorTestid: 'email-error' },\n  { name: 'confirmEmail', label: 'Confirm email *', testid: 'confirm-email-input', labelTestid: 'confirm-email-label', errorTestid: 'confirm-email-error' },\n  { name: 'phone', label: 'Phone number', testid: 'phone-input', labelTestid: 'phone-label', errorTestid: 'phone-error' },\n];\n\nconst ALL_TOUCHED: Record<FieldName, boolean> = {\n  firstName: true,\n  lastName: true,\n  email: true,\n  confirmEmail: true,\n  phone: true,\n  termsAccepted: true,\n};\n\nexport function CheckoutPage() {\n  const { id } = useParams();\n  const screeningId = Number(id);\n  const navigate = useNavigate();\n  const { showToast } = useToast();\n  const booking = useBooking();\n  const [touched, setTouched] = useState<Record<FieldName, boolean>>({\n    firstName: false,\n    lastName: false,\n    email: false,\n    confirmEmail: false,\n    phone: false,\n    termsAccepted: false,\n  });\n  const [submitting, setSubmitting] = useState(false);\n\n  useEffect(() => {\n    const snapshot = getBookingSnapshot();\n    if (!snapshot || snapshot.paid || snapshot.screeningId !== screeningId || snapshot.seats.length === 0) {\n      navigate('/', { replace: true });\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  if (!booking) {\n    return null;\n  }\n\n  const errors: FormErrors = validateForm(booking.form);\n  const total = totalPrice(booking.seats);\n\n  function updateField<K extends keyof BookingFormValues>(field: K, value: BookingFormValues[K]) {\n    setBooking({ ...booking!, form: { ...booking!.form, [field]: value } });\n  }\n\n  function markTouched(field: FieldName) {\n    setTouched((prev) => ({ ...prev, [field]: true }));\n  }\n\n  async function handlePay() {\n    const currentErrors = validateForm(booking!.form);\n    if (Object.keys(currentErrors).length > 0) {\n      setTouched(ALL_TOUCHED);\n      showToast('The form contains errors');\n      return;\n    }\n    setSubmitting(true);\n    try {\n      const seats = orderedSeatIds(booking!.seats);\n      await createReservation({\n        screeningId,\n        seats,\n        customer: {\n          firstName: booking!.form.firstName,\n          lastName: booking!.form.lastName,\n          email: booking!.form.email,\n          phone: booking!.form.phone,\n        },\n        totalPrice: total,\n      });\n      setBooking({ ...booking!, paid: true, paidEmail: booking!.form.email });\n      navigate('/confirmation');\n    } catch {\n      showToast('Payment failed. Please try again.');\n    } finally {\n      setSubmitting(false);\n    }\n  }\n\n  return (\n    <div>\n      <h1 data-testid=\"checkout-title\">Your details</h1>\n      <div>\n        {TEXT_FIELDS.map((field) => (\n          <div key={field.name}>\n            <label data-testid={field.labelTestid} htmlFor={field.name}>\n              {field.label}\n            </label>\n            <TextField\n              id={field.name}\n              data-testid={field.testid}\n              value={booking.form[field.name]}\n              onChange={(e) => updateField(field.name, e.target.value)}\n              onBlur={() => markTouched(field.name)}\n            />\n            {touched[field.name] && errors[field.name] && (\n              <div data-testid={field.errorTestid}>{errors[field.name]}</div>\n            )}\n          </div>\n        ))}\n        <div>\n          <FormControlLabel\n            control={\n              <Checkbox\n                id=\"termsAccepted\"\n                data-testid=\"terms-checkbox\"\n                checked={booking.form.termsAccepted}\n                onChange={(e) => {\n                  updateField('termsAccepted', e.target.checked);\n                  markTouched('termsAccepted');\n                }}\n              />\n            }\n            label={<span data-testid=\"terms-label\">I accept the terms and conditions *</span>}\n          />\n          {touched.termsAccepted && errors.termsAccepted && <div data-testid=\"terms-error\">{errors.termsAccepted}</div>}\n        </div>\n        <div>\n          <Button data-testid=\"checkout-back-button\" onClick={() => navigate(`/screenings/${screeningId}/summary`)}>\n            Back\n          </Button>\n          <Button data-testid=\"pay-button\" disabled={submitting} onClick={handlePay}>\n            {submitting ? 'Processing…' : `Pay ${formatPrice(total)}`}\n          </Button>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nexport default CheckoutPage;\n","structuredPatch":[{"oldStart":58,"oldLines":11,"newStart":58,"newLines":12,"lines":["     return null;","   }"," ","-  const errors: FormErrors = validateForm(booking.form);","-  const total = totalPrice(booking.seats);","+  const currentBooking = booking;","+  const errors: FormErrors = validateForm(currentBooking.form);","+  const total = totalPrice(currentBooking.seats);"," ","   function updateField<K extends keyof BookingFormValues>(field: K, value: BookingFormValues[K]) {","-    setBooking({ ...booking!, form: { ...booking!.form, [field]: value } });","+    setBooking({ ...currentBooking, form: { ...currentBooking.form, [field]: value } });","   }"," ","   function markTouched(field: FieldName) {"]},{"oldStart":70,"oldLines":7,"newStart":71,"newLines":7,"lines":["   }"," ","   async function handlePay() {","-    const currentErrors = validateForm(booking!.form);","+    const currentErrors = validateForm(currentBooking.form);","     if (Object.keys(currentErrors).length > 0) {","       setTouched(ALL_TOUCHED);","       showToast('The form contains errors');"]},{"oldStart":78,"oldLines":19,"newStart":79,"newLines":19,"lines":["     }","     setSubmitting(true);","     try {","-      const seats = orderedSeatIds(booking!.seats);","+      const seats = orderedSeatIds(currentBooking.seats);","       await createReservation({","         screeningId,","         seats,","         customer: {","-          firstName: booking!.form.firstName,","-          lastName: booking!.form.lastName,","-          email: booking!.form.email,","-          phone: booking!.form.phone,","+          firstName: currentBooking.form.firstName,","+          lastName: currentBooking.form.lastName,","+          email: currentBooking.form.email,","+          phone: currentBooking.form.phone,","         },","         totalPrice: total,","       });","-      setBooking({ ...booking!, paid: true, paidEmail: booking!.form.email });","+      setBooking({ ...currentBooking, paid: true, paidEmail: currentBooking.form.email });","       navigate('/confirmation');","     } catch {","       showToast('Payment failed. Please try again.');"]}],"userModified":false,"replaceAll":false}}
