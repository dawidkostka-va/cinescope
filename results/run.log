ructuredPatch":[{"oldStart":12,"oldLines":7,"newStart":12,"newLines":7,"lines":["   });"," ","   it('describes couches as Couch a-b and seats by column', () => {","-    const [seat, couch] = toUnits(['R15C3', 'R15C4', 'R3C12']).reverse();","+    const [seat, couch] = toUnits(['R15C3', 'R15C4', 'R3C12']);","     expect(unitDescription(seat)).toBe('12');","     expect(unitDescription(couch)).toBe('Couch 3-4');","     expect(unitLabel(couch)).toBe('3-4');"]}],"userModified":false,"replaceAll":false}}
