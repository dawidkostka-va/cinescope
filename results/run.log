s/cinescope/src\",\n  \"tags\": [],\n  \"targets\": {\n    \"build\": {\n      \"executor\": \"@angular/build:application\",\n      \"outputs\": [\n        \"{options.outputPath}\"\n      ],\n      \"defaultConfiguration\": \"production\",\n      \"options\": {\n        \"outputPath\": \"dist/apps/cinescope\",\n        \"browser\": \"apps/cinescope/src/main.ts\",\n        \"tsConfig\": \"apps/cinescope/tsconfig.app.json\",\n        \"inlineStyleLanguage\": \"scss\",\n        \"assets\": [\n          {\n            \"glob\": \"**/*\",\n            \"input\": \"apps/cinescope/public\"\n          }\n        ],\n        \"styles\": [\n          \"apps/cinescope/src/styles.scss\"\n        ]\n      },\n      \"configurations\": {\n        \"production\": {\n          \"budgets\": [\n            {\n              \"type\": \"initial\",\n              \"maximumWarning\": \"500kb\",\n              \"maximumError\": \"1mb\"\n            }\n          ],\n          \"outputHashing\": \"all\"\n        },\n        \"development\": {\n          \"optimization\": false,\n          \"extractLicenses\": false,\n          \"sourceMap\": true\n        }\n      }\n    },\n    \"serve\": {\n      \"continuous\": true,\n      \"executor\": \"@angular/build:dev-server\",\n      \"defaultConfiguration\": \"development\",\n      \"options\": {\n        \"port\": 4200\n      },\n      \"configurations\": {\n        \"production\": {\n          \"buildTarget\": \"cinescope:build:production\"\n        },\n        \"development\": {\n          \"buildTarget\": \"cinescope:build:development\"\n        }\n      }\n    },\n    \"lint\": {\n      \"executor\": \"@nx/eslint:lint\"\n    },\n    \"test\": {\n      \"executor\": \"@angular/build:unit-test\",\n      \"options\": {\n        \"watch\": false\n      }\n    },\n    \"serve-static\": {\n      \"continuous\": true,\n      \"executor\": \"@nx/web:file-server\",\n      \"options\": {\n        \"buildTarget\": \"cinescope:build\",\n        \"port\