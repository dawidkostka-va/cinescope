ening: Screening; movie: Movie }),\n        error: () => this.router.navigateByUrl('/'),\n      });\n  }\n\n  protected remove(ticket: Ticket): void {\n    const seats = (this.bookingService.booking()?.seats ?? []).filter((id) => !ticket.ids.includes(id));\n    this.bookingService.setSeats(seats);\n    if (seats.length === 0) this.router.navigate(['/screenings', this.id, 'seats']);\n  }\n\n  protected back(): void {\n    this.router.navigate(['/screenings', this.id, 'seats']);\n  }\n\n  protected confirm(): void {\n    this.router.navigate(['/screenings', this.id, 'checkout']);\n  }\n}\nEOF\ncat > summary/summary.html <<'EOF'\n@if (data(); as d) {\n  <div class=\"page\">\n    <h1 data-testid=\"summary-title\">Your tickets</h1>\n    <ul class=\"list\" data-testid=\"summary-list\">\n      @for (t of tickets(); track t.row + '-' + t.start) {\n        <li class=\"item\" data-testid=\"summary-item\">\n          <span data-testid=\"summary-item-title\">{{ d.movie.title }}</span>\n          <span data-testid=\"summary-item-datetime\">{{ d.screening.date }} {{ d.screening.time }}</span>\n          <span class=\"row-info\">Row <span data-testid=\"summary-item-row\">{{ t.row }}</span></span>\n          <span class=\"seat-info\">Seat <span data-testid=\"summary-item-seat\">{{ seatDescription(t) }}</span></span>\n          <span data-testid=\"summary-item-price\">{{ formatPrice(t.price) }}</span>\n          <button mat-stroked-button type=\"button\" data-testid=\"summary-item-remove-button\" (click)=\"remove(t)\">\n            Remove\n          </button>\n        </li>\n      }\n    </ul>\n    <p class=\"total\" data-testid=\"summary-total\">Total: {{ total() }}</p>\n    <div class=\"actions\">\n      <button mat-stroked-button type=\"button\" data-testid=\"back-button\" (click)=\"back()\">Back</button>\n      <button mat-flat-button type=\"button\" data-testid=\"confirm-button\" (click)=\"confirm()\">Confirm</button>\n    </div>\n  </div>\n}\nEOF\ncat > summary/summary.scss <<