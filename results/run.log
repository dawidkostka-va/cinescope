{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QDixA1ohvyq2AmESshJmja","type":"tool_result","content":"1\timport { useEffect, useState } from 'react';\n2\timport { useNavigate, useParams } from 'react-router-dom';\n3\timport Box from '@mui/material/Box';\n4\timport Button from '@mui/material/Button';\n5\timport List from '@mui/material/List';\n6\timport ListItem from '@mui/material/ListItem';\n7\timport Stack from '@mui/material/Stack';\n8\timport Typography from '@mui/material/Typography';\n9\timport { fetchMovie, fetchScreening } from '../../api';\n10\timport type { Movie, Screening } from '../../types';\n11\timport { Booking, loadBooking, saveBooking } from '../../booking';\n12\timport { formatPrice, getBookingItems, seatDescription, totalPrice } from '../../seatUtils';\n13\t\n14\texport function SummaryPage() {\n15\t  const { screeningId } = useParams();\n16\t  const navigate = useNavigate();\n17\t\n18\t  const [booking, setBooking] = useState<Booking | null>(null);\n19\t  const [screening, setScreening] = useState<Screening | null>(null);\n20\t  const [movie, setMovie] = useState<Movie | null>(null);\n21\t  const [guardFailed, setGuardFailed] = useState(false);\n22\t\n23\t  useEffect(() => {\n24\t    const existing = loadBooking();\n25\t    if (\n26\t      !existing ||\n27\t      existing.paid ||\n28\t      existing.screeningId !== Number(screeningId) ||\n29\t      existing.seats.length === 0\n30\t    ) {\n31\t      setGuardFailed(true);\n32\t      navigate('/', { replace: true });\n33\t      return;\n34\t    }\n35\t    setBooking(existing);\n36\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n37\t  }, [screeningId]);\n38\t\n39\t  useEffect(() => {\n40\t    if (guardFailed) return;\n41\t    let cancelled = false;\n42\t    async function load() {\n43\t      try {\n44\t        const loadedScreening = await fetchScreening(screeningId as string);\n45\t        if (cancelled) return;\n46\t        setScreening(loadedScreening);\n47\t        const loadedMovie = await fetchMovie(loadedScreening.movieId);\n48\t        if (cancelled) return;\n49\t        setMovie(loadedMovie);\n50\t      } catch {\n51\t        if (!cancelled) {\n52\t          navigate('/', { replace: true });\n53\t        }\n54\t      }\n55\t    }\n56\t    load();\n57\t    return () => {\n58\t      cancelled = true;\n59\t    };\n60\t  }, [screeningId, guardFailed, navigate]);\n61\t\n62\t  if (guardFailed || !booking || !screening || !movie) {\n63\t    return null;\n64\t  }\n65\t\n66\t  const items = getBookingItems(booking.seats);\n67\t\n68\t  function handleRemove(ids: string[]) {\n69\t    if (!booking) return;\n70\t    const newSeats = booking.seats.filter((id) => !ids.includes(id));\n71\t    const updated = { ...booking, seats: newSeats };\n72\t    saveBooking(updated);\n73\t    if (newSeats.length === 0) {\n74\t      navigate(`/screenings/${screeningId}/seats`);\n75\t      return;\n76\t    }\n77\t    setBooking(updated);\n78\t  }\n79\t\n80\t  function handleBack() {\n81\t    navigate(`/screenings/${screeningId}/seats`);\n82\t  }\n83\t\n84\t  function handleConfirm() {\n85\t    navigate(`/screenings/${screeningId}/checkout`);\n86\t  }\n87\t\n88\t  return (\n89\t    <Box sx={{ maxWidth: 720, mx: 'auto', p: 3 }}>\n90\t      <Typography variant=\"h4\" data-testid=\"summary-title\" gutterBottom>\n91\t        Your tickets\n92\t      </Typography>\n93\t\n94\t      <List data-testid=\"summary-list\">\n95\t        {items.map((item) => (\n96\t          <ListItem\n97\t            key={item.ids.join('+')}\n98\t            data-testid=\"summary-item\"\n99\t            sx={{ display: 'flex', justifyContent: 'space-between', gap: 2 }}\n100\t          >\n101\t            <Stack>\n102\t              <Typography data-testid=\"summary-item-title\">{movie.title}</Typography>\n103\t              <Typography data-testid=\"summary-item-datetime\">\n104\t                {screening.date} {screening.time}\n105\t              </Typography>\n106\t              <Typography data-testid=\"summary-item-row\">{item.row}</Typography>\n107\t              <Typography data-testid=\"summary-item-seat\">{seatDescription(item)}</Typography>\n108\t              <Typography data-testid=\"summary-item-price\">{formatPrice(item.price)}</Typography>\n109\t            </Stack>\n110\t            <Button\n111\t              data-testid=\"summary-item-remove-button\"\n112\t              variant=\"outlined\"\n113\t              onClick={() => handleRemove(item.ids)}\n114\t            >\n115\t              Remove\n116\t            </Button>\n117\t          </ListItem>\n118\t        ))}\n119\t      </List>\n120\t\n121\t      <Typography data-testid=\"summary-total\" variant=\"h6\">\n122\t        Total: {totalPrice(booking.seats).toFixed(2)} PLN\n123\t      </Typography>\n124\t\n125\t      <Stack direction=\"row\" spacing={2} sx={{ mt: 2 }}>\n126\t        <Button data-testid=\"back-button\" variant=\"outlined\" onClick={handleBack}>\n127\t          Back\n128\t        </Button>\n129\t        <Button data-testid=\"confirm-button\" variant=\"contained\" onClick={handleConfirm}>\n130\t          Confirm\n131\t        </Button>\n132\t      </Stack>\n133\t    </Box>\n134\t  );\n135\t}\n136\t"}]},"parent_tool_use_id":"toolu_019qhPutAQhu9gtYed3XbehR","session_id":"3632df4e-836a-4239-9ca1-2c0c9dc67b92","uuid":"f6bcb333-65fe-403b-a2e3-ad2d65e93dd0","timestamp":"2026-10-20T06:41:55.842Z","subagent_type":"Explore","task_description":"Audit cinescope implementation against spec"}
