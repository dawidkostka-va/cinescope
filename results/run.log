\n          Back\n        </Button>\n        <Button data-testid=\"confirm-button\" onClick={() => navigate(`/screenings/${screeningId}/checkout`)}>\n          Confirm\n        </Button>\n      </div>\n    </div>\n  );\n}\n\nexport default SummaryPage;\n"}}}
