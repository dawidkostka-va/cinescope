um + item.price, 0);\n}\nEOF\ncat > api.service.ts <<'EOF'\nimport { HttpClient } from '@angular/common/http';\nimport { Injectable, inject } from '@angular/core';\nimport { Observable } from 'rxjs';\nimport { Movie, Reservation, Screening } from './models';\n\nconst BASE_URL = 'http://localhost:3000';\n\n@Injectable({ providedIn: 'root' })\nexport class ApiService {\n  private readonly http = inject(HttpClient);\n\n  movies(): Observable<Movie[]> {\n    return this.http.get<Movie[]>(`${BASE_URL}/movies`);\n  }\n\n  movie(id: number): Observable<Movie> {\n    return this.http.get<Movie>(`${BASE_URL}/movies/${id}`);\n  }\n\n  screenings(): Observable<Screening[]> {\n    return this.http.get<Screening[]>(`${BASE_URL}/screenings`);\n  }\n\n  screening(id: string | number): Observable<Screening> {\n    return this.http.get<Screening>(`${BASE_URL}/screenings/${id}`);\n  }\n\n  createReservation(reservation: Reservation): Observable<Reservation> {\n    return this.http.post<Reservation>(`${BASE_URL}/reservations`, reservation);\n  }\n}\nEOF\ncat > booking.service.ts <<'EOF'\nimport { Injectable, computed, signal } from '@angular/core';\nimport { Booking, FormValues } from './models';\nimport { Item, itemsFromSeats, totalOf } from './seats';\n\nconst STORAGE_KEY = 'cinescope.booking';\n\nexport const emptyForm = (): FormValues => ({\n  firstName: '',\n  lastName: '',\n  email: '',\n  confirmEmail: '',\n  phone: '',\n  terms: false,\n});\n\nfunction load(): Booking | null {\n  try {\n    const raw = sessionStorage.getItem(STORAGE_KEY);\n    if (!raw) return null;\n    const data = JSON.parse(raw);\n    if (typeof data?.screeningId !== 'number' || !Array.isArray(data.seats)) return null;\n    return {\n      screeningId: data.screeningId,\n      seats: data.seats.filter((s: unknown) => typeof s === 'string'),\n      form: { ...emptyForm(), ...(data.form ?? {}) },\n      paid: data.paid === true,\n      email: typeof data.email === 'string' ? data.email : '',\n    };\n  } catch {\n    return null;\n  }\n}\n\n@Injectable({ providedIn: 'root' })\nexport class BookingService {\n  private readonly _state = signal<Booking | null>(load());\n\n  readonly state = this._state.asReadonly();\n  readonly items = computed<Item[]>(() => itemsFromSeats(this._state()?.seats ?? []));\n  readonly total = computed(() => totalOf(this.items()));\n\n  isInProgressFor(screeningId: number): boolean {\n    const b = this._state();\n    return !!b && !b.paid && b.screeningId === screeningId;\n  }\n\n  start(screeningId: number): void {\n    this.set({ screeningId, seats: [], form: emptyForm(), paid: false, email: '' });\n  }\n\n  setSeats(seats: string[]): void {\n    this.update((b) => ({ ...b, seats }));\n  }\n\n  setForm(form: FormValues): void {\n    this.update((b) => ({ ...b, form }));\n  }\n\n  markPaid(email: string): void {\n    this.update((b) => ({ ...b, paid: true, email }));\n  }\n\n  clear(): void {\n    this.set(null);\n  }\n\n  private update(fn: (b: Booking) => Booking): void {\n    const current = this._state();\n    if (current) this.set(fn(current));\n  }\n\n  private set(booking: Booking | null): void {\n    this._state.set(booking);\n    try {\n      if (booking) sessionStorage.setItem(STORAGE_KEY, JSON.stringify(booking));\n      else sessionStorage.removeItem(STORAGE_KEY);\n    } catch {\n      // storage unavailable: keep the in-memory booking only\n    }\n  }\n}\nEOF\ncat > toast.service.ts <<'EOF'\nimport { Component, Injectable, inject } from '@angular/core';\nimport { MAT_SNACK_BAR_DATA, MatSnackBar } from '@angular/material/snack-bar';\n\n@Component({\n  selector: 'app-toast',\n  template: `<span data-testid=\"toast\">{{ data.message }}</span>`,\n})\nexport class Toast {\n  protected readonly data = inject<{ message: string }>(MAT_SNACK_BAR_DATA);\n}\n\n@Injectable({ providedIn: 'root' })\nexport class ToastService {\n  private readonly snackBar = inject(MatSnackBar);\n\n  show(message: string): void {\n    this.snackBar.openFromComponent(Toast, { data: { message }, duration: 4000 });\n  }\n}\nEOF\ncat > guards.ts <<'EOF'\nimport { inject } from '@angular/core';\nimport { CanActivateFn, Router } from '@angular/router';\nimport { BookingService } from './booking.service';\n\nexport const unpaidBookingGuard: CanActivateFn = (route) => {\n  const b = inject(BookingService).state();\n  const id = Number(route.paramMap.get('id'));\n  return b && !b.paid && b.screeningId === id && b.seats.length > 0 ? true : inject(Router).createUrlTree(['/']);\n};\n\nexport const paidBookingGuard: CanActivateFn = () => {\n  const b = inject(BookingService).state();\n  return b?.paid ? true : inject(Router).createUrlTree(['/']);\n};\nEOF\ncat > app.routes.ts <<'EOF'\nimport { Route } from '@angular/router';\nimport { paidBookingGuard, unpaidBookingGuard } from './guards';\n\nexport const appRoutes: Route[] = [\n  { path: '', pathMatch: 'full', loadComponent: () => import('./movie-list/movie-list').then((m) => m.MovieList) },\n  { path: 'screenings/:id/seats', loadComponent: () => import('./seat-map/seat-map').then((m) => m.SeatMap) },\n  {\n    path: 'screenings/:id/summary',\n    canActivate: [unpaidBookingGuard],\n    loadComponent: () => import('./summary/summary').then((m) => m.Summary),\n  },\n  {\n    path: 'screenings/:id/checkout',\n    canActivate: [unpaidBookingGuard],\n    loadComponent: () => import('./checkout/checkout').then((m) => m.Checkout),\n  },\n  {\n    path: 'confirmation',\n    canActivate: [paidBookingGuard],\n    loadComponent: () => import('./confirmation/confirmation').then((m) => m.Confirmation),\n  },\n  { path: '**', redirectTo: '' },\n];\nEOF\ncat > app.config.ts <<'EOF'\nimport { provideHttpClient } from '@angular/common/http';\nimport { ApplicationConfig, provideBrowserGlobalErrorListeners } from '@angular/core';\nimport { provideNativeDateAdapter } from '@angular/material/core';\nimport { provideRouter } from '@angular/router';\nimport { appRoutes } from './app.routes';\n\nexport const appConfig: ApplicationConfig = {\n  providers: [\n    provideBrowserGlobalErrorListeners(),\n    provideRouter(appRoutes),\n    provideHttpClient(),\n    provideNativeDateAdapter(),\n  ],\n};\nEOF"}}}
