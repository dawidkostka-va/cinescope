{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cg5fj8tUF1r1Rf39QZhhN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01He7eik9zCG7X6EiBB2QCPi","name":"Write","input":{"file_path":"/workspace/project/apps/cinescope/src/lib/toast.tsx","content":"import Snackbar from '@mui/material/Snackbar';\nimport { createContext, ReactNode, useCallback, useContext, useState } from 'react';\n\ninterface ToastContextValue {\n  showToast: (message: string) => void;\n}\n\nconst ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function ToastProvider({ children }: { children: ReactNode }) {\n  const [message, setMessage] = useState<string | null>(null);\n  const [toastKey, setToastKey] = useState(0);\n\n  const showToast = useCallback((next: string) => {\n    setMessage(next);\n    setToastKey((key) => key + 1);\n  }, []);\n\n  const handleClose = useCallback((_event: unknown, reason?: string) => {\n    if (reason === 'clickaway') return;\n    setMessage(null);\n  }, []);\n\n  return (\n    <ToastContext.Provider value={{ showToast }}>\n      {children}\n      <Snackbar\n        key={toastKey}\n        open={message !== null}\n        autoHideDuration={4000}\n        onClose={handleClose}\n        message={<span data-testid=\"toast\">{message}</span>}\n      />\n    </ToastContext.Provider>\n  );\n}\n\nexport function useToast(): ToastContextValue {\n  const context = useContext(ToastContext);\n  if (!context) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return context;\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":801,"cache_read_input_tokens":107387,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":801},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fc51c61a-6dab-4a2b-8142-c8f64be3453e","uuid":"9fce95be-c231-4d81-97b9-7693b522ca49","timestamp":"2026-10-16T09:20:11.332Z","request_id":"req_011Cg5fj8QCYyGomMp7fCG3e","wire_tool_inputs":{"toolu_01He7eik9zCG7X6EiBB2QCPi":{"file_path":"/workspace/project/apps/cinescope/src/lib/toast.tsx","content":"import Snackbar from '@mui/material/Snackbar';\nimport { createContext, ReactNode, useCallback, useContext, useState } from 'react';\n\ninterface ToastContextValue {\n  showToast: (message: string) => void;\n}\n\nconst ToastContext = createContext<ToastContextValue | null>(null);\n\nexport function ToastProvider({ children }: { children: ReactNode }) {\n  const [message, setMessage] = useState<string | null>(null);\n  const [toastKey, setToastKey] = useState(0);\n\n  const showToast = useCallback((next: string) => {\n    setMessage(next);\n    setToastKey((key) => key + 1);\n  }, []);\n\n  const handleClose = useCallback((_event: unknown, reason?: string) => {\n    if (reason === 'clickaway') return;\n    setMessage(null);\n  }, []);\n\n  return (\n    <ToastContext.Provider value={{ showToast }}>\n      {children}\n      <Snackbar\n        key={toastKey}\n        open={message !== null}\n        autoHideDuration={4000}\n        onClose={handleClose}\n        message={<span data-testid=\"toast\">{message}</span>}\n      />\n    </ToastContext.Provider>\n  );\n}\n\nexport function useToast(): ToastContextValue {\n  const context = useContext(ToastContext);\n  if (!context) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return context;\n}\n"}}}
