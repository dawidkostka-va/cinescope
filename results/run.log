{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cs2jbqjMjAds3AAfHPAWMf","type":"tool_result","content":"1\timport Button from '@mui/material/Button';\n2\timport Stack from '@mui/material/Stack';\n3\timport { DatePicker } from '@mui/x-date-pickers/DatePicker';\n4\timport { Dayjs } from 'dayjs';\n5\t\n6\texport interface DayButtonOption {\n7\t  value: string;\n8\t  label: string;\n9\t}\n10\t\n11\tinterface DayPickerProps {\n12\t  dayButtons: DayButtonOption[];\n13\t  selectedButtonValue: string | null;\n14\t  datePickerValue: Dayjs | null;\n15\t  minDate: Dayjs;\n16\t  onSelectDay: (value: string) => void;\n17\t  onSelectDate: (value: Dayjs) => void;\n18\t}\n19\t\n20\texport function DayPicker({\n21\t  dayButtons,\n22\t  selectedButtonValue,\n23\t  datePickerValue,\n24\t  minDate,\n25\t  onSelectDay,\n26\t  onSelectDate,\n27\t}: DayPickerProps) {\n28\t  return (\n29\t    <Stack direction=\"row\" spacing={2} alignItems=\"center\" data-testid=\"day-picker\">\n30\t      {dayButtons.map((day) => (\n31\t        <Button\n32\t          key={day.value}\n33\t          data-testid=\"day-button\"\n34\t          data-date={day.value}\n35\t          data-selected={day.value === selectedButtonValue ? 'true' : 'false'}\n36\t          variant={day.value === selectedButtonValue ? 'contained' : 'outlined'}\n37\t          onClick={() => onSelectDay(day.value)}\n38\t        >\n39\t          {day.label}\n40\t        </Button>\n41\t      ))}\n42\t      <DatePicker\n43\t        value={datePickerValue}\n44\t        minDate={minDate}\n45\t        onChange={(value) => {\n46\t          if (value && value.isValid()) {\n47\t            onSelectDate(value);\n48\t          }\n49\t        }}\n50\t        slotProps={{ textField: { 'data-testid': 'date-picker', size: 'small' } }}\n51\t      />\n52\t    </Stack>\n53\t  );\n54\t}\n55\t"}]},"parent_tool_use_id":null,"session_id":"b57fd512-3185-49f1-a3f5-4ca4529fa7ab","uuid":"9e32bced-86ad-4ef6-adff-818307d5d74c","timestamp":"20