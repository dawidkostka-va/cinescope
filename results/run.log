adonly bookingService = inject(BookingService);\n  private readonly toast = inject(ToastService);\n  private readonly id = inject(ActivatedRoute).snapshot.paramMap.get('id') ?? '';\n\n  protected readonly layout = LAYOUT;\n  protected readonly legend = LEGEND;\n  protected readonly gridColumn = gridColumn;\n\n  protected readonly screening = signal<Screening | null>(null);\n  protected readonly loaded = signal(false);\n\n  protected readonly subtitle = computed(() => {\n    const s = this.screening();\n    return s ? `Show Date: ${showDate(s.date, s.time)}` : '';\n  });\n\n  private readonly occupied = computed(() => new Set(this.screening()?.occupiedSeats ?? []));\n  private readonly selected = computed(() => new Set(this.bookingService.booking()?.seats ?? []));\n\n  protected readonly selectedCount = computed(() => this.selected().size);\n  protected readonly summaryRows = computed(() => {\n    const byRow = new Map<number, string[]>();\n    for (const t of this.bookingService.tickets()) {\n      const label = t.couch ? `${t.start}-${t.end}` : String(t.start);\n      byRow.set(t.row, [...(byRow.get(t.row) ?? []), label]);\n    }\n    return [...byRow].map(([row, labels]) => ({ row, text: `Row ${row}: ${labels.join(', ')}` }));\n  });\n\n  constructor() {\n    this.api\n      .screening(this.id)\n      .pipe(\n        tap((screening) => {\n          this.bookingService.startIfNeeded(screening.id);\n          this.screening.set(screening);\n        }),\n        switchMap((screening) => this.api.movie(screening.movieId)),\n      )\n      .subscribe({\n        next: () => this.loaded.set(true),\n        error: () => this.router.navigateByUrl('/'),\n      });\n  }\n\n  protected state(ticket: Ticket): SeatState {\n    if (ticket.ids.some((id) => this.occupied().has(id))) return 'unavailable';\n    if (this.selected().has(ticket.ids[0])) return 'selected';\n    if (!ticket.couch && isAccessible(ticket.row, ticket.start)) return 'accessible';\n    return 'available';\n  }\n\n  protected toggle(ticket: Ticket): void {\n    const state = this.state(ticket);\n    if (state === 'unavailable') return;\n    const current = this.bookingService.booking()?.seats ?? [];\n    if (state === 'selected') {\n      this.bookingService.setSeats(current.filter((id) => !ticket.ids.includes(id)));\n    } else if (current.length + ticket.ids.length > MAX_SEATS) {\n      this.toast.show('Maximum 10 seats per booking');\n    } else {\n      this.bookingService.setSeats([...current, ...ticket.ids]);\n    }\n  }\n\n  protected cancel(): void {\n    this.bookingService.clear();\n    this.router.navigateByUrl('/');\n  }\n\n  protected next(): void {\n    if (this.selectedCount() > 0) this.router.navigate(['/screenings', this.id, 'summary']);\n  }\n}\nEOF\ncat > seat-selection/seat-selection.html <<'EOF'\n@if (loaded()) {\n  <div class=\"page\">\n    <h1 data-testid=\"seat-map-title\">Choose your seats</h1>\n    <h2 data-testid=\"seat-map-subtitle\">{{ subtitle() }}</h2>\n\n    <div class=\"auditorium\">\n      <p class=\"limit\" data-testid=\"seat-limit-info\">You can reserve up to 10 seats per reservation</p>\n      <div class=\"screen\" data-testid=\"screen-indicator\">SCREEN</div>\n      <div class=\"seat-map\" data-testid=\"seat-map\">\n        @for (r of layout; track r.row) {\n          <div class=\"row\" data-testid=\"seat-row\" [attr.data-row]=\"r.row\">\n            <span class=\"label left\" data-testid=\"row-label-left\" [attr.data-row]=\"r.row\">{{ r.row }}</span>\n            <span class=\"aisle a1\" data-testid=\"aisle\" [attr.data-row]=\"r.row\"></span>\n            <span class=\"aisle a2\" data-testid=\"aisle\" [attr.data-row]=\"r.row\"></span>\n            @for (t of r.tickets; track t.start) {\n              @if (t.couch) {\n                <button\n                  type=\"button\"\n                  class=\"cell couch\"\n                  data-testid=\"couch\"\n                  [class]=\"'cell couch ' + state(t)\"\n                  [style.grid-column]=\"gridColumn(t.start) + ' / span 2'\"\n                  [attr.data-row]=\"t.row\"\n                  [attr.data-column-start]=\"t.start\"\n                  [attr.data-column-end]=\"t.end\"\n                  [attr.data-state]=\"state(t)\"\n                  [attr.aria-disabled]=\"state(t) === 'unavailable'\"\n                  (click)=\"toggle(t)\"\n                >{{ t.start }}-{{ t.end }}</button>\n              } @else {\n                <button\n                  type=\"button\"\n                  data-testid=\"seat\"\n                  [class]=\"'cell ' + state(t)\"\n                  [style.grid-column]=\"gridColumn(t.start)\"\n                  [attr.data-row]=\"t.row\"\n                  [attr.data-column]=\"t.start\"\n                  [attr.data-state]=\"state(t)\"\n                  [attr.aria-disabled]=\"state(t) === 'unavailable'\"\n                  (click)=\"toggle(t)\"\n                >{{ t.start }}</button>\n              }\n            }\n            <span class=\"label right\" data-testid=\"row-label-right\" [attr.data-row]=\"r.row\">{{ r.row }}</span>\n          </div>\n        }\n      </div>\n    </div>\n\n    <div class=\"legend\" data-testid=\"legend\">\n      @for (item of legend; track item.state) {\n        <span class=\"legend-item\" data-testid=\"legend-item\" [attr.data-state]=\"item.state\">\n          <span class=\"swatch\" [class]=\"'swatch ' + item.state\"></span>{{ item.label }}\n        </span>\n      }\n    </div>\n\n    <div class=\"panel\" data-testid=\"selected-seats\">\n      <div data-testid=\"selected-seats-count\">Selected seats: {{ selectedCount() }}</div>\n      @for (line of summaryRows(); track line.row) {\n        <div data-testid=\"selected-seats-row\" [attr.data-row]=\"line.row\">{{ line.text }}</div>\n      }\n    </div>\n\n    <div class=\"actions\">\n      <button mat-stroked-button type=\"button\" data-testid=\"cancel-button\" (click)=\"cancel()\">Cancel</button>\n      <button\n        mat-flat-button\n        type=\"button\"\n        data-testid=\"continue-button\"\n        [disabled]=\"selectedCount() === 0\"\n        (click)=\"next()\"\n      >\n        Continue\n      </button>\n    </div>\n  </div>\n}\nEOF\ncat > seat-selection/seat-selection.scss <<'EOF'\n$cell: 32px;\n$gap: 4px;\n\n.page {\n  padding: 16px 24px 32px;\n  text-align: center;\n}\n\nh1,\nh2 {\n  margin: 8px 0;\n}\n\nh2 {\n  font-weight: 400;\n  font-size: 18px;\n}\n\n.auditorium {\n  width: fit-content;\n  margin: 0 auto;\n}\n\n.limit {\n  text-align: center;\n  margin: 8px 0 16px;\n}\n\n.screen {\n  margin: 0 ($cell + 12px) 20px;\n  padding: 6px 0;\n  background: #444;\n  color: #fff;\n  letter-spacing: 6px;\n  border-radius: 4px;\n}\n\n.seat-map {\n  display: flex;\n  flex-direction: column;\n  gap: $gap;\n}\n\n.row {\n  display: grid;\n  grid-template-columns:\n    40px repeat(4, $cell) (2 * $cell) repeat(16, $cell) (2 * $cell) repeat(4, $cell)\n    40px;\n  column-gap: $gap;\n  height: $cell;\n\n  > * {\n    grid-row: 1;\n  }\n}\n\n.label {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 500;\n}\n\n.left {\n  grid-column: 1;\n}\n\n.right {\n  grid-column: 28;\n}\n\n.a1 {\n  grid-column: 6;\n}\n\n.a2 {\n  grid-column: 23;\n}\n\n.cell {\n  border: 0;\n  border-radius: 4px;\n  padding: 0;\n  font: inherit;\n  font-size: 12px;\n  color: #fff;\n  cursor: pointer;\n  outline-offset: 2px;\n}\n\n.couch {\n  border-radius: 10px;\n  border: 2px solid rgba(0, 0, 0, 0.35);\n  box-sizing: border-box;\n}\n\n.available,\n.swatch.available {\n  background-color: #2e7d32;\n}\n\n.selected,\n.swatch.selected {\n  background-color: #f9a825;\n}\n\n.unavailable,\n.swatch.unavailable {\n  background-color: #c62828;\n}\n\n.accessible,\n.swatch.accessible {\n  background-color: #1565c0;\n}\n\n.cell.selected {\n  color: #000;\n}\n\n.cell.unavailable {\n  cursor: not-allowed;\n}\n\n.legend {\n  display: flex;\n  justify-content: center;\n  gap: 24px;\n  margin: 24px 0