{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ShjeXsPkeikvdHRunqu79R","type":"tool_result","content":"1\timport Button from '@mui/material/Button';\n2\timport { DatePicker } from '@mui/x-date-pickers/DatePicker';\n3\timport dayjs, { Dayjs } from 'dayjs';\n4\timport { useCallback, useEffect, useState } from 'react';\n5\timport { useNavigate, useSearchParams } from 'react-router-dom';\n6\timport { fetchMovies, fetchScreeningsByDate } from '../../api/client';\n7\timport { Movie, Screening } from '../../api/types';\n8\timport { resolveSelectedDate, toIsoDate, today } from '../../domain/dateFormat';\n9\timport styles from './MovieListPage.module.scss';\n10\t\n11\ttype LoadState = { status: 'loading' } | { status: 'error' } | { status: 'loaded'; movies: Movie[]; screenings: Screening[] };\n12\t\n13\tinterface DayButton {\n14\t  label: string;\n15\t  date: string;\n16\t}\n17\t\n18\tfunction dayButtons(): DayButton[] {\n19\t  return Array.from({ length: 5 }, (_, i) => {\n20\t    const date = today().add(i, 'day');\n21\t    return { label: i === 0 ? 'Today' : date.format('dddd'), date: toIsoDate(date) };\n22\t  });\n23\t}\n24\t\n25\texport function MovieListPage() {\n26\t  const [searchParams, setSearchParams] = useSearchParams();\n27\t  const navigate = useNavigate();\n28\t  const selectedDate = resolveSelectedDate(searchParams.get('date'));\n29\t  const [state, setState] = useState<LoadState>({ status: 'loading' });\n30\t\n31\t  const load = useCallback(() => {\n32\t    setState({ status: 'loading' });\n33\t    Promise.all([fetchMovies(), fetchScreeningsByDate(selectedDate)])\n34\t      .then(([movies, screenings]) => setState({ status: 'loaded', movies, screenings }))\n35\t      .catch(() => setState({ status: 'error' }));\n36\t  }, [selectedDate]);\n37\t\n38\t  useEffect(() => {\n39\t    load();\n40\t  }, [load]);\n41\t\n42\t  function selectDate(iso: string): void {\n43\t    const isToday = iso === toIsoDate(today());\n44\t    setSearchParams(isToday ? {} : { date: iso });\n45\t  }\n46\t\n47\t  const buttons = dayButtons();\n48\t  const isQuickPickDate = buttons.some((b) => b.date === selectedDate);\n49\t\n50\t  return (\n51\t    <div className={styles.page}>\n52\t      <div data-testid=\"day-picker\" className={styles.dayPicker}>\n53\t        {buttons.map((b) => (\n54\t          <Button\n55\t            key={b.date}\n56\t            data-testid=\"day-button\"\n57\t            data-date={b.date}\n58\t            data-selected={b.date === selectedDate}\n59\t            variant={b.date === selectedDate ? 'contained' : 'outlined'}\n60\t            onClick={() => selectDate(b.date)}\n61\t          >\n62\t            {b.label}\n63\t          </Button>\n64\t        ))}\n65\t        <DatePicker\n66\t          data-testid=\"date-picker\"\n67\t          className={styles.datePicker}\n68\t          label=\"Choose a date\"\n69\t          minDate={today()}\n70\t          value={isQuickPickDate ? null : dayjs(selectedDate)}\n71\t          onChange={(value: Dayjs | null) => {\n72\t            if (value && value.isValid()) {\n73\t              selectDate(toIsoDate(value));\n74\t            }\n75\t          }}\n76\t        />\n77\t      </div>\n78\t\n79\t      {state.status === 'loading' && <div data-testid=\"movies-loading\">Loading…</div>}\n80\t\n81\t      {state.status === 'error' && (\n82\t        <div data-testid=\"movies-error\">\n83\t          Failed to load movies\n84\t          <div>\n85\t            <Button data-testid=\"movies-retry-button\" onClick={load} variant=\"outlined\">\n86\t              Retry\n87\t            </Button>\n88\t          </div>\n89\t        </div>\n90\t      )}\n91\t\n92\t      {state.status === 'loaded' && <MovieCards movies={state.movies} screenings={state.screenings} navigate={navigate} />}\n93\t    </div>\n94\t  );\n95\t}\n96\t\n97\tfunction MovieCards({\n98\t  movies,\n99\t  screenings,\n100\t  navigate,\n101\t}: {\n102\t  movies: Movie[];\n103\t  screenings: Screening[];\n104\t  navigate: ReturnType<typeof useNavigate>;\n105\t}) {\n106\t  const cards = movies\n107\t    .map((movie) => ({\n108\t      movie,\n109\t      screenings: screenings.filter((s) => s.movieId === movie.id).sort((a, b) => a.time.localeCompare(b.time)),\n110\t    }))\n111\t    .filter((c) => c.screenings.length > 0);\n112\t\n113\t  if (cards.length === 0) {\n114\t    return <div data-testid=\"movies-empty\">No screenings on this day</div>;\n115\t  }\n116\t\n117\t  return (\n118\t    <div data-testid=\"movie-list\">\n119\t      {cards.map(({ movie, screenings: movieScreenings }) => (\n120\t        <div key={movie.id} data-testid=\"movie-card\" data-movie-id={movie.id} className={styles.card}>\n121\t          <div className={styles.cardHeader}>\n122\t            <strong data-testid=\"movie-title\">{movie.title}</strong>\n123\t            <span data-testid=\"movie-genre\">{movie.genre}</span>\n124\t            <span data-testid=\"movie-runtime\">{movie.runtimeMinutes} min</span>\n125\t            <span data-testid=\"movie-format\">{movie.format}</span>\n126\t          </div>\n127\t          <div className={styles.screenings}>\n128\t            {movieScreenings.map((s) => (\n129\t              <Button\n130\t                key={s.id}\n131\t                data-testid=\"screening-button\"\n132\t                data-screening-id={s.id}\n133\t                variant=\"outlined\"\n134\t                onClick={() => navigate(`/screenings/${s.id}/seats`)}\n135\t              >\n136\t                {s.time}\n137\t              </Button>\n138\t            ))}\n139\t          </div>\n140\t        </div>\n141\t      ))}\n142\t    </div>\n143\t  );\n144\t}\n145\t"}]},"parent_tool_use_id":null,"session_id":"18d24fdc-128d-4444-9721-af8b117c5cc6","uuid":"a246fe28-0f68-4879-a654-7d81a8b4eee0","timestamp":"2026-10-20T08:13:26.857Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/pages/movie-list/MovieListPage.tsx","content":"import Button from '@mui/material/Button';\nimport { DatePicker } from '@mui/x-date-pickers/DatePicker';\nimport dayjs, { Dayjs } from 'dayjs';\nimport { useCallback, useEffect, useState } from 'react';\nimport { useNavigate, useSearchParams } from 'react-router-dom';\nimport { fetchMovies, fetchScreeningsByDate } from '../../api/client';\nimport { Movie, Screening } from '../../api/types';\nimport { resolveSelectedDate, toIsoDate, today } from '../../domain/dateFormat';\nimport styles from './MovieListPage.module.scss';\n\ntype LoadState = { status: 'loading' } | { status: 'error' } | { status: 'loaded'; movies: Movie[]; screenings: Screening[] };\n\ninterface DayButton {\n  label: string;\n  date: string;\n}\n\nfunction dayButtons(): DayButton[] {\n  return Array.from({ length: 5 }, (_, i) => {\n    const date = today().add(i, 'day');\n    return { label: i === 0 ? 'Today' : date.format('dddd'), date: toIsoDate(date) };\n  });\n}\n\nexport function MovieListPage() {\n  const [searchParams, setSearchParams] = useSearchParams();\n  const navigate = useNavigate();\n  const selectedDate = resolveSelectedDate(searchParams.get('date'));\n  const [state, setState] = useState<LoadState>({ status: 'loading' });\n\n  const load = useCallback(() => {\n    setState({ status: 'loading' });\n    Promise.all([fetchMovies(), fetchScreeningsByDate(selectedDate)])\n      .then(([movies, screenings]) => setState({ status: 'loaded', movies, screenings }))\n      .catch(() => setState({ status: 'error' }));\n  }, [selectedDate]);\n\n  useEffect(() => {\n    load();\n  }, [load]);\n\n  function selectDate(iso: string): void {\n    const isToday = iso === toIsoDate(today());\n    setSearchParams(isToday ? {} : { date: iso });\n  }\n\n  const buttons = dayButtons();\n  const isQuickPickDate = buttons.some((b) => b.date === selectedDate);\n\n  return (\n    <div className={styles.page}>\n      <div data-testid=\"day-picker\" className={styles.dayPicker}>\n        {buttons.map((b) => (\n          <Button\n            key={b.date}\n            data-testid=\"day-button\"\n            data-date={b.date}\n            data-selected={b.date === selectedDate}\n            variant={b.date === selectedDate ? 'contained' : 'outlined'}\n            onClick={() => selectDate(b.date)}\n          >\n            {b.label}\n          </Button>\n        ))}\n        <DatePicker\n          data-testid=\"date-picker\"\n          className={styles.datePicker}\n          label=\"Choose a date\"\n          minDate={today()}\n          value={isQuickPickDate ? null : dayjs(selectedDate)}\n          onChange={(value: Dayjs | null) => {\n            if (value && value.isValid()) {\n              selectDate(toIsoDate(value));\n            }\n          }}\n        />\n      </div>\n\n      {state.status === 'loading' && <div data-testid=\"movies-loading\">Loading…</div>}\n\n      {state.status === 'error' && (\n        <div data-testid=\"movies-error\">\n          Failed to load movies\n          <div>\n            <Button data-testid=\"movies-retry-button\" onClick={load} variant=\"outlined\">\n              Retry\n            </Button>\n          </div>\n        </div>\n      )}\n\n      {state.status === 'loaded' && <MovieCards movies={state.movies} screenings={state.screenings} navigate={navigate} />}\n    </div>\n  );\n}\n\nfunction MovieCards({\n  movies,\n  screenings,\n  navigate,\n}: {\n  movies: Movie[];\n  screenings: Screening[];\n  navigate: ReturnType<typeof useNavigate>;\n}) {\n  const cards = movies\n    .map((movie) => ({\n      movie,\n      screenings: screenings.filter((s) => s.movieId === movie.id).sort((a, b) => a.time.localeCompare(b.time)),\n    }))\n    .filter((c) => c.screenings.length > 0);\n\n  if (cards.length === 0) {\n    return <div data-testid=\"movies-empty\">No screenings on this day</div>;\n  }\n\n  return (\n    <div data-testid=\"movie-list\">\n      {cards.map(({ movie, screenings: movieScreenings }) => (\n        <div key={movie.id} data-testid=\"movie-card\" data-movie-id={movie.id} className={styles.card}>\n          <div className={styles.cardHeader}>\n            <strong data-testid=\"movie-title\">{movie.title}</strong>\n            <span data-testid=\"movie-genre\">{movie.genre}</span>\n            <span data-testid=\"movie-runtime\">{movie.runtimeMinutes} min</span>\n            <span data-testid=\"movie-format\">{movie.format}</span>\n          </div>\n          <div className={styles.screenings}>\n            {movieScreenings.map((s) => (\n              <Button\n                key={s.id}\n                data-testid=\"screening-button\"\n                data-screening-id={s.id}\n                variant=\"outlined\"\n                onClick={() => navigate(`/screenings/${s.id}/seats`)}\n              >\n                {s.time}\n              </Button>\n            ))}\n          </div>\n        </div>\n      ))}\n    </div>\n  );\n}\n","numLines":145,"startLine":1,"totalLines":145}}}
