m }, paid: !!parsed.paid, email: parsed.email ?? '' };\n  } catch {\n    return null;\n  }\n}\n\n@Injectable({ providedIn: 'root' })\nexport class BookingService {\n  private readonly state = signal<Booking | null>(read());\n\n  readonly booking = this.state.asReadonly();\n  readonly tickets = computed<Ticket[]>(() => ticketsFromSeats(this.state()?.seats ?? []));\n  readonly total = computed(() => this.tickets().reduce((sum, t) => sum + t.price, 0));\n\n  start(screeningId: number): void {\n    this.set({ screeningId, seats: [], form: emptyForm(), paid: false, email: '' });\n  }\n\n  startIfNeeded(screeningId: number): void {\n    const b = this.state();\n    if (!b || b.paid || b.screeningId !== screeningId) this.start(screeningId);\n  }\n\n  setSeats(seats: string[]): void {\n    this.patch({ seats });\n  }\n\n  setForm(form: CustomerForm): void {\n    this.patch({ form });\n  }\n\n  markPaid(email: string): void {\n    this.patch({ paid: true, email });\n  }\n\n  clear(): void {\n    this.set(null);\n  }\n\n  private patch(change: Partial<Booking>): void {\n    const b = this.state();\n    if (b) this.set({ ...b, ...change });\n  }\n\n  private set(booking: Booking | null): void {\n    this.state.set(booking);\n    try {\n      if (booking) sessionStorage.setItem(STORAGE_KEY, JSON.stringify(booking));\n      else sessionStorage.removeItem(STORAGE_KEY);\n    } catch {\n      // storage unavailable: keep the in-memory booking only\n    }\n  }\n}\nEOF\ncat > core/guards.ts <<'EOF'\nimport { inject } from '@angular/core';\nimport { CanActivateFn, Router } from '@angular/router';\nimport { BookingService } from './booking.service';\n\nexport const inProgressBookingGuard: CanActivateFn = (route) => {\n  const b = inject(BookingService).booking();\n  const ok = !!b && !b.paid && String(b.screeningId) === route.paramMap.get('id') && b.seats.length > 0;\n  return ok || inject(Router).createUrlTree(['/']);\n};\n\nexport const paidBookingGuard: CanActivateFn = () => {\n  const b = inject(BookingService).booking();\n  return !!b?.paid || inject(Router).createUrlTree(['/']);\n};\nEOF\ncat > core/toast.service.ts <<'EOF'\nimport { Component, Injectable, inject } from '@angular/core';\nimport { MAT_SNACK_BAR_DATA, MatSnackBar } from '@angular/material/snack-bar';\n\n@Component({\n  selector: 'app-toast',\n  template: '{{ message }}',\n  host: { 'data-testid': 'toast' },\n})\nexport class ToastComponent {\n  readonly message = inject<string>(MAT_SNACK_BAR_DATA);\n}\n\n@Injectable({ providedIn: 'root' })\nexport class ToastService {\n  private readonly snackBar = inject(MatSnackBar);\n\n  show(message: string): void {\n    this.snackBar.openFromComponent(ToastComponent, { data: message, duration: 4000 });\n  }\n}\nEOF\ncat > ../app/app.routes.ts <<'EOF'\nimport { Route } from '@angular/router';\nimport { inProgressBookingGuard, paidBookingGuard } from './core/guards';\n\nexport const appRoutes: Route[] = [\n  {\n    path: '',\n    pathMatch: 'full',\n    loadComponent: () => import('./movie-list/movie-list').then((m) => m.MovieList),\n  },\n  {\n    path: 'screenings/:id/seats',\n    loadComponent: () => import('./seat-selection/seat-selection').then((m) => m.SeatSelection),\n  },\n  {\n    path: 'screenings/:id/summary',\n    canActivate: [inProgressBookingGuard],\n    loadComponent: () => import('./summary/summary').then((m) => m.Summary),\n  },\n  {\n    path: 'screenings/:id/checkout',\n    canActivate: [inProgressBookingGuard],\n    loadComponent: () => import('./checkout/checkout').then((m) => m.Checkout),\n  },\n  {\n    path: 'confirmation',\n    canActivate: [paidBookingGuard],\n    loadComponent: () => import('./confirmation/confirmation').then((m) => m.Confirmation),\n  },\n  { path: '**', redirectTo: '' },\n];\nEOF\ncat > app.config.ts <<'EOF'\nimport { provideHttpClient } from '@angular/common/http';\nimport { ApplicationConfig, provideBrowserGlobalErrorListeners } from '@angular/core';\nimport { provideNativeDateAdapter } from '@angular/material/core';\nimport { provideRouter } from '@angular/router';\nimport { appRoutes } from './app.routes';\n\nexport const appConfig: ApplicationConfig = {\n  providers: [\n    provideBrowserGlobalErrorListeners(),\n    provideRouter(appRoutes),\n    provideHttpClient(),\n    provideNativeDateAdapter(),\n  ],\n};\nEOF"}}}
