{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017etR1N6LW4j4D4qSwQyLz3","type":"tool_result","content":"1\timport { Dayjs } from 'dayjs';\n2\timport Box from '@mui/material/Box';\n3\timport Button from '@mui/material/Button';\n4\timport { DatePicker } from '@mui/x-date-pickers/DatePicker';\n5\timport { toISODate, today } from '../../dateUtils';\n6\t\n7\tinterface DayPickerProps {\n8\t  selectedDate: Dayjs;\n9\t  onSelectDate: (date: Dayjs) => void;\n10\t}\n11\t\n12\texport function DayPicker({ selectedDate, onSelectDate }: DayPickerProps) {\n13\t  const todayDate = today();\n14\t  const quickDays = Array.from({ length: 5 }, (_, i) => todayDate.add(i, 'day'));\n15\t  const selectedISO = toISODate(selectedDate);\n16\t\n17\t  return (\n18\t    <Box\n19\t      data-testid=\"day-picker\"\n20\t      sx={{ display: 'flex', alignItems: 'center', gap: 1.5, flexWrap: 'wrap' }}\n21\t    >\n22\t      {quickDays.map((day, index) => {\n23\t        const iso = toISODate(day);\n24\t        const label = index === 0 ? 'Today' : day.format('dddd');\n25\t        return (\n26\t          <Button\n27\t            key={iso}\n28\t            data-testid=\"day-button\"\n29\t            data-date={iso}\n30\t            data-selected={iso === selectedISO ? 'true' : 'false'}\n31\t            variant={iso === selectedISO ? 'contained' : 'outlined'}\n32\t            onClick={() => onSelectDate(day)}\n33\t          >\n34\t            {label}\n35\t          </Button>\n36\t        );\n37\t      })}\n38\t      <DatePicker\n39\t        value={selectedDate}\n40\t        minDate={todayDate}\n41\t        onChange={(value) => {\n42\t          if (value && value.isValid()) {\n43\t            onSelectDate(value);\n44\t          }\n45\t        }}\n46\t        slotProps={{ textField: { htmlInput: { 'data-testid': 'date-picker' } } }}\n47\t      />\n48\t    </Box>\n49\t  );\n50\t}\n51\t"}]},"parent_tool_use_id":null,"session_id":"3632df4e-836a-4239-9ca1-2c0c9dc67b92","uuid":"c0ba15d0-b5b6-4f57-b08c-6bc02facd89c","timestamp":"2026-10-20T06:38:48.916Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/pages/MovieListPage/DayPicker.tsx","content":"import { Dayjs } from 'dayjs';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport { DatePicker } from '@mui/x-date-pickers/DatePicker';\nimport { toISODate, today } from '../../dateUtils';\n\ninterface DayPickerProps {\n  selectedDate: Dayjs;\n  onSelectDate: (date: Dayjs) => void;\n}\n\nexport function DayPicker({ selectedDate, onSelectDate }: DayPickerProps) {\n  const todayDate = today();\n  const quickDays = Array.from({ length: 5 }, (_, i) => todayDate.add(i, 'day'));\n  const selectedISO = toISODate(selectedDate);\n\n  return (\n    <Box\n      data-testid=\"day-picker\"\n      sx={{ display: 'flex', alignItems: 'center', gap: 1.5, flexWrap: 'wrap' }}\n    >\n      {quickDays.map((day, index) => {\n        const iso = toISODate(day);\n        const label = index === 0 ? 'Today' : day.format('dddd');\n        return (\n          <Button\n            key={iso}\n            data-testid=\"day-button\"\n            data-date={iso}\n            data-selected={iso === selectedISO ? 'true' : 'false'}\n            variant={iso === selectedISO ? 'contained' : 'outlined'}\n            onClick={() => onSelectDate(day)}\n          >\n            {label}\n          </Button>\n        );\n      })}\n      <DatePicker\n        value={selectedDate}\n        minDate={todayDate}\n        onChange={(value) => {\n          if (value && value.isValid()) {\n            onSelectDate(value);\n          }\n        }}\n        slotProps={{ textField: { htmlInput: { 'data-testid': 'date-picker' } } }}\n      />\n    </Box>\n  );\n}\n","numLines":51,"startLine":1,"totalLines":51}}}
