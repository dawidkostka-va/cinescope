);\n  return date.getFullYear() === y && date.getMonth() === mo - 1 && date.getDate() === d ? date : null;\n}\n\nexport function startOfToday(): Date {\n  const now = new Date();\n  return new Date(now.getFullYear(), now.getMonth(), now.getDate());\n}\n\nexport function addDays(date: Date, days: number): Date {\n  return new Date(date.getFullYear(), date.getMonth(), date.getDate() + days);\n}\n\nexport function weekdayName(date: Date): string {\n  return WEEKDAYS[date.getDay()];\n}\n\nexport function showDate(isoDate: string, time: string): string {\n  const d = parseIso(isoDate);\n  if (!d) return `${isoDate} ${time}`;\n  return `${weekdayName(d)} ${d.getDate()} ${MONTHS[d.getMonth()]} ${time}`;\n}\nEOF\ncat > core/seats.ts <<'EOF'\nexport const ROW_COUNT = 15;\nexport const COUCH_ROW = 15;\nexport const MAX_SEATS = 10;\n\nexport type SeatState = 'available' | 'selected' | 'unavailable' | 'accessible';\n\nexport interface Ticket {\n  row: number;\n  start: number;\n  end: number;\n  couch: boolean;\n  ids: string[];\n  price: number;\n}\n\nexport const seatId = (row: number, column: number) => `R${row}C${column}`;\n\nexport function parseSeatId(id: string): { row: number; column: number } | null {\n  const m = /^R(\\d+)C(\\d+)$/.exec(id);\n  return m ? { row: Number(m[1]), column: Number(m[2]) } : null;\n}\n\nexport function isAccessible(row: number, column: number): boolean {\n  return row === 1 && column >= 10 && column <= 15;\n}\n\nexport function priceOf(row: number, couch: boolean): number {\n  if (couch) return 89;\n  if (row <= 5) return 25;\n  if (row <= 10) return 32;\n  return 39;\n}\n\nexport function formatPrice(value: number): string {\n  return `${value.toFixed(2)} PLN`;\n}\n\nexport function couchTicket(row: number, start: number): Ticket {\n  return {\n    row,\n    start,\n    end: start + 1,\n    couch: true,\n    ids: [seatId(row, start), seatId(row, start + 1)],\n    price: priceOf(row, true),\n  };\n}\n\nexport function seatTicket(row: number, column: number): Ticket {\n  return { row, start: column, end: column, couch: false, ids: [seatId(row, column)], price: priceOf(row, false) };\n}\n\nexport function ticketsFromSeats(ids: readonly string[]): Ticket[] {\n  const map = new Map<string, Ticket>();\n  for (const id of ids) {\n    const parsed = parseSeatId(id);\n    if (!parsed) continue;\n    const { row, column } = parsed;\n    const ticket =\n      row === COUCH_ROW ? couchTicket(row, column - ((column - 1) % 2)) : seatTicket(row, column);\n    map.set(`${ticket.row}-${ticket.start}`, ticket);\n  }\n  return [...map.values()].sort((a, b) => a.row - b.row || a.start - b.start);\n}\n\nexport function seatDescription(ticket: Ticket): string {\n  return ticket.couch ? `Couch ${ticket.start}-${ticket.end}` : String(ticket.start);\n}\n\nexport function gridColumn(column: number): number {\n  if (column <= 4) return column + 1;\n  if (column <= 20) return column + 2;\n  return column + 3;\n}\nEOF\ncat > core/api.service.ts <<'EOF'\nimport { HttpClient } from '@angular/common/http';\nimport { Injectable, inject } from '@angular/core';\nimport { Movie, Reservation, ReservationRequest, Screening } from './models';\n\nconst BASE_URL = 'http://localhost:3000';\n\n@Injectable({ providedIn: 'root' })\nexport class ApiService {\n  private readonly http = inject(HttpClient);\n\n  movies() {\n    return this.http.get<Movie[]>(`${BASE_URL}/movies`);\n  }\n\n  movie(id: number) {\n    return this.http.get<Movie>(`${BASE_URL}/movies/${id}`);\n  }\n\n  screenings() {\n    return this.http.get<Screening[]>(`${BASE_URL}/screenings`);\n  }\n\n  screening(id: string | number) {\n    return this.http.get<Screening>(`${BASE_URL}/screenings/${id}`);\n  }\n\n  createReservation(request: ReservationRequest) {\n    return this.http.post<Reservation>(`${BASE_URL}/reservations`, request);\n  }\n}\nEOF\ncat > core/booking.service.ts <<'EOF'\nimport { Injectable, computed, signal } from '@angular/core';\nimport { Booking, CustomerForm } from './models';\nimport { Ticket, ticketsFromSeats } from './seats';\n\nconst STORAGE_KEY = 'cinescope.booking';\n\nexport const emptyForm = (): CustomerForm => ({\n  firstName: '',\n  lastName: '',\n  email: '',\n  confirmEmail: '',\n  phone: '',\n  terms: false,\n});\n\nfunction read(): Booking | null {\n  try {\n    const raw = sessionStorage.getItem(STORAGE_KEY);\n    if (!raw) return null;\n    const parsed = JSON.parse(raw) as Booking;\n    if (typeof parsed?.screeningId !== 'number' || !Array.isArray(parsed.seats)) return null;\n    return { ...parsed, form: { ...emptyForm(), ...parsed.form }, paid: !!parsed.paid, email: parsed.email ?? '' };\n  } catch {\n    return null;\n  }\n}\n\n@Injectable({ providedIn: 'root' })\nexport class BookingService {\n  private readonly state = signal<Booking | null>(read());\n\n  readonly booking = this.state.asReadonly();\n  readonly tickets = computed<Ticket[]>(() => ticketsFromSeats(this.state()?.seats ?? []));\n  readonly total = computed(() => this.tickets().reduce((sum, t) => sum + t.price, 0));\n\n  start(screeningId: number): void {\n    this.set({ screeningId, seats: [], form: emptyForm(), paid: false, email: '' });\n  }\n\n  startIfNeeded(screeningId: number): void {\n    const b = this.state();\n    if (!b || b.paid || b.screeningId !== screeningId) this.start(screeningId);\n  }\n\n  setSeats(seats: string[]): void {\n    this.patch({ seats });\n  }\n\n  setForm(form: CustomerForm): void {\n    this.patch({ form });\n  }\n\n  markPaid(email: string): void {\n    this.patch({ paid: true, email });\n  }\n\n  clear(): void {\n    this.set(null);\n  }\n\n  private patch(change: Partial<Booking>): void {\n    const b = this.state();\n    if (b) this.set({ ...b, ...change });\n  }\n\n  private set(booking: Booking | null): void {\n    this.state.set(booking);\n    try {\n      if (booking) sessionStorage.setItem(STORAGE_KEY, JSON.stringify(booking));\n      else sessionStorage.removeItem(STORAGE_KEY);\n    } catch {\n 