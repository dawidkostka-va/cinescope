n: Number(column) };\n}\n\nexport function seatPrice(row: number): number {\n  if (row <= 5) {\n    return 25;\n  }\n  return row <= 10 ? 32 : 39;\n}\n\nexport function formatPrice(amount: number): string {\n  return `${amount.toFixed(2)} PLN`;\n}\n\nexport function ticketsFor(ids: readonly string[]): Ticket[] {\n  const parsed = ids\n    .map((id) => parseSeatId(id))\n    .sort((a, b) => a.row - b.row || a.column - b.column);\n  const tickets: Ticket[] = [];\n  const seen = new Set<string>();\n\n  for (const { row, column } of parsed) {\n    const id = seatId(row, column);\n    if (seen.has(id)) {\n      continue;\n    }\n    seen.add(id);\n\n    if (row === COUCH_ROW) {\n      const partnerColumn = column % 2 === 1 ? column + 1 : column - 1;\n      const partner = seatId(row, partnerColumn);\n      const start = Math.min(column, partnerColumn);\n      const end = start + 1;\n      seen.add(partner);\n      tickets.push({\n        row,\n        isCouch: true,\n        column: start,\n        columnEnd: end,\n        ids: [seatId(row, start), seatId(row, end)],\n        label: `Couch ${start}-${end}`,\n        price: COUCH_PRICE,\n      });\n    } else {\n      tickets.push({\n        row,\n        isCouch: false,\n        column,\n        columnEnd: column,\n        ids: [id],\n        label: String(column),\n        price: seatPrice(row),\n      });\n    }\n  }\n  return tickets;\n}\n\n","structuredPatch":[{"oldStart":53,"oldLines":20,"newStart":53,"newLines":18,"lines":["       tickets.push({","         row,","         isCouch: true,","-        column: start,","-        columnEnd: end,","         ids: [seatId(row, start), seatId(row, end)],","-        label: `Couch ${start}-${end}`,","+        seatLabel: `Couch ${start}-${end}`,","+        columnsLabel: `${start}-${end}`,","         price: COUCH_PRICE,","       });","     } else {","       tickets.push({","         row,","         isCouch: false,","-        column,","-        columnEnd: column,","         ids: [i