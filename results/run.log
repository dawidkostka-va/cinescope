 <mat-error data-testid=\"confirm-email-error\">{{ msg }}</mat-error>\n      }\n    </mat-form-field>\n\n    <mat-form-field>\n      <mat-label data-testid=\"phone-label\">Phone number</mat-label>\n      <input\n        matInput\n        data-testid=\"phone-input\"\n        [value]=\"form().phone\"\n        (input)=\"onInput('phone', $any($event.target).value)\"\n        (blur)=\"onBlur('phone')\"\n      />\n      @if (phoneMessage(); as msg) {\n        <mat-error data-testid=\"phone-error\">{{ msg }}</mat-error>\n      }\n    </mat-form-field>\n\n    <div class=\"terms\">\n      <mat-checkbox\n        data-testid=\"terms-checkbox\"\n        [checked]=\"form().termsAccepted\"\n        (change)=\"onTermsChange($event.checked)\"\n      >\n        <span data-testid=\"terms-label\">I accept the terms and conditions *</span>\n      </mat-checkbox>\n      @if (termsMessage(); as msg) {\n        <div data-testid=\"terms-error\" class=\"terms-error\">{{ msg }}</div>\n      }\n    </div>\n  </form>\n\n  <div class=\"actions\">\n    <button type=\"button\" mat-stroked-button data-testid=\"checkout-back-button\" (click)=\"back()\">Back</button>\n    <button type=\"button\" mat-flat-button data-testid=\"pay-button\" [disabled]=\"processing()\" (click)=\"pay()\">\n      {{ processing() ? 'Processing…' : 'Pay ' + total().toFixed(2) + ' PLN' }}\n    </button>\n  </div>\n}\n","numLines":96,"startLine":1,"totalLines":96}}}
