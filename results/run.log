on('requestfailed', (req) => errors.push('REQFAIL: ' + req.url() + ' ' + req.failure()?.errorText));\n\n  async function shot(name) {\n    await page.screenshot({ path: `/tmp/pw-test/${name}.png`, fullPage: true });\n  }\n\n  await page.goto('http://localhost:4200/?date=2026-09-15', { waitUntil: 'networkidle' });\n  await page.waitForTimeout(300);\n  await shot('01-movie-list');\n  console.log('movie cards:', await page.locator('[data-testid=movie-card]').count());\n\n  await page.locator('[data-testid=screening-button]').first().click();\n  await page.waitForURL(/\\/screenings\\/\\d+\\/seats/);\n  await page.waitForTimeout(300);\n  await shot('02-seat-map');\n  console.log('seat count:', await page.locator('[data-testid=seat]').count());\n  console.log('couch count:', await page.locator('[data-testid=couch]').count());\n  console.log('accessible count:', await page.locator('[data-testid=seat][data-state=accessible]').count());\n  console.log('unavailable count:', await page.locator('[data-state=unavailable]').count());\n\n  // select a regular available seat\n  const seat = page.locator('[data-testid=seat][data-state=available]').first();\n  await seat.click();\n  // select a couch\n  const couch = page.locator('[data-testid=couch][data-state=available]').first();\n  await couch.click();\n  await page.waitForTimeout(100);\n  await shot('03-seat-selected');\n  console.log('selected count text:', await page.locator('[data-testid=selected-seats-count]').textContent());\n\n  await page.locator('[data-testid=continue-button]').click();\n  await page.waitForURL(/\\/screenings\\/\\d+\\/summary/);\n  await page.waitForTimeout(200);\n  await shot('04-summary');\n  console.log('summary total:', await page.locator('[data-testid=summary-total]').textContent());\n\n  await page.locator('[data-testid=confirm-button]').click();\n  await page.waitForURL(/\\/screenings\\/\\d+\\/checkout/);\n  await page.waitForTimeout(200);\n  await shot('05-checkout-empty');\n\n  // Try pay with empty form to see validation\n  await page.locator('[data-testid=pay-button]').click();\n  await page.waitForTimeout(300);\n  await shot('06-checkout-invalid');\n  console.log('toast text:', await page.locator('[data-testid=toast]').textContent().catch(() => 'NO TOAST'));\n\n  // fill form properly\n  await page.locator('[data-testid=first-name-input]').fill('Anna');\n  await page.locator('[data-testid=last-name-input]').fill('Kowalska');\n  await page.locator('[data-testid=email-input]').fill('anna.kowalska@example.com');\n  await page.locator('[data-testid=confirm-email-input]').fill('anna.kowalska@example.com');\n  await page.locator('[data-testid=phone-input]').fill('123456789');\n  await page.locator('[data-testid=terms-checkbox]').click();\n  await page.waitForTimeout(200);\n  await shot('07-checkout-filled');\n\n  await page.locator('[data-testid=pay-button]').click();\n  await page.waitForURL(/\\/confirmation/, { timeout: 5000 }).catch(async () => {\n    console.log('did not navigate to confirmation, current url:', page.url());\n    await shot('08-pay-failed');\n  });\n  await page.waitForTimeout(300);\n  await shot('09-confirmation');\n  console.log('confirmation message:', await page.locator('[data-testid=confirmation-message]').textContent().catch(() => 'MISSING'));\n\n  console.log('ERRORS:', JSON.stringify(errors, null, 2));\n  await browser.close();\n})();\n","structuredPatch":[{"oldStart":17,"oldLines":7,"newStart":17,"newLines":27,"lines":["     await page.screenshot({ path: `/tmp/pw-test/${name}.png`, fullPage: true });","   }"," ","-  await page.goto('http://localhost:4200/?date=2026-09-15', { waitUntil: 'networkidle' });","+  // Fix \"now\" to 2026-09-15T10:00:00 local time so the seeded screening data is visible.","+  await page.addInitScript(() => {","+    const FIXED = new Date(2026, 8, 15, 10, 0, 0).getTime();","+    const OriginalDate = Date;","+    class FakeDate extends OriginalDate {","+      constructor(...args) {","+        if (args.length === 0) {","+          super(FIXED);","+        } else {","+          super(...args);","+        }","+      }","+      static now() {","+        return FIXED;","+      }","+    }","+    // eslint-disable-next-line no-global-assign","+    Date = FakeDate;","+  });","+","+  await page.goto('http://localhost:4200/', { waitUntil: 'networkidle' });","   await page.waitForTimeout(300);","   await shot('01-movie-list');","   console.log('movie cards:', await page.locator('[data-testid=movie-card]').count());"]}],"userModified":false,"replaceAll":false}}
