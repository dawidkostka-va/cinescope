2));\n\n  // test specific invalid values\n  await evaluate(ws, `\n    (() => {\n      function setVal(testid, value) {\n        const el = document.querySelector('[data-testid=\"' + testid + '\"]');\n        const input = el.tagName === 'INPUT' ? el : el.querySelector('input');\n        const proto = Object.getPrototypeOf(input);\n        const setter = Object.getOwnPropertyDescriptor(proto, 'value').set;\n        setter.call(input, value);\n        input.dispatchEvent(new Event('input', { bubbles: true }));\n        input.dispatchEvent(new Event('blur', { bubbles: true }));\n      }\n      setVal('first-name-input', 'A');\n      setVal('email-input', 'not-an-email');\n      setVal('confirm-email-input', 'different@example.com');\n      setVal('phone-input', '123');\n    })()\n  `);\n  await sleep(300);\n  const errors2 = await evaluate(ws, `[...document.querySelectorAll('[data-testid$=\"-error\"]')].map(e => e.getAttribute('data-testid') + ' => ' + e.textContent)`);\n  console.log('ERRORS AFTER BAD INPUT:', JSON.stringify(errors2, null, 2));\n\n  console.log('CONSOLE ERRORS:', consoleErrors);\n  process.exit(0);\n}\n\nmain().catch((e) => {\n  console.error('DRIVER ERROR', e);\n  process.exit(1);\n});\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1809,"cache_read_input_tokens":163596,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1809},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5476e868-cc4f-4da9-a31d-ea08c408bea6","uuid":"cd230036-c64e-4cf3-bb02-22820267c257","timestamp":"2026-10-20T08:43:20.704Z","request_id":"req_011CgDC8YUxh3SZ73WxFs1ez","wire_tool_inputs":{"toolu_01MVBourN6zUpQ1nw9oEmewU":{"file_path":"/tmp/drive3.js","content":"const { newTab, connect, send, evaluate, sleep } = requi