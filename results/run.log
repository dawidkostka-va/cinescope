{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YJpPm6FYzHxGvywdk8XZyd","type":"tool_result","content":"1\timport { getCouchState, getRowCells, getSeatState, isAccessibleSeat, seatId, STATE_COLORS, TOTAL_ROWS } from '../../domain/seatLayout';\n2\timport styles from './SeatMap.module.scss';\n3\t\n4\tinterface SeatMapProps {\n5\t  occupied: ReadonlySet<string>;\n6\t  selected: ReadonlySet<string>;\n7\t  onToggleSeat: (id: string) => void;\n8\t  onToggleCouch: (idA: string, idB: string) => void;\n9\t}\n10\t\n11\texport function SeatMap({ occupied, selected, onToggleSeat, onToggleCouch }: SeatMapProps) {\n12\t  const rows = Array.from({ length: TOTAL_ROWS }, (_, i) => i + 1);\n13\t\n14\t  return (\n15\t    <div data-testid=\"seat-map\" className={styles.seatMap}>\n16\t      {rows.map((row) => (\n17\t        <div key={row} data-testid=\"seat-row\" data-row={row} className={styles.row}>\n18\t          <span data-testid=\"row-label-left\" data-row={row} className={styles.rowLabel}>\n19\t            {row}\n20\t          </span>\n21\t          <div className={styles.cells}>\n22\t            {getRowCells(row).map((cell, index) => {\n23\t              if (cell.type === 'entrance') {\n24\t                return <div key={index} className={styles.entrance} />;\n25\t              }\n26\t              if (cell.type === 'aisle') {\n27\t                return <div key={index} data-testid=\"aisle\" data-row={row} className={styles.aisle} />;\n28\t              }\n29\t              if (cell.type === 'seat') {\n30\t                const accessible = isAccessibleSeat(cell.row, cell.column);\n31\t                const id = seatId(cell.row, cell.column);\n32\t                const state = getSeatState(id, occupied, selected, accessible);\n33\t                return (\n34\t                  <div\n35\t                    key={index}\n36\t                    data-testid=\"seat\"\n37\t                    data-row={cell.row}\n38\t                    data-column={cell.column}\n39\t                    data-state={state}\n40\t                    className={styles.seat}\n41\t                    style={{ backgroundColor: STATE_COLORS[state] }}\n42\t                    onClick={() => {\n43\t                      if (state !== 'unavailable') onToggleSeat(id);\n44\t                    }}\n45\t                  >\n46\t                    {cell.column}\n47\t                  </div>\n48\t                );\n49\t              }\n50\t              const idA = seatId(cell.row, cell.columnStart);\n51\t              const idB = seatId(cell.row, cell.columnEnd);\n52\t              const state = getCouchState(idA, idB, occupied, selected);\n53\t              return (\n54\t                <div\n55\t                  key={index}\n56\t                  data-testid=\"couch\"\n57\t                  data-row={cell.row}\n58\t                  data-column-start={cell.columnStart}\n59\t                  data-column-end={cell.columnEnd}\n60\t                  data-state={state}\n61\t                  className={styles.couch}\n62\t                  style={{ backgroundColor: STATE_COLORS[state] }}\n63\t                  onClick={() => {\n64\t                    if (state !== 'unavailable') onToggleCouch(idA, idB);\n65\t                  }}\n66\t                >\n67\t                  {cell.columnStart}-{cell.columnEnd}\n68\t                </div>\n69\t              );\n70\t            })}\n71\t          </div>\n72\t          <span data-testid=\"row-label-right\" data-row={row} className={styles.rowLabel}>\n73\t            {row}\n74\t          </span>\n75\t        </div>\n76\t      ))}\n77\t    </div>\n78\t  );\n79\t}\n80\t"}]},"parent_tool_use_id":null,"session_id":"18d24fdc-128d-4444-9721-af8b117c5cc6","uuid":"07e667b5-1c63-4184-bb81-e1e9e3c3b8d3","timestamp":"2026-10-20T08:13:37.723Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/pages/seat-selection/SeatMap.tsx","content":"import { getCouchState, getRowCells, getSeatState, isAccessibleSeat, seatId, STATE_COLORS, TOTAL_ROWS } from '../../domain/seatLayout';\nimport styles from './SeatMap.module.scss';\n\ninterface SeatMapProps {\n  occupied: ReadonlySet<string>;\n  selected: ReadonlySet<string>;\n  onToggleSeat: (id: string) => void;\n  onToggleCouch: (idA: string, idB: string) => void;\n}\n\nexport function SeatMap({ occupied, selected, onToggleSeat, onToggleCouch }: SeatMapProps) {\n  const rows = Array.from({ length: TOTAL_ROWS }, (_, i) => i + 1);\n\n  return (\n    <div data-testid=\"seat-map\" className={styles.seatMap}>\n      {rows.map((row) => (\n        <div key={row} data-testid=\"seat-row\" data-row={row} className={styles.row}>\n          <span data-testid=\"row-label-left\" data-row={row} className={styles.rowLabel}>\n            {row}\n          </span>\n          <div className={styles.cells}>\n            {getRowCells(row).map((cell, index) => {\n              if (cell.type === 'entrance') {\n                return <div key={index} className={styles.entrance} />;\n              }\n              if (cell.type === 'aisle') {\n                return <div key={index} data-testid=\"aisle\" data-row={row} className={styles.aisle} />;\n              }\n              if (cell.type === 'seat') {\n                const accessible = isAccessibleSeat(cell.row, cell.column);\n                const id = seatId(cell.row, cell.column);\n                const state = getSeatState(id, occupied, selected, accessible);\n                return (\n                  <div\n                    key={index}\n                    data-testid=\"seat\"\n                    data-row={cell.row}\n                    data-column={cell.column}\n                    data-state={state}\n                    className={styles.seat}\n                    style={{ backgroundColor: STATE_COLORS[state] }}\n                    onClick={() => {\n                      if (state !== 'unavailable') onToggleSeat(id);\n                    }}\n                  >\n                    {cell.column}\n                  </div>\n                );\n              }\n              const idA = seatId(cell.row, cell.columnStart);\n              const idB = seatId(cell.row, cell.columnEnd);\n              const state = getCouchState(idA, idB, occupied, selected);\n              return (\n                <div\n                  key={index}\n                  data-testid=\"couch\"\n                  data-row={cell.row}\n                  data-column-start={cell.columnStart}\n                  data-column-end={cell.columnEnd}\n                  data-state={state}\n                  className={styles.couch}\n                  style={{ backgroundColor: STATE_COLORS[state] }}\n                  onClick={() => {\n                    if (state !== 'unavailable') onToggleCouch(idA, idB);\n                  }}\n                >\n                  {cell.columnStart}-{cell.columnEnd}\n                </div>\n              );\n            })}\n          </div>\n          <span data-testid=\"row-label-right\" data-row={row} className={styles.rowLabel}>\n            {row}\n          </span>\n        </div>\n      ))}\n    </div>\n  );\n}\n","numLines":80,"startLine":1,"totalLines":80}}}
