);\n  if (!context) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return context;\n}\n","structuredPatch":[{"oldStart":4,"oldLines":7,"newStart":4,"newLines":7,"lines":[" "," type ShowToast = (message: string) => void;"," ","-const ToastContext = createContext<ShowToast | null>(null);","+const ToastContext = createContext<ShowToast>(() => undefined);"," "," const TOAST_DURATION_MS = 4000;"," "]}],"userModified":false,"replaceAll":false}}
