urns to the movie list. */\n    23\t  protected continue(): void {\n    24\t    this.bookings.clear();\n    25\t    this.router.navigate(['/']);\n    26\t  }\n    27\t}\n==== app/confirmation/confirmation.html\n     1\t<section class=\"confirmation\">\n     2\t  <h1 data-testid=\"confirmation-heading\">Payment successful</h1>\n     3\t\n     4\t  <p data-testid=\"confirmation-message\">Your tickets will be sent shortly to {{ email }}</p>\n     5\t\n     6\t  <div class=\"actions\">\n     7\t    <button\n     8\t      type=\"button\"\n     9\t      matButton=\"filled\"\n    10\t      data-testid=\"confirmation-continue-button\"\n    11\t      (click)=\"continue()\"\n    12\t    >Continue</button>\n    13\t  </div>\n    14\t</section>\n==== app/confirmation/confirmation.scss\n     1\t:host {\n     2\t  display: block;\n     3\t}\n     4\t\n     5\t.confirmation {\n     6\t  max-width: 720px;\n     7\t  margin: 0 auto;\n     8\t  padding: 24px;\n     9\t\n    10\t  h1 {\n    11\t    margin: 0 0 16px;\n    12\t    font-size: 1.75rem;\n    13\t  }\n    14\t}\n    15\t\n    16\t.actions {\n    17\t  display: flex;\n    18\t  justify-content: center;\n    19\t  margin-top: 24px;\n    20\t}\n==== styles.scss\n     1\t@use '@angular/material' as mat;\n     2\t\n     3\thtml {\n     4\t  color-scheme: light;\n     5\t  @include mat.theme(\n     6\t    (\n     7\t      color: mat.$azure-palette,\n     8\t      typography: Roboto,\n     9\t      density: 0,\n    10\t    )\n    11\t  );\n    12\t}\n    13\t\n    14\tbody {\n    15\t  margin: 0;\n    16\t  font-family: Roboto, 'Helvetica Neue', sans-serif;\n    17\t}\n==== index.html\n     1\t<!doctype html>\n     2\t<html lang=\"en\">\n     3\t  <head>\n     4\t    <meta charset=\"utf-8\" />\n     5\t    <title>Cinescope</title>\n     6\t    <base href=\"/\" />\n     7\t    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n     8\t    <link rel=\"icon\" type=\"image/x-icon\" href=\"favicon.ico\" />\n     9\t    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" />\n    10\t    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap\" rel=\"stylesheet\" />\n    11\t  </head>\n    12\t  <body>\n    13\t    <app-root></app-root>\n    14\t  </body>\n    15\t</html>\n==== main.ts\n     1\timport { bootstrapApplication } from '@angular/platform-browser';\n     2\timport { appConfig } from './app/app.config';\n     3\timport { App } from './app/app';\n     4\t\n     5\tbootstrapApplication(App, appConfig).catch((err) => console.error(err));\n==== app/app.spec.ts\n     1\timport { TestBed } from '@angular/core/testing';\n     2\timport { App } from './app';\n     3\t\n     4\tdescribe('App', () => {\n     5\t  beforeEach(async () => {\n     6\t    await TestBed.configureTestingModule({\n     7\t      imports: [App],\n     8\t    }).compileComponents();\n     9\t  });\n    10\t\n    11\t  it('should create', () => {\n    12\t    const fixture = TestBed.createComponent(App);\n    13\t    expect(fixture.componentInstance).toBeTruthy();\n    14\t  });\n    15\t});\ndiff --git a/apps/cinescope/src/app/app.config.ts b/apps/cinescope/src/app/app.config.ts\nindex 5f42b90..f4b33d7 100644\n--- a/apps/cinescope/src/app/app.config.ts\n+++ b/apps/cinescope/src/app/app.config.ts\n@@ -1,8 +1,14 @@\n import { ApplicationConfig, provideBrowserGlobalErrorListeners } from '@angular/core';\n+import { provideHttpClient } from '@angular/common/http';\n import { provideNativeDateAdapter } from '@angular/material/core';\n-import { provideRouter } from '@angular/router';\n+import { provideRouter, withComponentInputBinding } from '@angular/router';\n import { appRoutes } from './app.routes';\n \n export const appConfig: ApplicationConfig = {\n-  providers: [provideBrowserGlobalErrorListeners(), provideRouter(appRoutes), provideNativeDateAdapter()],\n+  providers: [\n+    provideBrowserGlobalErrorListeners(),\n+    provideRouter(appRoutes, withComponentIn