ng | null {\n  const raw = sessionStorage.getItem(STORAGE_KEY);\n  return raw ? (JSON.parse(raw) as Booking) : null;\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":467,"cache_read_input_tokens":143959,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":467},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2d9d3054-1f8b-48da-8bb0-b3aa9648a130","uuid":"ff766950-7920-4e9e-a5e1-4f59ddc79471","timestamp":"2026-11-04T16:24:48.136Z","request_id":"req_011CgiCSeMXs8aDRpnreEgah","wire_tool_inputs":{"toolu_01Gq4du4qtAmRY8Esgs4h523":{"file_path":"/workspace/project/apps/cinescope/src/app/booking/booking.service.ts","content":"import { Injectable, signal } from '@angular/core';\nimport { CheckoutValues } from '../models';\n\nexport interface Booking {\n  screeningId: number;\n  seats: string[];\n  checkout: CheckoutValues;\n  paidEmail: string | null;\n}\n\nconst STORAGE_KEY = 'cinescope.booking';\n\nconst EMPTY_CHECKOUT: CheckoutValues = {\n  firstName: '',\n  lastName: '',\n  email: '',\n  confirmEmail: '',\n  phone: '',\n  terms: false,\n};\n\n@Injectable({ providedIn: 'root' })\nexport class BookingService {\n  private readonly state = signal<Booking | null>(readStored());\n  readonly booking = this.state.asReadonly();\n\n  openSeatMap(screeningId: number): void {\n    const current = this.state();\n    if (current?.screeningId === screeningId && current.paidEmail === null) {\n      return;\n    }\n    this.update({ screeningId, seats: [], checkout: EMPTY_CHECKOUT, paidEmail: null });\n  }\n\n  setSeats(seats: string[]): void {\n    const current = this.state();\n    if (current) {\n      this.update({ ...current, seats });\n    }\n  }\n\n  setCheckout(checkout: CheckoutValues): void {\n    const current = t