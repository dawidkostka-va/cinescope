{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YZh5kDLQ7TnUTzZZLtbukU","type":"tool_result","content":"1\timport type { BookingForm } from '../booking/types';\n2\t\n3\tconst EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n4\tconst PHONE_RE = /^\\d{9}$/;\n5\t\n6\texport interface CheckoutErrors {\n7\t  firstName: string | null;\n8\t  lastName: string | null;\n9\t  email: string | null;\n10\t  confirmEmail: string | null;\n11\t  phone: string | null;\n12\t  terms: string | null;\n13\t}\n14\t\n15\texport function validateCheckout(form: BookingForm): CheckoutErrors {\n16\t  return {\n17\t    firstName:\n18\t      form.firstName === ''\n19\t        ? 'First name is required'\n20\t        : form.firstName.length < 2\n21\t          ? 'First name must be at least 2 characters'\n22\t          : null,\n23\t    lastName:\n24\t      form.lastName === ''\n25\t        ? 'Last name is required'\n26\t        : form.lastName.length < 2\n27\t          ? 'Last name must be at least 2 characters'\n28\t          : null,\n29\t    email: form.email === '' ? 'Email is required' : !EMAIL_RE.test(form.email) ? 'Enter a valid email address' : null,\n30\t    confirmEmail:\n31\t      form.confirmEmail === ''\n32\t        ? 'Confirm email is required'\n33\t        : form.confirmEmail !== form.email\n34\t          ? 'Email addresses do not match'\n35\t          : null,\n36\t    phone: form.phone === '' ? null : !PHONE_RE.test(form.phone) ? 'Phone number must be exactly 9 digits' : null,\n37\t    terms: form.terms ? null : 'You must accept the terms and conditions',\n38\t  };\n39\t}\n40\t\n41\texport function hasCheckoutErrors(errors: CheckoutErrors): boolean {\n42\t  return Object.values(errors).some((message) => message !== null);\n43\t}\n44\t"}]},"parent_tool_use_id":null,"session_id":"18d24fdc-128d-4444-9721-af8b117c5cc6","uuid":"22aa9c03-c8e3-4714-bd33-1245998e273f","timestamp":"2026-10-20T08:14:16.281Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/domain/validation.ts","content":"import type { BookingForm } from '../booking/types';\n\nconst EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst PHONE_RE = /^\\d{9}$/;\n\nexport interface CheckoutErrors {\n  firstName: string | null;\n  lastName: string | null;\n  email: string | null;\n  confirmEmail: string | null;\n  phone: string | null;\n  terms: string | null;\n}\n\nexport function validateCheckout(form: BookingForm): CheckoutErrors {\n  return {\n    firstName:\n      form.firstName === ''\n        ? 'First name is required'\n        : form.firstName.length < 2\n          ? 'First name must be at least 2 characters'\n          : null,\n    lastName:\n      form.lastName === ''\n        ? 'Last name is required'\n        : form.lastName.length < 2\n          ? 'Last name must be at least 2 characters'\n          : null,\n    email: form.email === '' ? 'Email is required' : !EMAIL_RE.test(form.email) ? 'Enter a valid email address' : null,\n    confirmEmail:\n      form.confirmEmail === ''\n        ? 'Confirm email is required'\n        : form.confirmEmail !== form.email\n          ? 'Email addresses do not match'\n          : null,\n    phone: form.phone === '' ? null : !PHONE_RE.test(form.phone) ? 'Phone number must be exactly 9 digits' : null,\n    terms: form.terms ? null : 'You must accept the terms and conditions',\n  };\n}\n\nexport function hasCheckoutErrors(errors: CheckoutErrors): boolean {\n  return Object.values(errors).some((message) => message !== null);\n}\n","numLines":44,"startLine":1,"totalLines":44}}}
