{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AaUmTHNU38cbPe4fQJqj6j","type":"tool_result","content":"1\timport type { CreateReservationPayload, Movie, Reservation, Screening } from './types';\n2\t\n3\tconst BASE_URL = 'http://localhost:3000';\n4\t\n5\tasync function getJson<T>(path: string): Promise<T> {\n6\t  const response = await fetch(`${BASE_URL}${path}`);\n7\t  if (!response.ok) {\n8\t    throw new Error(`Request to ${path} failed with status ${response.status}`);\n9\t  }\n10\t  return response.json() as Promise<T>;\n11\t}\n12\t\n13\texport function fetchMovies(): Promise<Movie[]> {\n14\t  return getJson<Movie[]>('/movies');\n15\t}\n16\t\n17\texport function fetchScreeningsByDate(date: string): Promise<Screening[]> {\n18\t  return getJson<Screening[]>(`/screenings?date=${encodeURIComponent(date)}`);\n19\t}\n20\t\n21\texport function fetchScreening(id: number): Promise<Screening> {\n22\t  return getJson<Screening>(`/screenings/${id}`);\n23\t}\n24\t\n25\texport function fetchMovie(id: number): Promise<Movie> {\n26\t  return getJson<Movie>(`/movies/${id}`);\n27\t}\n28\t\n29\texport async function createReservation(payload: CreateReservationPayload): Promise<Reservation> {\n30\t  const response = await fetch(`${BASE_URL}/reservations`, {\n31\t    method: 'POST',\n32\t    headers: { 'Content-Type': 'application/json' },\n33\t    body: JSON.stringify(payload),\n34\t  });\n35\t  if (!response.ok) {\n36\t    throw new Error(`Creating reservation failed with status ${response.status}`);\n37\t  }\n38\t  return response.json() as Promise<Reservation>;\n39\t}\n40\t"}]},"parent_tool_use_id":null,"session_id":"18d24fdc-128d-4444-9721-af8b117c5cc6","uuid":"264227f2-ba3b-4702-a874-11b4e539d2fd","timestamp":"2026-10-20T08:17:25.698Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/api/client.ts","content":"import type { CreateReservationPayload, Movie, Reservation, Screening } from './types';\n\nconst BASE_URL = 'http://localhost:3000';\n\nasync function getJson<T>(path: string): Promise<T> {\n  const response = await fetch(`${BASE_URL}${path}`);\n  if (!response.ok) {\n    throw new Error(`Request to ${path} failed with status ${response.status}`);\n  }\n  return response.json() as Promise<T>;\n}\n\nexport function fetchMovies(): Promise<Movie[]> {\n  return getJson<Movie[]>('/movies');\n}\n\nexport function fetchScreeningsByDate(date: string): Promise<Screening[]> {\n  return getJson<Screening[]>(`/screenings?date=${encodeURIComponent(date)}`);\n}\n\nexport function fetchScreening(id: number): Promise<Screening> {\n  return getJson<Screening>(`/screenings/${id}`);\n}\n\nexport function fetchMovie(id: number): Promise<Movie> {\n  return getJson<Movie>(`/movies/${id}`);\n}\n\nexport async function createReservation(payload: CreateReservationPayload): Promise<Reservation> {\n  const response = await fetch(`${BASE_URL}/reservations`, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify(payload),\n  });\n  if (!response.ok) {\n    throw new Error(`Creating reservation failed with status ${response.status}`);\n  }\n  return response.json() as Promise<Reservation>;\n}\n","numLines":40,"startLine":1,"totalLines":40}}}
