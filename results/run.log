      [attr.data-row]=\"item.row\"\n                      [attr.data-column]=\"item.column\"\n                      [attr.data-state]=\"stateOf(item)\"\n                      [style.background-color]=\"colours[stateOf(item)]\"\n                    >\n                      {{ item.column }}\n                    </button>\n                  }\n                }\n              }\n            }\n          </div>\n\n          <div class=\"aisle\" data-testid=\"aisle\" [attr.data-row]=\"row.row\"></div>\n\n          <div class=\"block block-middle\">\n            @for (item of row.middle; track $index) {\n              @switch (item.kind) {\n                @case ('couch') {\n                  <button\n                    type=\"button\"\n                    class=\"couch\"\n                    data-testid=\"couch\"\n                    [attr.data-row]=\"item.row\"\n                    [attr.data-column-start]=\"item.start\"\n                    [attr.data-column-end]=\"item.end\"\n                    [attr.data-state]=\"stateOf(item)\"\n                    [style.background-color]=\"colours[stateOf(item)]\"\n                  >\n                    {{ item.start }}-{{ item.end }}\n                  </button>\n                }\n                @case ('seat') {\n                  <button\n                    type=\"button\"\n                    class=\"seat\"\n                    data-testid=\"seat\"\n                    [attr.data-row]=\"item.row\"\n                    [attr.data-column]=\"item.column\"\n                    [attr.data-state]=\"stateOf(item)\"\n                    [style.background-color]=\"colours[stateOf(item)]\"\n                  >\n                    {{ item.column }}\n                  </button>\n                }\n              }\n            }\n          </div>\n\n          <div class=\"aisle\" data-testid=\"aisle\" [attr.data-row]=\"row.row\"></div>\n\n          <div class=\"block block-right\">\n            @for (item of row.right; track $index