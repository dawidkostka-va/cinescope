\" data-testid=\"movie-list\">\n              @for (card of cards(); track card.movie.id) {\n                <mat-card class=\"movie-card\" data-testid=\"movie-card\" [attr.data-movie-id]=\"card.movie.id\">\n                  <mat-card-content>\n                    <h2 data-testid=\"movie-title\">{{ card.movie.title }}</h2>\n                    <div class=\"meta\">\n                      <span data-testid=\"movie-genre\">{{ card.movie.genre }}</span>\n                      <span data-testid=\"movie-runtime\">{{ card.movie.runtimeMinutes }} min</span>\n                      <span data-testid=\"movie-format\">{{ card.movie.format }}</span>\n                    </div>\n                    <div class=\"times\">\n                      @for (s of card.screenings; track s.id) {\n                        <button\n                          mat-stroked-button\n                          type=\"button\"\n                          data-testid=\"screening-button\"\n                          [attr.data-screening-id]=\"s.id\"\n                          (click)=\"open(s.id)\"\n                        >\n                          {{ s.time }}\n                        </button>\n                      }\n                    </div>\n                  </mat-card-content>\n                </mat-card>\n              }\n            </div>\n          }\n        }\n      }\n    </div>\n  `,\n  styles: `\n    .page {\n      max-width: 800px;\n      margin: 0 auto;\n      padding: 24px;\n    }\n    .day-picker {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 8px;\n      margin-bottom: 24px;\n    }\n    .day-picker button.selected {\n      background: #1565c0;\n      color: #fff;\n    }\n    .date-field {\n      width: 200px;\n      margin-left: 8px;\n    }\n    .movie-list {\n      display: flex;\n      flex-direction: column;\n      gap: 16px;\n    }\n    h2 {\n      margin: 0 0 8px;\n    }\n    .meta {\n      display: flex;\n      gap: 16px;\n      margin-bottom: 12px;\n      color: #555;\n    }\n    .times {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n    }\n  `,\n})\nexport class MovieList {\n  private readonly api = inject(ApiService);\n  private readonly router = inject(Router);\n  private readonly route = inject(ActivatedRoute);\n  private readonly destroyRef = inject(DestroyRef);\n\n  protected readonly minDate = today();\n  private readonly todayIso = toIso(this.minDate);\n  protected readonly days = Array.from({ length: 5 }, (_, i) => {\n    const date = addDays(this.minDate, i);\n    return { iso: toIso(date), label: i === 0 ? 'Today' : weekdayName(date) };\n  });\n\n  private readonly query = toSignal(this.route.queryParamMap, { initialValue: this.route.snapshot.queryParamMap });\n  protected readonly selectedIso = computed(() => {\n    const raw = this.query().get('date');\n    return parseIso(raw) && raw! >= this.todayIso ? raw! : this.todayIso;\n  });\n\n  protected readonly dateControl = new FormControl<Date | null>(null);\n  protected readonly state = signal<LoadState>('loading');\n  private readonly movies = signal<Movie[]>([]);\n  private readonly screenings = signal<Screening[]>([]);\n  private request?: Subscription;\n\n  protected readonly cards = computed(() => {\n    const iso = this.selectedIso();\n    const ofDay = this.screenings().filter((s) => s.date === iso);\n    return this.movies()\n      .map((movie) => ({\n        movie,\n        screenings: ofDay\n          .filter((s) => s.movieId === movie.id)\n          .sort((a, b) => a.time.localeCompare(b.time) || a.id - b.id),\n      }))\n      .filter((card) => card.screenings.length > 0);\n  });\n\n  constructor() {\n    effect(() => {\n      const iso = this.selectedIso();\n      this.dateControl.setValue(this.days.some((d) => d.iso === iso) ? null : parseIso(iso), { emitEvent: false });\n    });\n    this.destroyRef.onDestroy(() => this.request?.unsubscribe());\n    this.load();\n  }\n\n  protected load(): void {\n    this.request?.unsubscribe();\n    this.state.set('loading');\n    this.request = forkJoin([this.api.movies(), this.api.screenings()])\n      .pipe(takeUntilDestroyed(this.destroyRef))\n      .subscribe({\n        next: ([movies, screenings]) => {\n          this.movies.set(movies);\n          this.screenings.set(screenings);\n          this.state.set('loaded');\n        },\n        error: () => this.state.set('error'),\n      });\n  }\n\n  protected selectDay(iso: string): void {\n    this.router.navigate([], { queryParams: { date: iso } });\n  }\n\n  protected onPick(event: MatDatepickerInputEvent<Date>): void {\n    const date = event.value;\n    if (!date || date < this.minDate) {\n      this.dateControl.setValue(parseIso(this.selectedIso()) && !this.days.some((d) => d.iso === this.selectedIso()) ? parseIso(this.selectedIso()) : null, { emitEvent: false });\n      return;\n    }\n    this.selectDay(toIso(date));\n  }\n\n  protected open(id: number): void {\n    this.router.navigate(['/screenings', id, 'seats']);\n  }\n}\n","structuredPatch":[{"oldStart":204,"oldLines":13,"newStart":204,"newLines":15,"lines":[" ","   protected onPick(event: MatDatepickerInputEvent<Date>): void {","     const date = event.value;","-    if (!date || date < this.minDate) {","-      this.dateControl.setValue(parseIso(this.selectedIso()) && !this.days.some((d) => d.iso === this.selectedIso()) ? parseIso(this.selectedIso()) : null, { emitEvent: false });","-      return;","-    }","-    this.selectDay(toIso(date));","+    if (date && date >= this.minDate) this.selectDay(toIso(date));","+    else this.syncPicker();","   }"," ","+  private syncPicker(): void {","+    const iso = this.selectedIso();","+    this.dateControl.setValue(this.days.some((d) => d.iso === iso) ? null : parseIso(iso), { emitEvent: false });","+  }","+","   protected open(id: number): void {","     this.router.navigate(['/screenings', id, 'seats']);","   }"]}],"userModified":false,"replaceAll":false}}
