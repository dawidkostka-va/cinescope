{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EELFUyeV6W6Zkmaxjohx2z","type":"tool_result","content":"1\timport { Injectable, inject } from '@angular/core';\n2\timport { CanActivateFn, Router } from '@angular/router';\n3\t\n4\t/** The booking in progress: one screening and the seats selected for it. */\n5\texport interface Booking {\n6\t  screeningId: number;\n7\t  /** Seat identifiers (`R<row>C<column>`); a couch contributes both of its identifiers. */\n8\t  seats: string[];\n9\t}\n10\t\n11\tconst STORAGE_KEY = 'cinescope.booking';\n12\t\n13\tfunction parseBooking(raw: string | null): Booking | null {\n14\t  if (!raw) {\n15\t    return null;\n16\t  }\n17\t  try {\n18\t    const value = JSON.parse(raw) as Partial<Booking>;\n19\t    if (typeof value.screeningId !== 'number' || !Array.isArray(value.seats)) {\n20\t      return null;\n21\t    }\n22\t    const seats = value.seats;\n23\t    return seats.every((seat) => typeof seat === 'string') ? { screeningId: value.screeningId, seats } : null;\n24\t  } catch {\n25\t    return null;\n26\t  }\n27\t}\n28\t\n29\t/** Keeps the booking in `sessionStorage`, so it survives a reload. */\n30\t@Injectable({ providedIn: 'root' })\n31\texport class BookingService {\n32\t  /** The stored booking, or null when there is none. */\n33\t  current(): Booking | null {\n34\t    return parseBooking(sessionStorage.getItem(STORAGE_KEY));\n35\t  }\n36\t\n37\t  save(booking: Booking): void {\n38\t    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(booking));\n39\t  }\n40\t\n41\t  clear(): void {\n42\t    sessionStorage.removeItem(STORAGE_KEY);\n43\t  }\n44\t}\n45\t\n46\t/**\n47\t * Lets the summary and checkout screens open only for a booking of the screening in the route\n48\t * with at least one seat; otherwise redirects to `/`.\n49\t */\n50\texport const bookingGuard: CanActivateFn = (route) => {\n51\t  const booking = inject(BookingService).current();\n52\t  const allowed =\n53\t    booking !== null && String(booking.screeningId) === route.paramMap.get('id') && booking.seats.length > 0;\n54\t  return allowed ? true : inject(Router).createUrlTree(['/']);\n55\t};\n56\t"}]},"parent_tool_use_id":"toolu_01XJiGr3JxWLjX3LmcHjeMGA","session_id":"451a05d2-90d8-4144-a8fc-cedf6ee810e9","uuid":"a6302651-0568-4ccb-bdd0-148d2b827b7b","timestamp":"2026-11-27T12:59:56.134Z","subagent_type":"general-purpose","task_description":"Implement ticket 05"}
