{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011ChTQCi3TJ19moHMynyZ2V","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XSNDueemQD67ruhPgZgHvB","name":"Bash","input":{"command":"cd /workspace/project/apps/cinescope/src/app && for f in app.config.ts app.routes.ts app.ts app.html app.scss app.spec.ts models.ts cinema-api.ts dates.ts booking/booking.ts booking/tickets.ts toast/toast.ts placeholder/placeholder.ts summary/summary.ts summary/summary.html summary/summary.scss; do echo \"=== $f\"; cat \"$f\"; done","description":"Read existing app source files"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14048,"cache_read_input_tokens":28299,"cache_creation":{"ephemeral_5m_input_tokens":14048,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01MFVq4Me1E3XkNVvnbSHRaT","session_id":"1e089a7a-4bad-4c15-8bdb-116c29d15f7d","uuid":"26e43436-5bee-4cb9-b336-b3fbb7b67f8d","timestamp":"2026-11-27T12:04:04.664Z","request_id":"req_011ChTQChx1CbpCbc8pFfGs9","subagent_type":"general-purpose","task_description":"Implement ticket 05"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XSNDueemQD67ruhPgZgHvB","type":"tool_result","content":"=== app.config.ts\nimport { ApplicationConfig, provideBrowserGlobalErrorListeners } from '@angular/core';\nimport { provideHttpClient } from '@angular/common/http';\nimport { provideNativeDateAdapter } from '@angular/material/core';\nimport { provideRouter } from '@angular/router';\nimport { appRoutes } from './app.routes';\n\nexport const appConfig: ApplicationConfig = {\n  providers: [\n    provideBrowserGlobalErrorListeners(),\n    provideHttpClient(),\n    provideRouter(appRoutes),\n    provideNativeDateAdapter(),\n  ],\n};\n=== app.routes.ts\nimport { Routes } from '@angular/router';\nimport { bookingGuard } from './booking/booking';\nimport { MovieList } from './movie-list/movie-list';\nimport { Placeholder } from './placeholder/placeholder';\nimport { SeatSelection } from './seat-selection/seat-selection';\nimport { Summary } from './summary/summary';\n\nexport const appRoutes: Routes = [\n  { path: '', component: MovieList },\n  { path: 'screenings/:id/seats', component: SeatSelection },\n  { path: 'screenings/:id/summary', component: Summary, canActivate: [bookingGuard] },\n  { path: 'screenings/:id/checkout', component: Placeholder, canActivate: [bookingGuard] },\n  { path: 'confirmation', component: Placeholder },\n  { path: '**', redirectTo: '' },\n];\n=== app.ts\nimport { Component } from '@angular/core';\nimport { RouterOutlet } from '@angular/router';\n\n@Component({\n  imports: [RouterOutlet],\n  selector: 'app-root',\n  templateUrl: './app.html',\n  styleUrl: './app.scss',\n})\nexport class App {}\n=== app.html\n<router-outlet />\n=== app.scss\n=== app.spec.ts\nimport { TestBed } from '@angular/core/testing';\nimport { App } from './app';\n\ndescribe('App', () => {\n  beforeEach(async () => {\n    await TestBed.configureTestingModule({\n      imports: [App],\n    }).compileComponents();\n  });\n\n  it('should create', () => {\n    const fixture = TestBed.createComponent(App);\n    expect(fixture.componentInstance).toBeTruthy();\n  });\n});\n=== models.ts\nexport interface Movie {\n  id: number;\n  title: string;\n  genre: string;\n  runtimeMinutes: number;\n  format: 'PL dubbing' | 'PL subtitles';\n}\n\nexport interface Screening {\n  id: number;\n  movieId: number;\n  date: string;\n  time: string;\n  occupiedSeats: string[];\n}\n=== cinema-api.ts\nimport { HttpClient } from '@angular/common/http';\nimport { inject, Injectable } from '@angular/core';\nimport { Observable } from 'rxjs';\nimport { Movie, Screening } from './models';\n\nconst API_BASE_URL = 'http://localhost:3000';\n\n@Injectable({ providedIn: 'root' })\nexport class CinemaApi {\n  private readonly http = inject(HttpClient);\n\n  getMovies(): Observable<Movie[]> {\n    return this.http.get<Movie[]>(`${API_BASE_URL}/movies`);\n  }\n\n  getScreenings(date: string): Observable<Screening[]> {\n    return this.http.get<Screening[]>(`${API_BASE_URL}/screenings`, { params: { date } });\n  }\n\n  getScreening(id: number): Observable<Screening> {\n    return this.http.get<Screening>(`${API_BASE_URL}/screenings/${id}`);\n  }\n\n  getMovie(id: number): Observable<Movie> {\n    return this.http.get<Movie>(`${API_BASE_URL}/movies/${id}`);\n  }\n}\n=== dates.ts\nconst WEEKDAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\nconst MONTH_SHORT_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n\n/** Local-calendar date at midnight for the current browser day. */\nexport function startOfToday(): Date {\n  const now = new Date();\n  return new Date(now.getFullYear(), now.getMonth(), now.getDate());\n}\n\nexport function addDays(date: Date, days: number): Date {\n  return new Date(date.getFullYear(), date.getMonth(), date.getDate() + days);\n}\n\n/** Formats a date as `YYYY-MM-DD` using its local calendar fields. */\nexport function toIsoDate(date: Date): string {\n  const year = String(date.getFullYear()).padStart(4, '0');\n  const month = String(date.getMonth() + 1).padStart(2, '0');\n  const day = String(date.getDate()).padStart(2, '0');\n  return `${year}-${month}-${day}`;\n}\n\n/** Parses a `YYYY-MM-DD` string into a local date at midnight. */\nexport function isoToDate(iso: string): Date {\n  const [year, month, day] = iso.split('-').map(Number);\n  return new Date(year, month - 1, day);\n}\n\n/** True for a well-formed ISO date that exists in the calendar (e.g. not 2026-02-30). */\nexport function isValidIsoDate(value: string | null): value is string {\n  if (value === null || !/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) {\n    return false;\n  }\n  return toIsoDate(isoToDate(value)) === value;\n}\n\nexport function weekdayName(date: Date): string {\n  return WEEKDAY_NAMES[date.getDay()];\n}\n\n/** The show date as `<Weekday> <D> <Mon> <HH:mm>`, e.g. `Tuesday 15 Sep 16:00`. */\nexport function formatShowDate(isoDate: string, time: string): string {\n  const date = isoToDate(isoDate);\n  return `${weekdayName(date)} ${date.getDate()} ${MONTH_SHORT_NAMES[date.getMonth()]} ${time}`;\n}\n=== booking/booking.ts\nimport { inject, Injectable, signal } from '@angular/core';\nimport { CanActivateFn, Router } from '@angular/router';\n\n/** The booking in progress: the screening and the identifiers of the selected seats (a couch has two). */\nexport interface Booking {\n  screeningId: number;\n  seats: string[];\n}\n\nconst STORAGE_KEY = 'cinescope.booking';\n\n/** Holds the booking in progress and keeps it in `sessionStorage`, so it survives a reload. */\n@Injectable({ providedIn: 'root' })\nexport class BookingStore {\n  private readonly current = signal<Booking | null>(readStoredBooking());\n\n  readonly booking = this.current.asReadonly();\n\n  /** Starts an empty booking for the screening, unless the booking in progress already belongs to it. */\n  openFor(screeningId: number): void {\n    if (this.current()?.screeningId !== screeningId) {\n      this.save({ screeningId, seats: [] });\n    }\n  }\n\n  setSeats(seats: string[]): void {\n    const booking = this.current();\n    if (booking !== null) {\n      this.save({ ...booking, seats });\n    }\n  }\n\n  clear(): void {\n    this.current.set(null);\n    sessionStorage.removeItem(STORAGE_KEY);\n  }\n\n  private save(booking: Booking): void {\n    this.current.set(booking);\n    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(booking));\n  }\n}\n\n/**\n * Lets a route with an `id` parameter be entered only with a booking in progress for that\n * screening that has at least one seat; otherwise redirects to the movie list.\n */\nexport const bookingGuard: CanActivateFn = (route) => {\n  const booking = inject(BookingStore).booking();\n  const screeningId = Number(route.paramMap.get('id'));\n  const allowed = booking !== null && booking.screeningId === screeningId && booking.seats.length > 0;\n  return allowed ? true : inject(Router).createUrlTree(['/']);\n};\n\nfunction readStoredBooking(): Booking | null {\n  try {\n    const stored: unknown = JSON.parse(sessionStorage.getItem(STORAGE_KEY) ?? 'null');\n    return isBooking(stored) ? stored : null;\n  } catch {\n    return null;\n  }\n}\n\nfunction isBooking(value: unknown): value is Booking {\n  if (typeof value !== 'object' || value === null) {\n    return false;\n  }\n  const { screeningId, seats } = value as Partial<Booking>;\n  return typeof screeningId === 'number' && Array.isArray(seats) && seats.every((id) => typeof id === 'string');\n}\n=== booking/tickets.ts\nimport { seatIdentifier } from '../seat-selection/auditorium';\n\nconst COUCH_ROW = 15;\nconst COUCH_PRICE = 89;\n\n/** One line of the booking: a single seat, or a couch covering two adjacent columns of row 15. */\nexport type Ticket =\n  | { kind: 'seat'; row: number; column: number }\n  | { kind: 'couch'; row: number; start: number; end: number };\n\n/** The tickets of a booking, ordered by row and then by column. */\nexport function ticketsFor(seats: readonly string[]): Ticket[] {\n  const positions = seats\n    .map((id) => {\n      const [row, column] = id.slice(1).split('C').map(Number);\n      return { row, column };\n    })\n    .sort((a, b) => a.row - b.row || a.column - b.column);\n\n  const tickets: Ticket[] = [];\n  for (const { row, column } of positions) {\n    if (row !== COUCH_ROW) {\n      tickets.push({ kind: 'seat', row, column });\n    } else if (column % 2 === 1) {\n      // Row 15 holds only couches, which start at an odd column; the second identifier of each is skipped.\n      tickets.push({ kind: 'couch', row, start: column, end: column + 1 });\n    }\n  }\n  return tickets;\n}\n\n/** The seat identifiers a ticket occupies: one for a seat, two for a couch. */\nexport function identifiersOfTicket(ticket: Ticket): string[] {\n  return ticket.kind === 'seat'\n    ? [seatIdentifier(ticket.row, ticket.column)]\n    : [seatIdentifier(ticket.row, ticket.start), seatIdentifier(ticket.row, ticket.end)];\n}\n\n/** The seat description: the column of a seat, `Couch <a>-<b>` for a couch. */\nexport function describeTicket(ticket: Ticket): string {\n  return ticket.kind === 'seat' ? String(ticket.column) : `Couch ${ticket.start}-${ticket.end}`;\n}\n\n/** The price in PLN: by row for a seat, per couch for a couch. */\nexport function priceOf(ticket: Ticket): number {\n  if (ticket.kind === 'couch') {\n    return COUCH_PRICE;\n  }\n  if (ticket.row <= 5) {\n    return 25;\n  }\n  if (ticket.row <= 10) {\n    return 32;\n  }\n  return 39;\n}\n\n/** Formats an amount in PLN with two decimals, e.g. `25.00 PLN`. */\nexport function formatPrice(amount: number): string {\n  return `${amount.toFixed(2)} PLN`;\n}\n=== toast/toast.ts\nimport { Component, inject, Injectable } from '@angular/core';\nimport { MAT_SNACK_BAR_DATA, MatSnackBar } from '@angular/material/snack-bar';\n\n/** Content of a toast: the message text carries the `toast` test id. */\n@Component({\n  selector: 'app-toast',\n  template: `<span data-testid=\"toast\">{{ message }}</span>`,\n})\nexport class ToastMessage {\n  protected readonly message = inject<string>(MAT_SNACK_BAR_DATA);\n}\n\n/** Shows short messages as toasts. A toast stays for 4 seconds; a new one replaces the current one. */\n@Injectable({ providedIn: 'root' })\nexport class Toaster {\n  private readonly snackBar = inject(MatSnackBar);\n\n  show(message: string): void {\n    this.snackBar.openFromComponent(ToastMessage, { data: message, duration: 4000 });\n  }\n}\n=== placeholder/placeholder.ts\nimport { Component } from '@angular/core';\n\n/** Temporary screen for routes that later tickets implement. */\n@Component({\n  selector: 'app-placeholder',\n  template: '',\n})\nexport class Placeholder {}\n=== summary/summary.ts\nimport { Component, computed, effect, inject, resource } from '@angular/core';\nimport { toSignal } from '@angular/core/rxjs-interop';\nimport { MatButton } from '@angular/material/button';\nimport { ActivatedRoute, Router } from '@angular/router';\nimport { firstValueFrom } from 'rxjs';\nimport { BookingStore } from '../booking/booking';\nimport { describeTicket, formatPrice, identifiersOfTicket, priceOf, Ticket, ticketsFor } from '../booking/tickets';\nimport { CinemaApi } from '../cinema-api';\n\n@Component({\n  selector: 'app-summary',\n  imports: [MatButton],\n  templateUrl: './summary.html',\n  styleUrl: './summary.scss',\n})\nexport class Summary {\n  private readonly api = inject(CinemaApi);\n  private readonly bookings = inject(BookingStore);\n  private readonly router = inject(Router);\n  private readonly route = inject(ActivatedRoute);\n\n  private readonly params = toSignal(this.route.paramMap, { requireSync: true });\n  private readonly screeningId = computed(() => Number(this.params().get('id')));\n\n  protected readonly data = resource({\n    params: () => this.screeningId(),\n    loader: async ({ params: id }) => {\n      const screening = await firstValueFrom(this.api.getScreening(id));\n      const movie = await firstValueFrom(this.api.getMovie(screening.movieId));\n      return { screening, movie };\n    },\n  });\n\n  protected readonly lines = computed(() =>\n    ticketsFor(this.bookings.booking()?.seats ?? []).map((ticket) => ({\n      key: identifiersOfTicket(ticket).join(' '),\n      ticket,\n      description: describeTicket(ticket),\n      price: priceOf(ticket),\n    })),\n  );\n\n  protected readonly total = computed(() =>\n    formatPrice(this.lines().reduce((sum, line) => sum + line.price, 0)),\n  );\n\n  protected readonly formatPrice = formatPrice;\n\n  constructor() {\n    // A screening or movie that cannot be loaded sends the customer back to the movie list.\n    effect(() => {\n      if (this.data.error()) {\n        void this.router.navigate(['/']);\n      }\n    });\n  }\n\n  protected remove(ticket: Ticket): void {\n    const removed = identifiersOfTicket(ticket);\n    const remaining = (this.bookings.booking()?.seats ?? []).filter((id) => !removed.includes(id));\n    this.bookings.setSeats(remaining);\n    if (remaining.length === 0) {\n      this.openSeatMap();\n    }\n  }\n\n  protected onBack(): void {\n    this.openSeatMap();\n  }\n\n  protected onConfirm(): void {\n    void this.router.navigate(['/screenings', this.screeningId(), 'checkout']);\n  }\n\n  private openSeatMap(): void {\n    void this.router.navigate(['/screenings', this.screeningId(), 'seats']);\n  }\n}\n=== summary/summary.html\n<main class=\"page\">\n  @if (data.value(); as loaded) {\n    <h1 data-testid=\"summary-title\">Your tickets</h1>\n\n    <ul class=\"tickets\" data-testid=\"summary-list\">\n      @for (line of lines(); track line.key) {\n        <li class=\"ticket\" data-testid=\"summary-item\">\n          <div class=\"details\">\n            <span class=\"movie\" data-testid=\"summary-item-title\">{{ loaded.movie.title }}</span>\n            <span data-testid=\"summary-item-datetime\">{{ loaded.screening.date }} {{ loaded.screening.time }}</span>\n            <span>Row <span data-testid=\"summary-item-row\">{{ line.ticket.row }}</span></span>\n            <span>Seat <span data-testid=\"summary-item-seat\">{{ line.description }}</span></span>\n            <span data-testid=\"summary-item-price\">{{ formatPrice(line.price) }}</span>\n          </div>\n          <button mat-button type=\"button\" data-testid=\"summary-item-remove-button\" (click)=\"remove(line.ticket)\">Remove</button>\n        </li>\n      }\n    </ul>\n\n    <p class=\"total\" data-testid=\"summary-total\">Total: {{ total() }}</p>\n\n    <div class=\"actions\">\n      <button mat-stroked-button type=\"button\" data-testid=\"back-button\" (click)=\"onBack()\">Back</button>\n      <button mat-flat-button type=\"button\" data-testid=\"confirm-button\" (click)=\"onConfirm()\">Confirm</button>\n    </div>\n  }\n</main>\n=== summary/summary.scss\n:host {\n  display: block;\n}\n\n.page {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 16px;\n  padding: 24px 16px;\n\n  h1 {\n    margin: 0;\n  }\n}\n\n.tickets {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  width: 480px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.ticket {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 12px 16px;\n  border: 1px solid #e0e0e0;\n  border-radius: 8px;\n}\n\n.details {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.movie {\n  font-weight: 500;\n}\n\n.total {\n  margin: 0;\n  font-weight: 500;\n}\n\n.actions {\n  display: flex;\n  gap: 16px;\n}","is_error":false}]},"parent_tool_use_id":"toolu_01MFVq4Me1E3XkNVvnbSHRaT","session_id":"1e089a7a-4bad-4c15-8bdb-116c29d15f7d","uuid":"aee5397d-275c-463b-99ae-dbc7072b172d","timestamp":"2026-11-27T12:04:04.692Z","subagent_type":"general-purpose","task_description":"Implement ticket 05"}
{"type":"system","subtype":"task_progress","task_id":"a2685a0623552d4a3","tool_use_id":"toolu_01MFVq4Me1E3XkNVvnbSHRaT","description":"Running Read ticket 06, seat selection, movie list and styles","subagent_type":"general-purpose","usage":{"total_tokens":50049,"tool_uses":5,"duration_ms":10739},"last_tool_name":"Bash","uuid":"d1d1d817-b918-41da-9904-b6b012944189","session_id":"1e089a7a-4bad-4c15-8bdb-116c29d15f7d"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011ChTQCpjnLmVqr1Ue1obUK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015rB6trcRFxBNa9QXj22Y2v","name":"Bash","input":{"command":"cat spec/tickets/06-confirmation.md && cat apps/cinescope/src/app/seat-selection/seat-selection.ts && cat apps/cinescope/src/app/movie-list/movie-list.ts | head -80 && cat apps/cinescope/src/app/seat-selection/auditorium.ts | head -40 && cat apps/cinescope/src/styles.scss && git status --short && git log --oneline | head -3 && cat apps/cinescope/src/app/summary/summary.html >/dev/null && git diff --stat && cat spec/tickets/04-booking-summary.md | head -20","description":"Read ticket 06, seat selection, movie list and styles"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6616,"cache_read_input_tokens":42347,"cache_creation":{"ephemeral_5m_input_tokens":6616,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01MFVq4Me1E3XkNVvnbSHRaT","session_id":"1e089a7a-4bad-4c15-8bdb-116c29d15f7d","uuid":"dcd4fdca-6b91-4a12-9b7a-01c584c1d8ab","timestamp":"2026-11-27T12:04:10.976Z","request_id":"req_011ChTQCpacULULSg9dCGSFq","subagent_type":"general-purpose","task_description":"Implement ticket 05"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015rB6trcRFxBNa9QXj22Y2v","type":"tool_result","content":"# 06: Confirmation and booking lifecycle\n\n**What to build:** After a successful payment the customer sees the confirmation with their email address; `Continue` clears the booking and returns to `/`. The whole booking lifecycle from section 3.1 holds: it survives reloads, and every route guards against a missing or mismatched booking.\n\n**Specification:** sections 3.1, 8, 9.5.\n\n**Blocked by:** 05 — Checkout and payment.\n\n**Status:** ready\n\n- [ ] AC-48 — `/confirmation` shows `Payment successful` and `Your tickets will be sent shortly to <email>`; `Continue` navigates to `/` and clears the booking; the booking survives a reload via `sessionStorage`; entering the summary, checkout or confirmation without a matching booking redirects to `/`.\n- [ ] AC-69 — Every confirmation identifier in section 9.5 is present with the exact names and values given there.\n- [ ] Reloading `/confirmation` after paying still shows the confirmation.\n- [ ] After `Continue`, the seat map of the same screening shows no selected seats and the checkout form of a new booking is empty.\nimport { Component, computed, effect, inject, resource } from '@angular/core';\nimport { toSignal } from '@angular/core/rxjs-interop';\nimport { MatButton } from '@angular/material/button';\nimport { ActivatedRoute, Router } from '@angular/router';\nimport { firstValueFrom } from 'rxjs';\nimport { BookingStore } from '../booking/booking';\nimport { CinemaApi } from '../cinema-api';\nimport { formatShowDate } from '../dates';\nimport { Toaster } from '../toast/toast';\nimport { AuditoriumItem, buildAuditorium, identifiersOf, seatLabel, SeatState } from './auditorium';\n\nconst MAX_SEATS_PER_BOOKING = 10;\n\n@Component({\n  selector: 'app-seat-selection',\n  imports: [MatButton],\n  templateUrl: './seat-selection.html',\n  styleUrl: './seat-selection.scss',\n})\nexport class SeatSelection {\n  private readonly api = inject(CinemaApi);\n  private readonly router = inject(Router);\n  private readonly route = inject(ActivatedRoute);\n  private readonly toaster = inject(Toaster);\n  private readonly bookings = inject(BookingStore);\n\n  private readonly params = toSignal(this.route.paramMap, { requireSync: true });\n  private readonly screeningId = computed(() => Number(this.params().get('id')));\n\n  protected readonly data = resource({\n    params: () => this.screeningId(),\n    loader: async ({ params: id }) => {\n      const screening = await firstValueFrom(this.api.getScreening(id));\n      // Keeps the booking in progress if it belongs to this screening, otherwise starts an empty one.\n      this.bookings.openFor(screening.id);\n      const movie = await firstValueFrom(this.api.getMovie(screening.movieId));\n      return { screening, movie };\n    },\n  });\n\n  /** Identifiers of the selected seats of the booking for this screening; a couch contributes both of its identifiers. */\n  protected readonly selected = computed<ReadonlySet<string>>(() => {\n    const booking = this.bookings.booking();\n    return new Set(booking !== null && booking.screeningId === this.screeningId() ? booking.seats : []);\n  });\n\n  protected readonly selectedCount = computed(() => this.selected().size);\n\n  protected readonly rows = computed(() => {\n    const screening = this.data.value()?.screening;\n    return buildAuditorium(new Set(screening?.occupiedSeats ?? []), this.selected());\n  });\n\n  /** One line per row with a selection, in ascending row order. */\n  protected readonly selectedRows = computed(() =>\n    this.rows()\n      .map((row) => ({\n        row: row.number,\n        seats: row.blocks.flat().filter((item) => item.state === 'selected').map(seatLabel),\n      }))\n      .filter((line) => line.seats.length > 0)\n      .map((line) => ({ row: line.row, text: `Row ${line.row}: ${line.seats.join(', ')}` })),\n  );\n\n  protected readonly legend: { state: SeatState; label: string }[] = [\n    { state: 'available', label: 'Available' },\n    { state: 'selected', label: 'Selected' },\n    { state: 'unavailable', label: 'Unavailable' },\n    { state: 'accessible', label: 'Accessible' },\n  ];\n\n  constructor() {\n    // A screening that cannot be loaded (404 or any other failure) sends the customer back to the movie list.\n    effect(() => {\n      if (this.data.error()) {\n        void this.router.navigate(['/']);\n      }\n    });\n  }\n\n  protected showDate(date: string, time: string): string {\n    return formatShowDate(date, time);\n  }\n\n  protected toggle(item: AuditoriumItem): void {\n    if (item.state === 'unavailable') {\n      return;\n    }\n    const identifiers = identifiersOf(item);\n    const current = this.selected();\n    if (item.state === 'selected') {\n      this.bookings.setSeats([...current].filter((id) => !identifiers.includes(id)));\n      return;\n    }\n    if (current.size + identifiers.length > MAX_SEATS_PER_BOOKING) {\n      this.toaster.show(`Maximum ${MAX_SEATS_PER_BOOKING} seats per booking`);\n      return;\n    }\n    this.bookings.setSeats([...current, ...identifiers]);\n  }\n\n  protected onCancel(): void {\n    this.bookings.clear();\n    void this.router.navigate(['/']);\n  }\n\n  protected onContinue(): void {\n    if (this.selectedCount() === 0) {\n      return;\n    }\n    void this.router.navigate(['/screenings', this.screeningId(), 'summary']);\n  }\n}\nimport { Component, computed, effect, inject, resource } from '@angular/core';\nimport { toSignal } from '@angular/core/rxjs-interop';\nimport { ActivatedRoute, Router, RouterLink } from '@angular/router';\nimport { MatButton } from '@angular/material/button';\nimport { MatDatepickerModule } from '@angular/material/datepicker';\nimport { MatFormFieldModule } from '@angular/material/form-field';\nimport { MatInputModule } from '@angular/material/input';\nimport { firstValueFrom, forkJoin } from 'rxjs';\nimport { CinemaApi } from '../cinema-api';\nimport { addDays, isoToDate, isValidIsoDate, startOfToday, toIsoDate, weekdayName } from '../dates';\nimport { Movie, Screening } from '../models';\n\ninterface DayOption {\n  iso: string;\n  label: string;\n}\n\ninterface MovieCard {\n  movie: Movie;\n  screenings: Screening[];\n}\n\n@Component({\n  selector: 'app-movie-list',\n  imports: [RouterLink, MatButton, MatDatepickerModule, MatFormFieldModule, MatInputModule],\n  templateUrl: './movie-list.html',\n  styleUrl: './movie-list.scss',\n})\nexport class MovieList {\n  private readonly api = inject(CinemaApi);\n  private readonly router = inject(Router);\n  private readonly route = inject(ActivatedRoute);\n\n  protected readonly today = startOfToday();\n  protected readonly todayIso = toIsoDate(this.today);\n\n  protected readonly days: DayOption[] = Array.from({ length: 5 }, (_, index) => {\n    const date = addDays(this.today, index);\n    return { iso: toIsoDate(date), label: index === 0 ? 'Today' : weekdayName(date) };\n  });\n\n  private readonly query = toSignal(this.route.queryParamMap, { requireSync: true });\n\n  /** The selected day: the `date` query parameter when it is a valid ISO date not before today, otherwise today. */\n  protected readonly selectedIso = computed(() => {\n    const requested = this.query().get('date');\n    return isValidIsoDate(requested) && requested >= this.todayIso ? requested : this.todayIso;\n  });\n\n  protected readonly pickerValue = computed(() => isoToDate(this.selectedIso()));\n\n  protected readonly data = resource({\n    params: () => this.selectedIso(),\n    loader: ({ params: date }) =>\n      firstValueFrom(\n        forkJoin({\n          movies: this.api.getMovies(),\n          screenings: this.api.getScreenings(date),\n        }),\n      ),\n  });\n\n  protected readonly cards = computed<MovieCard[]>(() => {\n    const data = this.data.value();\n    if (!data) {\n      return [];\n    }\n    return data.movies.flatMap((movie) 