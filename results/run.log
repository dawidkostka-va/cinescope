{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QU3hG4VTAQzrkRsVBZSTND","type":"tool_result","content":"1\timport { useEffect, useState } from 'react';\n2\timport { useNavigate, useParams } from 'react-router-dom';\n3\timport Box from '@mui/material/Box';\n4\timport Button from '@mui/material/Button';\n5\timport Checkbox from '@mui/material/Checkbox';\n6\timport FormControlLabel from '@mui/material/FormControlLabel';\n7\timport FormHelperText from '@mui/material/FormHelperText';\n8\timport Stack from '@mui/material/Stack';\n9\timport TextField from '@mui/material/TextField';\n10\timport Typography from '@mui/material/Typography';\n11\timport { Booking, CheckoutValues, loadBooking, saveBooking } from '../../booking';\n12\timport { createReservation } from '../../api';\n13\timport { getBookingItems, totalPrice } from '../../seatUtils';\n14\timport { useToast } from '../../toast/ToastProvider';\n15\timport { validate, FieldErrors } from './checkoutValidation';\n16\t\n17\ttype TouchedState = Record<keyof FieldErrors, boolean>;\n18\t\n19\tconst INITIAL_TOUCHED: TouchedState = {\n20\t  firstName: false,\n21\t  lastName: false,\n22\t  email: false,\n23\t  confirmEmail: false,\n24\t  phone: false,\n25\t  terms: false,\n26\t};\n27\t\n28\texport function CheckoutPage() {\n29\t  const { screeningId } = useParams();\n30\t  const navigate = useNavigate();\n31\t  const showToast = useToast();\n32\t\n33\t  const [booking, setBooking] = useState<Booking | null>(null);\n34\t  const [guardFailed, setGuardFailed] = useState(false);\n35\t  const [touched, setTouched] = useState<TouchedState>(INITIAL_TOUCHED);\n36\t  const [submitting, setSubmitting] = useState(false);\n37\t\n38\t  useEffect(() => {\n39\t    const existing = loadBooking();\n40\t    if (\n41\t      !existing ||\n42\t      existing.paid ||\n43\t      existing.screeningId !== Number(screeningId) ||\n44\t      existing.seats.length === 0\n45\t    ) {\n46\t      setGuardFailed(true);\n47\t      navigate('/', { replace: true });\n48\t      return;\n49\t    }\n50\t    setBooking(existing);\n51\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n52\t  }, [screeningId]);\n53\t\n54\t  if (guardFailed || !booking) {\n55\t    return null;\n56\t  }\n57\t\n58\t  const values = booking.checkout;\n59\t  const errors = validate(values);\n60\t  const total = totalPrice(booking.seats);\n61\t\n62\t  function updateValues(partial: Partial<CheckoutValues>) {\n63\t    if (!booking) return;\n64\t    const updated = { ...booking, checkout: { ...booking.checkout, ...partial } };\n65\t    setBooking(updated);\n66\t    saveBooking(updated);\n67\t  }\n68\t\n69\t  function markTouched(field: keyof TouchedState) {\n70\t    setTouched((prev) => ({ ...prev, [field]: true }));\n71\t  }\n72\t\n73\t  function handleBack() {\n74\t    navigate(`/screenings/${screeningId}/summary`);\n75\t  }\n76\t\n77\t  async function handlePay() {\n78\t    if (!booking) return;\n79\t    const currentErrors = validate(booking.checkout);\n80\t    if (Object.keys(currentErrors).length > 0) {\n81\t      setTouched({\n82\t        firstName: true,\n83\t        lastName: true,\n84\t        email: true,\n85\t        confirmEmail: true,\n86\t        phone: true,\n87\t        terms: true,\n88\t      });\n89\t      showToast('The form contains errors');\n90\t      return;\n91\t    }\n92\t\n93\t    setSubmitting(true);\n94\t    try {\n95\t      const items = getBookingItems(booking.seats);\n96\t      const seats = items.flatMap((item) => item.ids);\n97\t      await createReservation({\n98\t        screeningId: Number(screeningId),\n99\t        seats,\n100\t        customer: {\n101\t          firstName: booking.checkout.firstName,\n102\t          lastName: booking.checkout.lastName,\n103\t          email: booking.checkout.email,\n104\t          phone: booking.checkout.phone,\n105\t        },\n106\t        totalPrice: total,\n107\t      });\n108\t      const updated = { ...booking, paid: true, customerEmail: booking.checkout.email };\n109\t      saveBooking(updated);\n110\t      navigate('/confirmation');\n111\t    } catch {\n112\t      setSubmitting(false);\n113\t      showToast('Payment failed. Please try again.');\n114\t    }\n115\t  }\n116\t\n117\t  const showError = (field: keyof FieldErrors) => touched[field] && Boolean(errors[field]);\n118\t\n119\t  return (\n120\t    <Box sx={{ maxWidth: 520, mx: 'auto', p: 3 }}>\n121\t      <Typography variant=\"h4\" data-testid=\"checkout-title\" gutterBottom>\n122\t        Your details\n123\t      </Typography>\n124\t\n125\t      <Stack spacing={2}>\n126\t        <TextField\n127\t          label=\"First name *\"\n128\t          value={values.firstName}\n129\t          onChange={(e) => updateValues({ firstName: e.target.value })}\n130\t          onBlur={() => markTouched('firstName')}\n131\t          error={showError('firstName')}\n132\t          helperText={showError('firstName') ? errors.firstName : undefined}\n133\t          slotProps={{\n134\t            htmlInput: { 'data-testid': 'first-name-input' },\n135\t            inputLabel: { 'data-testid': 'first-name-label' },\n136\t            formHelperText: { 'data-testid': 'first-name-error' },\n137\t          }}\n138\t        />\n139\t\n140\t        <TextField\n141\t          label=\"Last name *\"\n142\t          value={values.lastName}\n143\t          onChange={(e) => updateValues({ lastName: e.target.value })}\n144\t          onBlur={() => markTouched('lastName')}\n145\t          error={showError('lastName')}\n146\t          helperText={showError('lastName') ? errors.lastName : undefined}\n147\t          slotProps={{\n148\t            htmlInput: { 'data-testid': 'last-name-input' },\n149\t            inputLabel: { 'data-testid': 'last-name-label' },\n150\t            formHelperText: { 'data-testid': 'last-name-error' },\n151\t          }}\n152\t        />\n153\t\n154\t        <TextField\n155\t          label=\"Email *\"\n156\t          value={values.email}\n157\t          o