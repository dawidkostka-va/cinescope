ll.start }}</button>\n          } @else if (item.cell.kind === 'couch') {\n            <button\n              type=\"button\"\n              class=\"couch\"\n              data-testid=\"couch\"\n              [style.width.rem]=\"item.cell.span * 2 - 0.25\"\n              [attr.data-row]=\"row.row\"\n              [attr.data-column-start]=\"item.cell.start\"\n              [attr.data-column-end]=\"item.cell.end\"\n              [attr.data-state]=\"item.state\"\n              [disabled]=\"item.state === 'unavailable'\"\n              (click)=\"select(item.cell)\"\n            >{{ item.cell.start }}-{{ item.cell.end }}</button>\n          } @else if (item.cell.kind === 'aisle') {\n            <span class=\"gap\" data-testid=\"aisle\" [style.width.rem]=\"item.cell.span * 2\" [attr.data-row]=\"row.row\"></span>\n          } @else {\n            <span class=\"gap\" [style.width.rem]=\"item.cell.span * 2\"></span>\n          }\n        }\n        <span class=\"row-label\" data-testid=\"row-label-right\" [attr.data-row]=\"row.row\">{{ row.row }}</span>\n      </div>\n    }\n  </div>\n\n  <div class=\"legend\" data-testid=\"legend\">\n    @for (entry of legend; track entry.state) {\n      <span class=\"legend-item\" data-testid=\"legend-item\" [attr.data-state]=\"entry.state\">\n        <span class=\"swatch\"></span>{{ entry.label }}\n      </span>\n    }\n  </div>\n\n  <section class=\"selected-seats\" data-testid=\"selected-seats\">\n    <p data-testid=\"selected-seats-count\">Selected seats: {{ selectedCount() }}</p>\n    @for (line of selectedRows(); track line.row) {\n      <p data-testid=\"selected-seats-row\" [attr.data-row]=\"line.row\">Row {{ line.row }}: {{ line.labels.join(', ') }}</p>\n    }\n  </section>\n</section>\n","structuredPatch":[{"oldStart":1,"oldLines":3,"newStart":1,"newLines":4,"lines":["+@if (screening()) {"," <section class=\"seat-page\">","   <h1 data-testid=\"seat-map-title\">Choose your seats</h1>","   <p class=\"subtitle\" data-testid=\"seat-ma