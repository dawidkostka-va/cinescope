\n  <div class=\"actions\">\n    <button matButton=\"outlined\" type=\"button\" data-testid=\"checkout-back-button\" (click)=\"back()\">Back</button>\n    <button matButton=\"filled\" type=\"button\" data-testid=\"pay-button\" [disabled]=\"paying()\" (click)=\"pay()\">\n      {{ paying() ? 'Processing…' : payLabel() }}\n    </button>\n  </div>\n</form>\n","structuredPatch":[{"oldStart":31,"oldLines":8,"newStart":31,"newLines":6,"lines":[" ","   <div class=\"actions\">","     <button matButton=\"outlined\" type=\"button\" data-testid=\"checkout-back-button\" (click)=\"back()\">Back</button>","-    <button matButton=\"filled\" type=\"button\" data-testid=\"pay-button\" [disabled]=\"paying()\" (click)=\"pay()\">","-      {{ paying() ? 'Processing…' : payLabel() }}","-    </button>","+    <button matButton=\"filled\" type=\"button\" data-testid=\"pay-button\" [disabled]=\"paying()\" (click)=\"pay()\">{{ paying() ? 'Processing…' : payLabel() }}</button>","   </div>"," </form>"]}],"userModified":false,"replaceAll":false}}
