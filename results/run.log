{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EGCrwy1xw4EpVzrLQM7PSZ","type":"tool_result","content":"1\timport { useEffect, useMemo, useState } from 'react';\n2\timport { useNavigate, useParams } from 'react-router-dom';\n3\timport Box from '@mui/material/Box';\n4\timport Button from '@mui/material/Button';\n5\timport Stack from '@mui/material/Stack';\n6\timport Typography from '@mui/material/Typography';\n7\timport { fetchMovie, fetchScreening } from '../../api';\n8\timport type { Movie, Screening } from '../../types';\n9\timport { Booking, emptyBooking, loadBooking, saveBooking, clearBooking } from '../../booking';\n10\timport { formatShowDate } from '../../dateUtils';\n11\timport { MAX_SEATS, seatId } from '../../seatUtils';\n12\timport { useToast } from '../../toast/ToastProvider';\n13\timport { AuditoriumMap, ScreenIndicator } from './AuditoriumMap';\n14\timport { Legend } from './Legend';\n15\timport { SelectedSeatsPanel } from './SelectedSeatsPanel';\n16\t\n17\texport function SeatSelectionPage() {\n18\t  const { screeningId } = useParams();\n19\t  const navigate = useNavigate();\n20\t  const showToast = useToast();\n21\t\n22\t  const [screening, setScreening] = useState<Screening | null>(null);\n23\t  const [movie, setMovie] = useState<Movie | null>(null);\n24\t  const [booking, setBooking] = useState<Booking | null>(null);\n25\t\n26\t  useEffect(() => {\n27\t    let cancelled = false;\n28\t    async function load() {\n29\t      try {\n30\t        const loadedScreening = await fetchScreening(screeningId as string);\n31\t        if (cancelled) return;\n32\t        setScreening(loadedScreening);\n33\t        const loadedMovie = await fetchMovie(loadedScreening.movieId);\n34\t        if (cancelled) return;\n35\t        setMovie(loadedMovie);\n36\t      } catch {\n37\t        if (!cancelled) {\n38\t          navigate('/', { replace: true });\n39\t        }\n40\t      }\n41\t    }\n42\t    load();\n43\t    return () => {\n44\t      cancelled = true;\n45\t    };\n46\t  }, [screeningId, navigate]);\n47\t\n48\t  useEffect(() => {\n49\t    if (!screening) return;\n50\t    const existing = loadBooking();\n51\t    if (existing && !existing.paid && existing.screeningId === screening.id) {\n52\t      setBooking(existing);\n53\t    } else {\n54\t      const fresh = emptyBooking(screening.id);\n55\t      saveBooking(fresh);\n56\t      setBooking(fresh);\n57\t    }\n58\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n59\t  }, [screening?.id]);\n60\t\n61\t  const occupiedSeats = useMemo(() => new Set(screening?.occupiedSeats ?? []), [screening]);\n62\t  const selectedSeats = useMemo(() => new Set(booking?.seats ?? []), [booking]);\n63\t\n64\t  function updateSeats(newSeats: string[]) {\n65\t    if (!booking) return;\n66\t    const updated = { ...booking, seats: newSeats };\n67\t    setBooking(updated);\n68\t    saveBooking(updated);\n69\t  }\n70\t\n71\t  function handleToggleSeat(row: number, column: number) {\n72\t    if (!booking) return;\n73\t    const id = seatId(row, column);\n74\t    if (selectedSeats.has(id)) {\n75\t      updateSeats(booking.seats.filter((s) => s !== id));\n76\t      return;\n77\t    }\n78\t    if (booking.seats.length + 1 > MAX_SEATS) {\n79\t      showToast('Maximum 10 seats per booking');\n80\t      return;\n81\t    }\n82\t    updateSeats([...booking.seats, id]);\n83\t  }\n84\t\n85\t  function handleToggleCouch(row: number, columnStart: number, columnEnd: number) {\n86\t    if (!booking) return;\n87\t    const idA = seatId(row, columnStart);\n88\t    const idB = seatId(row, columnEnd);\n89\t    if (selectedSeats.has(idA) && selectedSeats.has(idB)) {\n90\t      updateSeats(booking.seats.filter((s) => s !== idA && s !== idB));\n91\t      return;\n92\t    }\n93\t    if (booking.seats.length + 2 > MAX_SEATS) {\n94\t      showToast('Maximum 10 seats per booking');\n95\t      return;\n96\t    }\n97\t    updateSeats([...booking.seats, idA, idB]);\n98\t  }\n99\t\n100\t  function handleCancel() {\n101\t    clearBooking();\n102\t    navigate('/');\n103\t  }\n104\t\n105\t  function handleContinue() {\n106\t    if (!booking || booking.seats.length === 0) return;\n107\t    navigate(`/screenings/${screeningId}/summary`);\n108\t  }\n109\t\n110\t  if (!screening || !movie || !booking) {\n111\t    return null;\n112\t  }\n113\t\n114\t  return (\n115\t    <Box sx={{ maxWidth: 1200, mx: 'auto', p: 3 }}>\n116\t      <Stack spacing={2} sx={{ alignItems: 'center' }}>\n117\t        <Typography variant=\"h4\" data-testid=\"seat-map-title\" sx={{ alignSelf: 'flex-start' }}>\n118\t          Choose your seats\n119\t        </Typography>\n120\t        <Typography data-testid=\"seat-map-subtitle\" sx={{ alignSelf: 'flex-start' }}>\n121\t          Show Date: {formatShowDate(screening.date, screening.time)}\n122\t        </Typography>\n123\t        <Typography data-testid=\"seat-limit-info\" align=\"center\">\n124\t          You can reserve up to 10 seats per reservation\n125\t        </Typography>\n126\t\n127\t        <ScreenIndicator />\n128\t        <AuditoriumMap\n129\t          occupiedSeats={occupiedSeats}\n130\t          selectedSeats={selectedSeats}\n131\t          onToggleSeat={handleToggleSeat}\n132\t          onToggleCouch={handleToggleCouch}\n133\t        />\n134\t\n135\t        <Legend />\n136\t\n137\t        <SelectedSeatsPanel seatIds={booking.seats} />\n138\t\n139\t        <Stack direction=\"row\" spacing={2}>\n140\t          <Button data-testid=\"cancel-button\" variant=\"outlined\" onClick={handleCancel}>\n141\t            Cancel\n142\t          </Button>\n143\t          <Button\n144\t            data-testid=\"continue-button\"\n145\t            variant=\"contained\"\n146\t            disabled={booking.seats.length === 0}\n147\t            onClick={handleContinue}\n148\t          >\n149\t            Continue\n150\t          </Button>\n151\t        </Stack>\n152\t      </Stack>\n153\t    </Box>\n154\t  );\n155\t}\n156\t"}]},"parent_tool_use_id":"toolu_019qhPutAQhu9gtYed3XbehR","session_id":"3632df4e-836a-4239-9ca1-2c0c9dc67b92","uuid":"80f355d1-06d4-4abc-87cb-bb67e8268dc4","timestamp":"2026-10-20T06:41:55.335Z","subagent_type":"Explore","task_description":"Audit cinescope implementation against spec"}
