d: string,\n  occupiedSeats: ReadonlySet<string>,\n  selectedSeats: ReadonlySet<string>,\n  accessible: boolean,\n): SeatState {\n  if (occupiedSeats.has(id)) return 'unavailable';\n  if (selectedSeats.has(id)) return 'selected';\n  if (accessible) return 'accessible';\n  return 'available';\n}\n\nexport function computeCouchState(\n  ids: [string, string],\n  occupiedSeats: ReadonlySet<string>,\n  selectedSeats: ReadonlySet<string>,\n): 'available' | 'selected' | 'unavailable' {\n  if (ids.some((id) => occupiedSeats.has(id))) return 'unavailable';\n  if (ids.some((id) => selectedSeats.has(id))) return 'selected';\n  return 'available';\n}\n\nexport function countSeats(seatIds: string[]): number {"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016qPNL33SoBqCF1A8Nmu8HK","type":"tool_result","content":"The file /workspace/project/apps/cinescope/src/lib/seats.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"bc998d0e-1624-444d-a35c-194e1322775c","uuid":"e3d59d97-24b1-4003-9f35-6870a5cf232c","timestamp":"2026-10-16T10:27:44.805Z","tool_use_result":{"filePath":"/workspace/project/apps/cinescope/src/lib/seats.ts","oldString":"export function countSeats(seatIds: string[]): number {","newString":"export function computeSeatState(\n  id: string,\n  occupiedSeats: ReadonlySet<string>,\n  selectedSeats: ReadonlySet<string>,\n  accessible: boolean,\n): SeatState {\n  if (occupiedSeats.has(id)) return 'unavailable';\n  if (selectedSeats.has(id)) return 'selected';\n  if (accessible) return 'accessible';\n  return 'available';\n}\n\nexport function computeCouchState(\n  ids: [string, string],\n  occupiedSeats: ReadonlySet<string>,\n  selectedSeats: ReadonlySet<string>,\n): 'available' | 'selected' | 'unavailable' {\n  if (ids.some((id) => occupiedSeats.has(id))) return 'unavailable';\n  if (ids.some((id) => selectedSeats.has(id))) return 'selected';\n  return 'available';\n}\n\nexport function countSeats(seatIds: string[]): number {","originalFile":"export const ROW_COUNT = 15;\nexport const COLUMN_COUNT = 24;\nexport const COUCH_ROW = 15;\nexport const MAX_SEATS = 10;\n\nexport type SeatState = 'available' | 'selected' | 'unavailable' | 'accessible';\n\nexport function seatId(row: number, column: number): string {\n  return `R${row}C${column}`;\n}\n\nexport function parseSeatId(id: string): { row: number; column: number } {\n  const match = /^R(\\d+)C(\\d+)$/.exec(id);\n  if (!match) {\n    throw new Error(`Invalid seat id: ${id}`);\n  }\n  return { row: Number(match[1]), column: Number(match[2]) };\n}\n\nexport function isAccessibleSeat(row: number, column: number): boolean {\n  return row === 1 && column >= 10 && column <= 15;\n}\n\nexport function isCouchRow(row: number): boolean {\n  return row === COUCH_ROW;\n}\n\n/** For a couch row, the [start, end] column pair covering the given column. */\nexport function couchRange(column: number): [number, number] {\n  const start = column % 2 === 1 ? column : column - 1;\n  return [start, start + 1];\n}\n\nexport function couchSeatIds(row: number, startColumn: number): [string, string] {\n  return [seatId(row, startColumn), seatId(row, startColumn + 1)];\n}\n\n/** Whether a column exists on the given row (false in the entrance gap of rows 1-10). */\nexport function columnExistsOnRow(row: number, column: number): boolean {\n  if (row >= 11) {\n    return true;\n  }\n  return column >= 5 && column <= COLUMN_COUNT;\n}\n\nexport function priceForRow(row: number): number {\n  if (row <= 5) return 25;\n  if (row <= 10) return 32;\n  if (row <= 14) return 39;\n  throw new Error(`Row ${row} has no per-seat price (couch row)`);\n}\n\nexport const COUCH_PRICE = 89;\n\nexport function formatPrice(amount: number): string {\n  return `${amount.toFixed(2)} PLN`;\n}\n\nexport interface SelectionUnit {\n  row: number;\n  /** Single seat column, or the lower column of a couch pair. */\n  startColumn: number;\n  endColumn?: number;\n  seatIds: string[];\n  price: number;\n}\n\n/** Groups a flat list of seat identifiers into seats and couches for display. */\nexport function toSelectionUnits(seatIds: string[]): SelectionUnit[] {\n  const ids = new Set(seatIds);\n  const seen = new Set<string>();\n  const units: SelectionUnit[] = [];\n\n  for (const id of seatIds) {\n    if (seen.has(id)) continue;\n    const { row, column } = parseSeatId(id);\n    if (isCouchRow(row)) {\n      const [start, end] = couchRange(column);\n      const pairIds = couchSeatIds(row, start);\n      seen.add(pairIds[0]);\n      seen.add(pairIds[1]);\n      units.push({\n        row,\n        startColumn: start,\n        endColumn: end,\n        seatIds: pairIds.filter((pid) => ids.has(pid)),\n        price: COUCH_PRICE,\n      });\n    } else {\n      seen.add(id);\n      units.push({\n        row,\n        startColumn: column,\n        seatIds: [id],\n        price: priceForRow(row),\n      });\n    }\n  }\n\n  return units.sort((a, b) => a.row - b.row || a.startColumn - b.startColumn);\n}\n\nexport function countSeats(seatIds: string[]): number {\n  return seatIds.length;\n}\n\nexport function totalPrice(seatIds: string[]): number {\n  return toSelectionUnits(seatIds).reduce((sum, unit) => sum + unit.price, 0);\n}\n","structuredPatch":[{"oldStart":100,"oldLines":6,"newStart":100,"newLines":28,"lines":["   return units.sort((a, b) => a.row - b.row || a.startColumn - b.startColumn);"," }"," ","+export function computeSeatState(","+  id: string,","+  occupiedSeats: ReadonlySet<string>,","+  selectedSeats: ReadonlySet<string>,","+  accessible: boolean,","+): SeatState {","+  if (occupiedSeats.has(id)) return 'unavailable';","+  if (selectedSeats.has(id)) return 'selected';","+  if (accessible) return 'accessible';","+  return 'available';","+}","+","+export function computeCouchState(","+  ids: [string, string],","+  occupiedSeats: ReadonlySet<string>,","+  selectedSeats: ReadonlySet<string>,","+): 'available' | 'selected' | 'unavailable' {","+  if (ids.some((id) => occupiedSeats.has(id))) return 'unavailable';","+  if (ids.some((id) => selectedSeats.has(id))) return 'selected';","+  return 'available';","+}","+"," export function countSeats(seatIds: string[]): number {","   return seatIds.length;"," }"]}],"userModified":false,"replaceAll":false}}
