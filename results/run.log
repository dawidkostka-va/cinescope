{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KzkpRmKPkYhNQ7gtNVbS3Q","type":"tool_result","content":"1\timport { Component, computed, inject, signal } from '@angular/core';\n2\timport { MatButtonModule } from '@angular/material/button';\n3\timport { ActivatedRoute, Router } from '@angular/router';\n4\timport { switchMap, map } from 'rxjs';\n5\timport { ApiService } from '../../core/api.service';\n6\timport { BookingService } from '../../core/booking.service';\n7\timport { Movie, Screening } from '../../core/models';\n8\timport { formatPrice } from '../../shared/seat-utils';\n9\timport { SummaryItem, buildSummaryItems } from '../../shared/grouping';\n10\t\n11\t@Component({\n12\t  selector: 'app-summary',\n13\t  imports: [MatButtonModule],\n14\t  templateUrl: './summary.component.html',\n15\t  styleUrl: './summary.component.scss',\n16\t})\n17\texport class SummaryComponent {\n18\t  private readonly route = inject(ActivatedRoute);\n19\t  private readonly router = inject(Router);\n20\t  private readonly api = inject(ApiService);\n21\t  protected readonly bookingService = inject(BookingService);\n22\t\n23\t  private readonly screeningId = Number(this.route.snapshot.paramMap.get('id'));\n24\t\n25\t  protected readonly screening = signal<Screening | null>(null);\n26\t  protected readonly movie = signal<Movie | null>(null);\n27\t\n28\t  protected readonly items = computed(() => buildSummaryItems(this.bookingService.booking()?.seats ?? []));\n29\t  protected readonly total = computed(() => this.items().reduce((sum, item) => sum + item.price, 0));\n30\t\n31\t  protected readonly formatPrice = formatPrice;\n32\t\n33\t  constructor() {\n34\t    this.api\n35\t      .getScreening(this.screeningId)\n36\t      .pipe(switchMap((screening) => this.api.getMovie(screening.movieId).pipe(map((movie) => ({ screening, movie })))))\n37\t      .subscribe({\n38\t        next: ({ screening, movie }) => {\n39\t          this.screening.set(screening);\n40\t          this.movie.set(movie);\n41\t        },\n42\t        error: () => this.router.navigateByUrl('/'),\n43\t      });\n44\t  }\n45\t\n46\t  protected remove(item: SummaryItem): void {\n47\t    this.bookingService.removeSeats(item.ids);\n48\t    if ((this.bookingService.booking()?.seats.length ?? 0) === 0) {\n49\t      this.router.navigate(['/screenings', this.screeningId, 'seats']);\n50\t    }\n51\t  }\n52\t\n53\t  protected back(): void {\n54\t    this.router.navigate(['/screenings', this.screeningId, 'seats']);\n55\t  }\n56\t\n57\t  protected confirm(): void {\n58\t    this.router.navigate(['/screenings', this.screeningId, 'checkout']);\n59\t  }\n60\t}\n61\t"}]},"parent_tool_use_id":null,"session_id":"58234399-3835-4505-bb7c-af12a0e71b05","uuid":"f9801541-9e21-4612-b917-e83a6c225b01","timestamp":"2026-10-16T08:34:46.482Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/app/pages/summary/summary.component.ts","content":"import { Component, computed, inject, signal } from '@angular/core';\nimport { MatButtonModule } from '@angular/material/button';\nimport { ActivatedRoute, Router } from '@angular/router';\nimport { switchMap, map } from 'rxjs';\nimport { ApiService } from '../../core/api.service';\nimport { BookingService } from '../../core/booking.service';\nimport { Movie, Screening } from '../../core/models';\nimport { formatPrice } from '../../shared/seat-utils';\nimport { SummaryItem, buildSummaryItems } from '../../shared/grouping';\n\n@Component({\n  selector: 'app-summary',\n  imports: [MatButtonModule],\n  templateUrl: './summary.component.html',\n  styleUrl: './summary.component.scss',\n})\nexport class SummaryComponent {\n  private readonly route = inject(ActivatedRoute);\n  private readonly router = inject(Router);\n  private readonly api = inject(ApiService);\n  protected readonly bookingService = inject(BookingService);\n\n  private readonly screeningId = Number(this.route.snapshot.paramMap.get('id'));\n\n  protected readonly screening = signal<Screening | null>(null);\n  protected readonly movie = signal<Movie | null>(null);\n\n  protected readonly items = computed(() => buildSummaryItems(this.bookingService.booking()?.seats ?? []));\n  protected readonly total = computed(() => this.items().reduce((sum, item) => sum + item.price, 0));\n\n  protected readonly formatPrice = formatPrice;\n\n  constructor() {\n    this.api\n      .getScreening(this.screeningId)\n      .pipe(switchMap((screening) => this.api.getMovie(screening.movieId).pipe(map((movie) => ({ screening, movie })))))\n      .subscribe({\n        next: ({ screening, movie }) => {\n          this.screening.set(screening);\n          this.movie.set(movie);\n        },\n        error: () => this.router.navigateByUrl('/'),\n      });\n  }\n\n  protected remove(item: SummaryItem): void {\n    this.bookingService.removeSeats(item.ids);\n    if ((this.bookingService.booking()?.seats.length ?? 0) === 0) {\n      this.router.navigate(['/screenings', this.screeningId, 'seats']);\n    }\n  }\n\n  protected back(): void {\n    this.router.navigate(['/screenings', this.screeningId, 'seats']);\n  }\n\n  protected confirm(): void {\n    this.router.navigate(['/screenings', this.screeningId, 'checkout']);\n  }\n}\n","numLines":61,"startLine":1,"totalLines":61}}}
