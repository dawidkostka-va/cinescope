eadonly movie = signal<Movie | null>(null);\n  readonly subtitle = computed(() => {\n    const screening = this.screening();\n    return screening ? showDate(screening.date, screening.time) : '';\n  });\n\n  private readonly occupied = computed(() => new Set(this.screening()?.occupiedSeats ?? []));\n\n  readonly colours = STATE_COLOURS;\n\n  constructor() {\n    this.route.paramMap\n      .pipe(\n        switchMap((params) => this.api.screening(Number(params.get('id')))),\n        switchMap((screening) =>\n          this.api.movie(screening.movieId).pipe(map((movie) => ({ screening, movie }))),\n        ),\n        takeUntilDestroyed(this.destroyRef),\n      )\n      .subscribe({\n        next: ({ screening, movie }) => {\n          this.screening.set(screening);\n          this.movie.set(movie);\n        },\n        error: () => void this.router.navigateByUrl('/'),\n      });\n  }\n\n  stateOf(item: AuditoriumItem): SeatState {\n    if (item.kind === 'couch') {\n      return this.isOccupied(item.ids[0]) || this.isOccupied(item.ids[1]) ? 'unavailable' : 'available';\n    }\n    if (this.isOccupied(item.id)) {\n      return 'unavailable';\n    }\n    return item.accessible ? 'accessible' : 'available';\n  }\n\n  asSeat(item: AuditoriumItem): SeatItem {\n    return item as SeatItem;\n  }\n\n  asCouch(item: AuditoriumItem): CouchItem {\n    return item as CouchItem;\n  }\n\n  private isOccupied(id: string): boolean {\n    return this.occupied().has(id);\n  }\n}\n","structuredPatch":[{"oldStart":67,"oldLines":14,"newStart":67,"newLines":6,"lines":["     return item.accessible ? 'accessible' : 'available';","   }"," ","-  asSeat(item: AuditoriumItem): SeatItem {","-    return item as SeatItem;","-  }","-","-  asCouch(item: AuditoriumItem): CouchItem {","-    return item as CouchItem;","-  }","-","   private isOccupied(id: string): boolean {","     return this.occupied().has(id);","   }"]}],"userModified":false,"replaceAll":false}}
