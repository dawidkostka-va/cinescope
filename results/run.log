d').count());\nawait tid('movies-retry-button').click(); await settle();\nawait page.waitForSelector('[data-testid=\"movie-card\"]');\nlog('RETRY ok cards', await tid('movie-card').count(), 'error gone', await tid('movies-error').count());\nawait page.unroute('**/movies');\n\n// Loading indicator while in flight\nawait page.route('**/screenings?**', async (route) => { await new Promise((r) => setTimeout(r, 1200)); await route.continue(); });\nawait page.goto(BASE + '/?date=2026-11-27');\nawait settle();\nlog('LOADING shown', await tid('movies-loading').count(), 'cards', await tid('movie-card').count());\nawait page.waitForSelector('[data-testid=\"movie-card\"]', { timeout: 5000 });\nlog('LOADING gone', await tid('movies-loading').count());\nawait page.unroute('**/screenings?**');\n\n// 404 seat map -> redirect to /\nawait page.goto(BASE + '/screenings/999/seats');\nawait page.waitForTimeout(800);\nlog('404 redirect', page.url());\n\n// Summary without booking -> /\nawait page.goto(BASE + '/screenings/1/summary');\nawait page.waitForTimeout(800);\nlog('summary no booking', page.url());\n\n// Cancel clears selection; Remove last item; summary guard\nawait page.goto(BASE + '/');\nawait page.waitForSelector('[data-testid=\"screening-button\"]');\nawait page.locator('[data-testid=\"screening-button\"]').first().click();\nawait page.waitForSelector('[data-testid=\"seat-map\"]');\nconst sid = page.url().match(/screenings\\/(\\d+)/)[1];\nawait page.locator('[data-testid=\"seat\"][data-row=\"7\"][data-column=\"12\"]').click(); await settle();\nlog('SEL before cancel', await tid('selected-seats-count').textContent());\nawait tid('cancel-button').click(); await settle();\nlog('CANCEL url', page.url());\nawait page.goto(BASE + `/screenings/${sid}/seats`);\nawait page.waitForSelector('[data-testid=\"seat-map\"]');\nlog('after cancel count', await tid('selected-seats-count').textContent());\nawait page.locator('[data-testid=\"seat\"][data-row=\"7\"][data-column=\"12\"]').click();