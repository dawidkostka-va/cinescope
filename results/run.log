rvice } from '../core/booking.service';\nimport { Movie, Screening } from '../core/models';\nimport { formatPrice, unitPrice } from '../core/pricing';\nimport { bookingTotal, SeatUnit, toUnits, unitDescription } from '../core/seat-units';\n\n@Component({\n  selector: 'app-summary',\n  imports: [MatButtonModule],\n  templateUrl: './summary.component.html',\n  styleUrl: './summary.component.scss',\n})\nexport class SummaryComponent {\n  private readonly api = inject(ApiService);\n  private readonly route = inject(ActivatedRoute);\n  private readonly router = inject(Router);\n  private readonly bookings = inject(BookingService);\n\n  readonly screening = signal<Screening | null>(null);\n  readonly movie = signal<Movie | null>(null);\n  readonly seats = computed(() => this.bookings.booking()?.seats ?? []);\n  readonly units = computed(() => toUnits(this.seats()));\n  readonly total = computed(() => formatPrice(bookingTotal(this.seats(), unitPrice)));\n\n  readonly describe = unitDescription;\n  readonly price = (unit: SeatUnit) => formatPrice(unitPrice(unit));\n\n  constructor() {\n    this.route.paramMap\n      .pipe(\n        map((params) => Number(params.get('id'))),\n        switchMap((id) =>\n          this.api.screeningWithMovie(id).pipe(\n            catchError(() => {\n              this.router.navigateByUrl('/');\n              return EMPTY;\n            }),\n          ),\n        ),\n        takeUntilDestroyed(),\n      )\n      .subscribe(({ screening, movie }) => {\n        this.screening.set(screening);\n        this.movie.set(movie);\n      });\n  }\n\n  remove(unit: SeatUnit): void {\n    const remaining = this.seats().filter((id) => !unit.ids.includes(id));\n    this.bookings.setSeats(remaining);\n    if (remaining.length === 0) {\n      this.back();\n    }\n  }\n\n  back(): void {\n    this.router.navigate(['/screenings', this.screening()?.id, 'seats']);\n  }\n\n  confirm(): void {\n    this.router.navigate(['/screenings', this.screening()?.id, 'checkout']);\n  }\n}\nEOF\ncat > summary/summary.component.html <<'EOF'\n<main class=\"page\">\n  <h1 data-testid=\"summary-title\">Your tickets</h1>\n\n  @if (screening(); as current) {\n    @if (movie(); as currentMovie) {\n      <div class=\"summary-list\" data-testid=\"summary-list\">\n        @for (unit of units(); track unit.ids.join()) {\n          <div class=\"summary-item\" data-testid=\"summary-item\">\n            <span class=\"cell title\" data-testid=\"summary-item-title\">{{ currentMovie.title }}</span>\n            <span class=\"cell\" data-testid=\"summary-item-datetime\">{{ current.date }} {{ current.time }}</span>\n            <span class=\"cell\" data-testid=\"summary-item-row\">{{ unit.row }}</span>\n            <span class=\"cell\" data-testid=\"summary-item-seat\">{{ describe(unit) }}</span>\n            <span class=\"cell\" data-testid=\"summary-item-price\">{{ price(unit) }}</span>\n            <button mat-stroked-button type=\"button\" data-testid=\"summary-item-remove-button\" (click)=\"remove(unit)\">Remove</button>\n          </div>\n        }\n      </div>\n\n      <p class=\"total\" data-testid=\"summary-total\">Total: {{ total() }}</p>\n\n      <div class=\"actions\">\n        <button mat-stroked-button type=\"button\" data-testid=\"back-button\" (click)=\"back()\">Back</button>\n        <button mat-flat-button type=\"button\" data-testid=\"confirm-button\" (click)=\"confirm()\">Confirm</button>\n      </div>\n    }\n  }\n</main>\nEOF\ncat > summary/summary.component.scss <<'EOF'\n.page {\n  max-width: 900px;\n  margin: 0 auto;\n  padding: 24px;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\nh1 {\n  margin: 0;\n}\n\n.summary-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.summary-item {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 12px 16px;\n  border: 1px solid var(--mat-sys-outline-variant);\n  border-radius: 8px;\n}\n\n.cell {\n  white-space: nowrap;\n}\n\n.title {\n  flex: 1;\n  font-weight: 500;\n}\n\n.total {\n  margin: 0;\n  text-align: right;\n  font-size: 18px;\n  font-weight: 500;\n}\n\n.actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n}\nEOF\ncat > app.routes.ts <<'EOF'\nimport { Routes } from '@angular/router';\nimport { MovieListComponent } from './movies/movie-list.component';\nimport { RoutePlaceholderComponent } from './core/route-placeholder.component';\nimport { paidBookingGuard, unpaidBookingGuard } from './core/booking.guards';\nimport { SeatSelectionComponent } from './seats/seat-selection.component';\nimport { SummaryComponent } from './summary/summary.component';\n\nexport const appRoutes: Routes = [\n  { path: '', component: MovieListComponent },\n  { path: 'screenings/:id/seats', component: SeatSelectionComponent },\n  { path: 'screenings/:id/summary', component: SummaryComponent, canActivate: [unpaidBookingGuard] },\n  { path: 'screenings/:id/checkout', component: RoutePlaceholderComponent, canActivate: [unpaidBookingGuard] },\n  { path: 'confirmation', component: RoutePlaceholderComponent, canActivate: [paidBookingGuard] },\n  { path: '**', redirectTo: '' },\n];\nEOF\ncd /workspace/project && pnpm_config_verify_deps_before_run=false pnpm nx build cinescope --skip-nx-cache 2>&1 | grep -E \"ERROR|Successfully|failed|✘|TS[0-9]+\" | head -20","description":"Add summary screen, route guards and build"}},"wire_ingest_context":{"toolu_01GU7ifHqB99DUoVLNYFgzeL":{"cwd":"/workspace/project/apps/cinescope/src/app"}}}
