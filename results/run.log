, computed, inject, resource, signal } from '@angular/core';","+import { Component, computed, inject, signal } from '@angular/core';"," import { toSignal } from '@angular/core/rxjs-interop';"," import { FormsModule } from '@angular/forms';"," import { MatButtonModule } from '@angular/material/button';"]},{"oldStart":8,"oldLines":9,"newStart":8,"newLines":9,"lines":[" import { ActivatedRoute, Router } from '@angular/router';"," import { firstValueFrom } from 'rxjs';"," import { ApiService } from '../core/api.service';","-import { compareCells, cellIds } from '../core/auditorium';","+import { cellIds, compareCells } from '../core/auditorium';"," import { BookingService } from '../core/booking.service';","-import { CHECKOUT_FIELDS, CheckoutErrors, CheckoutField, CheckoutValues, validateCheckout } from '../core/checkout';","+import { CHECKOUT_FIELDS, CheckoutField, CheckoutValues, validateCheckout } from '../core/checkout';"," import { formatPrice } from '../core/pricing';"," import { ToastService } from '../core/toast.service';"," "]},{"oldStart":34,"oldLines":19,"newStart":34,"newLines":6,"lines":["   readonly submitting = signal(false);","   readonly payLabel = computed(() => `Pay ${formatPrice(this.booking.total())}`);"," ","-  readonly data = resource({","-    params: () => Number(this.params().get('id')),","-    loader: async ({ params: id }) => {","-      try {","-        await firstValueFrom(this.api.screening(id));","-        return true;","-      } catch {","-        await this.router.navigate(['/']);","-        return undefined;","-      }","-    },","-  });","-","   error(field: CheckoutField): string | undefined {","     return this.touched().has(field) ? this.errors()[field] : undefined;","   }"]}],"originalFile":"import { Component, computed, inject, resource, signal } from '@angular/core';\nimport { toSignal } from '@angular/core/rxjs-interop';\nimport { FormsModule } from '@angular/forms';\nimport { MatButtonModule } from '@angular/material/button';\nimport { MatCheckboxModule } from '@angular/material/checkbox';\nimport { MatFormFieldModule } from '@angular/material/form-field';\nimport { MatInputModule } from '@angular/material/input';\nimport { ActivatedRoute, Router } from '@angular/router';\nimport { firstValueFrom } from 'rxjs';\nimport { ApiService } from '../core/api.service';\nimport { compareCells, cellIds } from '../core/auditorium';\nimport { BookingService } from '../core/booking.service';\nimport { CHECKOUT_FIELDS, CheckoutErrors, CheckoutField, CheckoutValues, validateCheckout } from '../core/checkout';\nimport { formatPrice } from '../core/pricing';\nimport { ToastService } from '../core/toast.service';\n\n@Component({\n  selector: 'app-checkout',\n  imports: [FormsModule, MatButtonModule, MatCheckboxModule, MatFormFieldModule, MatInputModule],\n  templateUrl: './checkout.component.html',\n  styleUrl: './checkout.component.scss',\n})\nexport class CheckoutComponent {\n  private readonly api = inject(ApiService);\n  private readonly router = inject(Router);\n  private readonly route = inject(ActivatedRoute);\n  private readonly toasts = inject(ToastService);\n  private readonly booking = inject(BookingService);\n  private readonly params = toSignal(this.route.paramMap, { requireSync: true });\n\n  readonly values = this.booking.form;\n  readonly errors = computed(() => validateCheckout(this.values()));\n  readonly touched = signal<ReadonlySet<CheckoutField>>(new Set());\n  readonly submitting = signal(false);\n  readonly payLabel = computed(() => `Pay ${formatPrice(this.booking.total())}`);\n\n  readonly data = resource({\n    params: () => Number(this.params().get('id')),\n    loader: async ({ params: id }) => {\n      try {\n        await firstValueFrom(this.api.screening(id));\n        return true;\n      } catch {\n        await this.router.navigate(['/']);\n        return undefined;\n      }\n    },\n  });\n\n  error(field: CheckoutField): string | undefined {\n    return this.touched().has(field) ? this.errors()[field] : undefined;\n  }\n\n  update<K extends CheckoutField>(field: K, value: CheckoutValues[K]): void {\n    this.booking.updateForm({ ...this.values(), [field]: value });\n  }\n\n  touch(field: CheckoutField): void {\n    this.touched.update((fields) => new Set(fields).add(field));\n  }\n\n  back(): void {\n    this.router.navigate(['/screenings', this.params().get('id'), 'summary']);\n  }\n\n  async pay(): Promise<void> {\n    if (Object.keys(this.errors()).length > 0) {\n      this.touched.set(new Set(CHECKOUT_FIELDS));\n      this.toasts.show('The form contains errors');\n      return;\n    }\n    const values = this.values();\n    this.submitting.set(true);\n    try {\n      await firstValueFrom(\n        this.api.createReservation({\n          screeningId: this.booking.screeningId() as number,\n          seats: [...this.booking.seats()].sort(compareCells).flatMap(cellIds),\n          customer: {\n            firstName: values.firstName,\n            lastName: values.lastName,\n            email: values.email,\n            phone: values.phone,\n          },\n          totalPrice: this.booking.total(),\n        }),\n      );\n      this.booking.markPaid(values.email);\n      await this.router.navigate(['/confirmation']);\n    } catch {\n      this.submitting.set(false);\n      this.toasts.show('Payment failed. Please try again.');\n    }\n  }\n}\n","userModified":false}}
