ovieId: 1, date: '2026-09-15', time: '16:00', occupiedSeats: occupied }),\n            movie: () => of({ id: 1, title: 'X', genre: 'Drama', runtimeMinutes: 100, format: 'PL dubbing' }),\n          },\n        },\n      ],\n    });\n    const fixture = TestBed.createComponent(SeatSelectionComponent);\n    fixture.detectChanges();\n    const el = fixture.nativeElement as HTMLElement;\n    const q = (sel: string) => Array.from(el.querySelectorAll<HTMLElement>(sel));\n    return { fixture, el, q, snack: TestBed.inject(MatSnackBar) };\n  }\n\n  it('draws the auditorium geometry', () => {\n    const { el, q } = setup([]);\n    expect(el.querySelector('[data-testid=seat-map-subtitle]')?.textContent).toBe('Show Date: Tuesday 15 Sep 16:00');\n    expect(q('[data-testid=seat-row]').length).toBe(15);\n    expect(q('[data-testid=seat]').length).toBe(296);\n    expect(q('[data-testid=couch]').length).toBe(12);\n    expect(q('[data-testid=aisle]').length).toBe(30);\n    expect(q('[data-testid=row-label-left]').length).toBe(15);\n    expect(q('[data-testid=row-label-right]').length).toBe(15);\n    const row1 = q('[data-testid=seat-row][data-row=\"1\"] [data-testid=seat]');\n    expect(row1.length).toBe(20);\n    expect(row1[0].textContent).toBe('5');\n    expect(row1.filter((s) => s.dataset['state'] === 'accessible').map((s) => s.textContent)).toEqual(\n      ['10', '11', '12', '13', '14', '15'],\n    );\n    expect(q('[data-testid=seat-row][data-row=\"11\"] [data-testid=seat]').length).toBe(24);\n    expect(q('[data-testid=couch]')[11].textContent).toBe('23-24');\n  });\n\n  it('marks occupied seats and couches unavailable', () => {\n    const { q } = setup(['R3C7', 'R15C6', 'R1C10']);\n    const state = (sel: string) => q(sel)[0].dataset['state'];\n    expect(state('[data-testid=seat][data-row=\"3\"][data-column=\"7\"]')).toBe('unavailable');\n    expect(state('[data-testid=seat][data-row=\"1\"][data-column=\"10\"]')).toBe('unavailable');\n    expect(state('[data-testid=couch][data-column-start=\"5\"]')).toBe('unavailable');\n    expect(state('[data-testid=couch][data-column-start=\"3\"]')).toBe('available');\n  });\n\n  it('selects, deselects, caps at 10 and lists the selection', () => {\n    const { fixture, q, snack } = setup(['R3C7']);\n    const click = (sel: string) => {\n      q(sel)[0].click();\n      fixture.detectChanges();\n    };\n    click('[data-testid=seat][data-row=\"3\"][data-column=\"7\"]');\n    expect(TestBed.inject(BookingService).seatCount()).toBe(0);\n\n    click('[data-testid=seat][data-row=\"7\"][data-column=\"12\"]');\n    click('[data-testid=seat][data-row=\"7\"][data-column=\"11\"]');\n    click('[data-testid=couch][data-column-start=\"1\"]');\n    expect(q('[data-testid=selected-seats-count]')[0].textContent).toBe('Selected seats: 4');\n    expect(q('[data-testid=selected-seats-row]').map((r) => r.textContent)).toEqual(['Row 7: 11, 12', 'Row 15: 1-2']);\n\n    click('[data-testid=seat][data-row=\"7\"][data-column=\"11\"]');\n    expect(q('[data-testid=selected-seats-count]')[0].textContent).toBe('Selected seats: 3');\n\n    for (const c of [3, 5, 7]) click(`[data-testid=couch][data-column-start=\"${c}\"]`);\n    expect(TestBed.inject(BookingService).seatCount()).toBe(9);\n    const open = vi.spyOn(snack, 'openFromComponent');\n    click('[data-testid=couch][data-column-start=\"9\"]');\n    expect(TestBed.inject(BookingService).seatCount()).toBe(9);\n    expect(open).toHaveBeenCalledTimes(1);\n    click('[data-testid=seat][data-row=\"9\"][data-column=\"9\"]');\n    expect(TestBed.inject(BookingService).seatCount()).toBe(10);\n    click('[data-testid=couch][data-column-start=\"1\"]');\n    expect(TestBed.inject(BookingService).seatCount()).toBe(8);\n  });\n});\nEOF\ncat > checkout/checkout.spec.ts <<'EOF'\nimport { TestBed } from '@angular/core/testing';\nimport { ActivatedRoute, Router, convertToParamMap, provideRouter } from '@angular/router';\nimport { Subject } from 'rxjs';\nimport { ApiService } from '../core/api.service';\nimport { BookingService } from '../core/booking.service';\nimport { Reservation } from '../core/models';\nimport { CheckoutComponent } from './checkout';\n\ndescribe('CheckoutComponent', () => {\n  const reserve = new Subject<Reservation>();\n  const reserveSpy = vi.fn(() => reserve);\n\n  function setup() {\n    sessionStorage.clear();\n    TestBed.configureTestingModule({\n      providers: [\n        provideRouter([]),\n        { provide: ActivatedRoute, useValue: { snapshot: { paramMap: convertToParamMap({ id: '1' }) } } },\n        { provide: ApiService, useValue: { reserve: reserveSpy } },\n      ],\n    });\n    const booking = TestBed.inject(BookingService);\n    booking.open(1);\n    booking.addSeats(['R7C12', 'R15C1', 'R15C2']);\n    const fixture = TestBed.createComponent(CheckoutComponent);\n    fixture.detectChanges();\n    const el = fixture.nativeElement as HTMLElement;\n    const get = (id: string) => el.querySelector<HTMLElement>(`[data-testid=\"${id}\"]`);\n    const type = (id: string, value: string) => {\n      const input = get(id) as HTMLInputElement;\n      input.value = value;\n      input.dispatchEvent(new Event('input'));\n      fixture.detectChanges();\n    };\n    const blur = (id: string) => {\n      get(id)!.dispatchEvent(new Event('blur'));\n      fixture.detectChanges();\n    };\n    return { fixture, get, type, blur, booking };\n  }\n\n  it('labels and total', () => {\n    const { get } = setup();\n    expect(get('first-name-label')?.textContent).toBe('First name *');\n    expect(get('phone-label')?.textContent).toBe('Phone number');\n    expect(get('pay-button')?.textContent?.trim()).toBe('Pay 121.00 PLN');\n  });\n\n  it('shows messages after blur and re-checks confirm email', () => {\n    const { get, type, blur } = setup();\n    expect(get('first-name-error')).toBeNull();\n    blur('first-name-input');\n    expect(get('first-name-error')?.textContent).toBe('First name is required');\n    type('first-name-input', 'A');\n    expect(get('first-name-error')?.textContent).toBe('First name must be at least 2 characters');\n    type('first-name-input', 'An');\n    expect(get('first-name-error')).toBeNull();\n\n    type('email-input', 'a@b');\n    blur('email-input');\n    expect(get('email-error')?.textContent).toBe('Enter a valid email address');\n    type('confirm-email-input', 'x@y.pl');\n    blur('confirm-email-input');\n    expect(get('confirm-email-error')?.textContent).toBe('Email addresses do not match');\n    type('email-input', 'x@y.pl');\n    expect(get('confirm-email-error')).toBeNull();\n\n    type('phone-input', '12345678');\n    blur('phone-input');\n    expect(get('phone-error')?.textContent).toBe('Phone number must be exactly 9 digits');\n    type('phone-input', '');\n    expect(get('phone-error')).toBeNull();\n  });\n\n  it('rejects an invalid form and pays a valid one', () => {\n    const { fixture, get, type, booking } = setup();\n    const router = TestBed.inject(Router);\n    const nav = vi.spyOn(router, 'navigateByUrl').mockResolvedValue(true);\n    get('pay-button')!.click();\n    fixture.detectChanges();\n    expect(reserveSpy).not.toHaveBeenCalled();\n    expect(get('terms-error')?.textContent).toBe('You must accept the terms and conditions');\n    expect(get('confirm-email-error')?.textContent).toBe('Confirm email is required');\n\n    type('first-name-input', 'Anna');\n    type('last-name-input', 'Kowalska');\n    type('email-input', 'anna@example.com');\n    type('confirm-email-input', 'anna@example.com');\n    (get('terms-checkbox')!.querySelector('input') as HTMLInputElement).click();\n    fixture.detectChanges();\n    get('pay-button')!.click();\n    fixture.detectChanges();\n    expect(reserveSpy).toHaveBeenCalledWith({\n      screeningId: 1,\n      seats: ['R7C12', 'R15C1', 'R15C2'],\n      customer: { firstName: 'Anna', lastName: 'Kowalska', email: 'anna@example.com', phone: '' },\n      totalPrice: 121,\n    });\n    expect(get('pay-button')?.textContent?.trim()).toBe('Processing…');\n    expect((get('pay-button') as HTMLButtonElement).disabled).toBe(true);\n    reserve.next({} as Reservation);\n    expect(booking.booking()?.paid).toBe(true);\n    expect(booking.booking()?.email).toBe('anna@example.com');\n    expect(nav).toHaveBeenCalledWith('/confirmation');\n  });\n});\nEOF\ncat > movies/movie-list.spec.ts <<'EOF'\nimport { TestBed } from '@angular/core/testing';\nimport { provideNativeDateAdapter } from '@angular/material/core';\nimport { provideRouter } from '@angular/router';\nimport { of, throwError } from 'rxjs';\nimport { ApiService } from '../core/api.service';\nimport { toIsoDate } from '../core/seating';\nimport { MovieListComponent } from './movie-list';\n\ndescribe('MovieListComponent', () => {\n  const todayIso = toIsoDate(new Date());\n  const movies = [\n    { id: 1, title: 'A', genre: 'Drama', runtimeMinutes: 128, format: 'PL dubbing' },\n    { id: 2, title: 'B', genre: 'Sci-Fi', runtimeMinutes: 90, format: 'PL subtitles' },\n  ];\n  const screenings = [\n    { id: 1, movieId: 1, date: todayIso, time: '18:00', occupiedSeats: [] },\n    { id: 2, movieId: 1, date: todayIso, time: '16:00', occupiedSeats: [] },\n    { id: 3, movieId: 2, date: '2000-01-01', time: '10:00', occupiedSeats: [] },\n  ];\n\n  function setup(api: object) {\n    TestBed.configureTestingModule({\n      providers: [provideRouter([]), provideNativeDateAdapter(), { provide: ApiService, useValue: api }],\n    });\n    const fixture = TestBed.createComponent(MovieListComponent);\n    fixture.detectChanges();\n    return { fixture, el: fixture.nativeElement as HTMLElement };\n  }\n\n  it('lists today’s movies with ordered screening buttons', () => {\n    const { el } = setup({ movies: () => of(movies), screenings: () => of(screenings) });\n    const cards = el.querySelectorAll('[data-testid=movie-card]');\n    expect(cards.length).toBe(1);\n    expect(cards[0].querySelector('[data-testid=movie-runtime]')?.textContent).toBe('1