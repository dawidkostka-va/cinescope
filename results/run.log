t-map',\n  imports: [MatButtonModule],\n  templateUrl: './seat-map.html',\n  styleUrl: './seat-map.scss',\n})\nexport class SeatMap {\n  private readonly api = inject(ApiService);\n  private readonly router = inject(Router);\n  private readonly route = inject(ActivatedRoute);\n  private readonly booking = inject(BookingService);\n  private readonly toast = inject(ToastService);\n\n  protected readonly rows = AUDITORIUM;\n  protected readonly legend: { state: SeatState; label: string }[] = [\n    { state: 'available', label: 'Available' },\n    { state: 'selected', label: 'Selected' },\n    { state: 'unavailable', label: 'Unavailable' },\n    { state: 'accessible', label: 'Accessible' },\n  ];\n\n  protected readonly screening = signal<Screening | null>(null);\n  protected readonly subtitle = computed(() => {\n    const s = this.screening();\n    return s ? showDate(s.date, s.time) : '';\n  });\n\n  private readonly occupied = computed(() => new Set(this.screening()?.occupiedSeats ?? []));\n  private readonly selected = computed(() => new Set(this.booking.booking()?.seats ?? []));\n\n  protected readonly selectedCount = computed(() => this.selected().size);\n  protected readonly selectedRows = computed(() => {\n    const byRow = new Map<number, string[]>();\n    for (const ticket of this.booking.tickets()) {\n      byRow.set(ticket.row, [...(byRow.get(ticket.row) ?? []), describeTicket(ticket)]);\n    }\n    return [...byRow].map(([row, seats]) => ({ row, text: seats.join(', ') }));\n  });\n\n  constructor() {\n    this.route.paramMap\n      .pipe(\n        map((params) => params.get('id') ?? ''),\n        switchMap((id) =>\n          this.api.screening(id).pipe(\n            switchMap((screening) =>\n              this.api.movie(screening.movieId).pipe(\n                catchError(() => of(null)),\n                map(() => screening),\n              ),\n            ),\n          ),\n        ),\n        takeUntilDestroyed(inject(DestroyRef)),\n      )\n      .subscribe({\n        next: (screening) => {\n          if (!this.booking.isInProgressFor(screening.id)) {\n            this.booking.start(screening.id);\n          }\n          this.screening.set(screening);\n        },\n        error: () => this.router.navigateByUrl('/'),\n      });\n  }\n\n  protected stateOf(cell: Cell): SeatState {\n    if (cell.ids.some((id) => this.occupied().has(id))) {\n      return 'unavailable';\n    }\n    if (cell.ids.every((id) => this.selected().has(id))) {\n      return 'selected';\n    }\n    return cell.accessible ? 'accessible' : 'available';\n  }\n\n  protected toggle(cell: Cell): void {\n    const state = this.stateOf(cell);\n    if (state === 'unavailable') {\n      return;\n    }\n    const current = this.booking.booking()?.seats ?? [];\n    if (state === 'selected') {\n      this.booking.setSeats(current.filter((id) => !cell.ids.includes(id)));\n    } else if (current.length + cell.ids.length > MAX_SEATS) {\n      this.toast.show(`Maximum ${MAX_SEATS} seats per booking`);\n    } else {\n      this.booking.setSeats([...current, ...cell.ids]);\n    }\n  }\n\n  protected cancel(): void {\n    this.booking.clear();\n    this.router.navigateByUrl('/');\n  }\n\n  protected next(): void {\n    const screening = this.screening();\n    if (screening && this.selectedCount() > 0) {\n      this.router.navigate(['/screenings', screening.id, 'summary']);\n    }\n  }\n}\nEOF\ncat > seat-map.html <<'EOF'\n@if (screening(); as s) {\n  <h1 data-testid=\"seat-map-title\">Choose your seats</h1>\n  <p class=\"subtitle\" data-testid=\"seat-map-subtitle\">Show Date: {{ subtitle() }}</p>\n\n  <div class=\"auditorium\">\n    <p class=\"limit\" data-testid=\"seat-limit-info\">You can reserve up to 10 seats per reservation</p>\n    <div class=\"screen\" data-testid=\"screen-indicator\">SCREEN</div>\n\n    <div class=\"seat-map\" data-testid=\"seat-map\">\n      @for (row of rows; track row.row) {\n        <div class=\"row\" data-testid=\"seat-row\" [attr.data-row]=\"row.row\">\n          <span class=\"row-label\" data-testid=\"row-label-left\" [attr.data-row]=\"row.row\">{{ row.row }}</span>\n          <div class=\"cells\">\n            @for (item of row.items; track $index) {\n              @switch (item.type) {\n                @case ('entrance') {\n                  <div class=\"entrance\"></div>\n                }\n                @case ('aisle') {\n                  <div class=\"aisle\" data-testid=\"aisle\" [attr.data-row]=\"row.row\"></div>\n                }\n                @case ('cell') {\n                  @if (item.cell.kind === 'couch') {\n                    <button\n                      type=\"button\"\n                      class=\"cell couch\"\n                      data-testid=\"couch\"\n                      [attr.data-row]=\"item.cell.row\"\n                      [attr.data-column-start]=\"item.cell.column\"\n                      [attr.data-column-end]=\"item.cell.columnEnd\"\n                      [attr.data-state]=\"stateOf(item.cell)\"\n                      (click)=\"toggle(item.cell)\"\n                    >{{ item.cell.column }}-{{ item.cell.columnEnd }}</button>\n                  } @else {\n                    <button\n                      type=\"button\"\n                      class=\"cell\"\n                      data-testid=\"seat\"\n                      [attr.data-row]=\"item.cell.row\"\n                      [attr.data-column]=\"item.cell.column\"\n                      [attr.data-state]=\"stateOf(item.cell)\"\n                      (click)=\"toggle(item.cell)\"\n                    >{{ item.cell.column }}</button>\n                  }\n                }\n              }\n            }\n          </div>\n          <span class=\"row-label\" data-testid=\"row-label-right\" [attr.data-row]=\"row.row\">{{ row.row }}</span>\n        </div>\n      }\n    </div>\n  </div>\n\n  <div class=\"legend\" data-testid=\"legend\">\n    @for (item of legend; track item.state) {\n      <div class=\"legend-item\" data-testid=\"legend-item\" [attr.data-state]=\"item.state\">\n        <span class=\"swatch\" [attr.data-state]=\"item.state\"></span>{{ item.label }}\n      </div>\n    }\n  </div>\n\n  <div class=\"selected-seats\" data-testid=\"selected-seats\">\n    <div data-testid=\"selected-seats-count\">Selected seats: {{ selectedCount() }}</div>\n    @for (row of selectedRows(); track row.row) {\n      <div data-testid=\"selected-seats-row\" [attr.data-row]=\"row.row\">Row {{ row.row }}: {{ row.text }}</div>\n    }\n  </div>\n\n  <div class=\"actions\">\n    <button mat-stroked-button type=\"button\" data-testid=\"cancel-button\" (click)=\"cancel()\">Cancel</button>\n    <button mat-flat-button type=\"button\" data-testid=\"continue-button\" (click)=\"next()\">Continue</button>\n  </div>\n}\nEOF\ncat > seat-map.scss <<'EOF'\n$seat: 34px;\n$gap: 4px;\n\n:host {\n  display: block;\n}\n\nh1 {\n  margin: 0 0 4px;\n}\n\n.subtitle {\n  margin: 0 0 16px;\n}\n\n.auditorium {\n  width: fit-content;\n  margin: 0 auto;\n}\n\n.limit {\n  text-align: center;\n  margin: 0 0 16px;\n}\n\n.screen {\n  margin: 0 0 20px;\n  padding: 6px 0;\n  text-align: center;\n  letter-spacing: 8px;\n  color: #fff;\n  background: #455a64;\n  border-radius: 4px 4px 24px 24px;\n}\n\n.seat-map {\n  display: flex;\n  flex-direction: column;\n  gap: $gap;\n}\n\n.row {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.row-label {\n  width: 24px;\n  text-align: center;\n  font-weight: 500;\n}\n\n.cells {\n  display: flex;\n  gap: $gap;\n}\n\n.entrance {\n  flex: none;\n  width: 4 * $seat + 3 * $gap;\n  height: $seat;\n}\n\n.aisle {\n  flex: none;\n  width: 2 * $seat + $gap;\n  height: $seat;\n}\n\n.cell {\n  flex: none;\n  box-sizing: border-box;\n  width: $seat;\n  height: $seat;\n  padding: 0;\n  border: 0;\n  border-radius: 6px;\n  font: 500 12px Roboto, sans-serif;\n  color: #fff;\n  cursor: pointer;\n\n  &.couch {\n    width: 2 * $seat + $gap;\n    border-radius: 12px;\n  }\n\n  &[data-state='available'] {\n    background-color: #2e7d32;\n  }\n\n  &[data-state='selected'] {\n    background-color: #f9a825;\n    color: #000;\n  }\n\n  &[data-state='unavailable'] {\n    background-color: #c62828;\n    cursor: not-allowed;\n  }\n\n  &[data-state='accessible'] {\n    background-color: #1565c0;\n  }\n}\n\n.legend {\n  display: flex;\n  justify-content: center;\n  gap: 24px;\n  margin: 24px 0;\n}\n\n.legend-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.swatch {\n  width: 20px;\n  height: 20px;\n  border-radius: 4px;\n\n  &[data-state='available'] {\n    background-color: #2e7d32;\n  }\n\n  &[data-state='selected'] {\n    background-color: #f9a825;\n  }\n\n  &[data-state='unavailable'] {\n    background-color: #c62828;\n  }\n\n  &[data-state='accessible'] {\n    background-color: #1565c0;\n  }\n}\n\n.selected-seats {\n  margin-bottom: 24px;\n}\n\n.actions {\n  display: flex;\n  gap: 12px;\n}\nEOF","description":"Write seat map component"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4010,"cache_read_input_tokens":74271,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4010},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5ad61f45-396c-48c1-821f-7f42c80deb4d","uuid":"676e13c3-e190-49e5-8ccd-67355dc55013","timestamp":"2026-11-27T16:31:00.827Z","request_id":"req_011ChTkXTVTj9UW6XXMi9SyF"}
