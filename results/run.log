{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013urs82xNsTFJQnmgMki9zc","type":"tool_result","content":"1\timport { Injectable, signal } from '@angular/core';\n2\timport { Booking, CheckoutFormValues, emptyForm } from './booking.model';\n3\t\n4\tconst STORAGE_KEY = 'cinescope.booking';\n5\t\n6\texport type ToggleResult = 'added' | 'removed' | 'limit';\n7\t\n8\t@Injectable({ providedIn: 'root' })\n9\texport class BookingService {\n10\t  private readonly _booking = signal<Booking | null>(readFromStorage());\n11\t\n12\t  readonly booking = this._booking.asReadonly();\n13\t\n14\t  /**\n15\t   * Shows the booking in progress for this screening, or starts a new, empty\n16\t   * one, discarding whatever was there before.\n17\t   */\n18\t  ensureBookingFor(screeningId: number): void {\n19\t    const current = this._booking();\n20\t    if (current && !current.paid && current.screeningId === screeningId) {\n21\t      return;\n22\t    }\n23\t    this.persist({ screeningId, seats: [], form: emptyForm(), paid: false, customerEmail: null });\n24\t  }\n25\t\n26\t  isActiveFor(screeningId: number): boolean {\n27\t    const booking = this._booking();\n28\t    return !!booking && !booking.paid && booking.screeningId === screeningId && booking.seats.length > 0;\n29\t  }\n30\t\n31\t  isPaid(): boolean {\n32\t    return this._booking()?.paid ?? false;\n33\t  }\n34\t\n35\t  toggleSeats(ids: string[]): ToggleResult {\n36\t    const current = this._booking();\n37\t    if (!current) {\n38\t      return 'removed';\n39\t    }\n40\t    const allSelected = ids.every((id) => current.seats.includes(id));\n41\t    if (allSelected) {\n42\t      this.persist({ ...current, seats: current.seats.filter((id) => !ids.includes(id)) });\n43\t      return 'removed';\n44\t    }\n45\t    if (current.seats.length + ids.length > 10) {\n46\t      return 'limit';\n47\t    }\n48\t    this.persist({ ...current, seats: [...current.seats, ...ids] });\n49\t    return 'added';\n50\t  }\n51\t\n52\t  removeSeats(ids: string[]): void {\n53\t    const current = this._booking();\n54\t    if (!current) {\n55\t      return;\n56\t    }\n57\t    this.persist({ ...current, seats: current.seats.filter((id) => !ids.includes(id)) });\n58\t  }\n59\t\n60\t  updateForm(values: CheckoutFormValues): void {\n61\t    const current = this._booking();\n62\t    if (!current) {\n63\t      return;\n64\t    }\n65\t    this.persist({ ...current, form: values });\n66\t  }\n67\t\n68\t  markPaid(email: string): void {\n69\t    const current = this._booking();\n70\t    if (!current) {\n71\t      return;\n72\t    }\n73\t    this.persist({ ...current, paid: true, customerEmail: email });\n74\t  }\n75\t\n76\t  clear(): void {\n77\t    this.persist(null);\n78\t  }\n79\t\n80\t  private persist(booking: Booking | null): void {\n81\t    this._booking.set(booking);\n82\t    if (booking) {\n83\t      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(booking));\n84\t    } else {\n85\t      sessionStorage.removeItem(STORAGE_KEY);\n86\t    }\n87\t  }\n88\t}\n89\t\n90\tfunction readFromStorage(): Booking | null {\n91\t  try {\n92\t    const raw = sessionStorage.getItem(STORAGE_KEY);\n93\t    return raw ? (JSON.parse(raw) as Booking) : null;\n94\t  } catch {\n95\t    return null;\n96\t  }\n97\t}\n98\t"}]},"parent_tool_use_id":null,"session_id":"58234399-3835-4505-bb7c-af12a0e71b05","uuid":"986e3dad-fc07-4032-9bdf-f4e1a3a2079d","timestamp":"2026-10-16T08:26:12.954Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/app/core/booking.service.ts","content":"import { Injectable, signal } from '@angular/core';\nimport { Booking, CheckoutFormValues, emptyForm } from './booking.model';\n\nconst STORAGE_KEY = 'cinescope.booking';\n\nexport type ToggleResult = 'added' | 'removed' | 'limit';\n\n@Injectable({ providedIn: 'root' })\nexport class BookingService {\n  private readonly _booking = signal<Booking | null>(readFromStorage());\n\n  readonly booking = this._booking.asReadonly();\n\n  /**\n   * Shows the booking in progress for this screening, or starts a new, empty\n   * one, discarding whatever was there before.\n   */\n  ensureBookingFor(screeningId: number): void {\n    const current = this._booking();\n    if (current && !current.paid && current.screeningId === screeningId) {\n      return;\n    }\n    this.persist({ screeningId, seats: [], form: emptyForm(), paid: false, customerEmail: null });\n  }\n\n  isActiveFor(screeningId: number): boolean {\n    const booking = this._booking();\n    return !!booking && !booking.paid && booking.screeningId === screeningId && booking.seats.length > 0;\n  }\n\n  isPaid(): boolean {\n    return this._booking()?.paid ?? false;\n  }\n\n  toggleSeats(ids: string[]): ToggleResult {\n    const current = this._booking();\n    if (!current) {\n      return 'removed';\n    }\n    const allSelected = ids.every((id) => current.seats.includes(id));\n    if (allSelected) {\n      this.persist({ ...current, seats: current.seats.filter((id) => !ids.includes(id)) });\n      return 'removed';\n    }\n    if (current.seats.length + ids.length > 10) {\n      return 'limit';\n    }\n    this.persist({ ...current, seats: [...current.seats, ...ids] });\n    return 'added';\n  }\n\n  removeSeats(ids: string[]): void {\n    const current = this._booking();\n    if (!current) {\n      return;\n    }\n    this.persist({ ...current, seats: current.seats.filter((id) => !ids.includes(id)) });\n  }\n\n  updateForm(values: CheckoutFormValues): void {\n    const current = this._booking();\n    if (!current) {\n      return;\n    }\n    this.persist({ ...current, form: values });\n  }\n\n  markPaid(email: string): void {\n    const current = this._booking();\n    if (!current) {\n      return;\n    }\n    this.persist({ ...current, paid: true, customerEmail: email });\n  }\n\n  clear(): void {\n    this.persist(null);\n  }\n\n  private persist(booking: Booking | null): void {\n    this._booking.set(booking);\n    if (booking) {\n      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(booking));\n    } else {\n      sessionStorage.removeItem(STORAGE_KEY);\n    }\n  }\n}\n\nfunction readFromStorage(): Booking | null {\n  try {\n    const raw = sessionStorage.getItem(STORAGE_KEY);\n    return raw ? (JSON.parse(raw) as Booking) : null;\n  } catch {\n    return null;\n  }\n}\n","numLines":98,"startLine":1,"totalLines":98}}}
