l: boolean;\n  phone: boolean;\n  terms: boolean;\n}\n\nconst INITIAL_TOUCHED: Touched = {\n  firstName: false,\n  lastName: false,\n  email: false,\n  confirmEmail: false,\n  phone: false,\n  terms: false,\n};\n\nexport function CheckoutPage() {\n  const { id } = useParams<{ id: string }>();\n  const screeningId = Number(id);\n  const navigate = useNavigate();\n  const { booking, setFormField, markPaid } = useBooking();\n  const { showToast } = useToast();\n\n  const allowed = useBookingGuard(\n    () => !!booking && !booking.paid && booking.screeningId === screeningId && booking.seats.length > 0,\n  );\n\n  const [touched, setTouched] = useState<Touched>(INITIAL_TOUCHED);\n  const [submitting, setSubmitting] = useState(false);\n\n  const units = useMemo(() => unitsFromSeats(booking?.seats ?? []), [booking]);\n  const total = useMemo(() => units.reduce((sum, unit) => sum + unitPrice(unit), 0), [units]);\n\n  if (!allowed) {\n    return <Navigate to=\"/\" replace />;\n  }\n\n  if (!booking) {\n    return null;\n  }\n\n  const values = booking.formValues;\n\n  const setField = <K extends keyof CheckoutFormValues>(key: K, value: CheckoutFormValues[K]) => {\n    setFormField(key, value);\n  };\n\n  const errors = {\n    firstName: validateFirstName(values.firstName),\n    lastName: validateLastName(values.lastName),\n    email: validateEmail(values.email),\n    confirmEmail: validateConfirmEmail(values.confirmEmail, values.email),\n    phone: validatePhone(values.phone),\n    terms: validateTerms(values.termsAccepted),\n  };\n\n  const markTouched = (field: keyof Touched) => () => setTouched((prev) => ({ ...prev, [field]: true }));\n\n  const handlePay = () => {\n    if (submitting) return;\n\n    const hasErrors = Object.values(errors).some((message) => message !== null);\n    if (hasErrors) {\n      setTouched({\n        firstName: true,\n        lastName: true,\n        email: true,\n        confirmEmail: true,\n        phone: true,\n        terms: true,\n      });\n      showToast('The form contains errors');\n      return;\n    }\n\n    setSubmitting(true);\n    const seats = units.flatMap(unitIds);\n    createReservation({\n      screeningId,\n      seats,\n      customer: {\n        firstName: values.firstName,\n        lastName: values.lastName,\n        email: values.email,\n        phone: values.phone,\n      },\n      totalPrice: total,\n    })\n      .then(() => {\n        markPaid(values.email);\n        navigate('/confirmation');\n      })\n      .catch(() => {\n        setSubmitting(false);\n        showToast('Payment failed. Please try again.');\n      });\n  };\n\n  return (\n    <div className={styles.page}>\n      <Typography variant=\"h4\" data-testid=\"checkout-title\">\n        Your details\n      </Typography>\n\n      <div className={styles.field}>\n        <TextField\n          fullWidth\n          label=\"First name *\"\n          data-testid=\"first-name-input\"\n          slotProps={{ inputLabel: { 'data-testid': 'first-name-label' } as any }}\n          value={values.firstName}\n          onChange={(e) => setField('firstName', e.target.value)}\n          onBlur={markTouched('firstName')}\n          error={touched.firstName && !!errors.firstName}\n        />\n        {touched.firstName && errors.firstName && (\n          <FormHelperText data-testid=\"first-name-error\" error>\n            {errors.firstName}\n          </FormHelperText>\n        )}\n      </div>\n\n      <div className={styles.field}>\n        <TextField\n          fullWidth\n          label=\"Last name *\"\n          data-testid=\"last-name-input\"\n          slotProps={{ inputLabel: { 'data-testid': 'last-name-label' } as any }}\n          value={values.lastName}\n          onChange={(e) => setField('lastName', e.target.value)}\n          onBlur={markTouched('lastName')}\n          error={touched.lastName && !!errors.lastName}\n        />\n        {touched.lastName && errors.lastName && (\n          <FormHelperText data-testid=\"last-name-error\" error>\n            {errors.lastName}\n          </FormHelperText>\n        )}\n      </div>\n\n      <div className={styles.field}>\n        <TextField\n          fullWidth\n          label=\"Email *\"\n          data-testid=\"email-input\"\n          slotProps={{ inputLabel: { 'data-testid': 'email-label' } as any }}\n          value={values.email}\n          onChange={(e) => setField('email', e.target.value)}\n          onBlur={markTouched('email')}\n          error={touched.email && !!errors.email}\n        />\n        {touched.email && errors.email && (\n          <FormHelperText data-testid=\"email-error\" error>\n            {errors.email}\n          </FormHelperText>\n        )}\n      </div>\n\n      <div className={styles.field}>\n        <TextField\n          fullWidth\n          label=\"Confirm email *\"\n          data-testid=\"confirm-email-input\"\n          slotProps={{ inputLabel: { 'data-testid': 'confirm-email-label' } as any }}\n          value={values.confirmEmail}\n          onChange={(e) => setField('confirmEmail', e.target.value)}\n          onBlur={markTouched('confirmEmail')}\n          error={touched.confirmEmail && !!errors.confirmEmail}\n        />\n        {touched.confirmEmail && errors.confirmEmail && (\n          <FormHelperText data-testid=\"confirm-email-error\" error>\n            {errors.confirmEmail}\n          </FormHelperText>\n        )}\n      </div>\n\n      <div className={styles.field}>\n        <TextField\n          fullWidth\n          label=\"Phone number\"\n          data-testid=\"phone-input\"\n          slotProps={{ inputLabel: { 'data-testid': 'phone-label' } as any }}\n          value={values.phone}\n          onChange={(e) => setField('phone', e.target.value)}\n          onBlur={markTouched('phone')}\n          error={touched.phone && !!errors.phone}\n        />\n        {touched.phone && errors.phone && (\n          <FormHelperText data-testid=\"phone-error\" error>\n            {errors.phone}\n          </FormHelperText>\n        )}\n      </div>\n\n      <div className={styles.field}>\n        <FormControlLabel\n          data-testid=\"terms-label\"\n          control={\n            <Checkbox\n              data-testid=\"terms-checkbox\"\n              checked={values.termsAccepted}\n              onChange={(e) => {\n                setField('termsAccepted', e.target.checked);\n                setTouched((prev) => ({ ...prev, terms: true }));\n              }}\n            />\n          }\n          label=\"I accept the terms and conditions *\"\n        />\n        {touched.terms && errors.terms && (\n          <FormHelperText data-testid=\"terms-error\" error>\n            {errors.terms}\n          </FormHelperText>\n        )}\n      </div>\n\n      <div className={styles.actions}>\n        <Button\n          data-testid=\"checkout-back-button\"\n          variant=\"outlined\"\n          onClick={() => navigate(`/screenings/${screeningId}/summary`)}\n        >\n          Back\n        </Button>\n        <Button data-testid=\"pay-button\" variant=\"contained\" disabled={submitting} onClick={handlePay}>\n          {submitting ? 'Processing…' : `Pay ${formatPrice(total)}`}\n        </Button>\n      </div>\n    </div>\n  );\n}\n","structuredPatch":[{"oldStart":32,"oldLines":6,"newStart":32,"newLines":10,"lines":["   terms: boolean;"," }"," ","+function labelSlotProps(testId: string): InputLabelProps {","+  return { 'data-testid': testId } as InputLabelProps;","+}","+"," const INITIAL_TOUCHED: Touched = {","   firstName: false,","   lastName: false,"]}],"userModified":false,"replaceAll":false}}
