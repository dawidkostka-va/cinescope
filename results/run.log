id=\"couch\"\n                [attr.data-row]=\"item.row\"\n                [attr.data-column-start]=\"item.startColumn\"\n                [attr.data-column-end]=\"item.endColumn\"\n                [attr.data-state]=\"item.state\"\n                [disabled]=\"item.state === 'unavailable'\"\n              >{{ item.startColumn }}-{{ item.endColumn }}</button>\n            } @else if (item.kind === 'aisle') {\n              <div class=\"aisle\" data-testid=\"aisle\" [attr.data-row]=\"item.row\"></div>\n            } @else {\n              <div class=\"entrance\"></div>\n            }\n          }\n          <span class=\"row-label\" data-testid=\"row-label-right\" [attr.data-row]=\"row.row\">{{ row.row }}</span>\n        </div>\n      }\n    </div>\n  </main>\n}\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":4,"lines":["-@if (screening(); as current) {","+@if (screening()) {","   <main class=\"page\">","     <h1 data-testid=\"seat-map-title\">Choose your seats</h1>","     <p class=\"subtitle\" data-testid=\"seat-map-subtitle\">Show Date: {{ showDate() }}</p>"]}],"userModified":false,"replaceAll":false}}
