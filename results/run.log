  @if (cards().length > 0) {\n        <section class=\"movie-list\" data-testid=\"movie-list\">\n          @for (card of cards(); track card.movie.id) {\n            <article class=\"movie-card\" data-testid=\"movie-card\" [attr.data-movie-id]=\"card.movie.id\">\n              <h2 data-testid=\"movie-title\">{{ card.movie.title }}</h2>\n              <p class=\"meta\">\n                <span data-testid=\"movie-genre\">{{ card.movie.genre }}</span>\n                <span data-testid=\"movie-runtime\">{{ card.movie.runtimeMinutes }} min</span>\n                <span data-testid=\"movie-format\">{{ card.movie.format }}</span>\n              </p>\n              <div class=\"screenings\">\n                @for (screening of card.screenings; track screening.id) {\n                  <button\n                    mat-stroked-button\n                    type=\"button\"\n                    data-testid=\"screening-button\"\n                    [attr.data-screening-id]=\"screening.id\"\n                    [routerLink]=\"['/screenings', screening.id, 'seats']\"\n                  >\n                    {{ screening.time }}\n                  </button>\n                }\n              </div>\n            </article>\n          }\n        </section>\n      } @else {\n        <p class=\"status\" data-testid=\"movies-empty\">No screenings on this day</p>\n      }\n    }\n  }\n</main>\n","structuredPatch":[],"originalFile":null,"userModified":false}}
