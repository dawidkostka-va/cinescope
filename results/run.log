aryCount);\n  await evaluate(ws, `document.querySelector('[data-testid=\"continue-button\"]').click()`);\n  await sleep(700);\n  await evaluate(ws, `document.querySelector('[data-testid=\"back-button\"]').click()`);\n  await sleep(700);\n  console.log('AFTER SUMMARY BACK URL:', await evaluate(ws, 'location.pathname'));\n  console.log('AFTER SUMMARY BACK COUNT:', await evaluate(ws, `document.querySelector('[data-testid=\"selected-seats-count\"]')?.textContent`));\n\n  // forward again, confirm, fill partial checkout, back to summary, forward again -> values retained\n  await evaluate(ws, `document.querySelector('[data-testid=\"continue-button\"]').click()`);\n  await sleep(700);\n  await evaluate(ws, `document.querySelector('[data-testid=\"confirm-button\"]').click()`);\n  await sleep(700);\n  await evaluate(ws, `\n    (() => {\n      function setVal(testid, value) {\n        const el = document.querySelector('[data-testid=\"' + testid + '\"]');\n        const input = el.tagName === 'INPUT' ? el : el.querySelector('input');\n        const proto = Object.getPrototypeOf(input);\n        const setter = Object.getOwnPropertyDescriptor(proto, 'value').set;\n        setter.call(input, value);\n        input.dispatchEvent(new Event('input', { bubbles: true }));\n      }\n      setVal('first-name-input', 'Jan');\n    })()\n  `);\n  await sleep(200);\n  await evaluate(ws, `document.querySelector('[data-testid=\"checkout-back-button\"]').click()`);\n  await sleep(700);\n  console.log('AFTER CHECKOUT BACK URL:', await evaluate(ws, 'location.pathname'));\n  await evaluate(ws, `document.querySelector('[data-testid=\"confirm-button\"]').click()`);\n  await sleep(700);\n  const firstNameVal = await evaluate(ws, `\n    (() => { const el = document.querySelector('[data-testid=\"first-name-input\"]'); const input = el.tagName === 'INPUT' ? el : el.querySelector('input'); return input.value; })()\n  `);\n  console.log('FIRST NAME RETAINED:', firstNameVal);\n\n  // data-testid audit: ai