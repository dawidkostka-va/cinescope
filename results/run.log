{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011CgiCKfwqXyJ1cpaqWsiW1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KEtzKQSiirQaQcbR68ewQM","name":"Write","input":{"file_path":"/workspace/project/apps/cinescope/src/app/seat-map/seat-map.ts","content":"import { Component, computed, effect, inject, signal } from '@angular/core';\nimport { toSignal } from '@angular/core/rxjs-interop';\nimport { httpResource } from '@angular/common/http';\nimport { MatButtonModule } from '@angular/material/button';\nimport { ActivatedRoute, Router } from '@angular/router';\nimport { API_URL } from '../api';\nimport { formatShowDate } from '../date';\nimport { Movie, Screening } from '../models';\nimport { ToastService } from '../toast/toast.service';\nimport { AuditoriumRow, buildAuditorium, SeatState } from './auditorium';\nimport { describeSelection, MAX_SEATS } from './selection';\n\n@Component({\n  selector: 'app-seat-map',\n  imports: [MatButtonModule],\n  templateUrl: './seat-map.html',\n  styleUrl: './seat-map.scss',\n})\nexport class SeatMap {\n  private readonly router = inject(Router);\n  private readonly toast = inject(ToastService);\n  private readonly params = toSignal(inject(ActivatedRoute).paramMap, { requireSync: true });\n\n  private readonly screeningResource = httpResource<Screening>(\n    () => `${API_URL}/screenings/${this.params().get('id')}`,\n  );\n  private readonly movieResource = httpResource<Movie>(() => {\n    const screening = this.screeningResource.value();\n    return screening ? `${API_URL}/movies/${screening.movieId}` : undefined;\n  });\n\n  protected readonly screening = computed(() =>\n    this.movieResource.hasValue() ? this.screeningResource.value() : undefined,\n  );\n  protected readonly showDate = computed(() => {\n    const screening = this.screening();\n    return screening ? formatShowDate(screening.date, screening.time) : '';\n  });\n  protected readonly rows = computed<AuditoriumRow[]>(() =>\n    buildAuditorium(new Set(this.screening()?.occupiedSeats ?? [])),\n  );\n\n  protected readonly selected = signal<ReadonlySet<string>>(new Set());\n  protected readonly selectedCount = computed(() => this.selected().size);\n  protected readonly selectionLines = computed(() => describeSelection(this.selected()));\n\n  protected readonly legend: { state: SeatState; label: string }[] = [\n    { state: 'available', label: 'Available' },\n    { state: 'selected', label: 'Selected' },\n    { state: 'unavailable', label: 'Unavailable' },\n    { state: 'accessible', label: 'Accessible' },\n  ];\n\n  constructor() {\n    effect(() => {\n      if (this.screeningResource.error() || this.movieResource.error()) {\n        this.router.navigateByUrl('/', { replaceUrl: true });\n      }\n    });\n  }\n\n  protected stateOf(state: SeatState, ids: readonly string[]): SeatState {\n    if (state === 'unavailable') {\n      return state;\n    }\n    return ids.every((id) => this.selected().has(id)) ? 'selected' : state;\n  }\n\n  protected toggle(ids: readonly string[]): void {\n    const current = this.selected();\n    const next = new Set(current);\n    if (ids.every((id) => current.has(id))) {\n      ids.forEach((id) => next.delete(id));\n    } else if (current.size + ids.length > MAX_SEATS) {\n      this.toast.show(`Maximum ${MAX_SEATS} seats per booking`);\n      return;\n    } else {\n      ids.forEach((id) => next.add(id));\n    }\n    this.selected.set(next);\n  }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8126,"cache_read_input_tokens":112926,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8126},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2d9d3054-1f8b-48da-8bb0-b3aa9648a130","uuid":"caa4c7aa-b153-4788-9ad6-41bb984200ca","timestamp":"2026-11-04T16:22:47.355Z","request_id":"req_011CgiCKf7EETwQddb5xsxGt","wire_tool_inputs":{"toolu_01KEtzKQSiirQaQcbR68ewQM":{"file_path":"/workspace/project/apps/cinescope/src/app/seat-map/seat-map.ts","content":"import { Component, computed, effect, inject, signal } from '@angular/core';\nimport { toSignal } from '@angular/core/rxjs-interop';\nimport { httpResource } from '@angular/common/http';\nimport { MatButtonModule } from '@angular/material/button';\nimport { ActivatedRoute, Router } from '@angular/router';\nimport { API_URL } from '../api';\nimport { formatShowDate } from '../date';\nimport { Movie, Screening } from '../models';\nimport { ToastService } from '../toast/toast.service';\nimport { AuditoriumRow, buildAuditorium, SeatState } from './auditorium';\nimport { describeSelection, MAX_SEATS } from './selection';\n\n@Component({\n  selector: 'app-seat-map',\n  imports: [MatButtonModule],\n  templateUrl: './seat-map.html',\n  styleUrl: './seat-map.scss',\n})\nexport class SeatMap {\n  private readonly router = inject(Router);\n  private readonly toast = inject(ToastService);\n  private readonly params = toSignal(inject(ActivatedRoute).paramMap, { requireSync: true });\n\n  private readonly screeningResource = httpResource<Screening>(\n    () => `${API_URL}/screenings/${this.params().get('id')}`,\n  );\n  private readonly movieResource = httpResource<Movie>(() => {\n    const screening = this.screeningResource.value();\n    return screening ? `${API_URL}/movies/${screening.movieId}` : undefined;\n  });\n\n  protected readonly screening = computed(() =>\n    this.movieResource.hasValue() ? this.screeningResource.value() : undefined,\n  );\n  protected readonly showDate = computed(() => {\n    const screening = this.screening();\n    return screening ? formatShowDate(screening.date, screening.time) : '';\n  });\n  protected readonly rows = computed<AuditoriumRow[]>(() =>\n    buildAuditorium(new Set(this.screening()?.occupiedSeats ?? [])),\n  );\n\n  protected readonly selected = signal<ReadonlySet<string>>(new Set());\n  protected readonly selectedCount = computed(() => this.selected().size);\n  protected readonly selectionLines = computed(() => describeSelection(this.selected()));\n\n  protected readonly legend: { state: SeatState; label: string }[] = [\n    { state: 'available', label: 'Available' },\n    { state: 'selected', label: 'Selected' },\n    { state: 'unavailable', label: 'Unavailable' },\n    { state: 'accessible', label: 'Accessible' },\n  ];\n\n  constructor() {\n    effect(() => {\n      if (this.screeningResource.error() || this.movieResource.error()) {\n        this.router.navigateByUrl('/', { replaceUrl: true });\n      }\n    });\n  }\n\n  protected stateOf(state: SeatState, ids: readonly string[]): SeatState {\n    if (state === 'unavailable') {\n      return state;\n    }\n    return ids.every((id) => this.selected().has(id)) ? 'selected' : state;\n  }\n\n  protected toggle(ids: readonly string[]): void {\n    const current = this.selected();\n    const next = new Set(current);\n    if (ids.every((id) => current.has(id))) {\n      ids.forEach((id) => next.delete(id));\n    } else if (current.size + ids.length > MAX_SEATS) {\n      this.toast.show(`Maximum ${MAX_SEATS} seats per booking`);\n      return;\n    } else {\n      ids.forEach((id) => next.add(id));\n    }\n    this.selected.set(next);\n  }\n}\n"}}}
