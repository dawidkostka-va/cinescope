{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019nDf6mDBqZirSrp2LYeX2C","type":"tool_result","content":"1\timport Snackbar from '@mui/material/Snackbar';\n2\timport SnackbarContent from '@mui/material/SnackbarContent';\n3\timport { createContext, ReactNode, useContext, useEffect, useState } from 'react';\n4\t\n5\tinterface ToastContextValue {\n6\t  showToast: (message: string) => void;\n7\t}\n8\t\n9\tconst ToastContext = createContext<ToastContextValue | null>(null);\n10\t\n11\tconst TOAST_DURATION_MS = 4000;\n12\t\n13\tinterface ToastState {\n14\t  id: number;\n15\t  message: string;\n16\t}\n17\t\n18\texport function ToastProvider({ children }: { children: ReactNode }) {\n19\t  const [toast, setToast] = useState<ToastState | null>(null);\n20\t\n21\t  function showToast(message: string): void {\n22\t    setToast({ id: Date.now(), message });\n23\t  }\n24\t\n25\t  useEffect(() => {\n26\t    if (!toast) return;\n27\t    const timer = setTimeout(() => setToast(null), TOAST_DURATION_MS);\n28\t    return () => clearTimeout(timer);\n29\t  }, [toast]);\n30\t\n31\t  return (\n32\t    <ToastContext.Provider value={{ showToast }}>\n33\t      {children}\n34\t      <Snackbar open={toast !== null} anchorOrigin={{ vertical: 'bottom', horizontal: 'center' }}>\n35\t        <SnackbarContent data-testid=\"toast\" message={toast?.message ?? ''} />\n36\t      </Snackbar>\n37\t    </ToastContext.Provider>\n38\t  );\n39\t}\n40\t\n41\texport function useToast(): ToastContextValue {\n42\t  const value = useContext(ToastContext);\n43\t  if (!value) {\n44\t    throw new Error('useToast must be used within a ToastProvider');\n45\t  }\n46\t  return value;\n47\t}\n48\t"}]},"parent_tool_use_id":null,"session_id":"18d24fdc-128d-4444-9721-af8b117c5cc6","uuid":"ac500ab1-c9eb-46a5-9111-52d70a3bec45","timestamp":"2026-10-20T08:17:20.598Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/toast/ToastContext.tsx","content":"import Snackbar from '@mui/material/Snackbar';\nimport SnackbarContent from '@mui/material/SnackbarContent';\nimport { createContext, ReactNode, useContext, useEffect, useState } from 'react';\n\ninterface ToastContextValue {\n  showToast: (message: string) => void;\n}\n\nconst ToastContext = createContext<ToastContextValue | null>(null);\n\nconst TOAST_DURATION_MS = 4000;\n\ninterface ToastState {\n  id: number;\n  message: string;\n}\n\nexport function ToastProvider({ children }: { children: ReactNode }) {\n  const [toast, setToast] = useState<ToastState | null>(null);\n\n  function showToast(message: string): void {\n    setToast({ id: Date.now(), message });\n  }\n\n  useEffect(() => {\n    if (!toast) return;\n    const timer = setTimeout(() => setToast(null), TOAST_DURATION_MS);\n    return () => clearTimeout(timer);\n  }, [toast]);\n\n  return (\n    <ToastContext.Provider value={{ showToast }}>\n      {children}\n      <Snackbar open={toast !== null} anchorOrigin={{ vertical: 'bottom', horizontal: 'center' }}>\n        <SnackbarContent data-testid=\"toast\" message={toast?.message ?? ''} />\n      </Snackbar>\n    </ToastContext.Provider>\n  );\n}\n\nexport function useToast(): ToastContextValue {\n  const value = useContext(ToastContext);\n  if (!value) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return value;\n}\n","numLines":48,"startLine":1,"totalLines":48}}}
