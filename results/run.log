{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KKjqzPhS4ShybJX8XgXgZc","type":"tool_result","content":"### 3.2 Toasts\n\nShort messages are shown as toasts. Only one toast is visible at a time — a new toast\nreplaces the current one. A toast stays visible for 4 seconds and then disappears.\n\n---\nimport { inject, Injectable } from '@angular/core';\nimport { MatSnackBar } from '@angular/material/snack-bar';\nimport { Toast } from './toast';\n\nconst TOAST_DURATION_MS = 4000;\n\n@Injectable({ providedIn: 'root' })\nexport class ToastService {\n  private readonly snackBar = inject(MatSnackBar);\n\n  show(message: string): void {\n    this.snackBar.openFromComponent(Toast, {\n      data: message,\n      duration: TOAST_DURATION_MS,\n      horizontalPosition: 'center',\n      verticalPosition: 'bottom',\n    });\n  }\n}\n---\nimport { Component, inject } from '@angular/core';\nimport { MAT_SNACK_BAR_DATA } from '@angular/material/snack-bar';\n\n@Component({\n  selector: 'app-toast',\n  template: '{{ message }}',\n  host: { 'data-testid': 'toast' },\n})\nexport class Toast {\n  protected readonly message = inject<string>(MAT_SNACK_BAR_DATA);\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"2d9d3054-1f8b-48da-8bb0-b3aa9648a130","uuid":"2a4a4b4a-9840-4369-81fe-73a2e3903f0a","timestamp":"2026-11-04T16:26:43.378Z","tool_use_result":{"stdout":"### 3.2 Toasts\n\nShort messages are shown as toasts. Only one toast is visible at a time — a new toast\nreplaces the current one. A toast stays visible for 4 seconds and then disappears.\n\n---\nimport { inject, Injectable } from '@angular/core';\nimport { MatSnackBar } from '@angular/material/snack-bar';\nimport { Toast } from './toast';\n\nconst TOAST_DURATION_MS = 4000;\n\n@Injectable({ providedIn: 'root' })\nexport class ToastService {\n  private readonly snackBar = inject(MatSnackBar);\n\n  show(message: string): void {\n    this.snackBar.openFromComponent(Toast, {\n      data: message,\n      duration: TOAST_DURATION_MS,\n      horizontalPosition: 'center',\n      verticalPosition: 'bottom',\n    });\n  }\n}\n---\nimport { Component, inject } from '@angular/core';\nimport { MAT_SNACK_BAR_DATA } from '@angular/material/snack-bar';\n\n@Component({\n  selector: 'app-toast',\n  template: '{{ message }}',\n  host: { 'data-testid': 'toast' },\n})\nexport class Toast {\n  protected readonly message = inject<string>(MAT_SNACK_BAR_DATA);\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
