{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgD8ZvdC6xwFrzUUWG83P","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Na1H2J55zhBAkcrDoAqZ9x","name":"Write","input":{"file_path":"/workspace/project/apps/cinescope/src/domain/dateFormat.ts","content":"import dayjs, { Dayjs } from 'dayjs';\n\nexport const ISO_DATE_FORMAT = 'YYYY-MM-DD';\n\nexport function today(): Dayjs {\n  return dayjs().startOf('day');\n}\n\nexport function toIsoDate(date: Dayjs): string {\n  return date.format(ISO_DATE_FORMAT);\n}\n\nexport function isValidIsoDate(value: string): boolean {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) {\n    return false;\n  }\n  const parsed = dayjs(value);\n  return parsed.isValid() && parsed.format(ISO_DATE_FORMAT) === value;\n}\n\nexport function isPastDate(isoDate: string): boolean {\n  return dayjs(isoDate).isBefore(today(), 'day');\n}\n\n/** Resolves a `date` search param to a selected day: a missing, invalid or past date selects today. */\nexport function resolveSelectedDate(param: string | null): string {\n  if (param && isValidIsoDate(param) && !isPastDate(param)) {\n    return param;\n  }\n  return toIsoDate(today());\n}\n\nexport function formatShowDate(isoDate: string, time: string): string {\n  return dayjs(`${isoDate}T${time}`).format('dddd D MMM HH:mm');\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":716,"cache_read_input_tokens":98542,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":716},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"18d24fdc-128d-4444-9721-af8b117c5cc6","uuid":"8dcbcf50-093e-440c-af13-17defd63942b","timestamp":"2026-10-20T07:56:20.773Z","request_id":"req_011CgD8Zv6hfjZxRjX4pYiQ6","wire_tool_inputs":{"toolu_01Na1H2J55zhBAkcrDoAqZ9x":{"file_path":"/workspace/project/apps/cinescope/src/domain/dateFormat.ts","content":"import dayjs, { Dayjs } from 'dayjs';\n\nexport const ISO_DATE_FORMAT = 'YYYY-MM-DD';\n\nexport function today(): Dayjs {\n  return dayjs().startOf('day');\n}\n\nexport function toIsoDate(date: Dayjs): string {\n  return date.format(ISO_DATE_FORMAT);\n}\n\nexport function isValidIsoDate(value: string): boolean {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value)) {\n    return false;\n  }\n  const parsed = dayjs(value);\n  return parsed.isValid() && parsed.format(ISO_DATE_FORMAT) === value;\n}\n\nexport function isPastDate(isoDate: string): boolean {\n  return dayjs(isoDate).isBefore(today(), 'day');\n}\n\n/** Resolves a `date` search param to a selected day: a missing, invalid or past date selects today. */\nexport function resolveSelectedDate(param: string | null): string {\n  if (param && isValidIsoDate(param) && !isPastDate(param)) {\n    return param;\n  }\n  return toIsoDate(today());\n}\n\nexport function formatShowDate(isoDate: string, time: string): string {\n  return dayjs(`${isoDate}T${time}`).format('dddd D MMM HH:mm');\n}\n"}}}
