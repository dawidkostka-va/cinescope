{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DXKdkWfFfGseBb16WM4pyu","type":"tool_result","content":"1\timport { ChangeEvent, FocusEvent, useEffect, useState } from 'react';\n2\timport { useNavigate, useParams } from 'react-router-dom';\n3\timport Box from '@mui/material/Box';\n4\timport Button from '@mui/material/Button';\n5\timport Checkbox from '@mui/material/Checkbox';\n6\timport FormControlLabel from '@mui/material/FormControlLabel';\n7\timport FormHelperText from '@mui/material/FormHelperText';\n8\timport Stack from '@mui/material/Stack';\n9\timport TextField from '@mui/material/TextField';\n10\timport Typography from '@mui/material/Typography';\n11\timport { Booking, CheckoutValues, loadBooking, saveBooking } from '../../booking';\n12\timport { createReservation } from '../../api';\n13\timport { getBookingItems, totalPrice } from '../../seatUtils';\n14\timport { useToast } from '../../toast/ToastProvider';\n15\timport { validate, FieldErrors } from './checkoutValidation';\n16\t\n17\ttype TouchedState = Record<keyof FieldErrors, boolean>;\n18\t\n19\tconst INITIAL_TOUCHED: TouchedState = {\n20\t  firstName: false,\n21\t  lastName: false,\n22\t  email: false,\n23\t  confirmEmail: false,\n24\t  phone: false,\n25\t  terms: false,\n26\t};\n27\t\n28\tinterface TextFieldRowProps {\n29\t  id: string;\n30\t  label: string;\n31\t  labelTestId: string;\n32\t  inputTestId: string;\n33\t  errorTestId: string;\n34\t  value: string;\n35\t  onChange: (e: ChangeEvent<HTMLInputElement>) => void;\n36\t  onBlur: (e: FocusEvent<HTMLInputElement>) => void;\n37\t  showError: boolean;\n38\t  errorMessage?: string;\n39\t}\n40\t\n41\tfunction TextFieldRow({\n42\t  id,\n43\t  label,\n44\t  labelTestId,\n45\t  inputTestId,\n46\t  errorTestId,\n47\t  value,\n48\t  onChange,\n49\t  onBlur,\n50\t  showError,\n51\t  errorMessage,\n52\t}: TextFieldRowProps) {\n53\t  return (\n54\t    <Box>\n55\t      <Typography component=\"label\" htmlFor={id} data-testid={labelTestId} sx={{ display: 'block', mb: 0.5 }}>\n56\t        {label}\n57\t      </Typography>\n58\t      <TextField\n59\t        id={id}\n60\t        fullWidth\n61\t        value={value}\n62\t        onChange={onChange}\n63\t        onBlur={onBlur}\n64\t        error={showError}\n65\t        slotProps={{ htmlInput: { 'data-testid': inputTestId } }}\n66\t      />\n67\t      {showError && (\n68\t        <FormHelperText error data-testid={errorTestId}>\n69\t          {errorMessage}\n70\t        </FormHelperText>\n71\t      )}\n72\t    </Box>\n73\t  );\n74\t}\n75\t\n76\texport function CheckoutPage() {\n77\t  const { screeningId } = useParams();\n78\t  const navigate = useNavigate();\n79\t  const showToast = useToast();\n80\t\n81\t  const [booking, setBooking] = useState<Booking | null>(null);\n82\t  const [guardFailed, setGuardFailed] = useState(false);\n83\t  const [touched, setTouched] = useState<TouchedState>(INITIAL_TOUCHED);\n84\t  const [submitting, setSubmitting] = useState(false);\n85\t\n86\t  useEffect(() => {\n87\t    const existing = loadBooking();\n88\t    if (\n89\t      !existing ||\n90\t      existing.paid ||\n91\t      existing.screeningId !== Number(screeningId) ||\n92\t      existing.seats.length === 0\n93\t    ) {\n94\t      setGuardFailed(true);\n95\t      navigate('/', { replace: true });\n96\t      return;\n97\t    }\n98\t    setBooking(existing);\n99\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n100\t  }, [screeningId]);\n101\t\n102\t  if (guardFailed || !booking) {\n103\t    return null;\n104\t  }\n105\t\n106\t  const values = booking.checkout;\n107\t  const errors = validate(values);\n108\t  const total = totalPrice(booking.seats);\n109\t\n110\t  function updateValues(partial: Partial<CheckoutValues>) {\n111\t    if (!booking) return;\n112\t    const updated = { ...booking, checkout: { ...booking.checkout, ...partial } };\n113\t    setBooking(updated);\n114\t    saveBooking(updated);\n115\t  }\n116\t\n117\t  function markTouched(field: keyof TouchedState) {\n118\t    setTouched((prev) => ({ ...prev, [field]: true }));\n119\t  }\n120\t\n121\t  function handleBack() {\n122\t    navigate(`/screenings/${screeningId}/summary`);\n123\t  }\n124\t\n125\t  async function handlePay() {\n126\t    if (!booking) return;\n127\t    const currentErrors = validate(booking.checkout);\n128\t    if (Object.keys(currentErrors).length > 0) {\n129\t      setTouched({\n130\t        firstName: true,\n131\t        lastName: true,\n132\t        email: true,\n133\t        confirmEmail: true,\n134\t        phone: true,\n135\t        terms: true,\n136\t      });\n137\t      showToast('The form contains errors');\n138\t      return;\n139\t    }\n140\t\n141\t    setSubmitting(true);\n142\t    try {\n143\t      const items = getBookingItems(booking.seats);\n144\t      const seats = items.flatMap((item) => item.ids);\n145\t      await createReservation({\n146\t        screeningId: Number(screeningId),\n147\t        seats,\n148\t        customer: {\n149\t          firstName: booking.checkout.firstName,\n150\t          lastName: booking.checkout.lastName,\n151\t          email: booking.checkout.email,\n152\t          phone: booking.checkout.phone,\n153\t        },\n154\t        totalPrice: total,\n155\t      });\n156\t      const updated = { ...booking, paid: true, customerEmail: booking.checkout.email };\n157\t      saveBooking(updated);\n158\t      navigate('/confirmation');\n159\t    } catch {\n160\t      setSubmitting(false);\n161\t      showToast('Payment failed. Please try again.');\n162\t    }\n163\t  }\n164\t\n165\t  const fieldError = (field: keyof FieldErrors) => touched[field] && Boolean(errors[field]);\n166\t\n167\t  return (\n168\t    <Box sx={{ maxWidth: 520, mx: 'auto', p: 3 }}>\n169\t      <Typography variant=\"h4\" data-testid=\"checkout-title\" gutterBottom>\n170\t        Your details\n171\t      </Typography>\n172\t\n173\t      <Stack spacing={2}>\n174\t        <TextFieldRow\n175\t          id=\"first-name\"\n176\t          label=\"First name *\"\n177\t          labelTestId=\"first-name-label\"\n178\t          inputTestId=\"first-name-input\"\n179\t          errorTestId=\"first-name-error\"\n180\t          value={values.firstName}\n181\t          onChange={(e) => updateValues({ firstName: e.target.value })}\n182\t          onBlur={() => markTouched('firstName')}\n183\t          showError={fieldError('firstName')}\n184\t          errorMessage={errors.firstName}\n185\t        />\n186\t\n187\t        <TextFieldRow\n188\t          id=\"last-name\"\n189\t          label=\"Last name *\"\n190\t          labelTestId=\"last-name-label\"\n191\t          inputTestId=\"last-name-input\"\n192\t          errorTestId=\"last-name-error\"\n193\t          value={values.lastName}\n194\t          onChange={(e) => updateValues({ lastName: e.target.value })}\n195\t          onBlur={() => markTouched('lastName')}\n196\t          showError={fieldError('lastName')}\n197\t          errorMessage={errors.lastName}\n198\t        />\n199\t\n200\t        <TextFieldRow\n201\t          id=\"email\"\n202\t          label=\"Email *\"\n203\t          labelTestId=\"email-label\"\n204\t          inputTestId=\"email-input\"\n205\t          errorTestId=\"email-error\"\n206\t          value={values.email}\n207\t          onChange={(e) => updateValues({ email: e.target.value })}\n208\t          onBlur={() => markTouched('email')}\n209\t          showError={fieldError('email')}\n210\t          errorMessage={errors.email}\n211\t        />\n212\t\n213\t        <TextFieldRow\n214\t          id=\"confirm-email\"\n215\t          label=\"Confirm email *\"\n216\t          labelTestId=\"confirm-email-label\"\n217\t          inputTestId=\"confirm-email-input\"\n218\t          errorTestId=\"confirm-email-error\"\n219\t          value={values.confirmEmail}\n220\t          onChange={(e) => updateValues({ confirmEmail: e.target.value })}\n221\t          onBlur={() => markTouched('confirmEmail')}\n222\t          showError={fieldError('confirmEmail')}\n223\t          errorMessage={errors.confirmEmail}\n224\t        />\n225\t\n226\t        <TextFieldRow\n227\t          id=\"phone\"\n228\t          label=\"Phone number\"\n229\t          labelTestId=\"phone-label\"\n230\t          inputTestId=\"phone-input\"\n231\t          errorTestId=\"phone-error\"\n232\t          value={values.phone}\n233\t          onChange={(e) => updateValues({ phone: e.target.value })}\n234\t          onBlur={() => markTouched('phone')}\n235\t          showError={fieldError('phone')}\n236\t          errorMessage={errors.phone}\n237\t        />\n238\t\n239\t        <Box>\n240\t          <FormControlLabel\n241\t            control={\n242\t              <Checkbox\n243\t                data-testid=\"terms-checkbox\"\n244\t                checked={values.acceptTerms}\n245\t                onChange={(e) => {\n246\t                  updateValues({ acceptTerms: e.target.checked });\n247\t                  markTouched('terms');\n248\t                }}\n249\t              />\n250\t            }\n251\t            label={<span data-testid=\"terms-label\">I accept the terms and conditions *</span>}\n252\t          />\n253\t          {fieldError('terms') && (\n254\t            <FormHelperText error data-testid=\"terms-error\">\n255\t              {errors.terms}\n256\t            </FormHelperText>\n257\t          )}\n258\t        </Box>\n259\t      </Stack>\n260\t\n261\t      <Stack direction=\"row\" spacing={2} sx={{ mt: 3 }}>\n262\t        <Button data-testid=\"checkout-back-button\" variant=\"outlined\" onClick={handleBack}>\n263\t          Back\n264\t        </Button>\n265\t        <Button data-testid=\"pay-button\" variant=\"contained\" disabled={submitting} onClick={handlePay}>\n266\t          {submitting ? 'Processing…' : `Pay ${total.toFixed(2)} PLN`}\n267\t        </Button>\n268\t      </Stack>\n269\t    </Box>\n270\t  );\n271\t}\n272\t"}]},"parent_tool_use_id":"toolu_019qhPutAQhu9gtYed3XbehR","session_id":"3632df4e-836a-