oking {\n    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(booking));\n    return booking;\n  }\n\n  clear(): void {\n    sessionStorage.removeItem(STORAGE_KEY);\n  }\n}\n\nexport const bookingInProgress: CanActivateFn = (route) => {\n  const booking = inject(BookingService).current();\n  const screeningId = Number(route.paramMap.get('id'));\n  if (booking?.screeningId === screeningId && booking.seats.length > 0) {\n    return true;\n  }\n  return inject(Router).createUrlTree(['/']);\n};\nEOF\ncat app.routes.ts; cat api.ts | head -3","description":"Tick ticket 03, add booking helpers, pricing and booking service"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1410,"cache_read_input_tokens":141384,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1410},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5dce9b95-c95f-42d9-ad14-7fe0b1984c4e","uuid":"ec96bd74-26af-4f5f-9221-c1fc10b23b64","timestamp":"2026-11-03T15:49:47.658Z","request_id":"req_011CggFwAhHT2FQK4RQ6jeqm","wire_tool_inputs":{"toolu_01SGpvb9TXW4Ccaos3psZouq":{"command":"cd /workspace/project/spec/tickets && sed -i 's/- \\[ \\] AC-/- [x] AC-/; s/\\*\\*Status:\\*\\* ready/**Status:** done/' 03-seat-selection.md && grep -c '\\[x\\]' 03-seat-selection.md && cd /workspace/project/apps/cinescope/src/app && cat >> seat-selection/auditorium.ts <<'EOF'\n\nexport function isSeatLike(cell: Cell): boolean {\n  return cell.kind === 'seat' || cell.kind === 'couch';\n}\n\nexport function bookedCells(seats: readonly string[]): Cell[] {\n  const picked = new Set(seats);\n  return AUDITORIUM.flatMap((row) => row.cells).filter(\n    (cell) => isSeatLike(cell) && cell.ids.every((id) => picked.has(id)),\n  );\n}\nEOF\nmkdir -p booking && cat > booking/pricing.ts <<'EOF'\nimport { Cell } from '../seat-selection/auditorium';\n\nexport function priceOf(cell: Cell): number {\n  if (cell.kind === 'couch') {\n    return 89;\n  }\n  if (cell.row <= 5) {\n    return 25;\n  }\n  if (cell.row <= 10) {\n    return 32;\n  }\n  return 39;\n}\n\nexport function formatPrice(amount: number): string {\n  return `${amount.toFixed(2)} PLN`;\n}\nEOF\ncat > booking/booking.ts <<'EOF'\nimport { Injectable, inject } from '@angular/core';\nimport { CanActivateFn, Router } from '@angular/router';\n\nconst STORAGE_KEY = 'cinescope.booking';\n\nexport interface Booking {\n  screeningId: number;\n  seats: string[];\n}\n\n@Injectable({ providedIn: 'root' })\nexport class BookingService {\n  current(): Booking | null {\n    const raw = sessionStorage.getItem(STORAGE_KEY);\n    return raw ? (JSON.parse(raw) as Booking) : null;\n  }\n\n  startOrResume(screeningId: number): Booking {\n    const existing = this.current();\n    return existing?.screeningId === screeningId ? existing : this.save({ screeningId, seats: [] });\n  }\n\n  save(booking: Booking): Booking {\n    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(booking));\n    return booking;\n  }\n\n  clear(): void {\n    sessionStorage.removeItem(STORAGE_KEY);\n  }\n}\n\nexport const bookingInProgress: CanActivateFn = (route) => {\n  const booking = inject(BookingService).current();\n  const screeningId = Number(route.paramMap.get('id'));\n  if (booking?.screeningId === screeningId && booking.seats.length > 0) {\n    return true;\n  }\n  return inject(Router).createUrlTree(['/']);\n};\nEOF\ncat app.routes.ts; cat api.ts | head -3","description":"Tick ticket 03, add booking helpers, pricing and booking service"}}}
