{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cg5kxQkAAcojT2sMZkBVZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PGWZ5hyfni2bDoJetjTqJ5","name":"Write","input":{"file_path":"/workspace/project/apps/cinescope/src/pages/Summary/Summary.tsx","content":"import { useEffect, useState } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport List from '@mui/material/List';\nimport ListItem from '@mui/material/ListItem';\nimport { fetchMovie, fetchScreening } from '../../lib/api';\nimport { Movie, Screening } from '../../lib/types';\nimport { useBooking } from '../../lib/bookingContext';\nimport { formatPrice, toSelectionUnits } from '../../lib/seats';\n\nexport function Summary() {\n  const { id } = useParams<{ id: string }>();\n  const screeningId = Number(id);\n  const navigate = useNavigate();\n  const { booking, removeSeats } = useBooking();\n\n  const [screening, setScreening] = useState<Screening | null>(null);\n  const [movie, setMovie] = useState<Movie | null>(null);\n  const [failed, setFailed] = useState(false);\n\n  const bookingIsValid =\n    !!booking &&\n    !booking.paid &&\n    booking.screeningId === screeningId &&\n    booking.seats.length > 0;\n\n  useEffect(() => {\n    if (!bookingIsValid) {\n      navigate('/', { replace: true });\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  useEffect(() => {\n    if (!bookingIsValid) return;\n    let cancelled = false;\n    fetchScreening(screeningId)\n      .then((loadedScreening) =>\n        fetchMovie(loadedScreening.movieId).then((loadedMovie) => {\n          if (cancelled) return;\n          setScreening(loadedScreening);\n          setMovie(loadedMovie);\n        }),\n      )\n      .catch(() => {\n        if (!cancelled) setFailed(true);\n      });\n    return () => {\n      cancelled = true;\n    };\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [screeningId]);\n\n  useEffect(() => {\n    if (failed) {\n      navigate('/', { replace: true });\n    }\n  }, [failed, navigate]);\n\n  if (!bookingIsValid || !booking || !screening || !movie) {\n    return null;\n  }\n\n  const units = toSelectionUnits(booking.seats);\n  const total = units.reduce((sum, unit) => sum + unit.price, 0);\n\n  const handleRemove = (seatIds: string[]) => {\n    removeSeats(seatIds);\n    if (booking.seats.length - seatIds.length <= 0) {\n      navigate(`/screenings/${screening.id}/seats`);\n    }\n  };\n\n  return (\n    <Box sx={{ maxWidth: 800, mx: 'auto', p: 3 }}>\n      <Typography data-testid=\"summary-title\" variant=\"h5\" sx={{ mb: 2 }}>\n        Your tickets\n      </Typography>\n\n      <List data-testid=\"summary-list\">\n        {units.map((unit) => {\n          const seatDescription =\n            unit.endColumn !== undefined\n              ? `Couch ${unit.startColumn}-${unit.endColumn}`\n              : `${unit.startColumn}`;\n          return (\n            <ListItem\n              key={`${unit.row}-${unit.startColumn}`}\n              data-testid=\"summary-item\"\n              sx={{ display: 'flex', justifyContent: 'space-between' }}\n            >\n              <Box>\n                <Typography data-testid=\"summary-item-title\">{movie.title}</Typography>\n                <Typography data-testid=\"summary-item-datetime\">\n                  {screening.date} {screening.time}\n                </Typography>\n                <Typography>\n                  Row <span data-testid=\"summary-item-row\">{unit.row}</span>\n                </Typography>\n                <Typography data-testid=\"summary-item-seat\">{seatDescription}</Typography>\n                <Typography data-testid=\"summary-item-price\">\n                  {formatPrice(unit.price)}\n                </Typography>\n              </Box>\n              <Button\n                data-testid=\"summary-item-remove-button\"\n                onClick={() => handleRemove(unit.seatIds)}\n              >\n                Remove\n              </Button>\n            </ListItem>\n          );\n        })}\n      </List>\n\n      <Typography data-testid=\"summary-total\" variant=\"h6\" sx={{ my: 2 }}>\n        Total: {total.toFixed(2)} PLN\n      </Typography>\n\n      <Stack direction=\"row\" spacing={2}>\n        <Button\n          data-testid=\"back-button\"\n          variant=\"outlined\"\n          onClick={() => navigate(`/screenings/${screening.id}/seats`)}\n        >\n          Back\n        </Button>\n        <Button\n          data-testid=\"confirm-button\"\n          variant=\"contained\"\n          onClick={() => navigate(`/screenings/${screening.id}/checkout`)}\n        >\n          Confirm\n        </Button>\n      </Stack>\n    </Box>\n  );\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2465,"cache_read_input_tokens":102617,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2465},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"bc998d0e-1624-444d-a35c-194e1322775c","uuid":"92fea8bb-a34e-4301-8ed5-ec7d7dda8232","timestamp":"2026-10-16T10:28:57.379Z","request_id":"req_011Cg5kxQ8Sq8dxkPmund6L5","wire_tool_inputs":{"toolu_01PGWZ5hyfni2bDoJetjTqJ5":{"file_path":"/workspace/project/apps/cinescope/src/pages/Summary/Summary.tsx","content":"import { useEffect, useState } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typ