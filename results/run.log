l('/', { replaceUrl: true });\n      }\n    });\n  }\n\n  protected remove(ids: readonly string[]): void {\n    const seats = (this.bookings.booking()?.seats ?? []).filter((id) => !ids.includes(id));\n    this.bookings.setSeats(seats);\n    if (seats.length === 0) {\n      this.router.navigateByUrl(`/screenings/${this.screeningId()}/seats`);\n    }\n  }\n\n  protected back(): void {\n    this.router.navigateByUrl(`/screenings/${this.screeningId()}/seats`);\n  }\n\n  protected confirm(): void {\n    this.router.navigateByUrl(`/screenings/${this.screeningId()}/checkout`);\n  }\n\n  protected formatPrice = formatPrice;\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1157,"cache_read_input_tokens":139414,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1157},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2d9d3054-1f8b-48da-8bb0-b3aa9648a130","uuid":"91b18e6f-a6d1-432f-b249-653ff6b28319","timestamp":"2026-11-04T16:24:03.707Z","request_id":"req_011CgiCRKaQEYWEgQS2yt1Cd","wire_tool_inputs":{"toolu_01X8fhmdy9LcXb9qAGg544C3":{"file_path":"/workspace/project/apps/cinescope/src/app/summary/summary.ts","content":"import { Component, computed, effect, inject } from '@angular/core';\nimport { toSignal } from '@angular/core/rxjs-interop';\nimport { MatButtonModule } from '@angular/material/button';\nimport { ActivatedRoute, Router } from '@angular/router';\nimport { map } from 'rxjs';\nimport { BookingService } from '../booking/booking.service';\nimport { formatPrice, unitPrice } from '../seat-map/pricing';\nimport { selectionUnits } from '../seat-map/selection';\nimport { loadScreeningWithMovie } from '../screening/screening-data';\n\n@Component({\n  selector: 'app-summary',\n  imports: [MatButtonModule],\n  