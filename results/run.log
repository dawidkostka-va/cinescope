 for (let start = from; start <= to; start += 2) {\n      cells.push({ kind: 'couch', row, start, end: start + 1 });\n    }\n    return cells;\n  }\n  for (let column = from; column <= to; column++) {\n    const accessible = row === ACCESSIBLE_ROW && column >= ACCESSIBLE_FROM && column <= ACCESSIBLE_TO;\n    cells.push({ kind: 'seat', row, column, accessible });\n  }\n  return cells;\n}\n\nexport const AUDITORIUM: AuditoriumRow[] = Array.from({ length: ROW_COUNT }, (_, index) => {\n  const row = index + 1;\n  return {\n    row,\n    left: row > LAST_ROW_WITHOUT_LEFT_BLOCK ? cellsBetween(row, 1, 4) : null,\n    middle: cellsBetween(row, 5, 20),\n    right: cellsBetween(row, 21, 24),\n  };\n});\n","structuredPatch":[{"oldStart":38,"oldLines":6,"newStart":38,"newLines":18,"lines":["     : [seatId(cell.row, cell.start), seatId(cell.row, cell.end)];"," }"," ","+export function cellStartColumn(cell: Cell): number {","+  return cell.kind === 'seat' ? cell.column : cell.start;","+}","+","+export function cellLabel(cell: Cell): string {","+  return cell.kind === 'seat' ? `${cell.column}` : `${cell.start}-${cell.end}`;","+}","+","+export function compareCells(a: Cell, b: Cell): number {","+  return a.row - b.row || cellStartColumn(a) - cellStartColumn(b);","+}","+"," function cellsBetween(row: number, from: number, to: number): Cell[] {","   const cells: Cell[] = [];","   if (row === COUCH_ROW) {"]}],"userModified":false,"replaceAll":false}}
