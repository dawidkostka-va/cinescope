\t  const { booking, updateForm, markPaid } = useBooking();\n51\t  const { showToast } = useToast();\n52\t  const [touched, setTouched] = useState<Touched>(INITIAL_TOUCHED);\n53\t  const [submitting, setSubmitting] = useState(false);\n54\t\n55\t  useEffect(() => {\n56\t    if (!isBookingUsable(booking, screeningId)) {\n57\t      navigate('/', { replace: true });\n58\t    }\n59\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n60\t  }, []);\n61\t\n62\t  if (!booking || !isBookingUsable(booking, screeningId)) {\n63\t    return null;\n64\t  }\n65\t\n66\t  const form = booking.form;\n67\t  const errors = validateCheckout(form);\n68\t  const items = buildBookedItems(booking.seats);\n69\t  const total = items.reduce((sum, item) => sum + item.price, 0);\n70\t\n71\t  function handleChange(field: TextFieldKey, value: string): void {\n72\t    updateForm({ [field]: value } as Partial<BookingForm>);\n73\t  }\n74\t\n75\t  function handleBlur(field: TextFieldKey | 'terms'): void {\n76\t    setTouched((t) => ({ ...t, [field]: true }));\n77\t  }\n78\t\n79\t  async function handlePay(): Promise<void> {\n80\t    if (hasCheckoutErrors(errors)) {\n81\t      setTouched({ firstName: true, lastName: true, email: true, confirmEmail: true, phone: true, terms: true });\n82\t      showToast('The form contains errors');\n83\t      return;\n84\t    }\n85\t    setSubmitting(true);\n86\t    try {\n87\t      await createReservation({\n88\t        screeningId,\n89\t        seats: items.flatMap((item) => item.ids),\n90\t        customer: { firstName: form.firstName, lastName: form.lastName, email: form.email, phone: form.phone },\n91\t        totalPrice: total,\n92\t      });\n93\t      markPaid(form.email);\n94\t      navigate('/confirmation');\n95\t    } catch {\n96\t      setSubmitting(false);\n97\t      showToast('Payment failed. Please try again.');\n98\t    }\n99\t  }\n100\t\n101\t  function renderField(field: TextFieldKey) {\n102\t    const testId = FIELD_TEST_ID[field];\n103\t    const message = touched[field] ? errors[field] : null;\n104\t    return (\n105\t      <div className={styles.field} key={field}>\n106\t        <InputLabel data-testid={`${testId}-label`} htmlFor={`${testId}-input-el`}>\n107\t          {FIELD_LABEL[field]}\n108\t        </InputLabel>\n109\t        <TextField\n110\t          id={`${testId}-input-el`}\n111\t          data-testid={`${testId}-input`}\n112\t          size=\"small\"\n113\t          value={form[field]}\n114\t          onChange={(e) => handleChange(field, e.target.value)}\n115\t          onBlur={() => handleBlur(field)}\n116\t          error={!!message}\n117\t        />\n118\t        {message && (\n119\t          <FormHelperText error data-testid={`${testId}-error`}>\n120\t            {message}\n121\t          </FormHelperText>\n122\t        )}\n123\t      </div>\n124\t    );\n125\t  }\n126\t\n127\t  const termsMessage = touched.terms ? errors.terms : null;\n128\t\n129\t  return (\n130\t    <div className={styles.page}>\n131\t      <h1 data-testid=\"checkout-title\">Your details</h1>\n132\t\n133\t      {renderField('firstName')}\n134\t      {renderField('lastName')}\n135\t      {renderField('email')}\n136\t      {renderField('confirmEmail')}\n137\t      {renderField('phone')}\n138\t\n139\t      <div className={styles.checkboxRow}>\n140\t        <FormControlLabel\n141\t          data-testid=\"terms-label\"\n142\t          control={\n143\t            <Checkbox\n144\t              data-testid=\"terms-checkbox\"\n145\t              checked={form.terms}\n146\t              onChange={(e) => {\n147\t                updateForm({ terms: e.target.checked });\n148\t                handleBlur('terms');\n149\t              }}\n150\t            />\n151\t          }\n152\t          label=\"I accept the terms and conditions *\"\n153\t        />\n154\t        {termsMessage && (\n155\t          <FormHelperText error data-testid=\"terms-error\">\n156\t            {termsMessage}\n157\t          </FormHelperText>\n158\t        )}\n159\t      </div>\n160\t\n161\t      <div className={styles.actions}>\n162\t        <Button data-testid=\"checkout-back-button\" variant=\"outlined\" onClick={() => navigate(`/screenings/${screeningId}/summary`)}>\n163\t          Back\n164\t        </Button>\n165\t        <Button data-testid=\"pay-button\" variant=\"contained\" disabled={submitting} onClick={handlePay}>\n166\t          {submitting ? 'Processing…' : `Pay ${total.toFixed(2)} PLN`}\n167\t        </Button>\n168\t      </div>\n169\t    </div>\n170\t  );\n171\t}\n172\t"}]},"parent_tool_use_id":null,"session_id":"18d24fdc-128d-4444-9721-af8b117c5cc6","uuid":"2780aa51-007d-4eb3-b83d-3808b556f614","timestamp":"2026-10-20T08:14:10.187Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/pages/checkout/CheckoutPage.tsx","content":"import Button from '@mui/material/Button';\nimport Checkbox from '@mui/material/Checkbox';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormHelperText from '@mui/material/FormHelperText';\nimport InputLabel from '@mui/material/InputLabel';\nimport TextField from '@mui/material/TextField';\nimport { useEffect, useState } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport { createReservation } from '../../api/client';\nimport { useBooking } from '../../booking/BookingContext';\nimport { BookingForm, isBookingUsable } from '../../booking/types';\nimport { buildBookedItems } from '../../domain/seatLayout';\nimport { hasCheckoutErrors, validateCheckout } from '../../domain/validation';\nimport { useToast } from '../../toast/ToastContext';\nimport styles from './CheckoutPage.module.scss';\n\ntype TextFieldKey = 'firstName' | 'lastName' | 'email' | 'confirmEmail' | 'phone';\n\nconst FIELD_TEST_ID: Record<TextFieldKey, string> = {\n  firstName: 'first-name',\n  lastName: 'last-name',\n  email: 'email',\n  confirmEmail: 'confirm-email',\n  phone: 'phone',\n};\n\nconst FIELD_LABEL: Record<TextFieldKey, string> = {\n  firstName: 'First name *',\n  lastName: 'Last name *',\n  email: 'Email *',\n  confirmEmail: 'Confirm email *',\n  phone: 'Phone number',\n};\n\ntype Touched = Record<TextFieldKey | 'terms', boolean>;\n\nconst INITIAL_TOUCHED: Touched = {\n  firstName: false,\n  lastName: false,\n  email: false,\n  confirmEmail: false,\n  phone: false,\n  terms: false,\n};\n\nexport function CheckoutPage() {\n  const { id } = useParams();\n  const screeningId = Number(id);\n  const navigate = useNavigate();\n  const { booking, updateForm, markPaid } = useBooking();\n  const { showToast } = useToast();\n  const [touched, setTouched] = useState<Touched>(INITIAL_TOUCHED);\n  const [submitting, setSubmitting] = useState(false);\n\n  useEffect(() => {\n    if (!isBookingUsable(booking, screeningId)) {\n      navigate('/', { replace: true });\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  if (!booking || !isBookingUsable(booking, screeningId)) {\n    return null;\n  }\n\n  const form = booking.form;\n  const errors = validateCheckout(form);\n  const items = buildBookedItems(booking.seats);\n  const total = items.reduce((sum, item) => sum + item.price, 0);\n\n  function handleChange(field: TextFieldKey, value: string): void {\n    updateForm({ [field]: value } as Partial<BookingForm>);\n  }\n\n  function handleBlur(field: TextFieldKey | 'terms'): void {\n    setTouched((t) => ({ ...t, [field]: true }));\n  }\n\n  async function handlePay(): Promise<void> {\n    if (hasCheckoutErrors(errors)) {\n      setTouched({ firstName: true, lastName: true, email: true, confirmEmail: true, phone: true, terms: true });\n      showToast('The form contains errors');\n      return;\n    }\n    setSubmitting(true);\n    try {\n      await createReservation({\n        screeningId,\n        seats: items.flatMap((item) => item.ids),\n        customer: { firstName: form.firstName, lastName: form.lastName, email: form.email, phone: form.phone },\n        totalPrice: total,\n      });\n      markPaid(form.email);\n      navigate('/confirmation');\n    } catch {\n      setSubmitting(false);\n      showToast('Payment failed. Please try again.');\n    }\n  }\n\n  function renderField(field: TextFieldKey) {\n    const testId = FIELD_TEST_ID[field];\n    const message = touched[field] ? errors[field] : null;\n    return (\n      <div className={styles.field} key={field}>\n        <InputLabel data-testid={`${testId}-label`} htmlFor={`${testId}-input-el`}>\n          {FIELD_LABEL[field]}\n        </InputLabel>\n        <TextField\n          id={`${testId}-input-el`}\n          data-testid={`${testId}-input`}\n          size=\"small\"\n          value={form[field]}\n          onChange={(e) => handleChange(field, e.target.value)}\n          onBlur={() => handleBlur(field)}\n          error={!!message}\n        />\n        {message && (\n          <FormHelperText error data-testid={`${testId}-error`}>\n            {message}\n          </FormHelperText>\n        )}\n      </div>\n    );\n  }\n\n  const termsMessage = touched.terms ? errors.terms : null;\n\n  return (\n    <div className={styles.page}>\n      <h1 data-testid=\"checkout-title\">Your details</h1>\n\n      {renderField('firstName')}\n      {renderField('lastName')}\n      {renderField('email')}\n      {renderField('confirmEmail')}\n      {renderField('phone')}\n\n      <div className={styles.checkboxRow}>\n        <FormControlLabel\n          data-testid=\"terms-label\"\n          control={\n            <Checkbox\n              data-testid=\"terms-checkbox\"\n              checked={form.terms}\n              onChange={(e) => {\n                updateForm({ terms: e.target.checked });\n                handleBlur('terms');\n              }}\n            />\n          }\n          label=\"I accept the terms and conditions *\"\n        />\n        {termsMessage && (\n          <FormHelperText error data-testid=\"terms-error\">\n            {termsMessage}\n          </FormHelperText>\n        )}\n      </div>\n\n      <div className={styles.actions}>\n        <Button data-testid=\"checkout-back-button\" variant=\"outlined\" onClick={() => navigate(`/screenings/${screeningId}/summary`)}>\n          Back\n        </Button>\n        <Button data-testid=\"pay-button\" variant=\"contained\" disabled={submitting} onClick={handlePay}>\n          {submitting ? 'Processing…' : `Pay ${total.toFixed(2)} PLN`}\n        </Button>\n      </div>\n    </div>\n  );\n}\n","numLines":172,"startLine":1,"totalLines":172}}}
