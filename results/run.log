{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U3Zs7AuAfYknrVnTj8rWQz","type":"tool_result","content":"1\timport { CSSProperties } from 'react';\n2\timport Box from '@mui/material/Box';\n3\timport Typography from '@mui/material/Typography';\n4\timport {\n5\t  COUCH_ROW,\n6\t  ROW_COUNT,\n7\t  couchState,\n8\t  couches,\n9\t  rowColumns,\n10\t  seatState,\n11\t  SeatState,\n12\t} from '../../seatUtils';\n13\timport './AuditoriumMap.scss';\n14\t\n15\tconst SEAT_WIDTH = '2.2rem';\n16\tconst AISLE_WIDTH = '4.4rem';\n17\tconst LABEL_WIDTH = '1.5rem';\n18\t\n19\tconst GRID_TEMPLATE_COLUMNS = [\n20\t  LABEL_WIDTH,\n21\t  ...Array(4).fill(SEAT_WIDTH),\n22\t  AISLE_WIDTH,\n23\t  ...Array(16).fill(SEAT_WIDTH),\n24\t  AISLE_WIDTH,\n25\t  ...Array(4).fill(SEAT_WIDTH),\n26\t  LABEL_WIDTH,\n27\t].join(' ');\n28\t\n29\tconst LABEL_LEFT_TRACK = 1;\n30\tconst AISLE_1_TRACK = 6;\n31\tconst AISLE_2_TRACK = 23;\n32\tconst LABEL_RIGHT_TRACK = 28;\n33\t\n34\tconst STATE_COLORS: Record<SeatState, string> = {\n35\t  available: '#2E7D32',\n36\t  selected: '#F9A825',\n37\t  unavailable: '#C62828',\n38\t  accessible: '#1565C0',\n39\t};\n40\t\n41\tfunction trackForColumn(column: number): number {\n42\t  if (column <= 4) return column + 1;\n43\t  if (column <= 20) return column + 2;\n44\t  return column + 3;\n45\t}\n46\t\n47\tinterface AuditoriumMapProps {\n48\t  occupiedSeats: ReadonlySet<string>;\n49\t  selectedSeats: ReadonlySet<string>;\n50\t  onToggleSeat: (row: number, column: number) => void;\n51\t  onToggleCouch: (row: number, columnStart: number, columnEnd: number) => void;\n52\t}\n53\t\n54\texport function AuditoriumMap({\n55\t  occupiedSeats,\n56\t  selectedSeats,\n57\t  onToggleSeat,\n58\t  onToggleCouch,\n59\t}: AuditoriumMapProps) {\n60\t  const rows = Array.from({ length: ROW_COUNT }, (_, i) => i + 1);\n61\t\n62\t  return (\n63\t    <Box\n64\t      data-testid=\"seat-map\"\n65\t      className=\"seat-map\"\n66\t      style={{ gridTemplateColumns: GRID_TEMPLATE_COLUMNS }}\n67\t    >\n68\t      {rows.map((row) => (\n69\t        <div key={row} data-testid=\"seat-row\" data-row={row} style={{ display: 'contents' }}>\n70\t          <div\n71\t            data-testid=\"row-label-left\"\n72\t            data-row={row}\n73\t            className=\"row-label\"\n74\t            style={{ gridColumn: LABEL_LEFT_TRACK, gridRow: row }}\n75\t          >\n76\t            {row}\n77\t          </div>\n78\t\n79\t          {row === COUCH_ROW\n80\t            ? couches().map(([columnStart, columnEnd]) => {\n81\t                const state = couchState(row, columnStart, columnEnd, occupiedSeats, selectedSeats);\n82\t                const style: CSSProperties = {\n83\t                  gridColumn: `${trackForColumn(columnStart)} / span 2`,\n84\t                  gridRow: row,\n85\t                  ['--seat-bg' as string]: STATE_COLORS[state],\n86\t                };\n87\t                return (\n88\t                  <button\n89\t                    key={`${columnStart}-${columnEnd}`}\n90\t                    type=\"button\"\n91\t                    data-testid=\"couch\"\n92\t                    data-row={row}\n93\t                    data-column-start={columnStart}\n94\t                    data-column-end={columnEnd}\n95\t                    data-state={state}\n96\t                    className={`seat${state === 'unavailable' ? ' seat--unavailable' : ''}`}\n97\t                    style={style}\n98\t                    onClick={() => onToggleCouch(row, columnStart, columnEnd)}\n99\t                  >\n100\t                    {columnStart}-{columnEnd}\n101\t                  </button>\n102\t                );\n103\t              })\n104\t            : rowColumns(row).map((column) => {\n105\t                const state = seatState(row, column, occupiedSeats, selectedSeats);\n106\t                const style: CSSProperties = {\n107\t                  gridColumn: trackForColumn(column),\n108\t                  gridRow: row,\n109\t                  ['--seat-bg' as string]: STATE_COLORS[state],\n110\t                };\n111\t                return (\n112\t                  <button\n113\t                    key={column}\n114\t                    type=\"button\"\n115\t                    data-testid=\"seat\"\n116\t                    data-row={row}\n117\t                    data-column={column}\n118\t                    data-state={state}\n119\t                    className={`seat${state === 'unavailable' ? ' seat--unavailable' : ''}`}\n120\t                    style={style}\n121\t                    onClick={() => onToggleSeat(row, column)}\n122\t                  >\n123\t                    {column}\n124\t                  </button>\n125\t                );\n126\t              })}\n127\t\n128\t          <div\n129\t            data-testid=\"aisle\"\n130\t            data-row={row}\n131\t            className=\"aisle\"\n132\t            style={{ gridColumn: AISLE_1_TRACK, gridRow: row }}\n133\t          />\n134\t          <div\n135\t            data-testid=\"aisle\"\n136\t            data-row={row}\n137\t            className=\"aisle\"\n138\t            style={{ gridColumn: AISLE_2_TRACK, gridRow: row }}\n139\t          />\n140\t\n141\t          <div\n142\t            data-testid=\"row-label-right\"\n143\t            data-row={row}\n144\t            className=\"row-label\"\n145\t            style={{ gridColumn: LABEL_RIGHT_TRACK, gridRow: row }}\n146\t          >\n147\t            {row}\n148\t          </div>\n149\t        </div>\n150\t      ))}\n151\t    </Box>\n152\t  );\n153\t}\n154\t\n155\texport function ScreenIndicator() {\n156\t  return (\n157\t    <Box\n158\t      data-testid=\"screen-indicator\"\n159\t      sx={{\n160\t        mx: 'auto',\n161\t        mb: 2,\n162\t        width: '60%',\n163\t        textAlign: 'center',\n164\t        py: 1,\n165\t        borderRadius: 1,\n166\t        backgroundColor: '#ccc',\n167\t      }}\n168\t    >\n169\t      <Typography variant=\"overline\">SCREEN</Typography>\n170\t    </Box>\n171\t  );\n172\t}\n173\t"}]},"parent_tool_use_id":"toolu_019qhPutAQhu9gtYed3XbehR","session_id":"3632df4e-836a-4239-9ca1-2c0c9dc67b92","uuid":"7611907e-bf6b-4bc3-8ec6-c3afa27d87ac","timestamp":"2026-10-20T06:41:44.469Z","subagent_type":"Explore","task_description":"Audit cinescope implementation against spec"}
