ovie;\n  screenings: Screening[];\n}\n\ninterface DayButton {\n  label: string;\n  iso: string;\n}\n\n@Component({\n  selector: 'app-movie-list',\n  imports: [MatButtonModule, MatDatepickerModule, MatFormFieldModule, MatInputModule],\n  templateUrl: './movie-list.html',\n  styleUrl: './movie-list.scss',\n})\nexport class MovieListComponent {\n  private readonly api = inject(ApiService);\n  private readonly route = inject(ActivatedRoute);\n  private readonly router = inject(Router);\n\n  private readonly dateParam = toSignal(this.route.queryParamMap, { initialValue: this.route.snapshot.queryParamMap });\n\n  readonly today = startOfDay(new Date());\n  readonly minDate = this.today;\n\n  readonly selectedDate = computed(() => resolveSelectedDate(this.dateParam().get('date')));\n  readonly selectedDateIso = computed(() => isoDate(this.selectedDate()));\n\n  readonly dayButtons: DayButton[] = [0, 1, 2, 3, 4].map((offset) => {\n    const date = addDays(this.today, offset);\n    return { label: offset === 0 ? 'Today' : weekdayName(date), iso: isoDate(date) };\n  });\n\n  readonly loading = signal(true);\n  readonly error = signal(false);\n  readonly cards = signal<MovieCard[]>([]);\n\n  constructor() {\n    this.load(this.selectedDateIso());\n    let previous = this.selectedDateIso();\n    toSignal(this.route.queryParamMap, { initialValue: null });\n    // Reload whenever the resolved selected date changes.\n    const checkAndReload = () => {\n      const current = this.selectedDateIso();\n      if (current !== previous) {\n        previous = current;\n        this.load(current);\n      }\n    };\n    // computed() values are read eagerly above; re-check on each change detection tick via effect.\n    import('@angular/core').then(({ effect, runInInjectionContext }) => {\n      runInInjectionContext(this.injector, () => effect(checkAndReload));\n    });\n  }\n\n  private readonly injector = inject((await import('@angular/core')).Injector as never);\n\n  private load(date: s