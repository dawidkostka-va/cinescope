inject(BookingService);\n\n  readonly data = resource({\n    params: () => Number(this.params().get('id')),\n    loader: async ({ params: id }) => {\n      try {\n        const screening = await firstValueFrom(this.api.screening(id));\n        const movie = await firstValueFrom(this.api.movie(screening.movieId));\n        return { screening, movie };\n      } catch {\n        await this.router.navigate(['/']);\n        return undefined;\n      }\n    },\n  });\n\n  readonly items = computed(() =>\n    [...this.booking.seats()].sort(compareCells).map((cell) => ({\n      key: cellIds(cell).join(),\n      cell,\n      row: cell.row,\n      seat: seatDescription(cell),\n      price: formatPrice(priceOf(cell)),\n    })),\n  );\n\n  readonly totalText = computed(() => {\n    const total = this.booking.seats().reduce((sum, cell) => sum + priceOf(cell), 0);\n    return `Total: ${formatPrice(total)}`;\n  });\n\n  remove(cell: Cell): void {\n    this.booking.toggle(cell);\n    if (this.booking.seatCount() === 0) {\n      this.back();\n    }\n  }\n\n  back(): void {\n    this.router.navigate(['/screenings', this.params().get('id'), 'seats']);\n  }\n\n  confirm(): void {\n    this.router.navigate(['/screenings', this.params().get('id'), 'checkout']);\n  }\n}\n","structuredPatch":[{"oldStart":49,"oldLines":10,"newStart":49,"newLines":7,"lines":["     })),","   );"," ","-  readonly totalText = computed(() => {","-    const total = this.booking.seats().reduce((sum, cell) => sum + priceOf(cell), 0);","-    return `Total: ${formatPrice(total)}`;","-  });","+  readonly totalText = computed(() => `Total: ${formatPrice(this.booking.total())}`);"," ","   remove(cell: Cell): void {","     this.booking.toggle(cell);"]}],"userModified":false,"replaceAll":false}}
