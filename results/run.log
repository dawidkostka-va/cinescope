.kind === 'couch') {\n      if (this.isOccupied(item.ids[0]) || this.isOccupied(item.ids[1])) {\n        return 'unavailable';\n      }\n      return this.selected().has(item.ids[0]) ? 'selected' : 'available';\n    }\n    if (this.isOccupied(item.id)) {\n      return 'unavailable';\n    }\n    if (this.selected().has(item.id)) {\n      return 'selected';\n    }\n    return item.accessible ? 'accessible' : 'available';\n  }\n\n  select(item: AuditoriumItem): void {\n    const screening = this.screening();\n    if (!screening || this.stateOf(item) === 'unavailable') {\n      return;\n    }\n    const ids = item.kind === 'couch' ? item.ids : [item.id];\n    if (this.booking.toggle(screening.id, ids) === 'limit') {\n      this.toast.show('Maximum 10 seats per booking');\n    }\n  }\n\n  cancel(): void {\n    this.booking.clear();\n    void this.router.navigateByUrl('/');\n  }\n\n  continue(): void {\n    const screening = this.screening();\n    if (!screening || this.selectedIds().length === 0) {\n      return;\n    }\n    void this.router.navigateByUrl(`/screenings/${screening.id}/summary`);\n  }\n\n  private isOccupied(id: string): boolean {\n    return this.occupied().has(id);\n  }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":10,"newStart":1,"newLines":14,"lines":[" import { ChangeDetectionStrategy, Component, DestroyRef, computed, inject, signal } from '@angular/core';"," import { takeUntilDestroyed } from '@angular/core/rxjs-interop';"," import { ActivatedRoute, Router } from '@angular/router';","+import { MatButtonModule } from '@angular/material/button';"," import { map, switchMap } from 'rxjs/operators';","+import { BookingStore } from '../booking/booking.store';","+import { ticketsFor } from '../booking/tickets';"," import { CinemaApi } from '../cinema.api';"," import { showDate } from '../dates';"," import { Movie, Screening } from '../models';","+import { Toast } from '../toast/toast';"," import { AuditoriumItem, buildAuditorium } from './auditorium';",