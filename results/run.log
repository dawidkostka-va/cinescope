{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgD1sKdCtgUYyXWjrEiVy","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KjAtGA6UgHRYZNHaTjETtD","name":"Write","input":{"file_path":"/workspace/project/apps/cinescope/src/toast/ToastProvider.tsx","content":"import { createContext, ReactNode, useCallback, useContext, useRef, useState } from 'react';\nimport Snackbar from '@mui/material/Snackbar';\nimport Alert from '@mui/material/Alert';\n\ntype ShowToast = (message: string) => void;\n\nconst ToastContext = createContext<ShowToast | null>(null);\n\nconst TOAST_DURATION_MS = 4000;\n\nexport function ToastProvider({ children }: { children: ReactNode }) {\n  const [message, setMessage] = useState<string | null>(null);\n  const timerRef = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);\n\n  const show = useCallback<ShowToast>((text) => {\n    setMessage(text);\n    if (timerRef.current) {\n      clearTimeout(timerRef.current);\n    }\n    timerRef.current = setTimeout(() => setMessage(null), TOAST_DURATION_MS);\n  }, []);\n\n  return (\n    <ToastContext.Provider value={show}>\n      {children}\n      <Snackbar\n        open={message !== null}\n        anchorOrigin={{ vertical: 'bottom', horizontal: 'center' }}\n      >\n        <Alert severity=\"info\" variant=\"filled\" data-testid=\"toast\" sx={{ width: '100%' }}>\n          {message}\n        </Alert>\n      </Snackbar>\n    </ToastContext.Provider>\n  );\n}\n\nexport function useToast(): ShowToast {\n  const context = useContext(ToastContext);\n  if (!context) {\n    throw new Error('useToast must be used within a ToastProvider');\n  }\n  return context;\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":141,"cache_read_input_tokens":98292,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":141},"output_tokens":16