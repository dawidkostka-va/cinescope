]);\n  }\n\n  protected cancel(): void {\n    this.bookings.clear();\n    this.router.navigateByUrl('/');\n  }\n\n  protected continue(): void {\n    this.router.navigateByUrl(`/screenings/${this.screeningId()}/summary`);\n  }\n}\n"}}}
