{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CgD23HGrHNtvMD7hBH81r","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AnWnJcR8MY9M2gKUucmgJb","name":"Write","input":{"file_path":"/workspace/project/apps/cinescope/src/pages/SummaryPage/SummaryPage.tsx","content":"import { useEffect, useState } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport List from '@mui/material/List';\nimport ListItem from '@mui/material/ListItem';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport { fetchMovie, fetchScreening } from '../../api';\nimport type { Movie, Screening } from '../../types';\nimport { Booking, loadBooking, saveBooking } from '../../booking';\nimport { formatPrice, getBookingItems, seatDescription, totalPrice } from '../../seatUtils';\n\nexport function SummaryPage() {\n  const { screeningId } = useParams();\n  const navigate = useNavigate();\n\n  const [booking, setBooking] = useState<Booking | null>(null);\n  const [screening, setScreening] = useState<Screening | null>(null);\n  const [movie, setMovie] = useState<Movie | null>(null);\n  const [guardFailed, setGuardFailed] = useState(false);\n\n  useEffect(() => {\n    const existing = loadBooking();\n    if (\n      !existing ||\n      existing.paid ||\n      existing.screeningId !== Number(screeningId) ||\n      existing.seats.length === 0\n    ) {\n      setGuardFailed(true);\n      navigate('/', { replace: true });\n      return;\n    }\n    setBooking(existing);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [screeningId]);\n\n  useEffect(() => {\n    if (guardFailed) return;\n    let cancelled = false;\n    async function load() {\n      try {\n        const loadedScreening = await fetchScreening(screeningId as string);\n        if (cancelled) return;\n        setScreening(loade