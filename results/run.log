ate.status === 'loading' || !booking || booking.screeningId !== screeningId) {\n45\t    return null;\n46\t  }\n47\t\n48\t  const occupied = new Set(state.screening.occupiedSeats);\n49\t  const selected = new Set(booking.seats);\n50\t\n51\t  function handleToggle(ids: string[]): void {\n52\t    const result = toggleSeatGroup(ids);\n53\t    if (result === 'limit') {\n54\t      showToast('Maximum 10 seats per booking');\n55\t    }\n56\t  }\n57\t\n58\t  function handleCancel(): void {\n59\t    clearBooking();\n60\t    navigate('/');\n61\t  }\n62\t\n63\t  function handleContinue(): void {\n64\t    if (selected.size === 0) return;\n65\t    navigate(`/screenings/${screeningId}/summary`);\n66\t  }\n67\t\n68\t  return (\n69\t    <div className={styles.page}>\n70\t      <h1 data-testid=\"seat-map-title\">Choose your seats</h1>\n71\t      <p data-testid=\"seat-map-subtitle\">Show Date: {formatShowDate(state.screening.date, state.screening.time)}</p>\n72\t      <p data-testid=\"seat-limit-info\" className={styles.limitInfo}>\n73\t        You can reserve up to 10 seats per reservation\n74\t      </p>\n75\t      <div data-testid=\"screen-indicator\" className={styles.screen}>\n76\t        SCREEN\n77\t      </div>\n78\t      <SeatMap\n79\t        occupied={occupied}\n80\t        selected={selected}\n81\t        onToggleSeat={(seat) => handleToggle([seat])}\n82\t        onToggleCouch={(a, b) => handleToggle([a, b])}\n83\t      />\n84\t      <Legend />\n85\t      <SelectedSeatsPanel selected={booking.seats} />\n86\t      <div className={styles.actions}>\n87\t        <Button data-testid=\"cancel-button\" variant=\"outlined\" onClick={handleCancel}>\n88\t          Cancel\n89\t        </Button>\n90\t        <Button data-testid=\"continue-button\" variant=\"contained\" disabled={selected.size === 0} onClick={handleContinue}>\n91\t          Continue\n92\t        </Button>\n93\t      </div>\n94\t    </div>\n95\t  );\n96\t}\n97\t"}]},"parent_tool_use_id":null,"session_id":"18d24fdc-128d-4444-9721-af8b117c5cc6","uuid":"9849a892-47f2-4c7d-a687-6b7553938bf2","timestamp":"2026-10-20T08:13:33.613Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/pages/seat-selection/SeatSelectionPage.tsx","content":"import Button from '@mui/material/Button';\nimport { useEffect, useState } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport { fetchMovie, fetchScreening } from '../../api/client';\nimport { Movie, Screening } from '../../api/types';\nimport { useBooking } from '../../booking/BookingContext';\nimport { formatShowDate } from '../../domain/dateFormat';\nimport { useToast } from '../../toast/ToastContext';\nimport { Legend } from './Legend';\nimport { SeatMap } from './SeatMap';\nimport styles from './SeatSelectionPage.module.scss';\nimport { SelectedSeatsPanel } from './SelectedSeatsPanel';\n\ntype LoadState = { status: 'loading' } | { status: 'loaded'; screening: Screening; movie: Movie };\n\nexport function SeatSelectionPage() {\n  const { id } = useParams();\n  const screeningId = Number(id);\n  const navigate = useNavigate();\n  const { booking, startBookingForScreening, toggleSeatGroup, clearBooking } = useBooking();\n  const { showToast } = useToast();\n  const [state, setState] = useState<LoadState>({ status: 'loading' });\n\n  useEffect(() => {\n    let cancelled = false;\n    setState({ status: 'loading' });\n    (async () => {\n      try {\n        const screening = await fetchScreening(screeningId);\n        const movie = await fetchMovie(screening.movieId);\n        if (cancelled) return;\n        startBookingForScreening(screeningId);\n        setState({ status: 'loaded', screening, movie });\n      } catch {\n        if (!cancelled) navigate('/', { replace: true });\n      }\n    })();\n    return () => {\n      cancelled = true;\n    };\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [screeningId]);\n\n  if (state.status === 'loading' || !booking || booking.screeningId !== screeningId) {\n    return null;\n  }\n\n  const occupied = new Set(state.screening.occupiedSeats);\n  const selected = new Set(booking.seats);\n\n  function handleToggle(ids: string[]): void {\n    const result = toggleSeatGroup(ids);\n    if (result === 'limit') {\n      showToast('Maximum 10 seats per booking');\n    }\n  }\n\n  function handleCancel(): void {\n    clearBooking();\n    navigate('/');\n  }\n\n  function handleContinue(): void {\n    if (selected.size === 0) return;\n    navigate(`/screenings/${screeningId}/summary`);\n  }\n\n  return (\n    <div className={styles.page}>\n      <h1 data-testid=\"seat-map-title\">Choose your seats</h1>\n      <p data-testid=\"seat-map-subtitle\">Show Date: {formatShowDate(state.screening.date, state.screening.time)}</p>\n      <p data-testid=\"seat-limit-info\" className={styles.limitInfo}>\n        You can reserve up to 10 seats per reservation\n      </p>\n      <div data-testid=\"screen-indicator\" className={styles.screen}>\n        SCREEN\n      </div>\n      <SeatMap\n        occupied={occupied}\n        selected={selected}\n        onToggleSeat={(seat) => handleToggle([seat])}\n        onToggleCouch={(a, b) => handleToggle([a, b])}\n      />\n      <Legend />\n      <SelectedSeatsPanel selected={booking.seats} />\n      <div className={styles.actions}>\n        <Button data-testid=\"cancel-button\" variant=\"outlined\" onClick={handleCancel}>\n          Cancel\n        </Button>\n        <Button data-testid=\"continue-button\" variant=\"contained\" disabled={selected.size === 0} onClick={handleContinue}>\n          Continue\n        </Button>\n      </div>\n    </div>\n  );\n}\n","numLines":97,"startLine":1,"totalLines":97}}}
