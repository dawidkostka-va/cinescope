ds.every((id) => selected.has(id))) return 'selected';\n    return 'available';\n  }\n\n  onSeatClick(cell: SeatCell): void {\n    if (this.seatState(cell) === 'unavailable') return;\n    this.toggle([cell.id]);\n  }\n\n  onCouchClick(cell: CouchCell): void {\n    if (this.couchState(cell) === 'unavailable') return;\n    this.toggle(cell.ids);\n  }\n\n  private toggle(ids: string[]): void {\n    const result = this.bookingService.toggleSeats(ids);\n    if (result === 'limit-exceeded') {\n      this.toast.show('Maximum 10 seats per booking');\n    }\n  }\n\n  cancel(): void {\n    this.bookingService.clear();\n    this.router.navigate(['/']);\n  }\n\n  continue(): void {\n    if (this.selectedCount() === 0) return;\n    const screeningId = this.data()?.screening.id;\n    if (screeningId === undefined) return;\n    this.router.navigate(['/screenings', screeningId, 'summary']);\n  }\n\n  isSeat(cell: RowCell): cell is SeatCell {\n    return cell.kind === 'seat';\n  }\n  isCouch(cell: RowCell): cell is CouchCell {\n    return cell.kind === 'couch';\n  }\n  isAisle(cell: RowCell): cell is AisleCell {\n    return cell.kind === 'aisle';\n  }\n  isEmpty(cell: RowCell): cell is EmptyCell {\n    return cell.kind === 'empty';\n  }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":18,"newStart":1,"newLines":10,"lines":["-import { toObservable } from '@angular/core/rxjs-interop';","-import { Component, computed, inject, input } from '@angular/core';","+import { Component, computed, inject, input, signal } from '@angular/core';","+import { takeUntilDestroyed, toObservable } from '@angular/core/rxjs-interop';"," import { MatButtonModule } from '@angular/material/button';"," import { Router } from '@angular/router';"," import { EMPTY, catchError, switchMap } from 'rxjs';","-import { takeUntilDestroyed } from '@angular/core/rxjs-interop';"," import { ApiService } from '../../core/api.service';","-import {","-  AisleCell,","-  CouchCell,","-  EmptyCell,","-  ROW_LAYOUTS,","-  RowCell