s}\n202\t                onChange={(e) => {\n203\t                  updateValues({ acceptTerms: e.target.checked });\n204\t                  markTouched('terms');\n205\t                }}\n206\t              />\n207\t            }\n208\t            label={<span data-testid=\"terms-label\">I accept the terms and conditions *</span>}\n209\t          />\n210\t          {showError('terms') && (\n211\t            <FormHelperText error data-testid=\"terms-error\">\n212\t              {errors.terms}\n213\t            </FormHelperText>\n214\t          )}\n215\t        </Box>\n216\t      </Stack>\n217\t\n218\t      <Stack direction=\"row\" spacing={2} sx={{ mt: 3 }}>\n219\t        <Button data-testid=\"checkout-back-button\" variant=\"outlined\" onClick={handleBack}>\n220\t          Back\n221\t        </Button>\n222\t        <Button\n223\t          data-testid=\"pay-button\"\n224\t          variant=\"contained\"\n225\t          disabled={submitting}\n226\t          onClick={handlePay}\n227\t        >\n228\t          {submitting ? 'Processing…' : `Pay ${total.toFixed(2)} PLN`}\n229\t        </Button>\n230\t      </Stack>\n231\t    </Box>\n232\t  );\n233\t}\n234\t"}]},"parent_tool_use_id":null,"session_id":"3632df4e-836a-4239-9ca1-2c0c9dc67b92","uuid":"36619967-bc0d-406d-a4ae-73995a96d1de","timestamp":"2026-10-20T06:34:27.282Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/pages/CheckoutPage/CheckoutPage.tsx","content":"import { useEffect, useState } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Checkbox from '@mui/material/Checkbox';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport FormHelperText from '@mui/material/FormHelperText';\nimport Stack from '@mui/material/Stack';\nimport TextField from '@mui/material/TextField';\nimport Typography from '@mui/material/Typography';\nimport { Booking, CheckoutValues, loadBooking, saveBooking } from '../../booking';\nimport { createReservation } from '../../api';\nimport { getBookingItems, totalPrice } from '../../seatUtils';\nimport { useToast } from '../../toast/ToastProvider';\nimport { validate, FieldErrors } from './checkoutValidation';\n\ntype TouchedState = Record<keyof FieldErrors, boolean>;\n\nconst INITIAL_TOUCHED: TouchedState = {\n  firstName: false,\n  lastName: false,\n  email: false,\n  confirmEmail: false,\n  phone: false,\n  terms: false,\n};\n\nexport function CheckoutPage() {\n  const { screeningId } = useParams();\n  const navigate = useNavigate();\n  const showToast = useToast();\n\n  const [booking, setBooking] = useState<Booking | null>(null);\n  const [guardFailed, setGuardFailed] = useState(false);\n  const [touched, setTouched] = useState<TouchedState>(INITIAL_TOUCHED);\n  const [submitting, setSubmitting] = useState(false);\n\n  useEffect(() => {\n    const existing = loadBooking();\n    if (\n      !existing ||\n      existing.paid ||\n      existing.screeningId !== Number(screeningId) ||\n      existing.seats.length === 0\n    ) {\n      setGuardFailed(true);\n      navigate('/', { replace: true });\n      return;\n    }\n    setBooking(existing);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [screeningId]);\n\n  if (guardFailed || !booking) {\n    return null;\n  }\n\n  const values = booking.checkout;\n  const errors = validate(values);\n  const total = totalPrice(booking.seats);\n\n  function updateValues(partial: Partial<CheckoutValues>) {\n    if (!booking) return;\n    const updated = { ...booking, checkout: { ...booking.checkout, ...partial } };\n    setBooking(updated);\n    saveBooking(updated);\n  }\n\n  function markTouched(field: keyof TouchedState) {\n    setTouched((prev) => ({ ...prev, [field]: true }));\n  }\n\n  function handleBack() {\n    navigate(`/screenings/${screeningId}/summary`);\n  }\n\n  async function handlePay() {\n    if (!booking) return;\n    const currentErrors = validate(booking.checkout);\n    if (Object.keys(currentErrors).length > 0) {\n      setTouched({\n        firstName: true,\n        lastName: true,\n        email: true,\n        confirmEmail: true,\n        phone: true,\n        terms: true,\n      });\n      showToast('The form contains errors');\n      return;\n    }\n\n    setSubmitting(true);\n    try {\n      const items = getBookingItems(booking.seats);\n      const seats = items.flatMap((item) => item.ids);\n      await createReservation({\n        screeningId: Number(screeningId),\n        seats,\n        customer: {\n          firstName: booking.checkout.firstName,\n          lastName: booking.checkout.lastName,\n          email: booking.checkout.email,\n          phone: booking.checkout.phone,\n        },\n        totalPrice: total,\n      });\n      const updated = { ...booking, paid: true, customerEmail: booking.checkout.email };\n      saveBooking(updated);\n      navigate('/confirmation');\n    } catch {\n      setSubmitting(false);\n      showToast('Payment failed. Please try again.');\n    }\n  }\n\n  const showError = (field: keyof FieldErrors) => touched[field] && Boolean(errors[field]);\n\n  return (\n    <Box sx={{ maxWidth: 520, mx: 'auto', p: 3 }}>\n      <Typography variant=\"h4\" data-testid=\"checkout-title\" gutterBottom>\n        Your details\n      </Typography>\n\n      <Stack spacing={2}>\n        <TextField\n          label=\"First name *\"\n          value={values.firstName}\n          onChange={(e) => updateValues({ firstName: e.target.value })}\n          onBlur={() => markTouched('firstName')}\n          error={showError('firstName')}\n          helperText={showError('firstName') ? errors.firstName : undefined}\n          slotProps={{\n            htmlInput: { 'data-testid': 'first-name-input' },\n            inputLabel: { 'data-testid': 'first-name-label' },\n            formHelperText: { 'data-testid': 'first-name-error' },\n          }}\n        />\n\n        <TextField\n          label=\"Last name *\"\n          value={values.lastName}\n          onChange={(e) => updateValues({ lastName: e.target.value })}\n          onBlur={() => markTouched('lastName')}\n          error={showError('lastName')}\n          helperText={showError('lastName') ? errors.lastName : undefined}\n          slotProps={{\n            htmlInput: { 'data-testid': 'last-name-input' },\n            inputLabel: { 'data-testid': 'last-name-label' },\n            formHelperText: { 'data-testid': 'last-name-error' },\n          }}\n        />\n\n        <TextField\n          label=\"Email *\"\n          value={values.email}\n          onChange={(e) => updateValues({ email: e.target.value })}\n          onBlur={() => markTouched('email')}\n          error={showError('email')}\n          helperText={showError('email') ? errors.email : undefined}\n          slotProps={{\n            htmlInput: { 'data-testid': 'email-input' },\n            inputLabel: { 'data-testid': 'email-label' },\n            formHelperText: { 'data-testid': 'email-error' },\n          }}\n        />\n\n        <TextField\n          label=\"Confirm email *\"\n          value={values.confirmEmail}\n          onChange={(e) => updateValues({ confirmEmail: e.target.value })}\n          onBlur={() => markTouched('confirmEmail')}\n          error={showError('confirmEmail')}\n          helperText={showError('confirmEmail') ? errors.confirmEmail : undefined}\n          slotProps={{\n            htmlInput: { 'data-testid': 'confirm-email-input' },\n            inputLabel: { 'data-testid': 'confirm-email-label' },\n            formHelperText: { 'data-testid': 'confirm-email-error' },\n          }}\n        />\n\n        <TextField\n          label=\"Phone number\"\n          value={values.phone}\n          onChange={(e) => updateValues({ phone: e.target.value })}\n          onBlur={() => markTouched('phone')}\n          error={showError('phone')}\n          helperText={showError('phone') ? errors.phone : undefined}\n          slotProps={{\n            htmlInput: { 'data-testid': 'phone-input' },\n            inputLabel: { 'data-testid': 'phone-label' },\n            formHelperText: { 'data-testid': 'phone-error' },\n          }}\n        />\n\n        <Box>\n          <FormControlLabel\n            control={\n              <Checkbox\n                data-testid=\"terms-checkbox\"\n                checked={values.acceptTerms}\n                onChange={(e) => {\n                  updateValues({ acceptTerms: e.target.checked });\n                  markTouched('terms');\n                }}\n              />\n            }\n            label={<span data-testid=\"terms-label\">I accept the terms and conditions *</span>}\n          />\n          {showError('terms') && (\n            <FormHelperText error data-testid=\"terms-error\">\n              {errors.terms}\n            </FormHelperText>\n          )}\n        </Box>\n      </Stack>\n\n      <Stack direction=\"row\" spacing={2} sx={{ mt: 3 }}>\n        <Button data-testid=\"checkout-back-button\" variant=\"outlined\" onClick={handleBack}>\n          Back\n        </Button>\n        <Button\n          data-testid=\"pay-button\"\n          variant=\"contained\"\n          disabled={submitting}\n          onClick={handlePay}\n        >\n          {submitting ? 'Processing…' : `Pay ${total.toFixed(2)} PLN`}\n        </Button>\n      </Stack>\n    </Box>\n  );\n}\n","numLines":234,"startLine":1,"totalLines":234}}}
