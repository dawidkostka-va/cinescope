r/material/snack-bar';\n\n@Component({\n  selector: 'app-toast',\n  template: `<span data-testid=\"toast\">{{ message }}</span>`,\n})\nexport class Toast {\n  message = inject<string>(MAT_SNACK_BAR_DATA);\n}\n\n@Injectable({ providedIn: 'root' })\nexport class ToastService {\n  private snackBar = inject(MatSnackBar);\n\n  show(message: string): void {\n    this.snackBar.openFromComponent(Toast, { data: message, duration: 4000 });\n  }\n}\nEOF\ncat > guards.ts <<'EOF'\nimport { inject } from '@angular/core';\nimport { CanActivateFn, Router } from '@angular/router';\nimport { BookingService } from './booking';\n\nexport const unpaidBookingGuard: CanActivateFn = (route) => {\n  const b = inject(BookingService).booking();\n  const router = inject(Router);\n  const ok = !!b && !b.paid && b.screeningId === Number(route.paramMap.get('id')) && b.seats.length > 0;\n  return ok || router.createUrlTree(['/']);\n};\n\nexport const paidBookingGuard: CanActivateFn = () => {\n  const b = inject(BookingService).booking();\n  return (!!b && b.paid) || inject(Router).createUrlTree(['/']);\n};\nEOF\ncat > app.routes.ts <<'EOF'\nimport { Route } from '@angular/router';\nimport { Checkout } from './checkout/checkout';\nimport { Confirmation } from './confirmation/confirmation';\nimport { paidBookingGuard, unpaidBookingGuard } from './guards';\nimport { MovieList } from './movie-list/movie-list';\nimport { SeatMap } from './seat-map/seat-map';\nimport { Summary } from './summary/summary';\n\nexport const appRoutes: Route[] = [\n  { path: '', pathMatch: 'full', component: MovieList },\n  { path: 'screenings/:id/seats', component: SeatMap },\n  { path: 'screenings/:id/summary', component: Summary, canActivate: [unpaidBookingGuard] },\n  { path: 'screenings/:id/checkout', component: Checkout, canActivate: [unpaidBookingGuard] },\n  { path: 'confirmation', component: Confirmation, canActivate: [paidBookingGuard] },\n  { path: '**', redirectTo: '' },\n];\nEOF\ncat > app.config.ts <<'EOF'\nimp