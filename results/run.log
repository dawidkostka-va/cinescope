{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BhnAscqVjS75gUc7JMQmSL","type":"tool_result","content":"1\timport Button from '@mui/material/Button';\n2\timport Checkbox from '@mui/material/Checkbox';\n3\timport FormControlLabel from '@mui/material/FormControlLabel';\n4\timport TextField from '@mui/material/TextField';\n5\timport { useEffect, useState } from 'react';\n6\timport { useNavigate, useParams } from 'react-router-dom';\n7\timport { createReservation } from '../lib/api';\n8\timport { BookingFormValues, getBookingSnapshot, setBooking, useBooking } from '../lib/bookingStore';\n9\timport { formatPrice, orderedSeatIds, totalPrice } from '../lib/ticketing';\n10\timport { useToast } from '../lib/toast';\n11\timport { FormErrors, validateForm } from '../lib/validation';\n12\t\n13\ttype TextFieldName = 'firstName' | 'lastName' | 'email' | 'confirmEmail' | 'phone';\n14\ttype FieldName = TextFieldName | 'termsAccepted';\n15\t\n16\tconst TEXT_FIELDS: { name: TextFieldName; label: string; testid: string; labelTestid: string; errorTestid: string }[] = [\n17\t  { name: 'firstName', label: 'First name *', testid: 'first-name-input', labelTestid: 'first-name-label', errorTestid: 'first-name-error' },\n18\t  { name: 'lastName', label: 'Last name *', testid: 'last-name-input', labelTestid: 'last-name-label', errorTestid: 'last-name-error' },\n19\t  { name: 'email', label: 'Email *', testid: 'email-input', labelTestid: 'email-label', errorTestid: 'email-error' },\n20\t  { name: 'confirmEmail', label: 'Confirm email *', testid: 'confirm-email-input', labelTestid: 'confirm-email-label', errorTestid: 'confirm-email-error' },\n21\t  { name: 'phone', label: 'Phone number', testid: 'phone-input', labelTestid: 'phone-label', errorTestid: 'phone-error' },\n22\t];\n23\t\n24\tconst ALL_TOUCHED: Record<FieldName, boolean> = {\n25\t  firstName: true,\n26\t  lastName: true,\n27\t  email: true,\n28\t  confirmEmail: true,\n29\t  phone: true,\n30\t  termsAccepted: true,\n31\t};\n32\t\n33\texport function CheckoutPage() {\n34\t  const { id } = useParams();\n35\t  const screeningId = Number(id);\n36\t  const navigate = useNavigate();\n37\t  const { showToast } = useToast();\n38\t  const booking = useBooking();\n39\t  const [touched, setTouched] = useState<Record<FieldName, boolean>>({\n40\t    firstName: false,\n41\t    lastName: false,\n42\t    email: false,\n43\t    confirmEmail: false,\n44\t    phone: false,\n45\t    termsAccepted: false,\n46\t  });\n47\t  const [submitting, setSubmitting] = useState(false);\n48\t\n49\t  useEffect(() => {\n50\t    const snapshot = getBookingSnapshot();\n51\t    if (!snapshot || snapshot.paid || snapshot.screeningId !== screeningId || snapshot.seats.length === 0) {\n52\t      navigate('/', { replace: true });\n53\t    }\n54\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n55\t  }, []);\n56\t\n57\t  if (!booking) {\n58\t    return null;\n59\t  }\n60\t\n61\t  const errors: FormErrors = validateForm(booking.form);\n62\t  const total = totalPrice(booking.seats);\n63\t\n64\t  function updateField<K extends keyof BookingFormValues>(field: K, value: BookingFormValues[K]) {\n65\t    setBooking({ ...booking!, form: { ...booking!.form, [field]: value } });\n66\t  }\n67\t\n68\t  function markTouched(field: FieldName) {\n69\t    setTouched((prev) => ({ ...prev, [field]: true }));\n70\t  }\n71\t\n72\t  async function handlePay() {\n73\t    const currentErrors = validateForm(booking!.form);\n74\t    if (Object.keys(currentErrors).length > 0) {\n75\t      setTouched(ALL_TOUCHED);\n76\t      showToast('The form contains errors');\n77\t      return;\n78\t    }\n79\t    setSubmitting(true);\n80\t    try {\n81\t      const seats = orderedSeatIds(booking!.seats);\n82\t      await createReservation({\n83\t        screeningId,\n84\t        seats,\n85\t        customer: {\n86\t          firstName: booking!.form.firstName,\n87\t          lastName: booking!.form.lastName,\n88\t          email: booking!.form.email,\n89\t          phone: booking!.form.phone,\n90\t        },\n91\t        totalPrice: total,\n92\t      });\n93\t      setBooking({ ...booking!, paid: true, paidEmail: booking!.form.email });\n94\t      navigate('/confirmation');\n95\t    } catch {\n96\t      showToast('Payment failed. Please try again.');\n97\t    } finally {\n98\t      setSubmitting(false);\n99\t    }\n100\t  }\n101\t\n102\t  return (\n103\t    <div>\n104\t      <h1 data-testid=\"checkout-title\">Your details</h1>\n105\t      <div>\n106\t        {TEXT_FIELDS.map((field) => (\n107\t          <div key={field.name}>\n108\t            <label data-testid={field.labelTestid} htmlFor={field.name}>\n109\t              {field.label}\n110\t            </label>\n111\t            <TextField\n112\t              id={field.name}\n113\t              data-testid={field.testid}\n114\t              value={booking.form[field.name]}\n115\t              onChange={(e) => updateField(field.name, e.target.value)}\n116\t              onBlur={() => markTouched(field.name)}\n117\t            />\n118\t            {touched[field.name] && errors[field.name] && (\n119\t              <div data-testid={field.errorTestid}>{errors[field.name]}</div>\n120\t            )}\n121\t          </div>\n122\t        ))}\n123\t        <div>\n124\t          <FormControlLabel\n125\t            control={\n126\t              <Checkbox\n127\t                id=\"termsAccepted\"\n128\t                data-testid=\"terms-checkbox\"\n129\t                checked={booking.form.termsAccepted}\n130\t                onChange={(e) => {\n131\t                  updateField('termsAccepted', e.target.checked);\n132\t                  markTouched('termsAccepted');\n133\t                }}\n134\t              />\n135\t            }\n136\t            label={<span data-testid=\"terms-label\">I accept the terms and conditions *</span>}\n137\t          />\n138\t          {touched.termsAccepted && errors.termsAccepted && <div data-testid=\"terms-error\">{errors.termsAccepted}</div>}\n139\t        </div>\n140\t        <div>\n141\t          <Button data-testid=\"checkout-back-button\" onClick={() => navigate(`/screenings/${screeningId}/summary`)}>\n142\t            Back\n143\t          </Button>\n144\t          <Button data-testid=\"pay-button\" disabled={submitting} onClick={handlePay}>\n145\t            {submitting ? 'Processing…' : `Pay ${formatPrice(total)}`}\n146\t          </Button>\n147\t        </div>\n148\t      </div>\n149\t    </div>\n150\t  );\n151\t}\n152\t\n153\texport default CheckoutPage;\n154\t"}]},"parent_tool_use_id":null,"session_id":"fc51c61a-6dab-4a2b-8142-c8f64be3453e","uuid":"53ae57be-5e8e-4b9d-a8cf-dd91df2e530d","timestamp":"2026-10-16T09:22:25.737Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/pages/CheckoutPage.tsx","content":"import Button from '@mui/material/Button';\nimport Checkbox from '@mui/material/Checkbox';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport TextField from '@mui/material/TextField';\nimport { useEffect, useState } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport { createReservation } from '../lib/api';\nimport { BookingFormValues, getBookingSnapshot, setBooking, useBooking } from '../lib/bookingStore';\nimport { formatPrice, orderedSeatIds, totalPrice } from '../lib/ticketing';\nimport { useToast } from '../lib/toast';\nimport { FormErrors, validateForm } from '../lib/validation';\n\ntype TextFieldName = 'firstName' | 'lastName' | 'email' | 'confirmEmail' | 'phone';\ntype FieldName = TextFieldName | 'termsAccepted';\n\nconst TEXT_FIELDS: { name: TextFieldName; label: string; testid: string; labelTestid: string; errorTestid: string }[] = [\n  { name: 'firstName', label: 'First name *', testid: 'first-name-input', labelTestid: 'first-name-label', errorTestid: 'first-name-error' },\n  { name: 'lastName', label: 'Last name *', testid: 'last-name-input', labelTestid: 'last-name-label', errorTestid: 'last-name-error' },\n  { name: 'email', label: 'Email *', testid: 'email-input', labelTestid: 'email-label', errorTestid: 'email-error' },\n  { name: 'confirmEmail', label: 'Confirm email *', testid: 'confirm-email-input', labelTestid: 'confirm-email-label', errorTestid: 'confirm-email-error' },\n  { name: 'phone', label: 'Phone number', testid: 'phone-input', labelTestid: 'phone-label', errorTestid: 'phone-error' },\n];\n\nconst ALL_TOUCHED: Record<FieldName, boolean> = {\n  firstName: true,\n  lastName: true,\n  email: true,\n  confirmEmail: true,\n  phone: true,\n  termsAccepted: true,\n};\n\nexport function CheckoutPage() {\n  const { id } = useParams();\n  const screeningId = Number(id);\n  const navigate = useNavigate();\n  const { showToast } = useToast();\n  const booking = useBooking();\n  const [touched, setTouched] = useState<Record<FieldName, boolean>>({\n    firstName: false,\n    lastName: false,\n    email: false,\n    confirmEmail: false,\n    phone: false,\n    termsAccepted: false,\n  });\n  const [submitting, setSubmitting] = useState(false);\n\n  useEffect(() => {\n    const snapshot = getBookingSnapshot();\n    if (!snapshot || snapshot.paid || snapshot.screeningId !== screeningId || snapshot.seats.length === 0) {\n      navigate('/', { replace: true });\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  if (!booking) {\n    return null;\n  }\n\n  const errors: FormErrors = validateForm(booking.form);\n  const total = totalPrice(booking.seats);\n\n  function updateField<K extends keyof BookingFormValues>(field: K, value: BookingFormValues[K]) {\n    setBooking({ ...booking!, form: { ...booking!.form, [field]: value } });\n  }\n\n  function markTouched(field: FieldName) {\n    setTouched((prev) => ({ ...prev, [field]: true }));\n  }\n\n  async function handlePay() {\n    const currentErrors = validateForm(booking!.form);\n    if (Object.keys(currentErrors).length > 0) {\n      setTouched(ALL_TOUCHED);\n      showToast('The form contains errors');\n      return;\n    }\n    setSubmitting(true);\n    try {\n      const seats = orderedSeatIds(booking!.seats);\n      await createReservation({\n        screeningId,\n        seats,\n        customer: {\n          firstName: booking!.form.firstName,\n          lastName: booking!.form.lastName,\n          email: booking!.form.email,\n          phone: booking!.form.phone,\n        },\n        totalPrice: total,\n      });\n      setBooking({ ...booking!, paid: true, paidEmail: booking!.form.email });\n      navigate('/confirmation');\n    } catch {\n      showToast('Payment failed. Please try again.');\n    } finally {\n      setSubmitting(false);\n    }\n  }\n\n  return (\n    <div>\n      <h1 data-testid=\"checkout-title\">Your details</h1>\n      <div>\n        {TEXT_FIELDS.map((field) => (\n          <div key={field.name}>\n            <label data-testid={field.labelTestid} htmlFor={field.name}>\n              {field.label}\n            </label>\n            <TextField\n              id={field.name}\n              data-testid={field.testid}\n              value={booking.form[field.name]}\n              onChange={(e) => updateField(field.name, e.target.value)}\n              onBlur={() => markTouched(field.name)}\n            />\n            {touched[field.name] && errors[field.name] && (\n              <div data-testid={field.errorTestid}>{errors[field.name]}</div>\n            )}\n          </div>\n        ))}\n        <div>\n          <FormControlLabel\n            control={\n              <Checkbox\n                id=\"termsAccepted\"\n                data-testid=\"terms-checkbox\"\n                checked={booking.form.termsAccepted}\n                onChange={(e) => {\n                  updateField('termsAccepted', e.target.checked);\n                  markTouched('termsAccepted');\n                }}\n              />\n            }\n            label={<span data-testid=\"terms-label\">I accept the terms and conditions *</span>}\n          />\n          {touched.termsAccepted && errors.termsAccepted && <div data-testid=\"terms-error\">{errors.termsAccepted}</div>}\n        </div>\n        <div>\n          <Button data-testid=\"checkout-back-button\" onClick={() => navigate(`/screenings/${screeningId}/summary`)}>\n            Back\n          </Button>\n          <Button data-testid=\"pay-button\" disabled={submitting} onClick={handlePay}>\n            {submitting ? 'Processing…' : `Pay ${formatPrice(total)}`}\n          </Button>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nexport default CheckoutPage;\n","numLines":154,"startLine":1,"totalLines":154}}}
