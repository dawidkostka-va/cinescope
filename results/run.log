{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cg3jYsAbEoR3TUbcXNYRL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012PdNatszyZm3NoXwh3K46C","name":"Write","input":{"file_path":"/workspace/project/apps/cinescope/src/booking/BookingContext.tsx","content":"import { createContext, ReactNode, useCallback, useContext, useEffect, useState } from 'react';\nimport { useToast } from '../toast/ToastContext';\nimport { MAX_SEATS_PER_BOOKING } from '../seating/layout';\nimport { loadBooking, saveBooking } from './storage';\nimport { Booking, CheckoutFormValues, createEmptyBooking } from './types';\n\ninterface BookingContextValue {\n  booking: Booking | null;\n  initForScreening: (screeningId: number) => void;\n  toggleUnit: (ids: string[]) => void;\n  removeUnit: (ids: string[]) => void;\n  setFormField: <K extends keyof CheckoutFormValues>(key: K, value: CheckoutFormValues[K]) => void;\n  markPaid: (email: string) => void;\n  clear: () => void;\n}\n\nconst BookingContext = createContext<BookingContextValue | null>(null);\n\nexport function BookingProvider({ children }: { children: ReactNode }) {\n  const [booking, setBooking] = useState<Booking | null>(() => loadBooking());\n  const { showToast } = useToast();\n\n  useEffect(() => {\n    saveBooking(booking);\n  }, [booking]);\n\n  const initForScreening = useCallback((screeningId: number) => {\n    setBooking((prev) => {\n      if (prev && prev.screeningId === screeningId && !prev.paid) {\n        return prev;\n      }\n      return createEmptyBooking(screeningId);\n    });\n  }, []);\n\n  const toggleUnit = useCallback(\n    (ids: string[]) => {\n      setBooking((prev) => {\n        if (!prev) return prev;\n        const allSelected = ids.every((id) => prev.seats.includes(id));\n        if (allSelected) {\n          return { ...prev, seats: prev.seats.filter((id) => !ids.includes(id)) };\n        }\n        if (prev.seats.length + ids.length > MAX_SEATS_PER_BOOKING) {\n          showToast('Maximum 10 seats per booking');\n          return prev;\n        }\n        return { ...prev, seats: [...prev.seats, ...ids] };\n      });\n    },\n    [showToast],\n  );\n\n  const removeUnit = useCallback((ids: string[]) => {\n    setBooking((prev) => {\n      if (!prev) return prev;\n      return { ...prev, seats: prev.seats.filter((id) => !ids.includes(id)) };\n    });\n  }, []);\n\n  const setFormField = useCallback(\n    <K extends keyof CheckoutFormValues>(key: K, value: CheckoutFormValues[K]) => {\n      setBooking((prev) => {\n        if (!prev) return prev;\n        return { ...prev, formValues: { ...prev.formValues, [key]: value } };\n      });\n    },\n    [],\n  );\n\n  const markPaid = useCallback((email: string) => {\n    setBooking((prev) => {\n      if (!prev) return prev;\n      return { ...prev, paid: true, customerEmail: email };\n    });\n  }, []);\n\n  const clear = useCallback(() => {\n    setBooking(null);\n  }, []);\n\n  return (\n    <BookingContext.Provider\n      value={{ booking, initForScreening, toggleUnit, removeUnit, setFormField, markPaid, clear }}\n    >\n      {children}\n    </BookingContext.Provider>\n  );\n}\n\nexport function useBooking(): BookingContextValue {\n  const context = useContext(BookingContext);\n  if (!context) {\n    throw new Error('useBooking must be used within a BookingProvider');\n  }\n  return context;\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":412,"cache_read_input_tokens":98435,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":412},"output_tokens":4,"service_tier":"standard","inference_geo":"global"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b57fd512-3185-49f1-a3f5-4ca4529fa7ab","uuid":"1aebbf86-70bc-4f57-92f9-3369a383cc69","timestamp":"2026-10-15T08:49:12.758Z","request_id":"req_011Cg3jYra