is.api.movie(screening.movieId).pipe(map((movie) => ({ screening, movie }))),\n        ),\n        takeUntilDestroyed(this.destroyRef),\n      )\n      .subscribe({\n        next: ({ screening, movie }) => {\n          this.screening.set(screening);\n          this.movie.set(movie);\n        },\n        error: () => void this.router.navigateByUrl('/'),\n      });\n  }\n\n  remove(ids: string[]): void {\n    const screening = this.screening();\n    if (!screening) {\n      return;\n    }\n    this.booking.removeTickets(ids);\n    if (this.selectedIds().length === 0) {\n      void this.router.navigateByUrl(`/screenings/${screening.id}/seats`);\n    }\n  }\n\n  back(): void {\n    const screening = this.screening();\n    if (screening) {\n      void this.router.navigateByUrl(`/screenings/${screening.id}/seats`);\n    }\n  }\n\n  confirm(): void {\n    const screening = this.screening();\n    if (screening) {\n      void this.router.navigateByUrl(`/screenings/${screening.id}/checkout`);\n    }\n  }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1519,"cache_read_input_tokens":125334,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1519},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c7c8768e-27bd-495d-9533-9cc8d41b9fd6","uuid":"8e340d7f-135a-4d89-9545-12d82464e33a","timestamp":"2026-11-02T15:18:54.583Z","request_id":"req_011CgeKqKJWPi8zNdnVJHLAs","wire_tool_inputs":{"toolu_01S17QoDMGe3p1A5dnzvG1Wa":{"file_path":"/workspace/project/apps/cinescope/src/app/summary/summary.ts","content":"import { ChangeDetectionStrategy, Component, DestroyRef, computed, inject, signal } from '@angular/core';\nimport { takeUntilDestroyed } from '@angular/core/rxjs-interop';\nimport { ActivatedRoute, Router } from '@angul