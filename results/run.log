mns: number[]): string {\n  const labels: string[] = [];\n  for (let index = 0; index < columns.length; index++) {\n    if (row === COUCH_ROW) {\n      labels.push(`${columns[index]}-${columns[index] + 1}`);\n      index++;\n    } else {\n      labels.push(String(columns[index]));\n    }\n  }\n  return labels.join(', ');\n}\n","userModified":false}}
