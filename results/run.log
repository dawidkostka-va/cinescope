{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Br3jLyUaeg69YY6eFDoXzZ","type":"tool_result","content":"     1\timport { vi } from 'vitest';\n     2\timport { provideHttpClient } from '@angular/common/http';\n     3\timport { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';\n     4\timport { ComponentFixture, TestBed } from '@angular/core/testing';\n     5\timport { Router, provideRouter } from '@angular/router';\n     6\timport { BookingService } from '../booking';\n     7\timport { ToastService } from '../toast';\n     8\timport { Checkout } from './checkout';\n     9\t\n    10\tconst BOOKING = { screeningId: 1, seats: ['R7C12', 'R15C1', 'R15C2'] };\n    11\t\n    12\tfunction input(fixture: ComponentFixture<Checkout>, testId: string): HTMLInputElement {\n    13\t  return fixture.nativeElement.querySelector(`[data-testid=\"${testId}\"]`) as HTMLInputElement;\n    14\t}\n    15\t\n    16\tfunction text(fixture: ComponentFixture<Checkout>, testId: string): string | null {\n    17\t  return (\n    18\t    (\n    19\t      fixture.nativeElement.querySelector(`[data-testid=\"${testId}\"]`) as HTMLElement | null\n    20\t    )?.textContent?.trim() ?? null\n    21\t  );\n    22\t}\n    23\t\n    24\t/** Types a value into a field and leaves it, as a customer would. */\n    25\tfunction type(fixture: ComponentFixture<Checkout>, testId: string, value: string): void {\n    26\t  const element = input(fixture, testId);\n    27\t  element.value = value;\n    28\t  element.dispatchEvent(new Event('input'));\n    29\t  element.dispatchEvent(new Event('blur'));\n    30\t  fixture.detectChanges();\n    31\t}\n    32\t\n    33\tfunction fillValidForm(fixture: ComponentFixture<Checkout>): void {\n    34\t  type(fixture, 'first-name-input', 'Anna');\n    35\t  type(fixture, 'last-name-input', 'Kowalska');\n    36\t  type(fixture, 'email-input', 'anna.kowalska@example.com');\n    37\t  type(fixture, 'confirm-email-input', 'anna.kowalska@example.com');\n    38\t  input(fixture, 'terms-checkbox').querySelector('input')?.click();\n    39\t  fixture.detectChanges();\n    40\t}\n    41\t\n    42\tfunction pay(fixture: ComponentFixture<Checkout>): void {\n    43\t  (fixture.nativeElement.querySelector('[data-testid=\"pay-button\"]') as HTMLButtonElement).click();\n    44\t  fixture.detectChanges();\n    45\t}\n    46\t\n    47\tdescribe('Checkout', () => {\n    48\t  let fixture: ComponentFixture<Checkout>;\n    49\t  let httpMock: HttpTestingController;\n    50\t  let toast: ToastService;\n    51\t  let router: Router;\n    52\t\n    53\t  beforeEach(async () => {\n    54\t    sessionStorage.clear();\n    55\t    sessionStorage.setItem('cinescope.booking', JSON.stringify(BOOKING));\n    56\t    await TestBed.configureTestingModule({\n    57\t      imports: [Checkout],\n    58\t      providers: [\n    59\t        provideHttpClient(),\n    60\t        provideHttpClientTesting(),\n    61\t        provideRouter([{ path: 'confirmation', children: [] }]),\n    62\t      ],\n    63\t    }).compileComponents();\n    64\t\n    65\t    httpMock = TestBed.inject(HttpTestingController);\n    66\t    toast = TestBed.inject(ToastService);\n    67\t    router = TestBed.inject(Router);\n    68\t    fixture = TestBed.createComponent(Checkout);\n    69\t    fixture.detectChanges();\n    70\t  });\n    71\t\n    72\t  afterEach(() => {\n    73\t    httpMock.verify();\n    74\t    sessionStorage.clear();\n    75\t  });\n    76\t\n    77\t  it('shows the title, the total and the labels with asterisks on required fields', () => {\n    78\t    expect(text(fixture, 'checkout-title')).toBe('Your details');\n    79\t    expect(text(fixture, 'pay-button')).toBe('Pay 121.00 PLN');\n    80\t    expect(text(fixture, 'first-name-label')).toBe('First name *');\n    81\t    expect(text(fixture, 'phone-label')).toBe('Phone number');\n    82\t  });\n    83\t\n    84\t  it('marks every field and shows the toast on an invalid form, without sending a request', () => {\n    85\t    const show = vi.spyOn(toast, 'show').mockImplementation(() => undefined);\n    86\t    pay(fixture);\n    87\t\n    88\t    expect(text(fixture, 'first-name-error')).toBe('First name is required');\n    89\t    expect(text(fixture, 'email-error')).toBe('Email is required');\n    90\t    expect(text(fixture, 'terms-error')).toBe('You must accept the terms and conditions');\n    91\t    expect(show).toHaveBeenCalledWith('The form contains errors');\n    92\t    httpMock.expectNone('http://localhost:3000/reservations');\n    93\t  });\n    94\t\n    95\t  it('shows a message once a field has been left', () => {\n    96\t    type(fixture, 'first-name-input', 'A');\n    97\t    expect(text(fixture, 'first-name-error')).toBe('First name must be at least 2 characters');\n    98\t    expect(text(fixture, 'last-name-error')).toBeNull();\n    99\t  });\n   100\t\n   101\t  it('sends the reservation, then marks the booking paid and opens the confirmation', async () => {\n   102\t    fillValidForm(fixture);\n   103\t    pay(fixture);\n   104\t\n   105\t    const request = httpMock.expectOne('http://localhost:3000/reservations');\n   106\t    expect(request.request.method).toBe('POST');\n   107\t    expect(request.request.body).toEqual({\n   108\t      screeningId: 1,\n   109\t      seats: ['R7C12', 'R15C1', 'R15C2'],\n   110\t      customer: {\n   111\t        firstName: 'Anna',\n   112\t        lastName: 'Kowalska',\n   113\t        email: 'anna.kowalska@example.com',\n   114\t        phone: '',\n   115\t      },\n   116\t      totalPrice: 121,\n   117\t    });\n   118\t    expect(text(fixture, 'pay-button')).toBe('Processing…');\n   119\t    expect(input(fixture, 'first-name-input').value).toBe('Anna');\n   120\t\n   121\t    const navigate = vi.spyOn(router, 'navigateByUrl').mockResolvedValue(true);\n   122\t    request.flush({ id: 1, ...request.request.body }, { status: 201, statusText: 'Created' });\n   123\t    f