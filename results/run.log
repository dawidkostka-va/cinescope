{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NnHVzUpTic3wjr1SxwUy5j","type":"tool_result","content":"1\timport { useEffect, useMemo, useState } from 'react';\n2\timport { useNavigate, useParams } from 'react-router-dom';\n3\timport Box from '@mui/material/Box';\n4\timport Button from '@mui/material/Button';\n5\timport Stack from '@mui/material/Stack';\n6\timport Typography from '@mui/material/Typography';\n7\timport { fetchMovie, fetchScreening } from '../../lib/api';\n8\timport { Movie, Screening } from '../../lib/types';\n9\timport { formatShowDate } from '../../lib/dates';\n10\timport { useBooking } from '../../lib/bookingContext';\n11\timport { useToast } from '../../components/Toast/ToastProvider';\n12\timport { SeatMap } from '../../components/SeatMap/SeatMap';\n13\timport { Legend } from '../../components/SeatMap/Legend';\n14\timport { SelectedSeatsPanel } from '../../components/SeatMap/SelectedSeatsPanel';\n15\t\n16\texport function SeatSelection() {\n17\t  const { id } = useParams<{ id: string }>();\n18\t  const navigate = useNavigate();\n19\t  const { booking, ensureBookingForScreening, toggleSeats, clear } = useBooking();\n20\t  const { showToast } = useToast();\n21\t\n22\t  const [screening, setScreening] = useState<Screening | null>(null);\n23\t  const [movie, setMovie] = useState<Movie | null>(null);\n24\t  const [failed, setFailed] = useState(false);\n25\t\n26\t  useEffect(() => {\n27\t    let cancelled = false;\n28\t    setScreening(null);\n29\t    setMovie(null);\n30\t    setFailed(false);\n31\t\n32\t    fetchScreening(id ?? '')\n33\t      .then((loadedScreening) => {\n34\t        if (cancelled) return;\n35\t        return fetchMovie(loadedScreening.movieId).then((loadedMovie) => {\n36\t          if (cancelled) return;\n37\t          setScreening(loadedScreening);\n38\t          setMovie(loadedMovie);\n39\t        });\n40\t      })\n41\t      .catch(() => {\n42\t        if (!cancelled) setFailed(true);\n43\t      });\n44\t\n45\t    return () => {\n46\t      cancelled = true;\n47\t    };\n48\t  }, [id]);\n49\t\n50\t  useEffect(() => {\n51\t    if (screening) {\n52\t      ensureBookingForScreening(screening.id);\n53\t    }\n54\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n55\t  }, [screening]);\n56\t\n57\t  useEffect(() => {\n58\t    if (failed) {\n59\t      navigate('/', { replace: true });\n60\t    }\n61\t  }, [failed, navigate]);\n62\t\n63\t  const occupiedSeats = useMemo(\n64\t    () => new Set(screening?.occupiedSeats ?? []),\n65\t    [screening],\n66\t  );\n67\t  const selectedSeats = useMemo(() => new Set(booking?.seats ?? []), [booking]);\n68\t\n69\t  if (!screening || !movie || !booking || booking.screeningId !== screening.id) {\n70\t    return null;\n71\t  }\n72\t\n73\t  const handleToggle = (seatIds: string[]) => {\n74\t    const result = toggleSeats(seatIds);\n75\t    if (result === 'blocked') {\n76\t      showToast('Maximum 10 seats per booking');\n77\t    }\n78\t  };\n79\t\n80\t  const handleCancel = () => {\n81\t    clear();\n82\t    navigate('/');\n83\t  };\n84\t\n85\t  const handleContinue = () => {\n86\t    if (booking.seats.length === 0) return;\n87\t    navigate(`/screenings/${screening.id}/summary`);\n88\t  };\n89\t\n90\t  return (\n91\t    <Box sx={{ maxWidth: 1100, mx: 'auto', p: 3 }}>\n92\t      <Typography data-testid=\"seat-map-title\" variant=\"h5\">\n93\t        Choose your seats\n94\t      </Typography>\n95\t      <Typography data-testid=\"seat-map-subtitle\" sx={{ mb: 2 }}>\n96\t        Show Date: {formatShowDate(screening.date, screening.time)}\n97\t      </Typography>\n98\t      <Typography data-testid=\"seat-limit-info\" sx={{ textAlign: 'center', mb: 2 }}>\n99\t        You can reserve up to 10 seats per reservation\n100\t      </Typography>\n101\t\n102\t      <SeatMap\n103\t        occupiedSeats={occupiedSeats}\n104\t        selectedSeats={selectedSeats}\n105\t        onToggle={handleToggle}\n106\t      />\n107\t\n108\t      <Box sx={{ display: 'flex', justifyContent: 'center' }}>\n109\t        <Legend />\n110\t      </Box>\n111\t\n112\t      <SelectedSeatsPanel selectedSeats={booking.seats} />\n113\t\n114\t      <Stack direction=\"row\" spacing={2}>\n115\t        <Button data-testid=\"cancel-button\" variant=\"outlined\" onClick={handleCancel}>\n116\t          Cancel\n117\t        </Button>\n118\t        <Button\n119\t          data-testid=\"continue-button\"\n120\t          variant=\"contained\"\n121\t          disabled={booking.seats.length === 0}\n122\t          onClick={handleContinue}\n123\t        >\n124\t          Continue\n125\t        </Button>\n126\t      </Stack>\n127\t    </Box>\n128\t  );\n129\t}\n130\t"}]},"parent_tool_use_id":null,"session_id":"bc998d0e-1624-444d-a35c-194e1322775c","uuid":"2c7f907a-a30a-401b-a506-a07f0ae74acb","timestamp":"2026-10-16T10:41:28.997Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/pages/SeatSelection/SeatSelection.tsx","content":"import { useEffect, useMemo, useState } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Stack from '@mui/material/Stack';\nimport Typography from '@mui/material/Typography';\nimport { fetchMovie, fetchScreening } from '../../lib/api';\nimport { Movie, Screening } from '../../lib/types';\nimport { formatShowDate } from '../../lib/dates';\nimport { useBooking } from '../../lib/bookingContext';\nimport { useToast } from '../../components/Toast/ToastProvider';\nimport { SeatMap } from '../../components/SeatMap/SeatMap';\nimport { Legend } from '../../components/SeatMap/Legend';\nimport { SelectedSeatsPanel } from '../../components/SeatMap/SelectedSeatsPanel';\n\nexport function SeatSelection() {\n  const { id } = useParams<{ id: string }>();\n  const navigate = useNavigate();\n  const { booking, ensureBookingForScreening, toggleSeats, clear } = useBooking();\n  const { showToast } = useToast();\n\n  const [screening, setScreening] = useState<Screening | null>(null);\n  const [movie, setMovie] = useState<Movie | null>(null);\n  const [failed, setFailed] = useState(false);\n\n  useEffect(() => {\n    let cancelled = false;\n    setScreening(null);\n    setMovie(null);\n    setFailed(false);\n\n    fetchScreening(id ?? '')\n      .then((loadedScreening) => {\n        if (cancelled) return;\n        return fetchMovie(loadedScreening.movieId).then((loadedMovie) => {\n          if (cancelled) return;\n          setScreening(loadedScreening);\n          setMovie(loadedMovie);\n        });\n      })\n      .catch(() => {\n        if (!cancelled) setFailed(true);\n      });\n\n    return () => {\n      cancelled = true;\n    };\n  }, [id]);\n\n  useEffect(() => {\n    if (screening) {\n      ensureBookingForScreening(screening.id);\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [screening]);\n\n  useEffect(() => {\n    if (failed) {\n      navigate('/', { replace: true });\n    }\n  }, [failed, navigate]);\n\n  const occupiedSeats = useMemo(\n    () => new Set(screening?.occupiedSeats ?? []),\n    [screening],\n  );\n  const selectedSeats = useMemo(() => new Set(booking?.seats ?? []), [booking]);\n\n  if (!screening || !movie || !booking || booking.screeningId !== screening.id) {\n    return null;\n  }\n\n  const handleToggle = (seatIds: string[]) => {\n    const result = toggleSeats(seatIds);\n    if (result === 'blocked') {\n      showToast('Maximum 10 seats per booking');\n    }\n  };\n\n  const handleCancel = () => {\n    clear();\n    navigate('/');\n  };\n\n  const handleContinue = () => {\n    if (booking.seats.length === 0) return;\n    navigate(`/screenings/${screening.id}/summary`);\n  };\n\n  return (\n    <Box sx={{ maxWidth: 1100, mx: 'auto', p: 3 }}>\n      <Typography data-testid=\"seat-map-title\" variant=\"h5\">\n        Choose your seats\n      </Typography>\n      <Typography data-testid=\"seat-map-subtitle\" sx={{ mb: 2 }}>\n        Show Date: {formatShowDate(screening.date, screening.time)}\n      </Typography>\n      <Typography data-testid=\"seat-limit-info\" sx={{ textAlign: 'center', mb: 2 }}>\n        You can reserve up to 10 seats per reservation\n      </Typography>\n\n      <SeatMap\n        occupiedSeats={occupiedSeats}\n        selectedSeats={selectedSeats}\n        onToggle={handleToggle}\n      />\n\n      <Box sx={{ display: 'flex', justifyContent: 'center' }}>\n        <Legend />\n      </Box>\n\n      <SelectedSeatsPanel selectedSeats={booking.seats} />\n\n      <Stack direction=\"row\" spacing={2}>\n        <Button data-testid=\"cancel-button\" variant=\"outlined\" onClick={handleCancel}>\n          Cancel\n        </Button>\n        <Button\n          data-testid=\"continue-button\"\n          variant=\"contained\"\n          disabled={booking.seats.length === 0}\n          onClick={handleContinue}\n        >\n          Continue\n        </Button>\n      </Stack>\n    </Box>\n  );\n}\n","numLines":130,"startLine":1,"totalLines":130}}}
