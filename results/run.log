{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cg5fiDEdvfCaXZcuiWRdw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MMCcdLqd5tKGK5zFo1qFaW","name":"Write","input":{"file_path":"/workspace/project/apps/cinescope/src/lib/bookingStore.ts","content":"import { useSyncExternalStore } from 'react';\n\nconst STORAGE_KEY = 'cinescope.booking';\n\nexport interface BookingFormValues {\n  firstName: string;\n  lastName: string;\n  email: string;\n  confirmEmail: string;\n  phone: string;\n  termsAccepted: boolean;\n}\n\nexport interface BookingState {\n  screeningId: number;\n  seats: string[];\n  form: BookingFormValues;\n  paid: boolean;\n  paidEmail: string | null;\n}\n\nfunction emptyForm(): BookingFormValues {\n  return {\n    firstName: '',\n    lastName: '',\n    email: '',\n    confirmEmail: '',\n    phone: '',\n    termsAccepted: false,\n  };\n}\n\nexport function emptyBooking(screeningId: number): BookingState {\n  return { screeningId, seats: [], form: emptyForm(), paid: false, paidEmail: null };\n}\n\nfunction readStorage(): BookingState | null {\n  try {\n    const raw = sessionStorage.getItem(STORAGE_KEY);\n    if (!raw) return null;\n    return JSON.parse(raw) as BookingState;\n  } catch {\n    return null;\n  }\n}\n\nlet booking: BookingState | null = readStorage();\nconst listeners = new Set<() => void>();\n\nfunction notify(): void {\n  listeners.forEach((listener) => listener());\n}\n\nfunction subscribe(listener: () => void): () => void {\n  listeners.add(listener);\n  return () => listeners.delete(listener);\n}\n\nexport function getBookingSnapshot(): BookingState | null {\n  return booking;\n}\n\nexport function setBooking(next: BookingState | null): void {\n  booking = next;\n  if (next) {\n    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(next));\n  } else {\n    sessionStorage.removeItem(STORAGE_KEY);\n  }\n  notify();\n}\n\nexport function clearBooking(): void {\n  setBooking(null);\n}\n\nexport function ensureBookingForScreening(screeningId: number): BookingState {\n  if (booking && booking.screeningId === screeningId && !booking.paid) {\n    return booking;\n  }\n  const fresh = emptyBooking(screeningId);\n  setBooking(fresh);\n  return fresh;\n}\n\nexport function useBooking(): BookingState | null {\n  return useSyncExternalStore(subscribe, getBookingSnapshot, getBookingSnapshot);\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":920,"cache_read_input_tokens":105452,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":920},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fc51c61a-6dab-4a2b-8142-c8f64be3453e","uuid":"b71ccebe-38df-48e5-91e6-2973ac566bc7","timestamp":"2026-10-16T09:20:00.569Z","request_id":"req_011Cg5fiCeAgXQFSJ3oVVYvy","wire_tool_inputs":{"toolu_01MMCcdLqd5tKGK5zFo1qFaW":{"file_path":"/workspace/project/apps/cinescope/src/lib/bookingStore.ts","content":"import { useSyncExternalStore } from 'react';\n\nconst STORAGE_KEY = 'cinescope.booking';\n\nexport interface BookingFormValues {\n  firstName: string;\n  lastName: string;\n  email: string;\n  confirmEmail: string;\n  phone: string;\n  termsAccepted: boolean;\n}\n\nexport interface BookingState {\n  screeningId: number;\n  seats: string[];\n  form: BookingFormValues;\n  paid: boolean;\n  paidEmail: string | null;\n}\n\nfunction emptyForm(): BookingFormValues {\n  return {\n    firstName: '',\n    lastName: '',\n    email: '',\n    confirmEmail: '',\n    phone: '',\n    termsAccepted: false,\n  };\n}\n\nexport function emptyBooking(screeningId: number): BookingState {\n  return { screeningId, seats: [], form: emptyForm(), paid: false, paidEmail: null };\n}\n\nfunction readStorage(): BookingState | null {\n  try {\n    const raw = sessionStorage.getItem(STORAGE_KEY);\n    if (!raw) return null;\n    return JSON.parse(raw) as BookingState;\n  } catch {\n    return null;\n  }\n}\n\nlet booking: BookingState | null = readStorage();\nconst listeners = new Set<() => void>();\n\nfunction notify(): void {\n  listeners.forEach((listener) => listener());\n}\n\nfunction subscribe(listener: () => void): () => void {\n  listeners.add(listener);\n  return () => listeners.delete(listener);\n}\n\nexport function getBookingSnapshot(): BookingState | null {\n  return booking;\n}\n\nexport function setBooking(next: BookingState | null): void {\n  booking = next;\n  if (next) {\n    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(next));\n  } else {\n    sessionStorage.removeItem(STORAGE_KEY);\n  }\n  notify();\n}\n\nexport function clearBooking(): void {\n  setBooking(null);\n}\n\nexport function ensureBookingForScreening(screeningId: number): BookingState {\n  if (booking && booking.screeningId === screeningId && !booking.paid) {\n    return booking;\n  }\n  const fresh = emptyBooking(screeningId);\n  setBooking(fresh);\n  return fresh;\n}\n\nexport function useBooking(): BookingState | null {\n  return useSyncExternalStore(subscribe, getBookingSnapshot, getBookingSnapshot);\n}\n"}}}
