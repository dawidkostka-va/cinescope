.isoDate}\n            data-testid=\"day-button\"\n            data-date={day.isoDate}\n            data-selected={selected ? 'true' : 'false'}\n            variant={selected ? 'contained' : 'outlined'}\n            onClick={() => onSelect(day.isoDate)}\n          >\n            {day.label}\n          </Button>\n        );\n      })}\n      <DatePicker\n        label=\"Choose a date\"\n        value={dayjs(selectedDate)}\n        minDate={dayjs(todayIsoDate())}\n        onChange={(value: Dayjs | null) => {\n          if (value && value.isValid()) {\n            onSelect(value.format('YYYY-MM-DD'));\n          }\n        }}\n        slotProps={{\n          textField: {\n            'data-testid': 'date-picker',\n            size: 'small',\n          } as never,\n        }}\n      />\n    </Stack>\n  );\n}\n","structuredPatch":[{"oldStart":27,"oldLines":8,"newStart":27,"newLines":7,"lines":["       data-testid=\"day-picker\"","       direction=\"row\"","       spacing={1}","-      alignItems=\"center\"","-      flexWrap=\"wrap\"","+      sx={{ alignItems: 'center', flexWrap: 'wrap' }}","     >","       {days.map((day) => {","         const selected = day.isoDate === selectedDate;"]}],"userModified":false,"replaceAll":false}}
