{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GeyMsvGbK87N5yCCs1QXei","type":"tool_result","content":"1\timport Button from '@mui/material/Button';\n2\timport { useEffect, useState } from 'react';\n3\timport { useNavigate, useParams } from 'react-router-dom';\n4\timport { fetchMovie, fetchScreening } from '../../api/client';\n5\timport { Movie, Screening } from '../../api/types';\n6\timport { useBooking } from '../../booking/BookingContext';\n7\timport { isBookingUsable } from '../../booking/types';\n8\timport { BookedItem, buildBookedItems, formatPrice } from '../../domain/seatLayout';\n9\timport styles from './SummaryPage.module.scss';\n10\t\n11\ttype LoadState = { status: 'loading' } | { status: 'loaded'; screening: Screening; movie: Movie };\n12\t\n13\texport function SummaryPage() {\n14\t  const { id } = useParams();\n15\t  const screeningId = Number(id);\n16\t  const navigate = useNavigate();\n17\t  const { booking, removeSeats } = useBooking();\n18\t  const [state, setState] = useState<LoadState>({ status: 'loading' });\n19\t\n20\t  useEffect(() => {\n21\t    if (!isBookingUsable(booking, screeningId)) {\n22\t      navigate('/', { replace: true });\n23\t      return;\n24\t    }\n25\t    let cancelled = false;\n26\t    (async () => {\n27\t      try {\n28\t        const screening = await fetchScreening(screeningId);\n29\t        const movie = await fetchMovie(screening.movieId);\n30\t        if (!cancelled) setState({ status: 'loaded', screening, movie });\n31\t      } catch {\n32\t        if (!cancelled) navigate('/', { replace: true });\n33\t      }\n34\t    })();\n35\t    return () => {\n36\t      cancelled = true;\n37\t    };\n38\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n39\t  }, []);\n40\t\n41\t  if (state.status === 'loading' || !booking || !isBookingUsable(booking, screeningId)) {\n42\t    return null;\n43\t  }\n44\t\n45\t  const items = buildBookedItems(booking.seats);\n46\t  const total = items.reduce((sum, item) => sum + item.price, 0);\n47\t\n48\t  function handleRemove(item: BookedItem): void {\n49\t    removeSeats(item.ids);\n50\t    if (items.length === 1) {\n51\t      navigate(`/screenings/${screeningId}/seats`);\n52\t    }\n53\t  }\n54\t\n55\t  return (\n56\t    <div className={styles.page}>\n57\t      <h1 data-testid=\"summary-title\">Your tickets</h1>\n58\t      <div data-testid=\"summary-list\">\n59\t        {items.map((item) => (\n60\t          <div key={item.key} data-testid=\"summary-item\" className={styles.item}>\n61\t            <div className={styles.itemDetails}>\n62\t              <div data-testid=\"summary-item-title\">{state.movie.title}</div>\n63\t              <div data-testid=\"summary-item-datetime\">\n64\t                {state.screening.date} {state.screening.time}\n65\t              </div>\n66\t              <div>\n67\t                Row <span data-testid=\"summary-item-row\">{item.row}</span>, Seat{' '}\n68\t                <span data-testid=\"summary-item-seat\">{item.row === 15 ? `Couch ${item.seatDescription}` : item.seatDescription}</span>\n69\t              </div>\n70\t            </div>\n71\t            <div data-testid=\"summary-item-price\">{formatPrice(item.price)}</div>\n72\t            <Button data-testid=\"summary-item-remove-button\" variant=\"outlined\" onClick={() => handleRemove(item)}>\n73\t              Remove\n74\t            </Button>\n75\t          </div>\n76\t        ))}\n77\t      </div>\n78\t      <div data-testid=\"summary-total\" className={styles.total}>\n79\t        Total: {total.toFixed(2)} PLN\n80\t      </div>\n81\t      <div className={styles.actions}>\n82\t        <Button data-testid=\"back-button\" variant=\"outlined\" onClick={() => navigate(`/screenings/${screeningId}/seats`)}>\n83\t          Back\n84\t        </Button>\n85\t        <Button data-testid=\"confirm-button\" variant=\"contained\" onClick={() => navigate(`/screenings/${screeningId}/checkout`)}>\n86\t          Confirm\n87\t        </Button>\n88\t      </div>\n89\t    </div>\n90\t  );\n91\t}\n92\t"}]},"parent_tool_use_id":null,"session_id":"18d24fdc-128d-4444-9721-af8b117c5cc6","uuid":"b97d753a-fc70-4e43-ac83-f62edfabdd03","timestamp":"2026-10-20T08:14:06.575Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/pages/summary/SummaryPage.tsx","content":"import Button from '@mui/material/Button';\nimport { useEffect, useState } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport { fetchMovie, fetchScreening } from '../../api/client';\nimport { Movie, Screening } from '../../api/types';\nimport { useBooking } from '../../booking/BookingContext';\nimport { isBookingUsable } from '../../booking/types';\nimport { BookedItem, buildBookedItems, formatPrice } from '../../domain/seatLayout';\nimport styles from './SummaryPage.module.scss';\n\ntype LoadState = { status: 'loading' } | { status: 'loaded'; screening: Screening; movie: Movie };\n\nexport function SummaryPage() {\n  const { id } = useParams();\n  const screeningId = Number(id);\n  const navigate = useNavigate();\n  const { booking, removeSeats } = useBooking();\n  const [state, setState] = useState<LoadState>({ status: 'loading' });\n\n  useEffect(() => {\n    if (!isBookingUsable(booking, screeningId)) {\n      navigate('/', { replace: true });\n      return;\n    }\n    let cancelled = false;\n    (async () => {\n      try {\n        const screening = await fetchScreening(screeningId);\n        const movie = await fetchMovie(screening.movieId);\n        if (!cancelled) setState({ status: 'loaded', screening, movie });\n      } catch {\n        if (!cancelled) navigate('/', { replace: true });\n      }\n    })();\n    return () => {\n      cancelled = true;\n    };\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  if (state.status === 'loading' || !booking || !isBookingUsable(booking, screeningId)) {\n    return null;\n  }\n\n  const items = buildBookedItems(booking.seats);\n  const total = items.reduce((sum, item) => sum + item.price, 0);\n\n  function handleRemove(item: BookedItem): void {\n    removeSeats(item.ids);\n    if (items.length === 1) {\n      navigate(`/screenings/${screeningId}/seats`);\n    }\n  }\n\n  return (\n    <div className={styles.page}>\n      <h1 data-testid=\"summary-title\">Your tickets</h1>\n      <div data-testid=\"summary-list\">\n        {items.map((item) => (\n          <div key={item.key} data-testid=\"summary-item\" className={styles.item}>\n            <div className={styles.itemDetails}>\n              <div data-testid=\"summary-item-title\">{state.movie.title}</div>\n              <div data-testid=\"summary-item-datetime\">\n                {state.screening.date} {state.screening.time}\n              </div>\n              <div>\n                Row <span data-testid=\"summary-item-row\">{item.row}</span>, Seat{' '}\n                <span data-testid=\"summary-item-seat\">{item.row === 15 ? `Couch ${item.seatDescription}` : item.seatDescription}</span>\n              </div>\n            </div>\n            <div data-testid=\"summary-item-price\">{formatPrice(item.price)}</div>\n            <Button data-testid=\"summary-item-remove-button\" variant=\"outlined\" onClick={() => handleRemove(item)}>\n              Remove\n            </Button>\n          </div>\n        ))}\n      </div>\n      <div data-testid=\"summary-total\" className={styles.total}>\n        Total: {total.toFixed(2)} PLN\n      </div>\n      <div className={styles.actions}>\n        <Button data-testid=\"back-button\" variant=\"outlined\" onClick={() => navigate(`/screenings/${screeningId}/seats`)}>\n          Back\n        </Button>\n        <Button data-testid=\"confirm-button\" variant=\"contained\" onClick={() => navigate(`/screenings/${screeningId}/checkout`)}>\n          Confirm\n        </Button>\n      </div>\n    </div>\n  );\n}\n","numLines":92,"startLine":1,"totalLines":92}}}
