": true\n        }\n      }\n    },\n    \"serve\": {\n      \"continuous\": true,\n      \"executor\": \"@angular/build:dev-server\",\n      \"defaultConfiguration\": \"development\",\n      \"options\": {\n        \"port\": 4200\n      },\n      \"configurations\": {\n        \"production\": {\n          \"buildTarget\": \"cinescope:build:production\"\n        },\n        \"development\": {\n          \"buildTarget\": \"cinescope:build:development\"\n        }\n      }\n    },\n    \"lint\": {\n      \"executor\": \"@nx/eslint:lint\"\n    },\n    \"test\": {\n      \"executor\": \"@angular/build:unit-test\",\n      \"options\": {\n        \"watch\": false\n      }\n    },\n    \"serve-static\": {\n      \"continuous\": true,\n      \"executor\": \"@nx/web:file-server\",\n      \"options\": {\n        \"buildTarget\": \"cinescope:build\",\n        \"port\": 4200,\n        \"staticFilePath\": \"dist/apps/cinescope/browser\",\n        \"spa\": true\n      }\n    }\n  }\n}\n\n{\n  \"name\": \"cinescope\",\n  \"version\": \"0.0.0\",\n  \"license\": \"MIT\",\n  \"private\": true,\n  \"packageManager\": \"pnpm@11.1.0\",\n  \"engines\": {\n    \"node\": \">=26.5.0\",\n    \"pnpm\": \">=11.1.0\"\n  },\n  \"scripts\": {\n    \"api\": \"json-server --watch db.json --port 3000\",\n    \"lint\": \"nx run-many -t lint\",\n    \"format\": \"prettier --write .\"\n  },\n  \"devDependencies\": {\n    \"@angular/build\": \"~22.0.4\",\n    \"@angular/cli\": \"~22.0.4\",\n    \"@angular/compiler-cli\": \"~22.0.4\",\n    \"@eslint/js\": \"^9.39.5\",\n    \"@nx/angular\": \"23.1.1\",\n    \"@nx/eslint\": \"23.1.1\",\n    \"@nx/eslint-plugin\": \"23.1.1\",\n    \"@nx/web\": \"23.1.1\",\n    \"angular-eslint\": \"^22.0.0\",\n    \"eslint\": \"^9.39.5\",\n    \"jsdom\": \"^27.1.0\",\n    \"json-server\": \"0.17.4\",\n    \"nx\": \"23.1.1\",\n    \"prettier\": \"^3.8.1\",\n    \"sass\": \"^1.97.2\",\n    \"tslib\": \"^2.3.0\",\n    \"typescript\": \"~6.0.3\",\n    \"typescript-eslint\": \"^