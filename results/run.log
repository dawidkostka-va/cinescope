he specification is [`../README.md`](../README.md); each\nticket names the sections it implements and the acceptance criteria it must satisfy.\n\n| # | Ticket | Blocked by | Criteria |\n|---|---|---|---|\n| 01 | [Movie list and day picker](01-movie-list.md) | — | 11 |\n| 02 | [Auditorium map](02-auditorium-map.md) | 01 | 13 |\n| 03 | [Seat selection, legend and selected-seats panel](03-seat-selection.md) | 02 | 14 |\n| 04 | [Booking and summary](04-booking-summary.md) | 03 | 16 |\n| 05 | [Checkout and payment](05-checkout.md) | 04 | 13 |\n| 06 | [Confirmation and booking lifecycle](06-confirmation.md) | 05 | 2 |\n| 07 | [Final pass](07-final-pass.md) | 01–06 | all |\n\nA ticket is done when every box in it is ticked and `pnpm nx build cinescope` succeeds.\n# 07: Final pass\n\n**What to build:** A walk through the whole flow — movie list, seat map, summary, checkout,\nconfirmation — against the specification, fixing whatever does not match.\n\n**Specification:** the whole of `README.md`, section 9 in particular.\n\n**Blocked by:** 01–06.\n\n**Status:** ready\n\n- [ ] Every acceptance criterion in section 10 is met.\n- [ ] `pnpm nx build cinescope` succeeds.\n 2007 spec/tickets/01-movie-list.md\n 2045 spec/tickets/02-auditorium-map.md\n 1842 spec/tickets/03-seat-selection.md\n 1953 spec/tickets/04-booking-summary.md\n 2048 spec/tickets/05-checkout.md\n 1075 spec/tickets/06-confirmation.md\n  402 spec/tickets/07-final-pass.md\n  877 spec/tickets/README.md\n12249 total\nimport { ApplicationConfig, provideBrowserGlobalErrorListeners } from '@angular/core';\nimport { provideNativeDateAdapter } from '@angular/material/core';\nimport { provideRouter } from '@angular/router';\nimport { appRoutes } from './app.routes';\n\nexport const appConfig: ApplicationConfig = {\n  providers: [provideBrowserGlobalErrorListeners(), provideRouter(appRoutes), provideNativeDateAdapter()],\n};\n<router-outlet />\nimport { Route } from '@angular/router';\n\nexport const appRoutes: Route[] = [];\nimport { Component } from '@angular/core';\nimport { RouterOutlet } from '@angular/router';\n\n@Component({\n  imports: [RouterOutlet],\n  selector: 'app-root',\n  templateUrl: './app.html',\n  styleUrl: './app.scss',\n})\nexport class App {}\nimport { TestBed } from '@angular/core/testing';\nimport { App } from './app';\n\ndescribe('App', () => {\n  beforeEach(async () => {\n    await TestBed.configureTestingModule({\n      imports: [App],\n    }).compileComponents();\n  });\n\n  it('should create', () => {\n    const fixture = TestBed.createComponent(App);\n    expect(fixture.componentInstance).toBeTruthy();\n  });\n});\n@use '@angular/material' as mat;\n\nhtml {\n  color-scheme: light;\n  @include mat.theme(\n    (\n      color: mat.$azure-palette,\n      typography: Roboto,\n      density: 0,\n    )\n  );\n}\n\nbody {\n  margin: 0;\n  font-family: Roboto, 'Helvetica Neue', sans-serif;\n}\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>Cinescope</title>\n    <base href=\"/\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <link rel=\"icon\" type=\"image/x-icon\" href=\"favicon.ico\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" />\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap\" rel=\"stylesheet\" />\n  </head>\n  <body>\n    <app-root></app-root>\n  </body>\n</html>\nimport { bootstrapApplication } from '@angular/platform-browser';\nimport { appConfig } from './app/app.config';\nimport { App } from './app/app';\n\nbootstrapApplication(App, appConfig).catch((err) => console.error(err));\n{\n  \"name\": \"cinescope\",\n  \"$schema\": \"../../node_modules/nx/schemas/project-schema.json\",\n  \"projectType\": \"application\",\n  \"prefix\": \"app\",\n  \"sourceRoot\": \"apps/cinescope/src\",\n  \"tags\": [],\n  \"targets\": {\n    \"build\": {\n      \"executor\": \"@angular/build:application\",\n      \"outputs\": [\n        \"{options.outputPath}\"\n      ],\n      \"defaultConfiguration\": \"production\",\n      \"options\": {\n        \"outputPath\": \"dist/apps/cinescope\",\n        \"browser\": \"apps/cinescope/src/main.ts\",\n        \"tsConfig\": \"apps/cinescope/tsconfig.app.json\",\n        \"inlineStyleLanguage\": \"scss\",\n        \"assets\": [\n          {\n            \"glob\": \"**/*\",\n            \"input\": \"apps/cinescope/public\"\n          }\n        ],\n        \"styles\": [\n          \"apps/cinescope/src/styles.scss\"\n        ]\n      },\n      \"configurations\": {\n        \"production\": {\n          \"budgets\": [\n            {\n              \"type\": \"initial\",\n              \"maximumWarning\": \"500kb\",\n              \"maximumError\": \"1mb\"\n            }\n          ],\n          \"outputHashing\": \"all\"\n        },\n        \"development\": {\n          \"optimization\": false,\n          \"extractLicenses\": false,\n          \"sourceMap\": true\n        }\n      }\n    },\n    \"serve\": {\n      \"continuous\": true,\n      \"executor\": \"@angular/build:dev-server\",\n      \"defaultConfiguration\": \"development\",\n      \"options\": {\n        \"port\": 4200\n      },\n      \"configurations\": {\n        \"production\": {\n          \"buildTarget\": \"cinescope:build:production\"\n        },\n        \"development\": {\n          \"buildTarget\": \"cinescope:build:development\"\n        }\n      }\n    },\n    \"lint\": {\n      \"executor\": \"@nx/eslint:lint\"\n    },\n    \"test\": {\n      \"executor\": \"@angular/build:unit-test\",\n      \"options\": {\n        \"watch\": false\n      }\n    },\n    \"serve-static\": {\n      \"continuous\": true,\n      \"executor\": \"@nx/web:file-server\",\n      \"options\": {\n        \"buildTarget\": \"cinescope:build\",\n        \"port\": 4200,\n        \"staticFilePath\": \"dist/apps/cinescope/browser\",\n        \"spa\": true\n      }\n    }\n  }\n}\n{\n  \"name\": \"cinescope\",\n  \"version\": \"0.0.0\",\n  \"license\": \"MIT\",\n  \"private\": true,\n  \"packageManager\": \"pnpm@11.1.0\",\n  \"engines\": {\n    \"node\": \">=26.5.0\",\n    \"pnpm\": \">=11.1.0\"\n  },\n  \"scripts\": {\n    \"api\": \"json-server --watch db.json --port 3000\",\n    \"lint\": \"nx run-many -t lint\",\n    \"format\": \"prettier --write .\"\n  },\n  \"devDependencies\": {\n    \"@angular/build\": \"~22.0.4\",\n    \"@angular/cli\": \"~22.0.4\",\n    \"@angular/compiler-cli\": \"~22.0.4\",\n    \"@eslint/js\": \"^9.39.5\",\n    \"@nx/angular\": \"23.1.1\",\n    \"@nx/eslint\": \"23.1.1\",\n    \"@nx/eslint-plugin\": \"23.1.1\",\n    \"@nx/web\": \"23.1.1\",\n    \"angular-eslint\": \"^22.0.0\",\n    \"eslint\": \"^9.39.5\",\n    \"jsdom\": \"^27.1.0\",\n    \"json-server\": \"0.17.4\",\n    \"nx\": \"23.1.1\",\n    \"prettier\": \"^3.8.1\",\n    \"sass\": \"^1.97.2\",\n    \"tslib\": \"^2.3.0\",\n    \"typescript\": \"~6.0.3\",\n    \"typescript-eslint\": \"^8.69.0\",\n    \"vitest\": \"^4.0.8\"\n  },\n  \"dependencies\": {\n    \"@angular/cdk\": \"~22.0.7\",\n    \"@angular/common\": \"~22.0.4\",\n    \"@angular/compiler\": \"~22.0.4\",\n    \"@angular/core\": \"~22.0.4\",\n    \"@angular/forms\": \"~22.0.4\",\n    \"@angular/material\": \"~22.0.7\",\n    \"@angular/platform-browser\": \"~22.0.4\",\n    \"@angular/router\": \"~22.0.4\",\n    \"rxjs\": \"~7.8.0\"\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
