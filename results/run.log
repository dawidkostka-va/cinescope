{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cg5m3simS9N3QB7jUHGLg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CmAyVnu55j5wtdPcaeNzzq","name":"Write","input":{"file_path":"/workspace/project/apps/cinescope/src/pages/Checkout/Checkout.tsx","content":"import { useEffect, useState } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport Box from '@mui/material/Box';\nimport Button from '@mui/material/Button';\nimport Checkbox from '@mui/material/Checkbox';\nimport FormControlLabel from '@mui/material/FormControlLabel';\nimport Stack from '@mui/material/Stack';\nimport TextField from '@mui/material/TextField';\nimport Typography from '@mui/material/Typography';\nimport { useBooking } from '../../lib/bookingContext';\nimport { useToast } from '../../components/Toast/ToastProvider';\nimport { createReservation } from '../../lib/api';\nimport { CheckoutFormValues } from '../../lib/types';\nimport { formatPrice, totalPrice, toSelectionUnits } from '../../lib/seats';\nimport {\n  validateConfirmEmail,\n  validateEmail,\n  validateFirstName,\n  validateLastName,\n  validatePhone,\n  validateTerms,\n} from '../../lib/validation';\n\ntype FieldName = keyof CheckoutFormValues;\n\nexport function Checkout() {\n  const { id } = useParams<{ id: string }>();\n  const screeningId = Number(id);\n  const navigate = useNavigate();\n  const { booking, setForm, pay } = useBooking();\n  const { showToast } = useToast();\n\n  const [touched, setTouched] = useState<Record<FieldName, boolean>>({\n    firstName: false,\n    lastName: false,\n    email: false,\n    confirmEmail: false,\n    phone: false,\n    terms: false,\n  });\n  const [submitting, setSubmitting] = useState(false);\n\n  const bookingIsValid =\n    !!booking &&\n    !booking.paid &&\n    booking.screeningId === screeningId &&\n    booking.seats.length > 0;\n\n  useEffect(() => {\n    if (!bookingIsValid) {\n      navigate('/', { replace: true });\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  if (!bookingIsValid || !booking) {\n    return null;\n  }\n\n  const form = booking.form;\n  const total = totalPrice(booking.seats);\n\n  const errors = {\n    firstName: validateFirstName(form.firstName),\n    lastName: validateLastName(form.lastName),\n    email: validateEmail(form.email),\n    confirmEmail: validateConfirmEmail(form.email, form.confirmEmail),\n    phone: validatePhone(form.phone),\n    terms: validateTerms(form.terms),\n  };\n\n  const updateField = <K extends FieldName>(field: K, value: CheckoutFormValues[K]) => {\n    setForm({ ...form, [field]: value });\n  };\n\n  const handleBlur = (field: FieldName) => {\n    setTouched((prev) => ({ ...prev, [field]: true }));\n  };\n\n  const handlePay = async () => {\n    const hasErrors = Object.values(errors).some((error) => error !== null);\n    if (hasErrors) {\n      setTouched({\n        firstName: true,\n        lastName: true,\n        email: true,\n        confirmEmail: true,\n        phone: true,\n        terms: true,\n      });\n      showToast('The form contains errors');\n      return;\n    }\n\n    setSubmitting(true);\n    try {\n      const seats = toSelectionUnits(booking.seats).flatMap((unit) => unit.seatIds);\n      await createReservation({\n        screeningId: booking.screeningId,\n        seats,\n        customer: {\n          firstName: form.firstName,\n          lastName: form.lastName,\n          email: form.email,\n          phone: form.phone,\n        },\n        totalPrice: total,\n      });\n      pay(form.email);\n      navigate('/confirmation');\n    } catch {\n      setSubmitting(false);\n      showToast('Payment failed. Please try again.');\n    }\n  };\n\n  return (\n    <Box sx={{ maxWidth: 600, mx: 'auto', p: 3 }}>\n      <Typography data-testid=\"checkout-title\" variant=\"h5\" sx={{ mb: 2 }}>\n        Your details\n      </Typography>\n\n      <Stack spacing={2}>\n        <TextField\n          label=\"First name *\"\n          value={form.firstName}\n          onChange={(e) => updateField('firstName', e.target.value)}\n          onBlur={() => handleBlur('firstName')}\n          error={touched.firstName && !!errors.firstName}\n          helperText={touched.firstName ? errors.firstName ?? undefined : undefined}\n          slotProps={{\n            htmlInput: { 'data-testid': 'first-name-input' },\n            inputLabel: { 'data-testid': 'first-name-label' },\n            formHelperText: { 'data-testid': 'first-name-error' },\n          }}\n        />\n\n        <TextField\n          label=\"Last name *\"\n          value={form.lastName}\n          onChange={(e) => updateField('lastName', e.target.value)}\n          onBlur={() => handleBlur('lastName')}\n          error={touched.lastName && !!errors.lastName}\n          helperText={touched.lastName ? errors.lastName ?? undefined : undefined}\n          slotProps={{\n            htmlInput: { 'data-testid': 'last-name-input' },\n            inputLabel: { 'data-testid': 'last-name-label' },\n            formHelperText: { 'data-testid': 'last-name-error' },\n          }}\n        />\n\n        <TextField\n          label=\"Email *\"\n          value={form.email}\n          onChange={(e) => updateField('email', e.target.value)}\n          onBlur={() => handleBlur('email')}\n          error={touched.email && !!errors.email}\n          helperText={touched.email ? errors.email ?? undefined : undefined}\n          slotProps={{\n            htmlInput: { 'data-testid': 'email-input' },\n            inputLabel: { 'data-testid': 'email-label' },\n            formHelperText: { 'data-testid': 'email-error' },\n          }}\n        />\n\n        <TextField\n          label=\"Confirm email *\"\n          value={form.confirmEmail}\n          onChange={(e) => updateField('confirmEmail', e.target.value)}\n          onBlur={() => handleBlur('confirmEmail')}\n          error={touched.confirmEmail && !!errors.confirmEmail}\n          helperText={touched.confirmEmail ? errors.confirmEmail ?? undefined : undefined}\n          slotProps={{\n            htmlInput: { 'data-testid': 'confirm-email-input' },\n            inputLabel: { 'data-testid': 'confirm-email-label' },\n            formHelperText: { 'data-testid': 'confirm-email-error' },\n          }}\n        />\n\n        <TextField\n          label=\"Phone number\"\n          value={form.phone}\n          onChange={(e) => updateField('phone', e.target.value)}\n          onBlur={() => handleBlur('phone')}\n          error={touched.phone && !!errors.phone}\n          helperText={touched.phone ? errors.phone ?? undefined : undefined}\n          slotProps={{\n            htmlInput: { 'data-testid': 'phone-input' },\n            inputLabel: { 'data-testid': 'phone-label' },\n            formHelperText: { 'data-testid': 'phone-error' },\n          }}\n        />\n\n        <FormControlLabel\n          control={\n            <Checkbox\n              checked={form.terms}\n              onChange={(e) => {\n                updateField('terms', e.target.checked);\n                handleBlur('terms');\n              }}\n              slotProps={{ input: { 'data-testid': 'terms-checkbox' } as never }}\n            />\n          }\n          label={<span data-testid=\"terms-label\">I accept the terms and conditions *</span>}\n        />\n        {touched.terms && errors.terms && (\n          <Typography data-testid=\"terms-error\" color=\"error\" variant=\"caption\">\n            {errors.terms}\n          </Typography>\n        )}\n      </Stack>\n\n      <Stack direction=\"row\" spacing={2} sx={{ mt: 3 }}>\n        <Button\n          data-testid=\"checkout-back-button\"\n          variant=\"outlined\"\n          onClick={() => navigate(`/screenings/${booking.screeningId}/summary`)}\n        >\n          Back\n        </Button>\n        <Button\n          data-testid=\"pay-button\"\n          variant=\"contained\"\n          disabl