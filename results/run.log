{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VKKVWJXWPR2DjjzxQNe5RH","type":"tool_result","content":"1\timport { createContext, ReactNode, useContext, useEffect, useState } from 'react';\n2\timport { Booking, BookingForm, createEmptyBooking } from './types';\n3\t\n4\tconst STORAGE_KEY = 'cinescope.booking';\n5\t\n6\tfunction loadBooking(): Booking | null {\n7\t  try {\n8\t    const raw = sessionStorage.getItem(STORAGE_KEY);\n9\t    return raw ? (JSON.parse(raw) as Booking) : null;\n10\t  } catch {\n11\t    return null;\n12\t  }\n13\t}\n14\t\n15\tfunction saveBooking(booking: Booking | null): void {\n16\t  if (booking === null) {\n17\t    sessionStorage.removeItem(STORAGE_KEY);\n18\t  } else {\n19\t    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(booking));\n20\t  }\n21\t}\n22\t\n23\texport type ToggleSeatResult = 'added' | 'removed' | 'limit';\n24\t\n25\tinterface BookingContextValue {\n26\t  booking: Booking | null;\n27\t  /** Keeps the booking in progress when it belongs to this screening and is unpaid, otherwise starts a new empty one. */\n28\t  startBookingForScreening: (screeningId: number) => void;\n29\t  /** Toggles a seat (one id) or a couch (two ids) as a single unit. */\n30\t  toggleSeatGroup: (ids: string[]) => ToggleSeatResult;\n31\t  removeSeats: (ids: string[]) => void;\n32\t  updateForm: (partial: Partial<BookingForm>) => void;\n33\t  markPaid: (email: string) => void;\n34\t  clearBooking: () => void;\n35\t}\n36\t\n37\tconst BookingContext = createContext<BookingContextValue | null>(null);\n38\t\n39\texport function BookingProvider({ children }: { children: ReactNode }) {\n40\t  const [booking, setBooking] = useState<Booking | null>(() => loadBooking());\n41\t\n42\t  useEffect(() => {\n43\t    saveBooking(booking);\n44\t  }, [booking]);\n45\t\n46\t  function startBookingForScreening(screeningId: number): void {\n47\t    setBooking((prev) => {\n48\t      if (prev && prev.screeningId === screeningId && !prev.paid) {\n49\t        return prev;\n50\t      }\n51\t      return createEmptyBooking(screeningId);\n52\t    });\n53\t  }\n54\t\n55\t  function toggleSeatGroup(ids: string[]): ToggleSeatResult {\n56\t    if (!booking) {\n57\t      return 'removed';\n58\t    }\n59\t    const isSelected = ids.every((id) => booking.seats.includes(id));\n60\t    if (isSelected) {\n61\t      setBooking({ ...booking, seats: booking.seats.filter((id) => !ids.includes(id)) });\n62\t      return 'removed';\n63\t    }\n64\t    if (booking.seats.length + ids.length > 10) {\n65\t      return 'limit';\n66\t    }\n67\t    setBooking({ ...booking, seats: [...booking.seats, ...ids] });\n68\t    return 'added';\n69\t  }\n70\t\n71\t  function removeSeats(ids: string[]): void {\n72\t    if (!booking) return;\n73\t    setBooking({ ...booking, seats: booking.seats.filter((id) => !ids.includes(id)) });\n74\t  }\n75\t\n76\t  function updateForm(partial: Partial<BookingForm>): void {\n77\t    if (!booking) return;\n78\t    setBooking({ ...booking, form: { ...booking.form, ...partial } });\n79\t  }\n80\t\n81\t  function markPaid(email: string): void {\n82\t    if (!booking) return;\n83\t    setBooking({ ...booking, paid: true, customerEmail: email });\n84\t  }\n85\t\n86\t  function clearBooking(): void {\n87\t    setBooking(null);\n88\t  }\n89\t\n90\t  return (\n91\t    <BookingContext.Provider\n92\t      value={{ booking, startBookingForScreening, toggleSeatGroup, removeSeats, updateForm, markPaid, clearBooking }}\n93\t    >\n94\t      {children}\n95\t    </BookingContext.Provider>\n96\t  );\n97\t}\n98\t\n99\texport function useBooking(): BookingContextValue {\n100\t  const value = useContext(BookingContext);\n101\t  if (!value) {\n102\t    throw new Error('useBooking must be used within a BookingProvider');\n103\t  }\n104\t  return value;\n105\t}\n106\t"}]},"parent_tool_use_id":null,"session_id":"18d24fdc-128d-4444-9721-af8b117c5cc6","uuid":"2577629d-718c-4f0c-8fa2-ff0c8a8e999b","timestamp":"2026-10-20T08:14:28.616Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/booking/BookingContext.tsx","content":"import { createContext, ReactNode, useContext, useEffect, useState } from 'react';\nimport { Booking, BookingForm, createEmptyBooking } from './types';\n\nconst STORAGE_KEY = 'cinescope.booking';\n\nfunction loadBooking(): Booking | null {\n  try {\n    const raw = sessionStorage.getItem(STORAGE_KEY);\n    return raw ? (JSON.parse(raw) as Booking) : null;\n  } catch {\n    return null;\n  }\n}\n\nfunction saveBooking(booking: Booking | null): void {\n  if (booking === null) {\n    sessionStorage.removeItem(STORAGE_KEY);\n  } else {\n    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(booking));\n  }\n}\n\nexport type ToggleSeatResult = 'added' | 'removed' | 'limit';\n\ninterface BookingContextValue {\n  booking: Booking | null;\n  /** Keeps the booking in progress when it belongs to this screening and is unpaid, otherwise starts a new empty one. */\n  startBookingForScreening: (screeningId: number) => void;\n  /** Toggles a seat (one id) or a couch (two ids) as a single unit. */\n  toggleSeatGroup: (ids: string[]) => ToggleSeatResult;\n  removeSeats: (ids: string[]) => void;\n  updateForm: (partial: Partial<BookingForm>) => void;\n  markPaid: (email: string) => void;\n  clearBooking: () => void;\n}\n\nconst BookingContext = createContext<BookingContextValue | null>(null);\n\nexport function BookingProvider({ children }: { children: ReactNode }) {\n  const [booking, setBooking] = useState<Booking | null>(() => loadBooking());\n\n  useEffect(() => {\n    saveBooking(booking);\n  }, [booking]);\n\n  function startBookingForScreening(screeningId: number): void {\n    setBooking((prev) => {\n      if (prev && prev.screeningId === screeningId && !prev.paid) {\n        return prev;\n      }\n      return createEmptyBooking(screeningId);\n    });\n  }\n\n  function toggleSeatGroup(ids: string[]): ToggleSeatResult {\n    if (!booking) {\n      return 'removed';\n    }\n    const isSelected = ids.every((id) => booking.seats.includes(id));\n    if (isSelected) {\n      setBooking({ ...booking, seats: booking.seats.filter((id) => !ids.includes(id)) });\n      return 'removed';\n    }\n    if (booking.seats.length + ids.length > 10) {\n      return 'limit';\n    }\n    setBooking({ ...booking, seats: [...booking.seats, ...ids] });\n    return 'added';\n  }\n\n  function removeSeats(ids: string[]): void {\n    if (!booking) return;\n    setBooking({ ...booking, seats: booking.seats.filter((id) => !ids.includes(id)) });\n  }\n\n  function updateForm(partial: Partial<BookingForm>): void {\n    if (!booking) return;\n    setBooking({ ...booking, form: { ...booking.form, ...partial } });\n  }\n\n  function markPaid(email: string): void {\n    if (!booking) return;\n    setBooking({ ...booking, paid: true, customerEmail: email });\n  }\n\n  function clearBooking(): void {\n    setBooking(null);\n  }\n\n  return (\n    <BookingContext.Provider\n      value={{ booking, startBookingForScreening, toggleSeatGroup, removeSeats, updateForm, markPaid, clearBooking }}\n    >\n      {children}\n    </BookingContext.Provider>\n  );\n}\n\nexport function useBooking(): BookingContextValue {\n  const value = useContext(BookingContext);\n  if (!value) {\n    throw new Error('useBooking must be used within a BookingProvider');\n  }\n  return value;\n}\n","numLines":106,"startLine":1,"totalLines":106}}}
