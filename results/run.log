251\t        showToast('Maximum 10 seats per booking');\n252\t        return;\n253\t      }\n254\t      nextSeats = [...currentBooking.seats, idA, idB];\n255\t    }\n256\t    setBooking({ ...currentBooking, seats: nextSeats });\n257\t  }\n258\t\n259\t  function handleCancel() {\n260\t    clearBooking();\n261\t    navigate('/');\n262\t  }\n263\t\n264\t  function handleContinue() {\n265\t    if (booking!.seats.length === 0) return;\n266\t    navigate(`/screenings/${screeningId}/summary`);\n267\t  }\n268\t\n269\t  const rows = Array.from({ length: ROW_COUNT }, (_, i) => i + 1);\n270\t\n271\t  return (\n272\t    <div className={styles.page}>\n273\t      <h1 data-testid=\"seat-map-title\">Choose your seats</h1>\n274\t      <div data-testid=\"seat-map-subtitle\">Show Date: {formatShowDate(screening.date, screening.time)}</div>"}]},"parent_tool_use_id":null,"session_id":"fc51c61a-6dab-4a2b-8142-c8f64be3453e","uuid":"65319dde-6484-4960-8673-11a1f58899de","timestamp":"2026-10-16T09:22:44.167Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/project/apps/cinescope/src/pages/SeatSelectionPage.tsx","content":"        if (cancelled) return;\n        ensureBookingForScreening(screeningId);\n        setData({ status: 'loaded', screening, movie });\n      })\n      .catch(() => {\n        if (!cancelled) navigate('/', { replace: true });\n      });\n    return () => {\n      cancelled = true;\n    };\n  }, [screeningId, navigate]);\n\n  if (data.status !== 'loaded' || !booking || booking.screeningId !== screeningId) {\n    return null;\n  }\n\n  const screening = data.screening as Screening;\n  const occupied = new Set(screening.occupiedSeats);\n  const selected = new Set(booking.seats);\n\n  function toggleSeat(targetId: string) {\n    if (occupied.has(targetId)) return;\n    const currentBooking = booking!;\n    const already = currentBooking.seats.includes(targetId);\n    let nextSeats: string[];\n    if (already) {\n      nextSeats = currentBooking.seats.filter((s) => s !== targetId);\n    } else {\n      if (currentBooking.seats.length + 1 > MAX_SEATS_PER_BOOKING) {\n        showToast('Maximum 10 seats per booking');\n        return;\n      }\n      nextSeats = [...currentBooking.seats, targetId];\n    }\n    setBooking({ ...currentBooking, seats: nextSeats });\n  }\n\n  function toggleCouch(idA: string, idB: string) {\n    if (occupied.has(idA) || occupied.has(idB)) return;\n    const currentBooking = booking!;\n    const already = currentBooking.seats.includes(idA) && currentBooking.seats.includes(idB);\n    let nextSeats: string[];\n    if (already) {\n      nextSeats = currentBooking.seats.filter((s) => s !== idA && s !== idB);\n    } else {\n      if (currentBooking.seats.length + 2 > MAX_SEATS_PER_BOOKING) {\n        showToast('Maximum 10 seats per booking');\n        return;\n      }\n      nextSeats = [...currentBooking.seats, idA, idB];\n    }\n    setBooking({ ...currentBooking, seats: nextSeats });\n  }\n\n  function handleCancel() {\n    clearBooking();\n    navigate('/');\n  }\n\n  function handleContinue() {\n    if (booking!.seats.length === 0) return;\n    navigate(`/screenings/${screeningId}/summary`);\n  }\n\n  const rows = Array.from({ length: ROW_COUNT }, (_, i) => i + 1);\n\n  return (\n    <div className={styles.page}>\n      <h1 data-testid=\"seat-map-title\">Choose your seats</h1>\n      <div data-testid=\"seat-map-subtitle\">Show Date: {formatShowDate(screening.date, screening.time)}</div>","numLines":70,"startLine":205,"totalLines":308}}}
