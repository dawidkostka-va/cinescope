{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016qmS7EFfetnf3ngAKo32aG","type":"tool_result","content":"1\timport { useCallback, useEffect, useState } from 'react';\n2\timport { useNavigate, useSearchParams } from 'react-router-dom';\n3\timport Box from '@mui/material/Box';\n4\timport Button from '@mui/material/Button';\n5\timport Card from '@mui/material/Card';\n6\timport CardContent from '@mui/material/CardContent';\n7\timport Stack from '@mui/material/Stack';\n8\timport Typography from '@mui/material/Typography';\n9\timport { Dayjs } from 'dayjs';\n10\timport { fetchMovies, fetchScreeningsByDate } from '../../api';\n11\timport type { Movie, Screening } from '../../types';\n12\timport { parseDateParam, toISODate } from '../../dateUtils';\n13\timport { DayPicker } from './DayPicker';\n14\t\n15\tinterface MovieWithScreenings {\n16\t  movie: Movie;\n17\t  screenings: Screening[];\n18\t}\n19\t\n20\ttype LoadState =\n21\t  | { status: 'loading' }\n22\t  | { status: 'error' }\n23\t  | { status: 'loaded'; movies: MovieWithScreenings[] };\n24\t\n25\texport function MovieListPage() {\n26\t  const [searchParams, setSearchParams] = useSearchParams();\n27\t  const navigate = useNavigate();\n28\t  const selectedDate = parseDateParam(searchParams.get('date'));\n29\t  const selectedISO = toISODate(selectedDate);\n30\t  const [state, setState] = useState<LoadState>({ status: 'loading' });\n31\t  const [retryToken, setRetryToken] = useState(0);\n32\t\n33\t  useEffect(() => {\n34\t    let cancelled = false;\n35\t    setState({ status: 'loading' });\n36\t\n37\t    async function load() {\n38\t      try {\n39\t        const [movies, screenings] = await Promise.all([\n40\t          fetchMovies(),\n41\t          fetchScreeningsByDate(selectedISO),\n42\t        ]);\n43\t        if (cancelled) return;\n44\t        const screeningsByMovie = new Map<number, Screening[]>();\n45\t        for (const screening of screenings) {\n46\t          const list = screeningsByMovie.get(screening.movieId) ?? [];\n47\t          list.push(screening);\n48\t          screeningsByMovie.set(screening.movieId, list);\n49\t        }\n50\t        const moviesWithScreenings: MovieWithScreenings[] = movies\n51\t          .map((movie) => ({\n52\t            movie,\n53\t            screenings: (screeningsByMovie.get(movie.id) ?? []).sort((a, b) =>\n54\t              a.time.localeCompare(b.time),\n55\t            ),\n56\t          }))\n57\t          .filter((entry) => entry.screenings.length > 0);\n58\t        setState({ status: 'loaded', movies: moviesWithScreenings });\n59\t      } catch {\n60\t        if (!cancelled) {\n61\t          setState({ status: 'error' });\n62\t        }\n63\t      }\n64\t    }\n65\t\n66\t    load();\n67\t    return () => {\n68\t      cancelled = true;\n69\t    };\n70\t  }, [selectedISO, retryToken]);\n71\t\n72\t  const handleSelectDate = useCallback(\n73\t    (date: Dayjs) => {\n74\t      setSearchParams({ date: toISODate(date) });\n75\t    },\n76\t    [setSearchParams],\n77\t  );\n78\t\n79\t  return (\n80\t    <Box sx={{ maxWidth: 960, mx: 'auto', p: 3 }}>\n81\t      <Stack spacing={3}>\n82\t        <DayPicker selectedDate={selectedDate} onSelectDate={handleSelectDate} />\n83\t\n84\t        {state.status === 'loading' && <Typography data-testid=\"movies-loading\">Loading…</Typography>}\n85\t\n86\t        {state.status === 'error' && (\n87\t          <Box data-testid=\"movies-error\">\n88\t            <Typography>Failed to load movies</Typography>\n89\t            <Button\n90\t              data-testid=\"movies-retry-button\"\n91\t              variant=\"contained\"\n92\t              onClick={() => setRetryToken((n) => n + 1)}\n93\t            >\n94\t              Retry\n95\t            </Button>\n96\t          </Box>\n97\t        )}\n98\t\n99\t        {state.status === 'loaded' && state.movies.length === 0 && (\n100\t          <Typography data-testid=\"movies-empty\">No screenings on this day</Typography>\n101\t        )}\n102\t\n103\t        {state.status === 'loaded' && state.movies.length > 0 && (\n104\t          <Stack data-testid=\"movie-list\" spacing={2}>\n105\t            {state.movies.map(({ movie, screenings }) => (\n106\t              <Card key={movie.id} data-testid=\"movie-card\" data-movie-id={movie.id}>\n107\t                <CardContent>\n108\t                  <Typography variant=\"h6\" data-testid=\"movie-title\">\n109\t                    {movie.title}\n110\t                  </Typography>\n111\t                  <Typography data-testid=\"movie-genre\">{movie.genre}</Typography>\n112\t                  <Typography data-testid=\"movie-runtime\">{movie.runtimeMinutes} min</Typography>\n113\t                  <Typography data-testid=\"movie-format\">{movie.format}</Typography>\n114\t                  <Stack direction=\"row\" spacing={1} sx={{ mt: 1, flexWrap: 'wrap' }}>\n115\t                    {screenings.map((screening) => (\n116\t                      <Button\n117\t                        key={screening.id}\n118\t                        data-testid=\"screening-button\"\n119\t                        data-screening-id={screening.id}\n120\t                        variant=\"outlined\"\n121\t                        onClick={() => navigate(`/screenings/${screening.id}/seats`)}\n122\t                      >\n123\t                        {screening.time}\n124\t                      </Button>\n125\t                    ))}\n126\t                  </Stack>\n127\t                </CardContent>\n128\t              </Card>\n129\t            ))}\n130\t          </Stack>\n131\t        )}\n132\t      </Stack>\n133\t    </Box>\n134\t  );\n135\t}\n136\t"}]},"parent_tool_use_id":"toolu_019qhPutAQhu9gtYed3XbehR","session_id":"3632df4e-836a-4239-9ca1-2c0c9dc67b92","uuid":"2c7c6544-af1f-4f65-99e3-4e6c2fb58aa2","timestamp":"2026-10-20T06:42:01.843Z","subagent_type":"Explore","task_description":"Audit cinescope implementation against spec"}
