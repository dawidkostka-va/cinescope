ted readonly lastName = signal(this.initialForm.lastName);\n37\t  protected readonly email = signal(this.initialForm.email);\n38\t  protected readonly confirmEmail = signal(this.initialForm.confirmEmail);\n39\t  protected readonly phone = signal(this.initialForm.phone);\n40\t  protected readonly termsAccepted = signal(this.initialForm.termsAccepted);\n41\t\n42\t  protected readonly touched = signal<Record<FieldName, boolean>>({\n43\t    firstName: false,\n44\t    lastName: false,\n45\t    email: false,\n46\t    confirmEmail: false,\n47\t    phone: false,\n48\t    termsAccepted: false,\n49\t  });\n50\t\n51\t  protected readonly submitting = signal(false);\n52\t\n53\t  protected readonly items = computed(() => buildSummaryItems(this.bookingService.booking()?.seats ?? []));\n54\t  protected readonly total = computed(() => this.items().reduce((sum, item) => sum + item.price, 0));\n55\t  protected readonly formatPrice = formatPrice;\n56\t\n57\t  protected readonly firstNameError = computed(() => requiredMinLength(this.firstName(), 'First name', 2));\n58\t  protected readonly lastNameError = computed(() => requiredMinLength(this.lastName(), 'Last name', 2));\n59\t\n60\t  protected readonly emailError = computed(() => {\n61\t    const value = this.email();\n62\t    if (!value) {\n63\t      return 'Email is required';\n64\t    }\n65\t    return EMAIL_RE.test(value) ? null : 'Enter a valid email address';\n66\t  });\n67\t\n68\t  protected readonly confirmEmailError = computed(() => {\n69\t    const value = this.confirmEmail();\n70\t    if (!value) {\n71\t      return 'Confirm email is required';\n72\t    }\n73\t    return value === this.email() ? null : 'Email addresses do not match';\n74\t  });\n75\t\n76\t  protected readonly phoneError = computed(() => {\n77\t    const value = this.phone();\n78\t    if (!value) {\n79\t      return null;\n80\t    }\n81\t    return /^\\d{9}$/.test(value) ? null : 'Phone number must be exactly 9 digits';\n82\t  });\n83\t\n84\t  protected readonly termsError = computed(() => (this.termsAccepted() ? null : 'You must accept the terms and conditions'));\n85\t\n86\t  protected readonly formValid = computed(\n87\t    () =>\n88\t      !this.firstNameError() &&\n89\t      !this.lastNameError() &&\n90\t      !this.emailError() &&\n91\t      !this.confirmEmailError() &&\n92\t      !this.phoneError() &&\n93\t      !this.termsError(),\n94\t  );\n95\t\n96\t  constructor() {\n97\t    effect(() => {\n98\t      this.bookingService.updateForm({\n99\t        firstName: this.firstName(),\n100\t        lastName: this.lastName(),\n101\t        email: this.email(),\n102\t        confirmEmail: this.confirmEmail(),\n103\t        phone: this.phone(),\n104\t        termsAccepted: this.termsAccepted(),\n105\t      });\n106\t    });\n107\t  }\n108\t\n109\t  protected inputValue(event: Event): string {\n110\t    return (event.target as HTMLInputElement).value;\n111\t  }\n112\t\n113\t  protected touch(field: FieldName): void {\n114\t    this.touched.update((t) => ({ ...t, [field]: true }));\n115\t  }\n116\t\n117\t  protected onTermsChange(event: MatCheckboxChange): void {\n118\t    this.termsAccepted.set(event.checked);\n119\t    this.touch('termsAccepted');\n120\t  }\n121\t\n122\t  protected back(): void {\n123\t    this.router.navigate(['/screenings', this.screeningId, 'summary']);\n124\t  }\n125\t\n126\t  protected pay(): void {\n127\t    if (this.submitting()) {\n128\t      return;\n129\t    }\n130\t    if (!this.formValid()) {\n131\t      this.touched.set({\n132\t        firstName: true,\n133\t        lastName: true,\n134\t        email: true,\n135\t        confirmEmail: true,\n136\t        phone: true,\n137\t        termsAccepted: true,\n138\t      });\n139\t      this.toast.show('The form contains errors');\n140\t      return;\n141\t    }\n142\t    const seats = this.items().flatMap((item) => item.ids);\n143\t    const payload: CreateReservationPayload = {\n144\t      screeningId: this.screeningId,\n145\t      seats,\n146\t  