{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YMvUT16RT6K1bu7eFhcpjL","type":"tool_result","content":"1\timport { Component, computed, inject, signal } from '@angular/core';\n2\timport { toSignal } from '@angular/core/rxjs-interop';\n3\timport { MatButtonModule } from '@angular/material/button';\n4\timport { ActivatedRoute, Router } from '@angular/router';\n5\timport { EMPTY, Observable, catchError, map, switchMap, tap } from 'rxjs';\n6\timport { CinemaApi } from '../cinema-api.service';\n7\timport { formatShowDate } from '../dates';\n8\timport { Movie, Screening } from '../models';\n9\timport { Toast } from '../toast';\n10\timport { CouchCell, SeatCell, SeatState, buildAuditorium, seatIdsOf } from './auditorium';\n11\t\n12\tinterface LoadedScreening {\n13\t  screening: Screening;\n14\t  movie: Movie;\n15\t}\n16\t\n17\t/** Painted state of a seat or couch: `selected` replaces a free state. */\n18\texport type DisplayState = SeatState | 'selected';\n19\t\n20\texport interface SelectedRowLine {\n21\t  row: number;\n22\t  seats: string;\n23\t}\n24\t\n25\tconst MAX_SEATS = 10;\n26\t\n27\t@Component({\n28\t  selector: 'app-seat-selection',\n29\t  imports: [MatButtonModule],\n30\t  templateUrl: './seat-selection.html',\n31\t  styleUrl: './seat-selection.scss',\n32\t})\n33\texport class SeatSelection {\n34\t  private readonly api = inject(CinemaApi);\n35\t  private readonly router = inject(Router);\n36\t  private readonly route = inject(ActivatedRoute);\n37\t  private readonly toast = inject(Toast);\n38\t\n39\t  /** Identifiers of the selected seats; a couch contributes both of its identifiers. */\n40\t  private readonly selectedIds = signal<ReadonlySet<string>>(new Set());\n41\t\n42\t  private readonly loaded = toSignal(\n43\t    this.route.paramMap.pipe(\n44\t      map((params) => params.get('id') ?? ''),\n45\t      tap(() => this.selectedIds.set(new Set())),\n46\t      switchMap((id) => this.load(id)),\n47\t    ),\n48\t    { initialValue: null },\n49\t  );\n50\t\n51\t  /** Null while the screening is loading; a failed load redirects to `/`. */\n52\t  readonly page = computed(() => {\n53\t    const current = this.loaded();\n54\t    if (!current) {\n55\t      return null;\n56\t    }\n57\t    return {\n58\t      showDate: formatShowDate(current.screening.date, current.screening.time),\n59\t      rows: buildAuditorium(current.screening.occupiedSeats),\n60\t    };\n61\t  });\n62\t\n63\t  readonly selectedCount = computed(() => this.selectedIds().size);\n64\t\n65\t  /** One `Row <r>: <seats>` line per row with a selection, rows in ascending order. */\n66\t  readonly selectedRows = computed<SelectedRowLine[]>(() => {\n67\t    const lines: SelectedRowLine[] = [];\n68\t    for (const row of this.page()?.rows ?? []) {\n69\t      const seats = row.cells.flatMap((cell) => {\n70\t        if (cell.kind !== 'seat' && cell.kind !== 'couch') {\n71\t          return [];\n72\t        }\n73\t        if (!this.isSelected(cell)) {\n74\t          return [];\n75\t        }\n76\t        return [cell.kind === 'seat' ? `${cell.column}` : `${cell.columnStart}-${cell.columnEnd}`];\n77\t      });\n78\t      if (seats.length > 0) {\n79\t        lines.push({ row: row.row, seats: seats.join(', ') });\n80\t      }\n81\t    }\n82\t    return lines;\n83\t  });\n84\t\n85\t  /** Selects or deselects a seat or couch as one unit; unavailable ones are ignored. */\n86\t  toggle(cell: SeatCell | CouchCell): void {\n87\t    if (cell.state === 'unavailable') {\n88\t      return;\n89\t    }\n90\t    const ids = seatIdsOf(cell);\n91\t    const selected = new Set(this.selectedIds());\n92\t    if (this.isSelected(cell)) {\n93\t      ids.forEach((id) => selected.delete(id));\n94\t    } else {\n95\t      if (selected.size + ids.length > MAX_SEATS) {\n96\t        this.toast.show(`Maximum ${MAX_SEATS} seats per booking`);\n97\t        return;\n98\t      }\n99\t      ids.forEach((id) => selected.add(id));\n100\t    }\n101\t    this.selectedIds.set(selected);\n102\t  }\n103\t\n104\t  isSelected(cell: SeatCell | CouchCell): boolean {\n105\t    return this.selectedIds().has(seatIdsOf(cell)[0]);\n106\t  }\n107\t\n108\t  displayState(cell: SeatCell | CouchCell): DisplayState {\n109\t    if (cell.state === 'unavailable') {\n110\t      return 'unavailable';\n111\t    }\n112\t    return this.isSelected(cell) ? 'selected' : cell.state;\n113\t  }\n114\t\n115\t  private load(id: string): Observable<LoadedScreening> {\n116\t    return this.api.screening(id).pipe(\n117\t      switchMap((screening) =>\n118\t        this.api.movie(screening.movieId).pipe(map((movie) => ({ screening, movie }))),\n119\t      ),\n120\t      catchError(() => {\n121\t        void this.router.navigate(['/']);\n122\t        return EMPTY;\n123\t      }),\n124\t    );\n125\t  }\n126\t}\n127\t"}]},"parent_tool_use_id":"toolu_01JPTxWcsTTxeiKsr6MdEebt","session_id":"da796ddb-14b5-4081-b15a-294e50582b81","uuid":"9b67375e-2a80-4cda-aeb1-7e47e80fc7c4","timestamp":"2026-11-27T15:32:04.080Z","subagent_type":"general-purpose","task_description":"Implement ticket 04"}
